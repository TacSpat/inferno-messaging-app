<div class="flex items-center justify-center min-h-screen bg-gray-900">
  <div class="w-full max-w-md bg-gray-800 rounded-lg shadow-xl p-8">
    <div class="text-center mb-6">
      <h1 class="text-3xl font-bold text-white">🔥 Inferno</h1>
      <p class="text-gray-400 mt-1">Create an account</p>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-4" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div>
        <%= f.label :email, class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full bg-gray-900 border border-gray-700 rounded px-3 py-2 text-white placeholder-gray-500 focus:outline-none focus:border-orange-500 text-sm" %>
      </div>

      <div>
        <%= f.label :username, class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
        <%= f.text_field :username, autocomplete: "username", class: "w-full bg-gray-900 border border-gray-700 rounded px-3 py-2 text-white placeholder-gray-500 focus:outline-none focus:border-orange-500 text-sm" %>
      </div>

      <div>
        <%= f.label :password, class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
        <%= f.password_field :password, autocomplete: "new-password", class: "w-full bg-gray-900 border border-gray-700 rounded px-3 py-2 text-white placeholder-gray-500 focus:outline-none focus:border-orange-500 text-sm" %>
      </div>

      <div>
        <%= f.label :password_confirmation, "Confirm Password", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full bg-gray-900 border border-gray-700 rounded px-3 py-2 text-white placeholder-gray-500 focus:outline-none focus:border-orange-500 text-sm" %>
      </div>

      <div>
        <%= f.submit "Continue", class: "w-full bg-orange-600 hover:bg-orange-700 text-white font-semibold py-2.5 rounded transition cursor-pointer text-sm" %>
      </div>
    <% end %>

    <p class="text-center text-sm text-gray-400 mt-4">
      Already have an account? <%= link_to "Log In", new_session_path(resource_name), class: "text-orange-400 hover:underline" %>
    </p>
  </div>
</div>
