<div class="flex items-center justify-center min-h-screen bg-gray-900">
  <div class="w-full max-w-md bg-gray-800 rounded-lg shadow-xl p-8">
    <div class="text-center mb-6">
      <h1 class="text-3xl font-bold text-white">Inferno</h1>
      <p class="text-gray-400 mt-1">Welcome back, <%= User.owner&.display_name || "owner" %>!</p>
    </div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>
      <!-- Hidden email field since we only have one user -->
      <%= f.hidden_field :email, value: User.owner&.email %>

      <div>
        <%= f.label :password, "Passphrase", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
        <%= f.password_field :password, autofocus: true, autocomplete: "current-password", class: "w-full bg-gray-900 border border-gray-700 rounded px-3 py-2 text-white placeholder-gray-500 focus:outline-none focus:border-accent text-sm" %>
      </div>

      <div class="flex items-center">
        <label class="flex items-center">
          <%= f.check_box :remember_me, class: "rounded bg-gray-900 border-gray-700 text-accent focus:ring-accent" %>
          <span class="ml-2 text-sm text-gray-400">Remember me</span>
        </label>
      </div>

      <div>
        <%= f.submit "Unlock", class: "w-full bg-gradient-to-r from-confirm-dark to-confirm hover:from-confirm hover:to-confirm-light text-white font-semibold py-2.5 rounded transition cursor-pointer text-sm" %>
      </div>
    <% end %>
  </div>
</div>
