<div class="reactions-container">
  <% if message.reactions.any? %>
    <div class="flex flex-wrap gap-1 mt-1">
      <% message.reactions.group_by(&:emoji).each do |emoji, reactions| %>
        <% user_reacted = defined?(current_user) && current_user && reactions.any? { |r| r.user_id == current_user.id } %>
        <button class="flex items-center rounded px-2 py-0.5 text-xs hover:bg-gray-750 border cursor-pointer <%= user_reacted ? 'bg-orange-600/20 border-orange-500' : 'bg-gray-800 border-gray-700' %>"
                data-action="click->message-form#toggleReaction"
                data-message-id="<%= message.public_id %>"
                data-emoji="<%= emoji %>">
          <span><%= emoji %></span>
          <span class="ml-1 text-gray-400"><%= reactions.count %></span>
        </button>
      <% end %>
    </div>
  <% end %>
</div>
