<div class="reactions-container">
  <% if message.reactions.any? %>
    <div class="flex flex-wrap gap-1.5 mt-1.5">
      <% message.reactions.group_by(&:emoji).each do |emoji, reactions| %>
        <% user_reacted = defined?(current_user) && current_user && reactions.any? { |r| r.user_id == current_user.id } %>
        <% ctrl = local_assigns[:reaction_controller] || 'message-form' %>
        <button class="flex items-center rounded-md px-2.5 py-1 text-sm hover:bg-gray-750 border cursor-pointer <%= user_reacted ? 'bg-red-600/15 border-red-500' : 'bg-gray-800 border-gray-700' %>"
                data-action="click-><%= ctrl %>#toggleReaction"
                data-message-id="<%= message.public_id %>"
                data-emoji="<%= emoji %>">
          <span class="text-lg leading-none"><%= render_reaction_emoji(emoji, message) %></span>
          <span class="ml-1.5 text-gray-400"><%= reactions.count %></span>
        </button>
      <% end %>
    </div>
  <% end %>
</div>
