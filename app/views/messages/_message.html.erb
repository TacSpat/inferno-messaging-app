<% grouped = local_assigns[:grouped] %>
<% author = message.user %>
<% unless author %>
  <% remote_member = message.channel&.server&.remote_members&.find_by(pubkey: message.nostr_author_pubkey) if message.nostr_author_pubkey.present? %>
  <% nostr_contact = remote_member ? nil : message.nostr_author %>
<% end %>
<% remote_author_name = remote_member&.display_name_for || nostr_contact&.effective_display_name || (message.nostr_author_pubkey.present? ? message.nostr_author_pubkey.first(12) + "..." : nil) %>
<% remote_avatar_url = remote_member&.effective_avatar_url || nostr_contact&.avatar_url %>
<% if message.system_message? %>
  <!-- System message (welcome, join, call log, etc.) -->
  <div id="message_<%= message.public_id %>" class="flex items-center py-1 px-2 sm:px-4" data-message-id="<%= message.public_id %>" data-author-id="<%= author&.public_id %>" data-timestamp="<%= message.created_at.iso8601 %>" data-system-message="true">
    <% if message.content&.start_with?("call:") %>
      <% call_parts = message.content.split(":") %>
      <% call_status = call_parts[2] %>
      <% call_duration = call_parts[3].to_i %>
      <% call_color = call_status == "ended" ? "text-green-400" : "text-red-400" %>
      <svg class="w-4 h-4 <%= call_color %> mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
      <span class="text-sm text-gray-300">
        <% if call_status == "ended" && call_duration > 0 %>
          Call ended — <%= call_duration / 60 %>:<%= "%02d" % (call_duration % 60) %>
        <% elsif call_status == "missed" %>
          Missed call
        <% elsif call_status == "declined" %>
          Call declined
        <% else %>
          Call ended
        <% end %>
      </span>
    <% else %>
      <svg class="w-4 h-4 text-green-400 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
      </svg>
      <span class="text-sm text-gray-300">
        <%= message.rendered_content %>
      </span>
    <% end %>
    <span class="ml-2 text-xs text-gray-500"><%= message.created_at.strftime("%m/%d/%Y %l:%M %p") %></span>
  </div>
<% else %>
  <div id="message_<%= message.public_id %>" class="flex flex-col sm:flex-row sm:items-start py-0.5 px-1 sm:px-2 group hover:bg-gray-680 rounded relative<%= ' message-grouped' if grouped %>" style="--tw-bg-opacity: 0.06;" data-message-id="<%= message.public_id %>" data-author-id="<%= author&.public_id %>" data-timestamp="<%= message.created_at.iso8601 %>"<%= ' data-is-reply="true"'.html_safe if message.parent %><%= ' data-is-sticker="true"'.html_safe if message.is_sticker? %> data-pinned="<%= message.pinned? %>" data-pin-url="<%= toggle_pin_channel_message_path(message.channel, message) %>">
    <% if grouped %>
      <!-- Grouped: hover timestamp spacer (desktop only) -->
      <div class="hidden sm:flex shrink-0 mt-0.5 mr-4 w-10 items-center justify-center">
        <span class="text-[10px] text-gray-500 opacity-0 group-hover:opacity-100"><%= message.created_at.strftime("%l:%M %p").strip %></span>
      </div>
    <% else %>
      <!-- Mobile: avatar + name inline row -->
      <% msg_avatar = author&.effective_avatar_url || remote_avatar_url %>
      <% msg_member = author || remote_member %>
      <% msg_avatar_blur = nsfw_blur_class(author&.try(:avatar_nsfw?) || remote_member&.try(:avatar_nsfw?)) %>
      <div class="flex items-center mb-0.5 sm:hidden">
        <% if msg_avatar.present? %>
          <%= image_tag msg_avatar, class: "w-7 h-7 rounded-full object-cover cursor-pointer shrink-0 #{msg_avatar_blur}", data: msg_member ? { msg_user_id: msg_member.public_id } : {} %>
        <% else %>
          <div class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold text-white cursor-pointer shrink-0" style="background-color: <%= msg_member&.try(:profile_color) || '#1e1c1b' %>"<%= " data-msg-user-id=\"#{msg_member&.public_id}\"".html_safe if msg_member %>>
            <%= author ? author.username[0].upcase : (remote_author_name ? remote_author_name[0].upcase : "?") %>
          </div>
        <% end %>
        <span class="ml-2 font-medium text-sm truncate" style="color: <%= author ? author.role_color_for(server) : (remote_member&.role_color_for || '#6b7280') %>"<%= " data-msg-user-id=\"#{msg_member&.public_id}\"".html_safe if msg_member %>>
          <%= author ? author.display_name_for(server) : (remote_author_name || "Unknown User") %>
        </span>
        <span class="ml-2 text-xs text-gray-500 shrink-0">
          <%= message.created_at.strftime("%l:%M %p").strip %>
        </span>
        <% if message.edited? %>
          <span class="ml-1 text-xs text-gray-500 shrink-0">(edited)</span>
        <% end %>
      </div>

      <!-- Desktop: avatar column -->
      <div class="hidden sm:block shrink-0 mt-0.5 mr-4">
        <% if msg_avatar.present? %>
          <%= image_tag msg_avatar, class: "w-10 h-10 rounded-full object-cover cursor-pointer #{msg_avatar_blur}", data: msg_member ? { msg_user_id: msg_member.public_id } : {} %>
        <% else %>
          <div class="w-10 h-10 rounded-full flex items-center justify-center text-sm font-bold text-white cursor-pointer" style="background-color: <%= msg_member&.try(:profile_color) || '#1e1c1b' %>"<%= " data-msg-user-id=\"#{msg_member&.public_id}\"".html_safe if msg_member %>>
            <%= author ? author.username[0].upcase : (remote_author_name ? remote_author_name[0].upcase : "?") %>
          </div>
        <% end %>
      </div>
    <% end %>

    <!-- Content -->
    <div class="flex-1 min-w-0">
      <% if message.parent %>
        <% parent_author = message.parent.user %>
        <div class="flex items-center text-xs text-gray-400 mb-0.5 cursor-pointer hover:text-gray-200" onclick="const el=document.getElementById('message_<%= message.parent.public_id %>'); if(el){el.scrollIntoView({behavior:'smooth',block:'center'});el.style.backgroundColor='rgb(var(--accent) / 0.3)';el.style.borderRadius='4px';setTimeout(function(){el.style.transition='background-color 0.8s ease-out';el.style.backgroundColor='transparent';setTimeout(function(){el.style.backgroundColor='';el.style.borderRadius='';el.style.transition=''},800)},1000)}">
          <svg class="w-3 h-3 mr-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/></svg>
          <span class="font-medium mr-1" style="color: <%= parent_author ? parent_author.role_color_for(server) : '#6b7280' %>"><%= parent_author&.username || "Deleted User" %></span>
          <span class="truncate max-w-xs"><%= truncate(message.parent.content.to_s.gsub(/```\w*\n?/, "").gsub(/```/, "").strip, length: 60) %></span>
        </div>
      <% end %>

      <% unless grouped %>
        <!-- Desktop name/timestamp -->
        <div class="hidden sm:flex items-baseline">
          <span class="font-medium hover:underline cursor-pointer text-sm" style="color: <%= author ? author.role_color_for(server) : (remote_member&.role_color_for || '#6b7280') %>"<%= " data-msg-user-id=\"#{author.public_id}\"".html_safe if author %>>
            <%= author ? author.display_name_for(server) : (remote_author_name || "Unknown User") %>
          </span>
          <span class="ml-2 text-xs text-gray-500">
            <%= message.created_at.strftime("%m/%d/%Y %l:%M %p") %>
          </span>
          <% if message.edited? %>
            <span class="ml-1 text-xs text-gray-500">(edited)</span>
          <% end %>
        </div>
      <% end %>
      <% if message.pinned? %>
        <div class="flex items-center gap-1 text-[11px] text-warning-light/70 mt-0.5">
          <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24"><path d="M16 12V4h1V2H7v2h1v8l-2 2v2h5.2v6h1.6v-6H18v-2l-2-2z"/></svg>
          Pinned
        </div>
      <% end %>
      <% if message.spoiler? && message.content.present? %>
        <div class="spoiler-inline" onclick="this.classList.toggle('revealed')" role="button" tabindex="0">
          <div class="spoiler-inline-content text-sm text-gray-200 leading-relaxed message-content" data-raw-content="<%= h(message.content) %>"><%= message.rendered_content %></div>
        </div>
      <% else %>
        <div class="text-sm text-gray-200 leading-relaxed message-content" data-raw-content="<%= h(message.content) %>">
          <%= message.rendered_content %>
        </div>
      <% end %>

      <% if local_assigns[:verification_channel] && message.user %>
        <% author_membership = message.user.server_memberships.find_by(server: server) %>
        <% if author_membership %>
          <% verified_role = server.roles.find_by(name: "Verified") %>
          <% is_verified = verified_role && author_membership.roles.include?(verified_role) %>
          <div class="flex items-center gap-2 mt-2">
            <% if is_verified %>
              <span class="inline-flex items-center gap-1 text-xs text-green-400 bg-green-400/10 px-2 py-1 rounded-lg">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                Verified
              </span>
              <%= button_to "Remove Verification",
                    server_settings_unverify_member_path(server, author_membership.public_id),
                    method: :post,
                    class: "text-xs text-gray-500 hover:text-danger-light transition cursor-pointer",
                    data: { turbo_confirm: "Remove verification from #{message.user.username}?" } %>
            <% else %>
              <%= button_to server_settings_verify_member_path(server, author_membership.public_id),
                    method: :post,
                    class: "inline-flex items-center gap-1.5 text-xs font-medium text-white bg-accent hover:bg-accent-light px-3 py-1.5 rounded-lg transition cursor-pointer",
                    data: { turbo_confirm: "Grant Verified role to #{message.user.username}?" } do %>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                Verify Member
              <% end %>
            <% end %>
          </div>
        <% end %>
      <% end %>

      <!-- Attachments -->
      <% if message.files.attached? %>
        <% spoiler_attach = message.spoiler? %>
        <% if spoiler_attach %>
          <div class="spoiler-attachment-wrap mt-2" onclick="this.classList.toggle('revealed')">
            <div class="spoiler-attachment-hidden">
              <svg class="w-8 h-8 text-gray-400 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.878 9.878L6.11 6.11m3.768 3.768l4.242 4.242m0 0l3.768 3.768M6.11 6.11L3 3m3.11 3.11l11.78 11.78M21 21l-3.11-3.11"/></svg>
              <span class="text-sm font-medium text-gray-300">Spoiler</span>
              <span class="text-xs text-gray-500"><%= message.files.count %> attachment<%= message.files.count == 1 ? '' : 's' %> — click to reveal</span>
            </div>
            <div class="spoiler-attachment-content">
        <% end %>
        <div class="flex flex-wrap gap-2 <%= 'mt-0' if spoiler_attach %> <%= 'mt-2' unless spoiler_attach %>">
          <% message.files.each do |file| %>
            <% if file.content_type&.start_with?("image/") %>
              <div data-attachment-id="<%= file.id %>" data-attachment-name="<%= file.filename %>" data-attachment-type="image" data-attachment-url="<%= url_for(file) %>" class="inline-block">
              <%= image_tag url_for(file), class: "max-w-full sm:max-w-sm max-h-72 rounded-lg cursor-pointer hover:shadow-lg transition-shadow", data: { preview_src: url_for(file), preview_filename: file.filename.to_s, lock_dims: true }.merge(file.content_type == "image/gif" ? { animated_gif: true } : {}) %>
              </div>
<% elsif file.content_type&.start_with?("video/") %>
              <div data-attachment-id="<%= file.id %>" data-attachment-name="<%= file.filename %>" data-attachment-type="video" data-attachment-url="<%= url_for(file) %>" class="inline-block relative rounded-lg overflow-hidden" data-controller="video-player">
                <video preload="metadata" class="max-w-full sm:max-w-lg max-h-96 block" src="<%= url_for(file) %>"
                       data-video-player-target="video" data-video-src="<%= url_for(file) %>"
                       data-video-filename="<%= file.filename %>"></video>
              </div>
<% elsif file.content_type&.start_with?("audio/") %>
  <div data-attachment-id="<%= file.id %>" data-attachment-name="<%= file.filename %>" data-attachment-type="audio" class="flex items-center gap-2 bg-gray-800 rounded-lg px-3 py-2">
    <span class="text-sm text-gray-300"><%= file.filename %></span>
    <audio controls preload="metadata" src="<%= url_for(file) %>" class="h-8"></audio>
  </div>
<% else %>
              <div data-attachment-id="<%= file.id %>" data-attachment-name="<%= file.filename %>" data-attachment-type="file" class="inline-block">
              <a href="<%= url_for(file) %>" data-turbo-frame="_top" class="flex items-center bg-gray-800 rounded-lg px-3 py-2 hover:bg-gray-750">
                <svg class="w-6 h-6 text-gray-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                <span class="text-sm text-accent-light"><%= file.filename %></span>
              </a>
              </div>
            <% end %>
          <% end %>
        </div>
        <% if spoiler_attach %>
            </div>
          </div>
        <% end %>
      <% end %>

      <!-- Reactions -->
      <%= render partial: "messages/reactions", locals: { message: message, reaction_controller: "message-form" } %>
    </div>

    <!-- Action buttons (hover) -->
    <div class="hidden group-hover:flex items-center bg-gray-800 rounded border border-gray-700 shadow-lg absolute top-0 right-2 -translate-y-1/2 z-10">
      <button class="p-1.5 text-gray-400 hover:text-gray-200 reaction-picker-btn" title="React"
              data-message-id="<%= message.public_id %>"
              data-action="click->message-form#openReactionPicker">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      </button>
      <button class="p-1.5 text-gray-400 hover:text-gray-200" title="Reply"
              data-action="click->message-form#setReply"
              data-message-id="<%= message.public_id %>"
              data-author-name="<%= author&.username || 'Deleted User' %>"
              data-preview="<%= truncate(message.content.to_s.gsub(/```\w*\n?/, "").gsub(/```/, "").strip, length: 80) %>">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/></svg>
      </button>
      <% if defined?(server) && server %>
        <% can_pin = current_user.server_memberships.find_by(server: server)&.has_permission?("manage_messages") %>
        <% if can_pin %>
          <button class="p-1.5 text-gray-400 hover:text-warning-light cursor-pointer" title="<%= message.pinned? ? 'Unpin' : 'Pin' %>"
                  data-pin-toggle data-pin-url="<%= toggle_pin_channel_message_path(message.channel, message) %>">
            <svg class="w-4 h-4" fill="<%= message.pinned? ? 'currentColor' : 'none' %>" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12V4h1V2H7v2h1v8l-2 2v2h5.2v6h1.6v-6H18v-2l-2-2z"/></svg>
          </button>
        <% end %>
      <% end %>
      <% if message.files.attached? && message.files.any? { |f| f.content_type&.start_with?("image/") || f.content_type&.start_with?("video/") } %>
        <button class="p-1.5 text-gray-400 hover:text-gray-200" title="Toggle Spoiler"
                data-action="click->message-actions#toggleSpoiler"
                data-message-id="<%= message.public_id %>">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.878 9.878L6.11 6.11m3.768 3.768l4.242 4.242m0 0l3.768 3.768M6.11 6.11L3 3m3.11 3.11l11.78 11.78M21 21l-3.11-3.11"/></svg>
        </button>
      <% end %>
      <button class="p-1.5 text-gray-400 hover:text-danger-light" title="Hide Message"
              data-action="click->message-actions#hideMessage"
              data-hide-url="<%= user_settings_hide_message_path(message.public_id) %>">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.618 5.984A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01"/></svg>
      </button>
      <% if author == current_user && !message.is_sticker? %>
        <button class="p-1.5 text-gray-400 hover:text-gray-200" title="Edit"
                data-msg-edit-id="<%= message.public_id %>">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
        </button>
      <% end %>
    </div>
  </div>
<% end %>
