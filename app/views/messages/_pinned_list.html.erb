<% if messages.empty? %>
  <div class="py-8 text-center">
    <svg class="w-8 h-8 text-gray-600 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12V4h1V2H7v2h1v8l-2 2v2h5.2v6h1.6v-6H18v-2l-2-2z"/></svg>
    <p class="text-sm text-gray-500">No pinned messages</p>
  </div>
<% else %>
  <div class="divide-y divide-gray-700/50">
    <% messages.each do |msg| %>
      <% author = msg.user %>
      <% unless author %>
        <% remote_member = msg.channel&.server&.remote_members&.find_by(pubkey: msg.nostr_author_pubkey) if msg.nostr_author_pubkey.present? %>
        <% nostr_contact = remote_member ? nil : msg.nostr_author %>
      <% end %>
      <% pin_author_name = author ? (server ? author.display_name_for(server) : (author.display_name.presence || author.username)) : (remote_member&.display_name_for || nostr_contact&.effective_display_name || (msg.nostr_author_pubkey.present? ? msg.nostr_author_pubkey.first(12) + "..." : "Unknown")) %>
      <% pin_avatar_url = author&.effective_avatar_url || remote_member&.effective_avatar_url || nostr_contact&.avatar_url %>
      <% pin_color = author && server ? author.role_color_for(server) : (remote_member&.role_color_for || (author ? '#d1d5db' : '#6b7280')) %>
      <% pin_profile_color = author&.try(:profile_color) || remote_member&.try(:profile_color) || '#1e1c1b' %>
      <div class="px-3 py-2.5 hover:bg-gray-800/60 cursor-pointer transition" data-jump-to-message="<%= msg.public_id %>">
        <div class="flex items-start gap-2.5">
          <!-- Avatar -->
          <div class="shrink-0 mt-0.5">
            <% if pin_avatar_url.present? %>
              <%= image_tag pin_avatar_url, class: "w-9 h-9 rounded-full object-cover" %>
            <% else %>
              <div class="w-9 h-9 rounded-full flex items-center justify-center text-xs font-bold text-white" style="background-color: <%= pin_profile_color %>">
                <%= pin_author_name[0]&.upcase || "?" %>
              </div>
            <% end %>
          </div>

          <!-- Content -->
          <div class="flex-1 min-w-0">
            <!-- Name + timestamp -->
            <div class="flex items-baseline gap-2 mb-0.5">
              <span class="text-sm font-medium" style="color: <%= pin_color %>">
                <%= pin_author_name %>
              </span>
              <span class="text-[11px] text-gray-500"><%= msg.created_at.strftime("%m/%d/%Y %l:%M %p") %></span>
            </div>

            <!-- Message body -->
            <% if msg.is_sticker? %>
              <div class="max-w-[128px]"><%= msg.rendered_content %></div>
            <% elsif msg.spoiler? && msg.content.present? %>
              <div class="spoiler-inline" onclick="event.stopPropagation(); this.classList.toggle('revealed')" role="button" tabindex="0">
                <div class="spoiler-inline-content text-sm text-gray-200 leading-relaxed message-content text-left"><%= msg.rendered_content %></div>
              </div>
            <% elsif msg.content.present? %>
              <div class="text-sm text-gray-200 leading-relaxed message-content text-left"><%= msg.rendered_content %></div>
            <% end %>

            <!-- Attachments -->
            <% if msg.files.attached? %>
              <div class="flex flex-wrap gap-2 mt-2">
                <% msg.files.each do |file| %>
                  <% if file.content_type&.start_with?("image/") %>
                    <div class="inline-block min-h-[4rem] min-w-[4rem] rounded-lg bg-gray-800">
                      <%= image_tag url_for(file), class: "max-w-full sm:max-w-xs max-h-60 rounded-lg", data: file.content_type == "image/gif" ? { animated_gif: true } : {} %>
                    </div>
                  <% elsif file.content_type&.start_with?("video/") %>
                    <div class="inline-block relative rounded-lg overflow-hidden">
                      <video preload="metadata" class="max-w-full sm:max-w-xs max-h-60 block rounded-lg" src="<%= url_for(file) %>" controls></video>
                    </div>
                  <% elsif file.content_type&.start_with?("audio/") %>
                    <div class="flex items-center gap-2 bg-gray-800 rounded-lg px-3 py-2">
                      <span class="text-sm text-gray-300"><%= file.filename %></span>
                      <audio controls preload="metadata" src="<%= url_for(file) %>" class="h-8"></audio>
                    </div>
                  <% else %>
                    <a href="<%= url_for(file) %>" data-turbo-frame="_top" class="flex items-center bg-gray-800 rounded-lg px-3 py-2 hover:bg-gray-750" onclick="event.stopPropagation()">
                      <svg class="w-6 h-6 text-gray-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                      <span class="text-sm text-accent-light"><%= file.filename %></span>
                    </a>
                  <% end %>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
