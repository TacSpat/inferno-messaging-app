<div id="message_<%= message.public_id %>" class="flex items-start py-0.5 px-2 group hover:bg-gray-680 rounded relative" style="--tw-bg-opacity: 0.06;" data-message-id="<%= message.public_id %>" data-author-id="<%= message.user.public_id %>">
  <!-- Avatar -->
  <div class="shrink-0 mt-0.5 mr-4">
    <% if message.user.avatar.attached? %>
      <%= image_tag message.user.avatar, class: "w-10 h-10 rounded-full object-cover cursor-pointer" %>
    <% else %>
      <div class="w-10 h-10 rounded-full flex items-center justify-center text-sm font-bold text-white cursor-pointer" style="background-color: <%= message.user.profile_color || '#2b2d31' %>">
        <%= message.user.username[0].upcase %>
      </div>
    <% end %>
  </div>

  <!-- Content -->
  <div class="flex-1 min-w-0">
    <% if message.parent %>
      <div class="flex items-center text-xs text-gray-400 mb-0.5 cursor-pointer hover:text-gray-200" onclick="const el=document.getElementById('message_<%= message.parent.public_id %>'); if(el){el.scrollIntoView({behavior:'smooth',block:'center'});el.style.backgroundColor='rgba(99,102,241,0.3)';el.style.borderRadius='4px';setTimeout(function(){el.style.transition='background-color 0.8s ease-out';el.style.backgroundColor='transparent';setTimeout(function(){el.style.backgroundColor='';el.style.borderRadius='';el.style.transition=''},800)},1000)}">
        <svg class="w-3 h-3 mr-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/></svg>
        <span class="font-medium mr-1 text-white"><%= message.parent.user.display_name.presence || message.parent.user.username %></span>
        <span class="truncate max-w-xs"><%= truncate(message.parent.content.to_s.gsub(/```\w*\n?/, "").gsub(/```/, "").strip, length: 60) %></span>
      </div>
    <% end %>

    <div class="flex items-baseline">
      <span class="font-medium hover:underline cursor-pointer text-sm text-white">
        <%= message.user.display_name.presence || message.user.username %>
      </span>
      <span class="ml-2 text-xs text-gray-500">
        <%= message.created_at.strftime("%m/%d/%Y %l:%M %p") %>
      </span>
      <% if message.edited? %>
        <span class="ml-1 text-xs text-gray-500">(edited)</span>
      <% end %>
    </div>
    <div class="text-sm text-gray-200 leading-relaxed message-content" data-raw-content="<%= h(message.content) %>">
      <%= message.rendered_content %>
    </div>

    <!-- Attachments -->
    <% if message.files.attached? %>
      <div class="flex flex-wrap gap-2 mt-2">
        <% message.files.each do |file| %>
          <% if file.content_type&.start_with?("image/") %>
            <div data-attachment-id="<%= file.id %>" class="inline-block">
              <%= image_tag url_for(file), class: "max-w-sm max-h-72 rounded-lg cursor-pointer hover:shadow-lg transition-shadow", loading: "lazy", data: { preview_src: url_for(file), preview_filename: file.filename.to_s } %>
            </div>
          <% elsif file.content_type&.start_with?("video/") %>
            <div class="inline-block relative rounded-lg overflow-hidden" data-controller="video-player">
              <video preload="metadata" class="max-w-lg max-h-96 block" src="<%= url_for(file) %>"
                     data-video-player-target="video" data-video-src="<%= url_for(file) %>"
                     data-video-filename="<%= file.filename %>"></video>
            </div>
          <% elsif file.content_type&.start_with?("audio/") %>
            <div class="flex items-center gap-2 bg-gray-800 rounded-lg px-3 py-2">
              <span class="text-sm text-gray-300"><%= file.filename %></span>
              <audio controls preload="metadata" src="<%= url_for(file) %>" class="h-8"></audio>
            </div>
          <% else %>
            <a href="<%= url_for(file) %>" class="flex items-center bg-gray-800 rounded-lg px-3 py-2 hover:bg-gray-750">
              <svg class="w-6 h-6 text-gray-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
              <span class="text-sm text-blue-400"><%= file.filename %></span>
            </a>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Action buttons (hover) -->
  <div class="hidden group-hover:flex items-center bg-gray-800 rounded border border-gray-700 shadow-lg absolute top-0 right-2 -translate-y-1/2 z-10">
    <button class="p-1.5 text-gray-400 hover:text-gray-200" title="Reply"
            data-action="click->dm-message-form#setReply"
            data-message-id="<%= message.public_id %>"
            data-author-name="<%= message.user.display_name.presence || message.user.username %>"
            data-preview="<%= truncate(message.content.to_s.gsub(/```\w*\n?/, "").gsub(/```/, "").strip, length: 80) %>">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/></svg>
    </button>
  </div>
</div>
