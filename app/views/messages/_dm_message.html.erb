<% author = message.user %>
<div id="message_<%= message.public_id %>" class="flex flex-col sm:flex-row sm:items-start py-0.5 px-1 sm:px-2 group hover:bg-gray-680 rounded relative" style="--tw-bg-opacity: 0.06;" data-message-id="<%= message.public_id %>" data-author-id="<%= author&.public_id %>">
  <!-- Mobile: avatar + name inline row -->
  <div class="flex items-center mb-0.5 sm:hidden">
    <% if author&.avatar&.attached? %>
      <%= image_tag author.avatar, class: "w-7 h-7 rounded-full object-cover cursor-pointer shrink-0", data: author ? { msg_user_id: author.public_id } : {} %>
    <% else %>
      <div class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold text-white cursor-pointer shrink-0" style="background-color: <%= author&.profile_color || '#1e1c1b' %>"<%= " data-msg-user-id=\"#{author.public_id}\"".html_safe if author %>>
        <%= author ? author.username[0].upcase : "?" %>
      </div>
    <% end %>
    <span class="ml-2 font-medium text-sm text-white truncate"<%= " data-msg-user-id=\"#{author.public_id}\"".html_safe if author %>>
      <%= author ? (author.display_name.presence || author.username) : "Deleted User" %>
    </span>
    <span class="ml-2 text-xs text-gray-500 shrink-0">
      <%= message.created_at.strftime("%l:%M %p").strip %>
    </span>
    <% if message.edited? %>
      <span class="ml-1 text-xs text-gray-500 shrink-0">(edited)</span>
    <% end %>
  </div>

  <!-- Desktop: avatar column -->
  <div class="hidden sm:block shrink-0 mt-0.5 mr-4">
    <% if author&.avatar&.attached? %>
      <%= image_tag author.avatar, class: "w-10 h-10 rounded-full object-cover cursor-pointer", data: author ? { msg_user_id: author.public_id } : {} %>
    <% else %>
      <div class="w-10 h-10 rounded-full flex items-center justify-center text-sm font-bold text-white cursor-pointer" style="background-color: <%= author&.profile_color || '#1e1c1b' %>"<%= " data-msg-user-id=\"#{author.public_id}\"".html_safe if author %>>
        <%= author ? author.username[0].upcase : "?" %>
      </div>
    <% end %>
  </div>

  <!-- Content -->
  <div class="flex-1 min-w-0">
    <% if message.parent %>
      <% parent_author = message.parent.user %>
      <div class="flex items-center text-xs text-gray-400 mb-0.5 cursor-pointer hover:text-gray-200" onclick="const el=document.getElementById('message_<%= message.parent.public_id %>'); if(el){el.scrollIntoView({behavior:'smooth',block:'center'});el.style.backgroundColor='rgb(var(--accent) / 0.3)';el.style.borderRadius='4px';setTimeout(function(){el.style.transition='background-color 0.8s ease-out';el.style.backgroundColor='transparent';setTimeout(function(){el.style.backgroundColor='';el.style.borderRadius='';el.style.transition=''},800)},1000)}">
        <svg class="w-3 h-3 mr-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/></svg>
        <span class="font-medium mr-1 text-white"><%= parent_author ? (parent_author.display_name.presence || parent_author.username) : "Deleted User" %></span>
        <span class="truncate max-w-xs"><%= truncate(message.parent.content.to_s.gsub(/```\w*\n?/, "").gsub(/```/, "").strip, length: 60) %></span>
      </div>
    <% end %>

    <!-- Desktop name/timestamp -->
    <div class="hidden sm:flex items-baseline">
      <span class="font-medium hover:underline cursor-pointer text-sm text-white"<%= " data-msg-user-id=\"#{author.public_id}\"".html_safe if author %>>
        <%= author ? (author.display_name.presence || author.username) : "Deleted User" %>
      </span>
      <span class="ml-2 text-xs text-gray-500">
        <%= message.created_at.strftime("%m/%d/%Y %l:%M %p") %>
      </span>
      <% if message.edited? %>
        <span class="ml-1 text-xs text-gray-500">(edited)</span>
      <% end %>
    </div>
    <div class="text-sm text-gray-200 leading-relaxed message-content" data-raw-content="<%= h(message.content) %>">
      <%= message.rendered_content %>
    </div>

    <!-- Attachments -->
    <% if message.files.attached? %>
      <div class="flex flex-wrap gap-2 mt-2">
        <% message.files.each do |file| %>
          <% if file.content_type&.start_with?("image/") %>
            <div data-attachment-id="<%= file.id %>" class="inline-block">
              <%= image_tag url_for(file), class: "max-w-full sm:max-w-sm max-h-72 rounded-lg cursor-pointer hover:shadow-lg transition-shadow", loading: "lazy", data: { preview_src: url_for(file), preview_filename: file.filename.to_s }.merge(file.content_type == "image/gif" ? { animated_gif: true } : {}) %>
            </div>
          <% elsif file.content_type&.start_with?("video/") %>
            <div class="inline-block relative rounded-lg overflow-hidden" data-controller="video-player">
              <video preload="metadata" class="max-w-full sm:max-w-lg max-h-96 block" src="<%= url_for(file) %>"
                     data-video-player-target="video" data-video-src="<%= url_for(file) %>"
                     data-video-filename="<%= file.filename %>"></video>
            </div>
          <% elsif file.content_type&.start_with?("audio/") %>
            <div class="flex items-center gap-2 bg-gray-800 rounded-lg px-3 py-2">
              <span class="text-sm text-gray-300"><%= file.filename %></span>
              <audio controls preload="metadata" src="<%= url_for(file) %>" class="h-8"></audio>
            </div>
          <% else %>
            <a href="<%= url_for(file) %>" class="flex items-center bg-gray-800 rounded-lg px-3 py-2 hover:bg-gray-750">
              <svg class="w-6 h-6 text-gray-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
              <span class="text-sm text-accent-light"><%= file.filename %></span>
            </a>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <!-- Reactions -->
    <%= render partial: "messages/reactions", locals: { message: message, reaction_controller: "dm-message-form" } %>
  </div>

  <!-- Action buttons (hover) -->
  <div class="hidden group-hover:flex items-center bg-gray-800 rounded border border-gray-700 shadow-lg absolute top-0 right-2 -translate-y-1/2 z-10">
    <button class="p-1.5 text-gray-400 hover:text-gray-200 reaction-picker-btn" title="React"
            data-message-id="<%= message.public_id %>"
            data-action="click->dm-message-form#openReactionPicker">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
    </button>
    <button class="p-1.5 text-gray-400 hover:text-gray-200" title="Reply"
            data-action="click->dm-message-form#setReply"
            data-message-id="<%= message.public_id %>"
            data-author-name="<%= author ? (author.display_name.presence || author.username) : 'Deleted User' %>"
            data-preview="<%= truncate(message.content.to_s.gsub(/```\w*\n?/, "").gsub(/```/, "").strip, length: 80) %>">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/></svg>
    </button>
  </div>
</div>
