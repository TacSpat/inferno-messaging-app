<div class="min-h-screen bg-gray-900 flex items-center justify-center px-4">
  <div class="max-w-md w-full">
    <div class="bg-gray-800 rounded-xl shadow-2xl p-8">
      <!-- Header -->
      <div class="text-center mb-6">
        <div class="w-12 h-12 mx-auto mb-4 border-4 border-gray-600 border-t-accent rounded-full animate-spin" id="sign-spinner"></div>
        <h1 class="text-xl font-bold text-white">Connecting to instance</h1>
        <p class="text-gray-400 text-sm mt-1">
          Verifying your identity with <strong class="text-gray-200"><%= @requesting_domain %></strong>
        </p>
      </div>

      <!-- Your profile -->
      <div class="bg-gray-900 rounded-lg p-4 mb-5">
        <p class="text-[10px] font-semibold text-gray-500 uppercase tracking-wide mb-2.5">Signed in as</p>
        <div class="flex items-center gap-3">
          <% if current_user.avatar.attached? %>
            <%= image_tag current_user.avatar, class: "w-10 h-10 rounded-full object-cover" %>
          <% elsif current_user.effective_avatar_url.present? %>
            <%= image_tag current_user.effective_avatar_url, class: "w-10 h-10 rounded-full object-cover" %>
          <% else %>
            <div class="w-10 h-10 rounded-full flex items-center justify-center text-sm font-bold" style="background-color: <%= current_user.profile_color || '#1e1c1b' %>">
              <%= current_user.username[0].upcase %>
            </div>
          <% end %>
          <div>
            <p class="text-white font-semibold"><%= current_user.display_name.presence || current_user.username %></p>
            <p class="text-xs text-gray-400"><%= current_user.tag %></p>
          </div>
        </div>
      </div>

      <!-- What's being shared -->
      <div class="mb-5">
        <p class="text-[10px] font-semibold text-gray-500 uppercase tracking-wide mb-2">Sharing with this instance</p>
        <div class="space-y-1.5">
          <div class="flex items-center gap-2 text-sm text-gray-300">
            <svg class="w-4 h-4 text-green-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Public key &amp; display name
          </div>
          <div class="flex items-center gap-2 text-sm text-gray-300">
            <svg class="w-4 h-4 text-green-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Profile color &amp; discriminator
          </div>
          <div class="flex items-center gap-2 text-sm text-gray-300">
            <svg class="w-4 h-4 text-green-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Federation token for this session
          </div>
          <div class="flex items-center gap-2 text-sm text-gray-400">
            <svg class="w-4 h-4 text-gray-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
            Private key never leaves this instance
          </div>
        </div>
      </div>

      <!-- Auto-submitting form (hidden) -->
      <%= form_with url: nostr_auth_sign_path, method: :post, id: "auto-sign-form", data: { turbo: false } do |f| %>
        <%= f.hidden_field :challenge, value: @challenge %>
        <%= f.hidden_field :callback, value: @callback %>
        <%= f.hidden_field :requesting_domain, value: @requesting_domain %>
      <% end %>

      <!-- Cancel link -->
      <div class="text-center">
        <%= link_to "Cancel", root_path, class: "text-xs text-gray-500 hover:text-gray-300 transition", data: { turbo: false }, id: "cancel-link" %>
      </div>
    </div>

    <p class="text-center text-xs text-gray-600 mt-4">
      Signing with your Nostr keypair
    </p>
  </div>
</div>

<script>
  // Auto-submit after a brief pause so the user can see what's happening
  setTimeout(function() {
    document.getElementById("auto-sign-form").submit();
  }, 1500);
</script>
