<div data-status-picker class="hidden absolute bottom-full left-0 mb-2 w-52 rounded-md shadow-lg z-50 py-1.5" style="background-color: #111110;">
  <button data-action="click->appearance#pickStatus" data-status="online" class="flex items-center w-full px-3 py-1.5 text-sm text-gray-200 hover:bg-white/10 gap-2.5">
    <span class="w-2.5 h-2.5 rounded-full bg-green-500 shrink-0"></span>
    Online
  </button>
  <button data-action="click->appearance#pickStatus" data-status="idle" class="flex items-center w-full px-3 py-1.5 text-sm text-gray-200 hover:bg-white/10 gap-2.5">
    <span class="w-2.5 h-2.5 rounded-full bg-yellow-500 shrink-0"></span>
    Idle
  </button>
  <button data-action="click->appearance#pickStatus" data-status="dnd" class="flex items-center w-full px-3 py-1.5 text-sm text-gray-200 hover:bg-white/10 gap-2.5">
    <span class="w-2.5 h-2.5 rounded-full bg-red-500 shrink-0"></span>
    Do Not Disturb
  </button>
  <button data-action="click->appearance#pickStatus" data-status="invisible" class="flex items-center w-full px-3 py-1.5 text-sm text-gray-200 hover:bg-white/10 gap-2.5">
    <span class="w-2.5 h-2.5 rounded-full bg-gray-500 shrink-0"></span>
    <span class="flex flex-col items-start">
      <span>Invisible</span>
      <span class="text-xs text-gray-500">Appear offline to others</span>
    </span>
  </button>
</div>
