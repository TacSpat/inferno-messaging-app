<% voice_connected = @current_voice_state.present? %>
<% voice_server = @current_voice_state&.server %>
<div id="voice-controls-bar" data-turbo-permanent class="<%= 'hidden' unless voice_connected %> voice-controls-inferno" style="background-color: #141312;"
     data-controller="voice-channel"
     data-voice-channel-server-id-value="<%= voice_server&.public_id %>"
     data-voice-channel-connected-value="<%= voice_connected %>"
     data-voice-channel-channel-id-value="<%= @current_voice_state&.channel&.public_id if voice_connected %>"
     data-voice-channel-channel-name-value="<%= @current_voice_state&.channel&.name if voice_connected %>"
     data-voice-channel-self-mute-value="<%= @current_voice_state&.self_mute if voice_connected %>"
     data-voice-channel-self-deaf-value="<%= @current_voice_state&.self_deaf if voice_connected %>">
  <div class="px-3 py-2">
    <div class="flex items-center mb-1">
      <svg class="w-4 h-4 text-green-500 mr-1.5 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M15.536 8.464a5 5 0 010 7.072M12 6v12m-3.536-2.464a5 5 0 010-7.072M18.364 5.636a9 9 0 010 12.728M5.636 18.364a9 9 0 010-12.728"/></svg>
      <span class="text-sm font-medium text-green-500" data-voice-channel-target="statusText">Voice Connected</span>
    </div>
    <p class="text-xs text-gray-400 truncate" data-voice-channel-target="channelName"><%= @current_voice_state&.channel&.name if voice_connected %></p>
  </div>
  <div class="flex items-center justify-center gap-2 px-3 pb-2">
    <button type="button" class="p-1.5 rounded hover:bg-gray-600 text-gray-300 hover:text-white transition" data-action="click->voice-channel#toggleMute" data-voice-channel-target="muteBtn" title="Mute">
      <svg class="w-5 h-5" data-voice-channel-target="muteIcon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/></svg>
    </button>
    <button type="button" class="p-1.5 rounded hover:bg-gray-600 text-gray-300 hover:text-white transition" data-action="click->voice-channel#toggleDeafen" data-voice-channel-target="deafenBtn" title="Deafen">
      <svg class="w-5 h-5" data-voice-channel-target="deafenIcon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z M15.54 8.46a5 5 0 010 7.07"/></svg>
    </button>
    <button type="button" class="p-1.5 rounded bg-red-600/20 hover:bg-red-600/40 text-red-400 hover:text-red-300 transition" data-action="click->voice-channel#leave" title="Disconnect">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 8l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2M5 3a2 2 0 00-2 2v1c0 8.284 6.716 15 15 15h1a2 2 0 002-2v-3.28a1 1 0 00-.684-.948l-4.493-1.498a1 1 0 00-1.21.502l-1.13 2.257a11.042 11.042 0 01-5.516-5.517l2.257-1.128a1 1 0 00.502-1.21L9.228 3.683A1 1 0 008.28 3H5z"/></svg>
    </button>
  </div>
</div>
