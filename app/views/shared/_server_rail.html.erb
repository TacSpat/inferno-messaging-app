<nav data-mobile-nav-target="serverRail" data-controller="server-rail" class="hidden md:flex flex-col items-center w-[72px] bg-gray-950 py-3 space-y-2 overflow-y-auto shrink-0 mobile-server-rail">
  <!-- Home/DM button -->
  <% home_active = !local_assigns[:active_server] %>
  <%
    home_badge_count = 0
    home_badge_count += current_user.pending_friend_requests.count
    current_user.conversation_participants.includes(:conversation).each do |cp|
      home_badge_count += cp.unread_count
    end
  %>
  <a href="<%= root_path %>" data-home-button class="group relative flex items-center justify-center w-12 h-12 rounded-2xl transition-all duration-200 <%= home_active ? 'bg-orange-600 rounded-xl' : 'bg-gray-700 hover:bg-orange-600 hover:rounded-xl' %>">
    <svg class="w-6 h-6 <%= home_active ? 'text-white' : 'text-gray-300 group-hover:text-white' %>" fill="currentColor" viewBox="0 0 24 24"><path d="M17.6 11.48l1.34-5.02a.5.5 0 00-.61-.6l-5.02 1.34a.5.5 0 00-.27.83l1.17 1.17-3.54 3.54a1 1 0 101.42 1.42l3.54-3.54 1.17 1.17a.5.5 0 00.83-.27zM6.4 12.52l-1.34 5.02a.5.5 0 00.61.6l5.02-1.34a.5.5 0 00.27-.83l-1.17-1.17 3.54-3.54a1 1 0 10-1.42-1.42l-3.54 3.54-1.17-1.17a.5.5 0 00-.83.27z"/></svg>
    <% if home_active %>
      <div class="absolute left-0 top-1/2 -translate-x-[22px] -translate-y-1/2 w-1 h-10 bg-white rounded-r-full"></div>
    <% end %>
    <% if home_badge_count > 0 %>
      <div class="home-badge mention-badge absolute -bottom-0.5 -right-0.5 min-w-[18px] h-[18px] bg-red-500 rounded-full flex items-center justify-center text-white text-xs font-bold px-1 border-2 border-gray-950">
        <%= home_badge_count > 99 ? '99+' : home_badge_count %>
      </div>
    <% end %>
  </a>

  <div class="w-8 h-0.5 bg-gray-800 rounded-full"></div>

  <!-- Server icons (sortable) -->
  <div data-server-rail-target="list" class="flex flex-col items-center space-y-2">
    <% current_user.ordered_rail_items.each do |item| %>
      <% if item[:type] == :folder %>
        <%= render partial: "shared/server_folder", locals: { item: item, active_server: local_assigns[:active_server] } %>
      <% else %>
        <div data-server-id="<%= item[:server].public_id %>" data-rail-item="server">
          <%= render partial: "servers/server_icon", locals: { server: item[:server], active: local_assigns[:active_server] == item[:server] } %>
        </div>
      <% end %>
    <% end %>
  </div>

  <!-- Remote server references -->
  <% current_user.remote_server_references.ordered.each do |ref| %>
    <div data-rail-item="remote-server" class="relative">
      <a href="<%= ref.remote_instance_url %>" target="_blank" rel="noopener"
         class="group relative flex items-center justify-center w-12 h-12 rounded-2xl bg-gray-700 hover:bg-indigo-600 hover:rounded-xl transition-all duration-200 cursor-pointer"
         title="<%= ref.name %> — <%= ref.instance_domain %>">
        <span class="text-white font-semibold text-sm"><%= ref.name&.split&.map(&:first)&.join&.slice(0, 2)&.upcase || "?" %></span>
        <div class="absolute -bottom-0.5 -right-0.5 w-4 h-4 bg-indigo-500 rounded-full flex items-center justify-center border-2 border-gray-950">
          <svg class="w-2.5 h-2.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
      </a>
    </div>
  <% end %>

  <!-- Add server button -->
  <a href="<%= new_server_path %>" class="flex items-center justify-center w-12 h-12 rounded-2xl bg-gray-700 hover:bg-green-600 hover:rounded-xl transition-all duration-200 text-green-500 hover:text-white text-2xl">
    +
  </a>
</nav>
