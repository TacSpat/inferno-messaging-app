<%# Mobile: magnifying glass button that opens full-screen search %>
<button type="button" class="sm:hidden text-gray-400 hover:text-white p-1 cursor-pointer"
        data-action="click->message-search#openMobileSearch" title="Search">
  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
  </svg>
</button>

<%# Desktop: inline search bar %>
<div class="relative hidden sm:block" data-message-search-target="searchWrap">
  <div class="flex items-center bg-gray-900 rounded h-7 pl-1 pr-2 gap-1 transition-all duration-200"
       data-action="click->message-search#focusInput"
       data-message-search-target="searchBar"
       style="width: 200px">
    <span data-message-search-target="chipsArea" class="flex items-center gap-1 shrink-0 overflow-x-auto no-scrollbar"></span>
    <input type="text"
           placeholder="Search"
           class="bg-transparent text-sm text-gray-200 placeholder-gray-500 outline-none flex-1 min-w-[50px] px-1"
           data-message-search-target="query"
           data-action="focus->message-search#showSuggestions blur->message-search#scheduleSuggestionsHide input->message-search#onInput keydown->message-search#onKeydown"
           autocomplete="off">
    <svg class="w-3.5 h-3.5 text-gray-500 shrink-0 cursor-pointer" fill="none" stroke="currentColor" viewBox="0 0 24 24"
         data-action="click->message-search#search">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
    </svg>
  </div>

  <%# Filter suggestions dropdown %>
  <div data-message-search-target="suggestions"
       class="hidden absolute right-0 top-full mt-1 w-72 bg-gray-900 border border-gray-700 rounded-lg shadow-xl z-50 py-1.5"
       data-action="mousedown->message-search#keepSuggestions">
    <%= render "shared/search_filter_options", server: (local_assigns[:server] ? server : nil) %>
  </div>

  <%# Autocomplete dropdown %>
  <div data-message-search-target="autocomplete"
       class="hidden absolute right-0 top-full mt-1 w-72 bg-gray-900 border border-gray-700 rounded-lg shadow-xl z-50 py-1.5 max-h-64 overflow-y-auto"
       data-action="mousedown->message-search#keepSuggestions">
    <div data-message-search-target="autocompleteHeader" class="px-3 py-1 text-[11px] text-gray-500 font-semibold uppercase tracking-wide"></div>
    <div data-message-search-target="autocompleteList"></div>
  </div>

  <%# Date picker %>
  <div data-message-search-target="datePicker"
       class="hidden absolute right-0 top-full mt-1 bg-gray-900 border border-gray-700 rounded-lg shadow-xl z-50 p-3"
       data-action="mousedown->message-search#keepSuggestions">
    <div data-message-search-target="datePickerLabel" class="text-[11px] text-gray-500 font-semibold uppercase tracking-wide mb-2"></div>
    <input type="date" data-message-search-target="datePickerInput"
           class="bg-gray-800 text-white text-sm rounded px-3 py-1.5 border border-gray-700 outline-none focus:border-accent/50 w-full"
           data-action="change->message-search#selectDate">
  </div>
</div>

<%# Mobile: full-screen search overlay %>
<div data-message-search-target="mobileOverlay" class="hidden fixed inset-0 z-[60] bg-gray-800 flex flex-col sm:hidden">
  <%# Mobile search header %>
  <div class="flex items-center gap-2 px-3 py-2.5 border-b border-gray-700 shrink-0">
    <button type="button" data-action="click->message-search#closeMobileSearch" class="text-gray-400 hover:text-white p-1 cursor-pointer shrink-0">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    </button>
    <div class="flex items-center bg-gray-900 rounded h-8 pl-1 pr-2 flex-1 min-w-0">
      <span data-message-search-target="mobileChipsArea" class="flex items-center gap-1 shrink-0 overflow-x-auto"></span>
      <input type="text"
             placeholder="Search messages..."
             class="bg-transparent text-sm text-gray-200 placeholder-gray-500 outline-none flex-1 min-w-[60px] px-1"
             data-message-search-target="mobileQuery"
             data-action="input->message-search#onMobileInput keydown->message-search#onMobileKeydown"
             autocomplete="off">
    </div>
    <button type="button" data-action="click->message-search#mobileSearch" class="text-accent-light hover:text-white p-1 cursor-pointer shrink-0">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
      </svg>
    </button>
  </div>

  <%# Mobile filter suggestions (always visible when no results) %>
  <div data-message-search-target="mobileSuggestions" class="border-b border-gray-700 shrink-0">
    <%= render "shared/search_filter_options", server: (local_assigns[:server] ? server : nil), mobile: true %>
  </div>

  <%# Mobile autocomplete %>
  <div data-message-search-target="mobileAutocomplete" class="hidden border-b border-gray-700 shrink-0 max-h-48 overflow-y-auto">
    <div data-message-search-target="mobileAutocompleteHeader" class="px-3 py-1 text-[11px] text-gray-500 font-semibold uppercase tracking-wide"></div>
    <div data-message-search-target="mobileAutocompleteList"></div>
  </div>

  <%# Mobile date picker %>
  <div data-message-search-target="mobileDatePicker" class="hidden border-b border-gray-700 shrink-0 p-3">
    <div data-message-search-target="mobileDatePickerLabel" class="text-[11px] text-gray-500 font-semibold uppercase tracking-wide mb-2"></div>
    <input type="date" data-message-search-target="mobileDatePickerInput"
           class="bg-gray-900 text-white text-sm rounded px-3 py-2 border border-gray-700 outline-none focus:border-accent/50 w-full"
           data-action="change->message-search#selectMobileDate">
  </div>

  <%# Mobile loading %>
  <div data-message-search-target="mobileLoading" class="hidden flex items-center justify-center py-8">
    <div class="text-sm text-gray-500">Searching...</div>
  </div>

  <%# Mobile results %>
  <div data-message-search-target="mobileResultHeader" class="hidden px-3 py-2 border-b border-gray-700 shrink-0">
    <span data-message-search-target="mobileResultCount" class="text-sm font-semibold text-white">Results</span>
  </div>
  <div data-message-search-target="mobileResults" class="flex-1 overflow-y-auto py-1"></div>
</div>
