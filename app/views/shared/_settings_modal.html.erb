<div data-controller="settings-modal">
  <!-- Trigger is elsewhere (gear icon in user panel) -->

  <!-- Full-screen overlay -->
  <div data-settings-modal-target="overlay"
       data-action="click->settings-modal#closeOnBackdrop"
       class="hidden fixed inset-0 z-[90] bg-gray-900/80 flex">

    <div class="flex w-full h-full">
      <!-- Left sidebar -->
      <div class="flex justify-end w-[218px] min-w-[218px] bg-gray-800 overflow-y-auto settings-sidebar-mobile md:flex">
        <nav class="w-[190px] py-14 px-2 space-y-0.5" data-settings-modal-target="nav">
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide px-2.5 mb-1">User Settings</p>

          <button data-section="my-account" data-action="click->settings-modal#navigate"
                  class="w-full text-left px-2.5 py-1.5 rounded text-sm font-medium text-gray-400 hover:bg-gray-700 hover:text-gray-200 cursor-pointer">
            My Account
          </button>
          <button data-section="profile" data-action="click->settings-modal#navigate"
                  class="w-full text-left px-2.5 py-1.5 rounded text-sm font-medium text-gray-400 hover:bg-gray-700 hover:text-gray-200 cursor-pointer">
            Profile
          </button>
          <button data-section="appearance" data-action="click->settings-modal#navigate"
                  class="w-full text-left px-2.5 py-1.5 rounded text-sm font-medium text-gray-400 hover:bg-gray-700 hover:text-gray-200 cursor-pointer">
            Appearance
          </button>

          <div class="border-t border-gray-700 my-2"></div>
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide px-2.5 mb-1">App Settings</p>

          <button data-section="notifications" data-action="click->settings-modal#navigate"
                  class="w-full text-left px-2.5 py-1.5 rounded text-sm font-medium text-gray-400 hover:bg-gray-700 hover:text-gray-200 cursor-pointer">
            Notifications
          </button>
          <button data-section="keybinds" data-action="click->settings-modal#navigate"
                  class="w-full text-left px-2.5 py-1.5 rounded text-sm font-medium text-gray-400 hover:bg-gray-700 hover:text-gray-200 cursor-pointer">
            Keybinds
          </button>

          <div class="border-t border-gray-700 my-2"></div>

          <%= button_to "Log Out", destroy_user_session_path, method: :delete, class: "w-full text-left px-2.5 py-1.5 rounded text-sm font-medium text-red-400 hover:bg-red-600/20 hover:text-red-300 cursor-pointer" %>
        </nav>
      </div>

      <!-- Main content area -->
      <div class="flex-1 bg-gray-700 overflow-y-auto">
        <div class="max-w-[740px] py-8 px-4 sm:py-14 sm:px-10">
          <!-- Back button (mobile only) -->
          <button data-action="click->settings-modal#showNav" class="settings-back-btn hidden items-center text-gray-400 hover:text-white mb-4 cursor-pointer">
            <svg class="w-5 h-5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            <span class="text-sm">Back</span>
          </button>

          <!-- Close button -->
          <div class="fixed top-4 right-4 z-[100]">
            <button data-action="click->settings-modal#close"
                    class="w-9 h-9 rounded-full border-2 border-gray-400 flex items-center justify-center text-gray-400 hover:border-white hover:text-white cursor-pointer">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
              </svg>
            </button>
            <p class="text-xs text-gray-500 mt-1 text-center">ESC</p>
          </div>

          <!-- Dynamic content -->
          <div data-settings-modal-target="content">
            <p class="text-gray-400">Loading...</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
