<div class="flex items-center justify-center min-h-screen bg-gray-900 px-4">
  <div class="w-full max-w-sm text-center">
    <!-- Server card -->
    <div class="bg-gray-800 rounded-lg shadow-xl p-6 sm:p-8">
      <!-- Server icon -->
      <div class="flex justify-center mb-4">
        <% if @server.icon.attached? %>
          <%= image_tag @server.icon, class: "w-20 h-20 rounded-full object-cover" %>
        <% else %>
          <div class="w-20 h-20 rounded-full bg-gray-700 flex items-center justify-center text-3xl font-bold text-white">
            <%= @server.name[0].upcase %>
          </div>
        <% end %>
      </div>

      <p class="text-sm text-gray-400 mb-1">You've been invited to join</p>
      <h1 class="text-2xl font-bold text-white mb-3"><%= @server.name %></h1>

      <% if @server.description.present? %>
        <p class="text-sm text-gray-400 mb-4"><%= @server.description %></p>
      <% end %>

      <!-- Member counts -->
      <div class="flex items-center justify-center gap-4 mb-6 text-sm">
        <div class="flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-green-500"></span>
          <span class="text-gray-300"><%= @online_count %> Online</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-gray-500"></span>
          <span class="text-gray-300"><%= @member_count %> Members</span>
        </div>
      </div>

      <% if @already_member %>
        <!-- Already a member -->
        <%= link_to "Open #{@server.name}",
              server_channel_path(@server, @server.channels.ordered.first),
              class: "block w-full bg-orange-600 hover:bg-orange-700 text-white font-semibold py-3 rounded transition text-sm" %>
      <% elsif user_signed_in? %>
        <!-- Logged in, not a member -->
        <%= button_to "Accept Invite",
              accept_invite_path(@invite.code),
              method: :post,
              class: "w-full bg-orange-600 hover:bg-orange-700 text-white font-semibold py-3 rounded transition cursor-pointer text-sm" %>
      <% else %>
        <!-- Not logged in -->
        <div class="space-y-3">
          <%= button_to "Accept Invite",
                accept_invite_path(@invite.code),
                method: :post,
                class: "w-full bg-orange-600 hover:bg-orange-700 text-white font-semibold py-3 rounded transition cursor-pointer text-sm" %>
          <p class="text-xs text-gray-500">
            Already have an account?
            <%= link_to "Log in", new_user_session_path(invite: @invite.code), class: "text-orange-400 hover:text-orange-300" %>
          </p>
        </div>

        <!-- Federation: login from another instance -->
        <div class="mt-4 pt-4 border-t border-gray-700">
          <% if @detected_home_instance %>
            <p class="text-xs text-gray-400 mb-2">It looks like you're coming from <strong class="text-gray-200"><%= @detected_home_instance %></strong></p>
            <%= form_tag accept_invite_path(@invite.code), method: :post, data: { turbo: false } do %>
              <%= hidden_field_tag :home_instance, @detected_home_instance %>
              <%= submit_tag "Continue from #{@detected_home_instance}",
                    class: "w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 rounded transition cursor-pointer text-sm" %>
            <% end %>
          <% else %>
            <p class="text-xs text-gray-400 mb-2">Have an account on another instance?</p>
          <% end %>
          <%= form_tag accept_invite_path(@invite.code), method: :post, class: "space-y-2 #{'mt-3' if @detected_home_instance}", data: { turbo: false } do %>
            <%= text_field_tag :home_instance, nil,
                  placeholder: "home.instance.com",
                  class: "w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white text-sm focus:outline-none focus:border-orange-500" %>
            <%= submit_tag "Login via Home Instance",
                  class: "w-full bg-gray-700 hover:bg-gray-600 text-white font-semibold py-2 px-3 rounded transition cursor-pointer text-sm" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
