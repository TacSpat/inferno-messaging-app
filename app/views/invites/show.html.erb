<% content_for :head do %>
  <meta property="og:title" content="Join <%= @relay_invite ? @server_name : @server.name %> on Inferno">
  <meta property="og:description" content="<%= @relay_invite ? "#{@member_count} members" : (@server.description.presence || "#{@member_count} members · #{@online_count} online") %>">
  <% if !@relay_invite && @server.icon.attached? %>
    <meta property="og:image" content="<%= rails_blob_url(@server.icon) %>">
  <% elsif @relay_invite && @icon_url.present? %>
    <meta property="og:image" content="<%= @icon_url %>">
  <% end %>
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= request.original_url %>">
  <meta property="og:site_name" content="Inferno">
  <meta name="twitter:card" content="summary">
<% end %>

<div class="flex items-center justify-center min-h-screen bg-gray-900 px-4">
  <div class="w-full max-w-sm">
    <!-- Server card -->
    <div class="bg-gray-800 rounded-lg shadow-xl overflow-hidden">
      <!-- Banner -->
      <div class="relative h-32 bg-gradient-to-br from-accent-dark/60 to-gray-800">
        <% if !@relay_invite && @server.respond_to?(:banner) && @server.banner.attached? %>
          <%= image_tag @server.banner, class: "w-full h-full object-cover" %>
        <% end %>
      </div>

      <!-- Content -->
      <div class="relative px-6 pb-6">
        <!-- Server icon overlapping banner -->
        <div class="-mt-10 mb-3">
          <% if @relay_invite %>
            <% if @icon_url.present? %>
              <img src="<%= @icon_url %>" class="w-20 h-20 rounded-2xl object-cover border-4 border-gray-800 bg-gray-700" />
            <% else %>
              <div class="w-20 h-20 rounded-2xl bg-gray-700 border-4 border-gray-800 flex items-center justify-center text-3xl font-bold text-white">
                <%= @server_name[0].upcase %>
              </div>
            <% end %>
          <% elsif @server.icon.attached? %>
            <%= image_tag @server.icon, class: "w-20 h-20 rounded-2xl object-cover border-4 border-gray-800 bg-gray-700" %>
          <% else %>
            <div class="w-20 h-20 rounded-2xl bg-gray-700 border-4 border-gray-800 flex items-center justify-center text-3xl font-bold text-white">
              <%= @server.name[0].upcase %>
            </div>
          <% end %>
        </div>

        <% server_name = @relay_invite ? @server_name : @server.name %>

        <% if @invite_state == :valid %>
          <p class="text-xs text-gray-400 mb-0.5">You've been invited to join</p>
        <% end %>
        <h1 class="text-xl font-bold text-white mb-1"><%= server_name %></h1>

        <% if !@relay_invite && @server.description.present? %>
          <p class="text-sm text-gray-400 mb-3 line-clamp-2"><%= @server.description %></p>
        <% end %>

        <!-- Member counts -->
        <div class="flex items-center gap-4 mb-2 text-xs">
          <% if @online_count > 0 %>
            <div class="flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-green-500"></span>
              <span class="text-gray-300"><%= @online_count %> Online</span>
            </div>
          <% end %>
          <div class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-gray-500"></span>
            <span class="text-gray-300"><%= @member_count %> Members</span>
          </div>
        </div>

        <% is_age_restricted = !@relay_invite && @server.respond_to?(:age_restricted?) && @server.age_restricted? %>
        <% if is_age_restricted %>
          <div class="flex items-center gap-1.5 mb-3">
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-semibold bg-red-500/15 text-red-400 border border-red-500/20">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
              18+ Age Restricted
            </span>
          </div>
        <% end %>

        <p class="text-xs text-gray-500 mb-5">Inferno</p>

        <% if @invite_state == :expired %>
          <div class="bg-gray-900/60 border border-gray-700 rounded-lg p-4 text-center">
            <svg class="w-8 h-8 text-gray-500 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <p class="text-sm font-semibold text-gray-400 mb-1">Invite Expired</p>
            <p class="text-xs text-gray-500">This invite link can no longer be used.</p>
          </div>
        <% elsif @invite_state == :revoked %>
          <div class="bg-gray-900/60 border border-gray-700 rounded-lg p-4 text-center">
            <svg class="w-8 h-8 text-gray-500 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            <p class="text-sm font-semibold text-gray-400 mb-1">Invite No Longer Valid</p>
            <p class="text-xs text-gray-500">This invite link can no longer be used.</p>
          </div>
        <% elsif @invite_state == :maxed_out %>
          <div class="bg-gray-900/60 border border-gray-700 rounded-lg p-4 text-center">
            <svg class="w-8 h-8 text-gray-500 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <p class="text-sm font-semibold text-gray-400 mb-1">Invite Reached Max Uses</p>
            <p class="text-xs text-gray-500">This invite link can no longer be used.</p>
          </div>
        <% elsif @invite_state == :valid %>
          <% accept_path = @nostr_group_id.present? ? accept_nostr_invite_path(@nostr_group_id, @invite.code) : accept_invite_path(@invite.code) %>
          <% invite_show_path = @nostr_group_id.present? ? nostr_invite_path(@nostr_group_id, @invite.code) : invite_path(@invite.code) %>

          <% if @relay_invite %>
            <!-- Server not local — redirect to federation join flow -->
            <%= button_to "Join Server",
                  accept_path,
                  method: :post,
                  class: "w-full bg-gradient-to-r from-confirm-dark to-confirm hover:from-confirm hover:to-confirm-light text-white font-semibold py-2.5 rounded transition cursor-pointer text-sm" %>
          <% elsif @ban %>
            <div class="bg-danger/10 border border-danger/30 rounded-lg p-4 text-center">
              <svg class="w-8 h-8 text-danger-light mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/></svg>
              <p class="text-sm font-semibold text-danger-light mb-1">You are banned from this server</p>
              <% if @ban.reason.present? %>
                <p class="text-xs text-gray-400">Reason: <%= @ban.reason %></p>
              <% end %>
            </div>
          <% elsif @already_member %>
            <%= link_to "Open #{@server.name}",
                  server_channel_path(@server, @server.channels.ordered.first),
                  class: "block w-full text-center bg-gradient-to-r from-confirm-dark to-confirm hover:from-confirm hover:to-confirm-light text-white font-semibold py-2.5 rounded transition text-sm" %>
          <% elsif user_signed_in? %>
            <% if is_age_restricted %>
              <div class="bg-gray-900/60 border border-red-500/20 rounded-lg p-4 mb-3">
                <p class="text-sm text-gray-300 mb-1">This server is age-restricted (18+)</p>
                <p class="text-xs text-gray-500">By joining, you confirm that you are 18 years of age or older.</p>
              </div>
              <%= button_to "I am 18 or older — Join Server",
                    accept_path,
                    method: :post,
                    params: { age_confirmed: "true" },
                    class: "w-full bg-gradient-to-r from-confirm-dark to-confirm hover:from-confirm hover:to-confirm-light text-white font-semibold py-2.5 rounded transition cursor-pointer text-sm",
                    data: { turbo_confirm: "This server is age-restricted (18+). By continuing, you confirm you are 18 years of age or older." } %>
            <% else %>
              <%= button_to "Accept Invite",
                    accept_path,
                    method: :post,
                    class: "w-full bg-gradient-to-r from-confirm-dark to-confirm hover:from-confirm hover:to-confirm-light text-white font-semibold py-2.5 rounded transition cursor-pointer text-sm" %>
            <% end %>
          <% else %>
            <% if @detected_home_instance %>
              <!-- Remote user detected — only show federation login -->
              <%= form_tag accept_path, method: :post, data: { turbo: false } do %>
                <%= hidden_field_tag :home_instance, @detected_home_instance %>
                <p class="text-xs text-gray-400 mb-2">Joining from <strong class="text-gray-200"><%= @detected_home_instance %></strong></p>
                <%= submit_tag "Continue from #{@detected_home_instance}",
                      class: "w-full bg-gradient-to-r from-confirm-dark to-confirm hover:from-confirm hover:to-confirm-light text-white font-semibold py-2.5 rounded transition cursor-pointer text-sm" %>
              <% end %>

              <div class="mt-4 pt-4 border-t border-gray-700">
                <p class="text-xs text-gray-400 mb-2">Not your server? Enter it manually:</p>
                <%= form_tag accept_path, method: :post, class: "space-y-2", data: { turbo: false } do %>
                  <%= text_field_tag :home_instance, nil,
                        placeholder: "your.server.com",
                        class: "w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white text-sm focus:outline-none focus:border-accent" %>
                  <%= submit_tag "Login via Home Server",
                        class: "w-full bg-gray-700 hover:bg-gray-600 text-white font-semibold py-2 px-3 rounded transition cursor-pointer text-sm" %>
                <% end %>
              </div>
            <% else %>
              <!-- Local user — show accept/register/login -->
              <div class="space-y-3">
                <%= button_to "Accept Invite",
                      accept_path,
                      method: :post,
                      class: "w-full bg-gradient-to-r from-confirm-dark to-confirm hover:from-confirm hover:to-confirm-light text-white font-semibold py-2.5 rounded transition cursor-pointer text-sm" %>
                <p class="text-xs text-gray-500 text-center">
                  Already have an account?
                  <%= link_to "Log in", new_user_session_path(invite: @invite.code), class: "text-accent-light hover:text-accent" %>
                </p>
              </div>

              <div class="mt-4 pt-4 border-t border-gray-700">
                <p class="text-xs text-gray-400 mb-2">Have an account elsewhere?</p>
                <%= form_tag accept_path, method: :post, class: "space-y-2", data: { turbo: false } do %>
                  <%= text_field_tag :home_instance, nil,
                        placeholder: "your.server.com",
                        class: "w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white text-sm focus:outline-none focus:border-accent" %>
                  <%= submit_tag "Login via Home Server",
                        class: "w-full bg-gray-700 hover:bg-gray-600 text-white font-semibold py-2 px-3 rounded transition cursor-pointer text-sm" %>
                <% end %>
              </div>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
