<style>body { overflow: auto !important; }</style>
<div class="flex items-center justify-center min-h-screen bg-gray-900 px-4"
     data-controller="migration-sync"
     data-migration-sync-url-value="<%= setup_migration_status_path %>">
  <div class="w-full max-w-sm text-center">
    <%# Animated spinner %>
    <div class="mb-6">
      <div class="w-16 h-16 mx-auto rounded-2xl bg-gradient-to-br from-accent-dark to-accent flex items-center justify-center animate-pulse">
        <svg class="w-8 h-8 text-white animate-spin" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
      </div>
    </div>

    <h2 class="text-lg font-bold text-white mb-2">Restoring Your Identity</h2>
    <p class="text-sm text-gray-400 mb-6" data-migration-sync-target="step">Connecting to relays...</p>

    <%# Progress bar %>
    <div class="w-full bg-gray-800 rounded-full h-2 mb-4 overflow-hidden">
      <div data-migration-sync-target="progressBar" class="h-full bg-gradient-to-r from-accent-dark to-accent rounded-full transition-all duration-500 ease-out" style="width: 0%"></div>
    </div>

    <p class="text-xs text-gray-500" data-migration-sync-target="detail">Recovering contacts, servers, and messages...</p>

    <%# Error state %>
    <div data-migration-sync-target="error" class="hidden mt-4">
      <p class="text-sm text-danger-light mb-3" data-migration-sync-target="errorMsg">Something went wrong.</p>
      <a href="/" class="inline-block bg-gray-700 hover:bg-gray-600 text-white font-semibold px-6 py-2 rounded transition text-sm">Continue Anyway</a>
    </div>
  </div>
</div>
