<h2 class="text-xl font-bold text-white mb-6">Relays</h2>

<p class="text-sm text-gray-400 mb-6">
  Relays connect you to the federation network for messaging, contact discovery, and server sync.
</p>

<!-- Add relay -->
<div class="mb-6">
  <%= form_with url: settings_add_relay_path, method: :post, local: true, class: "flex gap-2" do %>
    <input type="text" name="relay_url" placeholder="wss://relay.example.com"
           class="flex-1 bg-gray-800 border border-gray-600 text-white text-sm rounded-lg px-3 py-2 placeholder-gray-500 focus:ring-1 focus:ring-accent focus:border-accent outline-none font-mono"
           required pattern="wss?://.*">
    <button type="submit" class="bg-accent hover:bg-accent-light text-white text-sm font-medium px-4 py-2 rounded-lg transition cursor-pointer shrink-0">
      Add Relay
    </button>
  <% end %>
</div>

<!-- Relay list -->
<div class="space-y-2">
  <% @relays.each do |relay| %>
    <div class="bg-gray-800 rounded-lg p-3 flex items-center gap-3 group">
      <!-- Status indicator -->
      <div class="w-8 h-8 rounded-full flex items-center justify-center shrink-0
                  <%= relay.active? ? 'bg-green-500/15' : relay.error? ? 'bg-red-500/15' : 'bg-gray-700' %>">
        <% if relay.active? %>
          <svg class="w-4 h-4 text-green-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.288 15.038a5.25 5.25 0 0 1 7.424 0M5.106 11.856c3.807-3.808 9.98-3.808 13.788 0M1.924 8.674c5.565-5.565 14.587-5.565 20.152 0M12.53 18.22l-.53.53-.53-.53a.75.75 0 0 1 1.06 0Z" />
          </svg>
        <% elsif relay.error? %>
          <svg class="w-4 h-4 text-red-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
          </svg>
        <% else %>
          <svg class="w-4 h-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 0 0 5.636 5.636m12.728 12.728A9 9 0 0 1 5.636 5.636m12.728 12.728L5.636 5.636" />
          </svg>
        <% end %>
      </div>

      <!-- Relay info -->
      <div class="flex-1 min-w-0">
        <p class="text-sm font-medium text-white font-mono truncate"><%= relay.url %></p>
        <p class="text-xs text-gray-500">
          <% if relay.active? %>
            Active
            <% if relay.last_connected_at %>
              &middot; Last connected <%= time_ago_in_words(relay.last_connected_at) %> ago
            <% end %>
          <% elsif relay.error? %>
            <span class="text-red-400">Error</span>
            <% if relay.last_error_message.present? %>
              &middot; <span class="text-red-400/70 truncate"><%= truncate(relay.last_error_message, length: 60) %></span>
            <% end %>
          <% else %>
            Disabled
            <% if relay.last_error_message&.include?("Auto-disabled") %>
              &middot; <span class="text-warning/70"><%= relay.last_error_message %></span>
            <% end %>
          <% end %>
        </p>
      </div>

      <!-- Actions -->
      <div class="flex items-center gap-1 shrink-0 opacity-0 group-hover:opacity-100 transition-opacity">
        <!-- Check connectivity -->
        <button type="button" class="p-1.5 text-gray-400 hover:text-white rounded hover:bg-gray-700 transition cursor-pointer" title="Test Connection"
                onclick="checkRelay(this, <%= relay.id %>)">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        </button>

        <!-- Toggle active/disabled -->
        <%= button_to settings_toggle_relay_path, method: :post, params: { relay_id: relay.id },
              class: "p-1.5 rounded hover:bg-gray-700 transition cursor-pointer #{relay.active? ? 'text-green-400 hover:text-warning-light' : 'text-gray-500 hover:text-green-400'}",
              title: relay.active? ? "Disable" : "Enable",
              data: { turbo_frame: "settings-frame" } do %>
          <% if relay.active? %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <% else %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <% end %>
        <% end %>

        <!-- Remove -->
        <%= button_to settings_remove_relay_path, method: :delete, params: { relay_id: relay.id },
              class: "p-1.5 text-gray-400 hover:text-red-400 rounded hover:bg-gray-700 transition cursor-pointer",
              title: "Remove",
              data: { turbo_confirm: "Remove this relay? This will affect all servers.", turbo_frame: "settings-frame" } do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @relays.empty? %>
    <div class="text-center py-8">
      <svg class="w-10 h-10 text-gray-600 mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.288 15.038a5.25 5.25 0 0 1 7.424 0M5.106 11.856c3.807-3.808 9.98-3.808 13.788 0M1.924 8.674c5.565-5.565 14.587-5.565 20.152 0M12.53 18.22l-.53.53-.53-.53a.75.75 0 0 1 1.06 0Z" />
      </svg>
      <p class="text-sm text-gray-500">No relays configured yet.</p>
      <p class="text-xs text-gray-600 mt-1">Add a relay above to connect to the federation network.</p>
    </div>
  <% end %>
</div>

<!-- Common relays suggestion -->
<div class="mt-6 border-t border-gray-700 pt-6">
  <h3 class="text-sm font-semibold text-gray-400 mb-3">Popular Relays</h3>
  <div class="flex flex-wrap gap-2">
    <% known = @relays.map(&:url) %>
    <% %w[wss://relay.damus.io wss://nos.lol wss://relay.snort.social wss://relay.nostr.band wss://relay.primal.net].each do |url| %>
      <% unless known.include?(url) %>
        <%= button_to settings_add_relay_path, method: :post, params: { relay_url: url },
              class: "inline-flex items-center gap-1.5 bg-gray-800 hover:bg-gray-700 text-gray-300 text-xs font-mono px-3 py-1.5 rounded-full transition cursor-pointer border border-gray-700 hover:border-gray-600",
              data: { turbo_frame: "settings-frame" } do %>
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          <%= url.sub("wss://", "") %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>

<script>
async function checkRelay(btn, relayId) {
  btn.disabled = true
  btn.innerHTML = '<svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>'
  const csrf = document.querySelector("meta[name=csrf-token]")?.content
  try {
    const res = await fetch("<%= settings_check_relay_path %>", {
      method: "POST",
      headers: { "X-CSRF-Token": csrf, "Content-Type": "application/json" },
      body: JSON.stringify({ relay_id: relayId })
    })
    const data = await res.json()
    if (data.status === "ok") {
      btn.innerHTML = '<svg class="w-4 h-4 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>'
    } else {
      btn.innerHTML = '<svg class="w-4 h-4 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>'
      btn.title = data.message || "Connection failed"
    }
  } catch {
    btn.innerHTML = '<svg class="w-4 h-4 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>'
  }
  setTimeout(() => {
    btn.disabled = false
    btn.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>'
  }, 3000)
}
</script>
