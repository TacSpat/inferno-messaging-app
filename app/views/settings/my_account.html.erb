<h2 class="text-xl font-bold text-white mb-6">My Account</h2>

<div class="rounded-lg border border-gray-700">
  <!-- Banner -->
  <div class="h-24 relative overflow-hidden rounded-t-lg">
    <% if @user.banner.attached? %>
      <%= image_tag @user.banner, class: "w-full h-full object-cover",
          style: "object-position: center #{@user.banner_offset_y || 0}px;" %>
    <% elsif @user.effective_banner_url.present? %>
      <%= image_tag @user.effective_banner_url, class: "w-full h-full object-cover",
          style: "object-position: center #{@user.banner_offset_y || 0}px;" %>
    <% else %>
      <div class="w-full h-full bg-gray-700"></div>
    <% end %>
  </div>

  <!-- Gradient body -->
  <div class="px-4 pb-4 pt-1 relative z-10" style="<%= profile_card_bg_style(@user) %>">
    <!-- Avatar row -->
    <div class="flex items-end -mt-[35px] mb-4">
      <div class="w-[76px] h-[76px] rounded-full p-[5px] shrink-0"
           style="background: <%= @user.profile_color_2.presence || @user.profile_color || '#1e1c1b' %>">
        <% if @user.avatar.attached? %>
          <%= image_tag @user.avatar, class: "w-full h-full rounded-full object-cover" %>
        <% elsif @user.effective_avatar_url.present? %>
          <%= image_tag @user.effective_avatar_url, class: "w-full h-full rounded-full object-cover" %>
        <% else %>
          <div class="w-full h-full rounded-full flex items-center justify-center text-2xl font-bold text-white"
               style="background-color: <%= @user.profile_color || '#1e1c1b' %>">
            <%= @user.username[0].upcase %>
          </div>
        <% end %>
      </div>
      <div class="ml-3 mb-1">
        <p class="text-lg font-bold text-white"><%= @user.display_name.presence || @user.username %></p>
        <p class="text-sm text-white/60"><%= @user.tag %></p>
      </div>
    </div>

    <!-- Info card -->
    <div class="bg-black/30 rounded-lg p-4 space-y-4">
      <div>
        <p class="text-xs font-semibold text-white/50 uppercase">Username</p>
        <p class="text-sm text-white"><%= @user.tag %></p>
      </div>
      <div>
        <p class="text-xs font-semibold text-white/50 uppercase">Email</p>
        <p class="text-sm text-white"><%= @user.email %></p>
      </div>
      <div>
        <p class="text-xs font-semibold text-white/50 uppercase">Member Since</p>
        <p class="text-sm text-white"><%= @user.created_at.strftime("%B %d, %Y") %></p>
      </div>
    </div>
  </div>
</div>

<!-- Nostr Identity -->
<div class="mt-6" data-controller="nostr-key-export">
  <h3 class="text-lg font-bold text-white mb-4">Nostr Identity</h3>
  <div class="rounded-lg border border-gray-700 p-4 space-y-4">
    <p class="text-sm text-gray-400">
      Your Nostr keypair is your cross-instance identity. Other instances can verify you using your public key.
    </p>

    <!-- Public Key (always visible) -->
    <div>
      <p class="text-xs font-semibold text-white/50 uppercase mb-1">Public Key (npub)</p>
      <div class="flex items-center gap-2">
        <code class="flex-1 text-sm text-white bg-gray-900 border border-gray-600 rounded px-3 py-2 font-mono break-all select-all"><%= @user.npub %></code>
        <button type="button"
                class="shrink-0 text-sm text-gray-400 hover:text-white bg-gray-700 hover:bg-gray-600 px-3 py-2 rounded transition"
                data-action="click->nostr-key-export#copyNpub"
                data-nostr-key-export-target="copyNpubBtn"
                data-value="<%= @user.npub %>">
          Copy
        </button>
      </div>
    </div>

    <!-- NIP-05 Identifier -->
    <div>
      <p class="text-xs font-semibold text-white/50 uppercase mb-1">NIP-05 Identifier</p>
      <p class="text-sm text-white"><%= @user.nip05_identifier %></p>
    </div>

    <% if @user.remote? %>
      <!-- Remote user: redirect to home instance for key management -->
      <div class="border-t border-gray-700 pt-4">
        <p class="text-xs font-semibold text-white/50 uppercase mb-1">Private Key Management</p>
        <p class="text-xs text-gray-400 mb-3">
          Your private key is stored on your home instance. To export or manage your key, visit your account settings there.
        </p>
        <% home_protocol = Rails.env.development? ? "http" : "https" %>
        <a href="<%= home_protocol %>://<%= @user.home_instance_domain %>/settings/account"
           target="_blank" rel="noopener"
           class="inline-flex items-center gap-2 text-sm bg-amber-600 hover:bg-amber-700 text-white font-semibold px-4 py-2 rounded transition">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          Manage on <%= @user.home_instance_domain %>
        </a>
      </div>
    <% else %>
      <!-- Private Key Export -->
      <div class="border-t border-gray-700 pt-4">
        <p class="text-xs font-semibold text-white/50 uppercase mb-1">Private Key (nsec)</p>
        <p class="text-xs text-yellow-500 mb-2">
          Your private key controls your identity. Never share it. You only need it if migrating to another instance.
        </p>

        <div data-nostr-key-export-target="revealSection">
          <!-- Password confirmation form -->
          <div data-nostr-key-export-target="passwordForm">
            <div class="flex items-end gap-2">
              <div class="flex-1">
                <label class="block text-xs text-gray-400 mb-1">Confirm your password to reveal</label>
                <input type="password"
                       data-nostr-key-export-target="passwordInput"
                       class="w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-amber-500 text-sm"
                       placeholder="Enter your password">
              </div>
              <button type="button"
                      class="shrink-0 text-sm bg-yellow-600 hover:bg-yellow-700 text-white font-semibold px-4 py-2 rounded transition"
                      data-action="click->nostr-key-export#revealKey">
                Reveal
              </button>
            </div>
            <p data-nostr-key-export-target="error" class="text-xs text-red-400 mt-1 hidden"></p>
          </div>

          <!-- Revealed key (hidden by default) -->
          <div data-nostr-key-export-target="keyDisplay" class="hidden">
            <div class="flex items-center gap-2">
              <code class="flex-1 text-sm text-yellow-300 bg-gray-900 border border-yellow-600/50 rounded px-3 py-2 font-mono break-all select-all"
                    data-nostr-key-export-target="nsecValue"></code>
              <button type="button"
                      class="shrink-0 text-sm text-gray-400 hover:text-white bg-gray-700 hover:bg-gray-600 px-3 py-2 rounded transition"
                      data-action="click->nostr-key-export#copyNsec">
                Copy
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Encrypted Export (NIP-49) -->
      <div class="border-t border-gray-700 pt-4">
        <p class="text-xs font-semibold text-white/50 uppercase mb-1">Encrypted Backup (NIP-49)</p>
        <p class="text-xs text-gray-400 mb-2">
          Export your private key encrypted with a backup password. Safer than raw nsec — you can store
          the ncryptsec string and decrypt it later on any Nostr client or instance.
        </p>

        <div data-nostr-key-export-target="encryptedSection">
          <!-- Encrypted export form -->
          <div data-nostr-key-export-target="encryptedForm" class="space-y-3">
            <div>
              <label class="block text-xs text-gray-400 mb-1">Account password</label>
              <input type="password"
                     data-nostr-key-export-target="encryptedPasswordInput"
                     class="w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-amber-500 text-sm"
                     placeholder="Your account password">
            </div>
            <div>
              <label class="block text-xs text-gray-400 mb-1">Backup password (min 8 characters)</label>
              <input type="password"
                     data-nostr-key-export-target="backupPasswordInput"
                     class="w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-amber-500 text-sm"
                     placeholder="Choose a strong backup password">
            </div>
            <button type="button"
                    class="text-sm bg-amber-600 hover:bg-amber-700 text-white font-semibold px-4 py-2 rounded transition"
                    data-action="click->nostr-key-export#exportEncrypted">
              Export Encrypted Key
            </button>
            <p data-nostr-key-export-target="encryptedError" class="text-xs text-red-400 mt-1 hidden"></p>
          </div>

          <!-- Encrypted result (hidden by default) -->
          <div data-nostr-key-export-target="encryptedResult" class="hidden">
            <div class="flex items-center gap-2">
              <code class="flex-1 text-sm text-amber-300 bg-gray-900 border border-amber-600/50 rounded px-3 py-2 font-mono break-all select-all"
                    data-nostr-key-export-target="ncryptsecValue"></code>
              <button type="button"
                      class="shrink-0 text-sm text-gray-400 hover:text-white bg-gray-700 hover:bg-gray-600 px-3 py-2 rounded transition"
                      data-action="click->nostr-key-export#copyNcryptsec">
                Copy
              </button>
            </div>
            <p class="text-xs text-gray-500 mt-2">
              Save this ncryptsec string securely. You'll need the backup password to decrypt it.
            </p>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>

<!-- Connected Instances -->
<div class="mt-6">
  <h3 class="text-lg font-bold text-white mb-4">Connected Instances</h3>
  <div class="rounded-lg border border-gray-700 p-4 space-y-3">
    <p class="text-sm text-gray-400">
      Instances where you have servers or an identity. Your home instance hosts your account; remote instances host servers you've joined or created via federation.
    </p>

    <% if current_user.remote? && current_user.home_instance_domain.present? %>
      <!-- Remote user's actual home instance -->
      <div class="bg-gray-900 rounded-lg p-3 flex items-center gap-3">
        <div class="w-8 h-8 rounded-full bg-orange-600/20 flex items-center justify-center shrink-0">
          <svg class="w-4 h-4 text-orange-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
          </svg>
        </div>
        <div>
          <p class="text-sm font-medium text-white"><%= current_user.home_instance_domain %></p>
          <p class="text-xs text-white/50">Home instance</p>
        </div>
      </div>
      <!-- Current instance (where shadow user lives) -->
      <div class="bg-gray-900 rounded-lg p-3 flex items-center gap-3">
        <div class="w-8 h-8 rounded-full bg-amber-600/20 flex items-center justify-center shrink-0">
          <svg class="w-4 h-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418" />
          </svg>
        </div>
        <div>
          <p class="text-sm font-medium text-white"><%= Rails.application.config.x.instance_domain %></p>
          <p class="text-xs text-white/50">Current instance</p>
        </div>
      </div>
    <% else %>
      <!-- Local user's home instance -->
      <div class="bg-gray-900 rounded-lg p-3 flex items-center gap-3">
        <div class="w-8 h-8 rounded-full bg-orange-600/20 flex items-center justify-center shrink-0">
          <svg class="w-4 h-4 text-orange-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
          </svg>
        </div>
        <div>
          <p class="text-sm font-medium text-white"><%= Rails.application.config.x.instance_domain %></p>
          <p class="text-xs text-white/50">Home instance</p>
        </div>
      </div>
    <% end %>

    <% grouped = @remote_server_references.group_by(&:instance_domain) %>
    <% if grouped.any? %>
      <% grouped.each do |domain, refs| %>
        <div class="bg-gray-900 rounded-lg p-3 flex items-start gap-3">
          <div class="w-8 h-8 rounded-full bg-amber-600/20 flex items-center justify-center shrink-0 mt-0.5">
            <svg class="w-4 h-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418" />
            </svg>
          </div>
          <div>
            <p class="text-sm font-medium text-white"><%= domain %></p>
            <p class="text-xs text-white/50"><%= pluralize(refs.size, "server") %></p>
            <div class="mt-1 space-y-0.5">
              <% refs.each do |ref| %>
                <p class="text-xs text-gray-400"><%= ref.name %></p>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="text-xs text-gray-500">No remote instance connections yet. Create or join a server on another instance to see it here.</p>
    <% end %>
  </div>
</div>
