<h2 class="text-xl font-bold text-white mb-6">My Account</h2>

<div class="rounded-lg border border-gray-700">
  <!-- Banner -->
  <div class="h-24 relative overflow-hidden rounded-t-lg">
    <% if @user.banner.attached? %>
      <%= image_tag @user.banner, class: "w-full h-full object-cover",
          style: "object-position: center #{@user.banner_offset_y || 0}px;" %>
    <% else %>
      <div class="w-full h-full bg-gray-700"></div>
    <% end %>
  </div>

  <!-- Gradient body -->
  <div class="px-4 pb-4 pt-1 relative z-10" style="<%= profile_card_bg_style(@user) %>">
    <!-- Avatar row -->
    <div class="flex items-end -mt-[35px] mb-4">
      <div class="w-[76px] h-[76px] rounded-full p-[5px] shrink-0"
           style="background: <%= @user.profile_color_2.presence || @user.profile_color || '#2b2d31' %>">
        <% if @user.avatar.attached? %>
          <%= image_tag @user.avatar, class: "w-full h-full rounded-full object-cover" %>
        <% else %>
          <div class="w-full h-full rounded-full flex items-center justify-center text-2xl font-bold text-white"
               style="background-color: <%= @user.profile_color || '#2b2d31' %>">
            <%= @user.username[0].upcase %>
          </div>
        <% end %>
      </div>
      <div class="ml-3 mb-1">
        <p class="text-lg font-bold text-white"><%= @user.display_name.presence || @user.username %></p>
        <p class="text-sm text-white/60"><%= @user.tag %></p>
      </div>
    </div>

    <!-- Info card -->
    <div class="bg-black/30 rounded-lg p-4 space-y-4">
      <div>
        <p class="text-xs font-semibold text-white/50 uppercase">Username</p>
        <p class="text-sm text-white"><%= @user.tag %></p>
      </div>
      <div>
        <p class="text-xs font-semibold text-white/50 uppercase">Email</p>
        <p class="text-sm text-white"><%= @user.email %></p>
      </div>
      <div>
        <p class="text-xs font-semibold text-white/50 uppercase">Member Since</p>
        <p class="text-sm text-white"><%= @user.created_at.strftime("%B %d, %Y") %></p>
      </div>
    </div>
  </div>
</div>
