<h2 class="text-xl font-bold text-white mb-6">My Account</h2>

<div class="rounded-lg border border-gray-700">
  <!-- Banner -->
  <div class="h-24 relative overflow-hidden rounded-t-lg">
    <% if @user.effective_banner_url.present? %>
      <%= image_tag @user.effective_banner_url, class: "w-full h-full object-cover",
          style: "object-position: center #{@user.banner_offset_y || 0}px;" %>
    <% else %>
      <div class="w-full h-full bg-gray-700"></div>
    <% end %>
  </div>

  <!-- Gradient body -->
  <div class="px-4 pb-4 pt-1 relative z-10" style="<%= profile_card_bg_style(@user) %>">
    <!-- Avatar -->
    <div class="relative -mt-[35px] mb-2">
      <div class="w-[76px] h-[76px] rounded-full p-[5px] inline-block"
           style="background: <%= @user.profile_color_2.presence || @user.profile_color || '#1e1c1b' %>">
        <% if @user.effective_avatar_url.present? %>
          <%= image_tag @user.effective_avatar_url, class: "w-full h-full rounded-full object-cover" %>
        <% else %>
          <div class="w-full h-full rounded-full flex items-center justify-center text-2xl font-bold text-white"
               style="background-color: <%= @user.profile_color || '#1e1c1b' %>">
            <%= @user.username[0].upcase %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Info card -->
    <div class="bg-black/30 rounded-lg p-4 space-y-3">
      <div>
        <h3 class="text-lg font-bold text-white leading-tight"><%= @user.display_name.presence || @user.username %></h3>
        <p class="text-sm text-white/60"><%= @user.tag %></p>
      </div>
      <div class="border-t border-white/10 pt-3">
        <p class="text-xs font-semibold text-white/50 uppercase mb-0.5">Email</p>
        <p class="text-sm text-white"><%= @user.email %></p>
      </div>
      <div class="border-t border-white/10 pt-3">
        <p class="text-xs font-semibold text-white/50 uppercase mb-0.5">Member Since</p>
        <p class="text-sm text-white"><%= @user.created_at.strftime("%B %d, %Y") %></p>
      </div>
    </div>
  </div>
</div>

<!-- Nostr Identity -->
<div class="mt-6" data-controller="nostr-key-export">
  <h3 class="text-lg font-bold text-white mb-4">Nostr Identity</h3>
  <div class="rounded-lg border border-gray-700 p-4 space-y-4">
    <p class="text-sm text-gray-400">
      Your Nostr keypair is your cross-instance identity. Other instances can verify you using your public key.
    </p>

    <!-- Public Key (always visible) -->
    <div>
      <p class="text-xs font-semibold text-white/50 uppercase mb-1">Public Key (npub)</p>
      <div class="flex items-center gap-2">
        <code class="flex-1 text-sm text-white bg-gray-900 border border-gray-600 rounded px-3 py-2 font-mono break-all select-all"><%= @user.npub %></code>
        <button type="button"
                class="shrink-0 text-sm text-gray-400 hover:text-white bg-gray-700 hover:bg-gray-600 px-3 py-2 rounded transition"
                data-action="click->nostr-key-export#copyNpub"
                data-nostr-key-export-target="copyNpubBtn"
                data-value="<%= @user.npub %>">
          Copy
        </button>
      </div>
    </div>

    <!-- NIP-05 Identifier -->
    <div>
      <p class="text-xs font-semibold text-white/50 uppercase mb-1">NIP-05 Identifier</p>
      <p class="text-sm text-white"><%= @user.nip05_identifier %></p>
    </div>

      <!-- Private Key Export -->
      <div class="border-t border-gray-700 pt-4">
        <p class="text-xs font-semibold text-white/50 uppercase mb-1">Private Key (nsec)</p>
        <p class="text-xs text-yellow-500 mb-2">
          Your private key controls your identity. Never share it. You only need it if migrating to another instance.
        </p>

        <div data-nostr-key-export-target="revealSection">
          <!-- Password confirmation form -->
          <div data-nostr-key-export-target="passwordForm">
            <div class="flex items-end gap-2">
              <div class="flex-1">
                <label class="block text-xs text-gray-400 mb-1">Confirm your password to reveal</label>
                <input type="password"
                       data-nostr-key-export-target="passwordInput"
                       class="w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-accent text-sm"
                       placeholder="Enter your password">
              </div>
              <button type="button"
                      class="shrink-0 text-sm bg-yellow-600 hover:bg-yellow-700 text-white font-semibold px-4 py-2 rounded transition"
                      data-action="click->nostr-key-export#revealKey">
                Reveal
              </button>
            </div>
            <p data-nostr-key-export-target="error" class="text-xs text-accent-light mt-1 hidden"></p>
          </div>

          <!-- Revealed key (hidden by default) -->
          <div data-nostr-key-export-target="keyDisplay" class="hidden">
            <div class="flex items-center gap-2">
              <code class="flex-1 text-sm text-yellow-300 bg-gray-900 border border-yellow-600/50 rounded px-3 py-2 font-mono break-all select-all"
                    data-nostr-key-export-target="nsecValue"></code>
              <button type="button"
                      class="shrink-0 text-sm text-gray-400 hover:text-white bg-gray-700 hover:bg-gray-600 px-3 py-2 rounded transition"
                      data-action="click->nostr-key-export#copyNsec">
                Copy
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Encrypted Export (NIP-49) -->
      <div class="border-t border-gray-700 pt-4">
        <p class="text-xs font-semibold text-white/50 uppercase mb-1">Encrypted Backup (NIP-49)</p>
        <p class="text-xs text-gray-400 mb-2">
          Export your private key encrypted with a backup password. Safer than raw nsec — you can store
          the ncryptsec string and decrypt it later on any Nostr client or instance.
        </p>

        <div data-nostr-key-export-target="encryptedSection">
          <!-- Encrypted export form -->
          <div data-nostr-key-export-target="encryptedForm" class="space-y-3">
            <div>
              <label class="block text-xs text-gray-400 mb-1">Account password</label>
              <input type="password"
                     data-nostr-key-export-target="encryptedPasswordInput"
                     class="w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-accent text-sm"
                     placeholder="Your account password">
            </div>
            <div>
              <label class="block text-xs text-gray-400 mb-1">Backup password (min 8 characters)</label>
              <input type="password"
                     data-nostr-key-export-target="backupPasswordInput"
                     class="w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-accent text-sm"
                     placeholder="Choose a strong backup password">
            </div>
            <button type="button"
                    class="text-sm bg-gradient-to-r from-confirm-dark to-confirm hover:from-confirm hover:to-confirm-light text-white font-semibold px-4 py-2 rounded transition"
                    data-action="click->nostr-key-export#exportEncrypted">
              Export Encrypted Key
            </button>
            <p data-nostr-key-export-target="encryptedError" class="text-xs text-accent-light mt-1 hidden"></p>
          </div>

          <!-- Encrypted result (hidden by default) -->
          <div data-nostr-key-export-target="encryptedResult" class="hidden">
            <div class="flex items-center gap-2">
              <code class="flex-1 text-sm text-accent-light bg-gray-900 border border-accent/50 rounded px-3 py-2 font-mono break-all select-all"
                    data-nostr-key-export-target="ncryptsecValue"></code>
              <button type="button"
                      class="shrink-0 text-sm text-gray-400 hover:text-white bg-gray-700 hover:bg-gray-600 px-3 py-2 rounded transition"
                      data-action="click->nostr-key-export#copyNcryptsec">
                Copy
              </button>
            </div>
            <p class="text-xs text-gray-500 mt-2">
              Save this ncryptsec string securely. You'll need the backup password to decrypt it.
            </p>
          </div>
        </div>
      </div>
  </div>
</div>

<!-- Your Node -->
<div class="mt-6" data-controller="clipboard">
  <h3 class="text-lg font-bold text-white mb-4">Your Node</h3>
  <div class="rounded-lg border border-gray-700 p-4 space-y-4">
    <p class="text-sm text-gray-400">
      Your machine is a Nostr relay and Blossom media server. Share these URLs so others can connect to you directly.
    </p>

    <% domain = Rails.application.config.x.instance_domain %>

    <!-- Relay URL -->
    <div>
      <p class="text-xs font-semibold text-white/50 uppercase mb-1">Relay (WebSocket)</p>
      <div class="flex items-center gap-2">
        <code class="flex-1 text-sm text-white bg-gray-900 border border-gray-600 rounded px-3 py-2 font-mono break-all select-all">wss://<%= domain %>/relay</code>
        <button type="button"
                class="shrink-0 text-sm text-gray-400 hover:text-white bg-gray-700 hover:bg-gray-600 px-3 py-2 rounded transition"
                data-action="click->clipboard#copy"
                data-clipboard-value="wss://<%= domain %>/relay">
          Copy
        </button>
      </div>
    </div>

    <!-- Blossom URL -->
    <div>
      <p class="text-xs font-semibold text-white/50 uppercase mb-1">Blossom Server (Media)</p>
      <div class="flex items-center gap-2">
        <code class="flex-1 text-sm text-white bg-gray-900 border border-gray-600 rounded px-3 py-2 font-mono break-all select-all">https://<%= domain %>/blossom</code>
        <button type="button"
                class="shrink-0 text-sm text-gray-400 hover:text-white bg-gray-700 hover:bg-gray-600 px-3 py-2 rounded transition"
                data-action="click->clipboard#copy"
                data-clipboard-value="https://<%= domain %>/blossom">
          Copy
        </button>
      </div>
    </div>

    <!-- NIP-05 (repeated for convenience) -->
    <div>
      <p class="text-xs font-semibold text-white/50 uppercase mb-1">NIP-05</p>
      <div class="flex items-center gap-2">
        <code class="flex-1 text-sm text-white bg-gray-900 border border-gray-600 rounded px-3 py-2 font-mono break-all select-all"><%= @user.nip05_identifier %></code>
        <button type="button"
                class="shrink-0 text-sm text-gray-400 hover:text-white bg-gray-700 hover:bg-gray-600 px-3 py-2 rounded transition"
                data-action="click->clipboard#copy"
                data-clipboard-value="<%= @user.nip05_identifier %>">
          Copy
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Nostr Relays -->
<div class="mt-6">
  <h3 class="text-lg font-bold text-white mb-4">Nostr Relays</h3>
  <div class="rounded-lg border border-gray-700 p-4 space-y-3">
    <p class="text-sm text-gray-400">
      Relays you're connected to for messaging and contact discovery.
    </p>

    <% RelayConnection.active.each do |relay| %>
      <div class="bg-gray-900 rounded-lg p-3 flex items-center gap-3">
        <div class="w-8 h-8 rounded-full bg-accent/15 flex items-center justify-center shrink-0">
          <svg class="w-4 h-4 text-accent-light" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.288 15.038a5.25 5.25 0 0 1 7.424 0M5.106 11.856c3.807-3.808 9.98-3.808 13.788 0M1.924 8.674c5.565-5.565 14.587-5.565 20.152 0M12.53 18.22l-.53.53-.53-.53a.75.75 0 0 1 1.06 0Z" />
          </svg>
        </div>
        <div>
          <p class="text-sm font-medium text-white font-mono"><%= relay.url %></p>
          <p class="text-xs text-white/50">Active relay</p>
        </div>
      </div>
    <% end %>

    <% if RelayConnection.active.empty? %>
      <p class="text-xs text-gray-500">No relays configured. Add relays in your settings to connect to the Nostr network.</p>
    <% end %>
  </div>
</div>
