<%
  theme_swatches = {
    "inferno"  => "linear-gradient(135deg, #1e1c1b 0%, #2c2a29 40%, #dc2626 100%)",
    "frostfire"  => "linear-gradient(135deg, #0f1b2d 0%, #243b53 40%, #3b82f6 100%)",
    "boron"      => "linear-gradient(135deg, #0f1f15 0%, #1a3328 40%, #10b981 100%)",
    "brimstone"  => "linear-gradient(135deg, #1a1025 0%, #2d1f42 40%, #a855f7 100%)",
    "plasma"     => "linear-gradient(135deg, #1c0f1c 0%, #3d2438 40%, #ec4899 100%)",
    "pulsar"     => "linear-gradient(135deg, #1e141e 0%, #3e2a3c 40%, #f9a8d4 100%)",
    "obsidian" => "linear-gradient(135deg, #111827 0%, #1e293b 40%, #94a3b8 100%)"
  }
%>

<div class="fixed bottom-0 left-0 right-0 z-[90] pointer-events-none" data-controller="theme-picker" data-theme-picker-current-value="<%= @user.theme %>">
  <div class="pointer-events-auto bg-gradient-to-t from-black/80 via-black/60 to-transparent pt-10 pb-5 px-6 sm:px-10">
    <%= form_tag settings_update_appearance_path, method: :patch do %>
      <div class="max-w-3xl mx-auto">
        <h3 class="text-xs font-semibold text-white/70 uppercase tracking-wide mb-3">Theme</h3>
        <div class="flex flex-wrap gap-2 mb-4">
          <% User::THEMES.each do |theme_name| %>
            <label class="cursor-pointer">
              <input type="radio" name="theme" value="<%= theme_name %>"
                     <%= 'checked' if @user.theme == theme_name %>
                     class="sr-only peer"
                     data-action="change->theme-picker#preview">
              <div class="border-2 border-white/10 peer-checked:border-white/60 rounded-lg p-2 transition
                          peer-checked:ring-2 peer-checked:ring-white/20 hover:border-white/30 bg-black/40 backdrop-blur-sm">
                <div class="h-6 w-20 rounded" style="background: <%= theme_swatches[theme_name] %>"></div>
                <span class="text-[11px] text-gray-300 capitalize mt-1 block"><%= theme_name %></span>
              </div>
            </label>
          <% end %>
        </div>
        <button type="submit" class="w-full bg-gradient-to-r from-confirm-dark to-confirm
               hover:from-confirm hover:to-confirm-light text-white font-semibold
               py-2.5 rounded transition cursor-pointer text-sm">
          Save Changes
        </button>
      </div>
    <% end %>
  </div>
</div>
