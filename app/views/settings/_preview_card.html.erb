<div class="rounded-lg shadow-xl border border-gray-600 overflow-hidden" data-banner-editor-target="previewCard">
  <!-- Banner -->
  <div class="h-[60px] relative">
    <% if @user.banner.attached? %>
      <%= image_tag @user.banner, class: "w-full h-full object-cover",
          data: { banner_editor_target: "previewBanner" } %>
    <% elsif @user.effective_banner_url.present? %>
      <%= image_tag @user.effective_banner_url, class: "w-full h-full object-cover",
          data: { banner_editor_target: "previewBanner" } %>
    <% else %>
      <div class="w-full h-full bg-gray-700"></div>
      <%= image_tag "", class: "w-full h-full object-cover hidden absolute inset-0",
          data: { banner_editor_target: "previewBanner" } %>
    <% end %>
  </div>
  <!-- Gradient body -->
  <div class="relative px-3 pb-3 pt-1" data-banner-editor-target="previewGradient"
       style="<%= profile_card_bg_style(@user) %>">
    <div class="relative -mt-[28px] mb-1">
      <div class="w-[52px] h-[52px] rounded-full p-[4px] inline-block" data-banner-editor-target="previewRing"
           style="background: <%= @user.profile_color_2.presence || @user.profile_color || '#1e1c1b' %>">
        <% if @user.avatar.attached? %>
          <%= image_tag @user.avatar, class: "w-full h-full rounded-full object-cover",
              data: { banner_editor_target: "previewAvatar" } %>
        <% elsif @user.effective_avatar_url.present? %>
          <%= image_tag @user.effective_avatar_url, class: "w-full h-full rounded-full object-cover",
              data: { banner_editor_target: "previewAvatar" } %>
        <% else %>
          <%= image_tag "", class: "w-full h-full rounded-full object-cover hidden",
              data: { banner_editor_target: "previewAvatar" } %>
          <div class="w-full h-full rounded-full flex items-center justify-center text-lg font-bold text-white"
               style="background-color: <%= @user.profile_color || '#1e1c1b' %>"
               data-banner-editor-target="previewAvatarInitial">
            <%= @user.username[0].upcase %>
          </div>
        <% end %>
      </div>
    </div>
    <div class="bg-black/30 rounded-lg p-3">
      <h3 class="text-base font-bold text-white leading-tight"><%= @user.display_name.presence || @user.username %></h3>
      <p class="text-xs text-white/60"><%= @user.tag %></p>
      <% if @user.status.present? %>
        <p class="text-xs text-white/70 mt-1"><%= @user.status_emoji %> <%= @user.status %></p>
      <% end %>
      <% if @user.bio.present? %>
        <div class="border-t border-white/10 mt-2 pt-2">
          <h4 class="text-[10px] font-semibold text-white/50 uppercase mb-0.5">About Me</h4>
          <p class="text-xs text-white/80"><%= @user.bio %></p>
        </div>
      <% end %>
    </div>
  </div>
</div>
