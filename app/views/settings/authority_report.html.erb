<div data-controller="report-wizard">

<!-- Step indicators -->
<div class="flex items-center gap-2 mb-6">
  <% %w[Understand Review Categorize Confirm].each_with_index do |label, i| %>
    <div class="flex items-center gap-2" data-report-wizard-target="stepIndicator">
      <div class="w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold transition
                  <%= i == 0 ? 'bg-accent text-white' : 'bg-gray-700 text-gray-500' %>"
           data-report-wizard-target="stepDot"><%= i + 1 %></div>
      <span class="text-xs font-medium transition hidden sm:inline
                   <%= i == 0 ? 'text-white' : 'text-gray-500' %>"
            data-report-wizard-target="stepLabel"><%= label %></span>
    </div>
    <% if i < 3 %>
      <div class="flex-1 h-px bg-gray-700 max-w-8"></div>
    <% end %>
  <% end %>
</div>

<!-- ═══════════════════════════════════════════════════════ -->
<!-- STEP 1: Understand what this is for                     -->
<!-- ═══════════════════════════════════════════════════════ -->
<div data-report-wizard-target="step" data-step="0">
  <h2 class="text-xl font-bold text-white mb-2">Report to Law Enforcement</h2>
  <p class="text-sm text-gray-400 mb-6">
    Before proceeding, make sure you understand what this tool does and when it should be used.
  </p>

  <div class="bg-gray-800 rounded-lg p-5 mb-5">
    <h3 class="text-sm font-semibold text-white mb-3">This generates a formal report containing:</h3>
    <ul class="space-y-2 text-sm text-gray-300 mb-5">
      <li class="flex items-start gap-2">
        <svg class="w-4 h-4 text-gray-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        Message metadata, timestamps, and Nostr cryptographic identifiers
      </li>
      <li class="flex items-start gap-2">
        <svg class="w-4 h-4 text-gray-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
        Author public keys and server context
      </li>
      <li class="flex items-start gap-2">
        <svg class="w-4 h-4 text-gray-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"/></svg>
        Attachment fingerprints (files themselves are purged for your safety)
      </li>
    </ul>

    <div class="border-t border-gray-700 pt-4">
      <h3 class="text-sm font-semibold text-white mb-3">This is intended for serious illegal activity:</h3>
      <ul class="space-y-1.5 text-sm text-gray-300 mb-4">
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-danger shrink-0"></span>
          Child exploitation material
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-danger shrink-0"></span>
          Credible threats of violence or harm
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-danger shrink-0"></span>
          Terrorism-related content
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-danger shrink-0"></span>
          Other criminal activity
        </li>
      </ul>
    </div>

    <div class="border-t border-gray-700 pt-4">
      <h3 class="text-sm font-semibold text-white mb-2">This is NOT appropriate for:</h3>
      <ul class="space-y-1 text-sm text-gray-500">
        <li>Someone being rude, offensive, or disrespectful</li>
        <li>Spam, scam messages, or unwanted advertising</li>
        <li>Content you personally disagree with or find distasteful</li>
        <li>Server drama, personal disputes, or hurt feelings</li>
        <li>Misinformation or conspiracy theories</li>
      </ul>
    </div>
  </div>

  <div class="bg-gray-900/60 rounded-lg p-4 mb-6 border border-danger/20">
    <p class="text-sm text-danger-light font-medium">Filing a false police report is a crime in most jurisdictions. Only proceed if you have a genuine belief that illegal activity has occurred.</p>
  </div>

  <%= render "settings/report_message_preview", message: @message %>

  <div class="flex items-center gap-3">
    <%= link_to "Cancel", user_settings_safety_path, class: "px-4 py-2 text-sm text-gray-400 hover:text-white transition", data: { turbo_frame: "settings-frame" } %>
    <button type="button" class="bg-gray-700 hover:bg-gray-600 text-white text-sm font-medium px-5 py-2 rounded-lg transition cursor-pointer"
            data-action="click->report-wizard#next">
      I understand, continue
    </button>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════ -->
<!-- STEP 2: Review the message                              -->
<!-- ═══════════════════════════════════════════════════════ -->
<div data-report-wizard-target="step" data-step="1" class="hidden">
  <h2 class="text-xl font-bold text-white mb-2">Review the Message</h2>
  <p class="text-sm text-gray-400 mb-6">
    Verify that this is the message you intend to report. The report will reference this specific content.
  </p>

  <div class="bg-gray-800 rounded-lg p-5 mb-6 report-message-preview">
    <div class="flex items-center gap-2 mb-3">
      <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wide">Message Details</h3>
      <span class="text-xs text-gray-600">ID: <%= @message.public_id %></span>
    </div>

    <div class="space-y-3">
      <div>
        <span class="text-xs text-gray-500">Author</span>
        <p class="text-sm text-gray-200">
          <% if @message.user %>
            <%= @message.user.username %>
          <% elsif @message.nostr_author_pubkey.present? %>
            <span class="font-mono text-xs"><%= @message.nostr_author_pubkey.first(20) %>...</span>
          <% else %>
            <span class="text-gray-500">Unknown</span>
          <% end %>
        </p>
      </div>

      <div>
        <span class="text-xs text-gray-500">Sent</span>
        <p class="text-sm text-gray-200"><%= @message.created_at.strftime("%B %d, %Y at %l:%M %p %Z") %></p>
      </div>

      <div>
        <span class="text-xs text-gray-500">Hidden</span>
        <p class="text-sm text-gray-200">
          <%= @message.hidden_at.strftime("%B %d, %Y at %l:%M %p %Z") %>
          <% if @message.hidden_reason.present? %>
            <span class="text-gray-500">— reason: <%= @message.hidden_reason %></span>
          <% end %>
        </p>
      </div>

      <div class="border-t border-gray-700 pt-3">
        <span class="text-xs text-gray-500">Content</span>
        <% if @message.hidden_reason == "csam_match" %>
          <p class="text-sm italic text-gray-500 mt-1">Content was blocked by automated safety systems and is not available for preview.</p>
        <% elsif @message.content.present? %>
          <div class="text-sm text-gray-300 mt-1 bg-gray-900/50 rounded px-3 py-2 max-w-lg">
            <%= truncate(@message.content, length: 300) %>
          </div>
        <% else %>
          <p class="text-sm italic text-gray-500 mt-1">No text content</p>
        <% end %>
      </div>

      <% if @message.hidden_attachment_records.any? %>
        <div class="border-t border-gray-700 pt-3">
          <span class="text-xs text-gray-500">Attachments</span>
          <p class="text-sm text-gray-400 mt-1">
            <%= @message.hidden_attachment_records.count %> file<%= @message.hidden_attachment_records.count == 1 ? '' : 's' %> — original media was purged, metadata and fingerprints will be included in the report
          </p>
          <div class="space-y-1 mt-2">
            <% @message.hidden_attachment_records.each do |att| %>
              <div class="text-xs text-gray-500 font-mono bg-gray-900/30 rounded px-2 py-1 inline-block mr-1">
                <%= att.original_filename %> (<%= number_to_human_size(att.byte_size) %>)
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <button type="button" class="px-4 py-2 text-sm text-gray-400 hover:text-white transition cursor-pointer"
            data-action="click->report-wizard#prev">Back</button>
    <button type="button" class="bg-gray-700 hover:bg-gray-600 text-white text-sm font-medium px-5 py-2 rounded-lg transition cursor-pointer"
            data-action="click->report-wizard#next">
      This is the correct message
    </button>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════ -->
<!-- STEP 3: Select category                                 -->
<!-- ═══════════════════════════════════════════════════════ -->
<div data-report-wizard-target="step" data-step="2" class="hidden">
  <h2 class="text-xl font-bold text-white mb-2">Categorize the Report</h2>
  <p class="text-sm text-gray-400 mb-6">
    Select the category that best describes the illegal activity. This helps law enforcement prioritize and route the report.
  </p>

  <%= render "settings/report_message_preview", message: @message %>

  <div class="space-y-3 mb-6" data-report-wizard-target="categoryList">
    <label class="flex items-start gap-3 p-4 rounded-lg border border-gray-700 hover:border-gray-600 cursor-pointer transition has-[:checked]:border-accent/50 has-[:checked]:bg-accent/5">
      <input type="radio" name="category" value="csam" class="w-4 h-4 mt-0.5 text-accent bg-gray-900 border-gray-600 focus:ring-accent focus:ring-offset-0" data-action="change->report-wizard#categorySelected">
      <div>
        <span class="text-sm font-medium text-white">Child exploitation material</span>
        <p class="text-xs text-gray-500 mt-0.5">Images, videos, or text depicting the sexual exploitation or abuse of minors</p>
      </div>
    </label>
    <label class="flex items-start gap-3 p-4 rounded-lg border border-gray-700 hover:border-gray-600 cursor-pointer transition has-[:checked]:border-accent/50 has-[:checked]:bg-accent/5">
      <input type="radio" name="category" value="threats" class="w-4 h-4 mt-0.5 text-accent bg-gray-900 border-gray-600 focus:ring-accent focus:ring-offset-0" data-action="change->report-wizard#categorySelected">
      <div>
        <span class="text-sm font-medium text-white">Credible threats of violence</span>
        <p class="text-xs text-gray-500 mt-0.5">Specific, actionable threats to harm individuals, groups, or property</p>
      </div>
    </label>
    <label class="flex items-start gap-3 p-4 rounded-lg border border-gray-700 hover:border-gray-600 cursor-pointer transition has-[:checked]:border-accent/50 has-[:checked]:bg-accent/5">
      <input type="radio" name="category" value="terrorism" class="w-4 h-4 mt-0.5 text-accent bg-gray-900 border-gray-600 focus:ring-accent focus:ring-offset-0" data-action="change->report-wizard#categorySelected">
      <div>
        <span class="text-sm font-medium text-white">Terrorism-related content</span>
        <p class="text-xs text-gray-500 mt-0.5">Recruitment, planning, propaganda, or glorification of terrorist acts</p>
      </div>
    </label>
    <label class="flex items-start gap-3 p-4 rounded-lg border border-gray-700 hover:border-gray-600 cursor-pointer transition has-[:checked]:border-accent/50 has-[:checked]:bg-accent/5">
      <input type="radio" name="category" value="other_illegal" class="w-4 h-4 mt-0.5 text-accent bg-gray-900 border-gray-600 focus:ring-accent focus:ring-offset-0" data-action="change->report-wizard#categorySelected">
      <div>
        <span class="text-sm font-medium text-white">Other criminal activity</span>
        <p class="text-xs text-gray-500 mt-0.5">Drug trafficking, fraud, human trafficking, or other activities that violate criminal law</p>
      </div>
    </label>
  </div>

  <div class="flex items-center gap-3">
    <button type="button" class="px-4 py-2 text-sm text-gray-400 hover:text-white transition cursor-pointer"
            data-action="click->report-wizard#prev">Back</button>
    <button type="button" class="bg-gray-700 hover:bg-gray-600 text-white text-sm font-medium px-5 py-2 rounded-lg transition cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed"
            data-action="click->report-wizard#next"
            data-report-wizard-target="categoryNext" disabled>
      Continue
    </button>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════ -->
<!-- STEP 4: Final confirmation + generate                   -->
<!-- ═══════════════════════════════════════════════════════ -->
<div data-report-wizard-target="step" data-step="3" class="hidden">
  <h2 class="text-xl font-bold text-white mb-2">Confirm and Generate</h2>
  <p class="text-sm text-gray-400 mb-6">
    Review your selections below. Once generated, the report will be downloaded as a text file that you can submit to the appropriate authority.
  </p>

  <%= render "settings/report_message_preview", message: @message, mb: "5" %>

  <div class="bg-gray-800 rounded-lg p-5 mb-5 space-y-3">
    <div>
      <span class="text-xs text-gray-500">Message</span>
      <p class="text-sm text-gray-200 font-mono"><%= @message.public_id %></p>
    </div>
    <div>
      <span class="text-xs text-gray-500">Category</span>
      <p class="text-sm text-gray-200" data-report-wizard-target="categoryDisplay">—</p>
    </div>
    <div>
      <span class="text-xs text-gray-500">Reporter</span>
      <p class="text-sm text-gray-200"><%= current_user.username %></p>
    </div>
  </div>

  <div class="bg-gray-900/60 rounded-lg p-4 mb-5 border border-gray-700">
    <p class="text-sm text-gray-300 mb-2">By generating this report you confirm that:</p>
    <ul class="space-y-1.5 text-sm text-gray-400">
      <li class="flex items-start gap-2">
        <svg class="w-4 h-4 text-gray-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        You have a genuine belief that this content involves illegal activity
      </li>
      <li class="flex items-start gap-2">
        <svg class="w-4 h-4 text-gray-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        You understand that you are responsible for submitting the report to the appropriate authority
      </li>
      <li class="flex items-start gap-2">
        <svg class="w-4 h-4 text-gray-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        You understand that filing a false report may have legal consequences
      </li>
    </ul>
  </div>

  <div class="mb-4">
    <label class="flex items-center gap-3 cursor-pointer">
      <input type="checkbox" data-report-wizard-target="confirmCheck" data-action="change->report-wizard#confirmToggled"
             class="w-4 h-4 rounded bg-gray-900 border-gray-600 text-accent focus:ring-accent focus:ring-offset-0">
      <span class="text-sm text-gray-300">I have read and understand the above</span>
    </label>
  </div>

  <%= form_with url: user_settings_generate_authority_report_path(@message.public_id), method: :post, local: true do %>
    <input type="hidden" name="category" data-report-wizard-target="categoryField" value="">
    <div class="flex items-center gap-3">
      <button type="button" class="px-4 py-2 text-sm text-gray-400 hover:text-white transition cursor-pointer"
              data-action="click->report-wizard#prev">Back</button>
      <button type="submit" class="bg-danger/80 hover:bg-danger text-white text-sm font-medium px-5 py-2 rounded-lg transition cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed"
              data-report-wizard-target="generateBtn" disabled>
        Generate Report
      </button>
    </div>
  <% end %>
</div>

<!-- ═══════════════════════════════════════════════════════ -->
<!-- Reporting Resources (always visible)                    -->
<!-- ═══════════════════════════════════════════════════════ -->
<div class="border-t border-gray-700 mt-8 pt-6">
  <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wide mb-3">Where to Submit</h3>
  <div class="space-y-2 text-sm">
    <div class="flex items-center gap-2">
      <span class="text-gray-500">Child exploitation:</span>
      <span class="text-accent-light">NCMEC CyberTipline — report.cybertip.org</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="text-gray-500">Threats / Terrorism (US):</span>
      <span class="text-accent-light">FBI IC3 — ic3.gov</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="text-gray-500">UK:</span>
      <span class="text-accent-light">Internet Watch Foundation — iwf.org.uk</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="text-gray-500">EU:</span>
      <span class="text-accent-light">Europol — europol.europa.eu/report-a-crime</span>
    </div>
  </div>
  <p class="text-xs text-gray-500 mt-3">
    Law enforcement can use the Nostr event ID in the report to retrieve the original content from relays with proper legal authority.
  </p>
</div>

</div>
