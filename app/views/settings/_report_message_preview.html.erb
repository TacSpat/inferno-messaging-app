<!-- Compact message preview card for authority report wizard -->
<div class="bg-gray-800/60 rounded-lg p-4 mb-<%= local_assigns[:mb] || '6' %> border border-gray-700 report-message-preview">
  <h4 class="text-xs font-bold text-gray-500 uppercase tracking-wide mb-3">Message Being Reported</h4>
  <div class="flex items-start gap-3">
    <div class="w-8 h-8 rounded-full bg-gray-700 flex items-center justify-center text-xs font-bold text-gray-400 shrink-0">
      <% if message.user %>
        <%= message.user.username[0].upcase %>
      <% else %>
        ?
      <% end %>
    </div>
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-2 mb-1">
        <span class="text-sm font-medium text-gray-300">
          <%= message.user&.username || message.nostr_author_pubkey&.first(12)&.then { "#{_1}..." } || "Unknown" %>
        </span>
        <span class="text-xs text-gray-600"><%= message.created_at.strftime("%b %d, %Y %l:%M %p") %></span>
      </div>
      <% if message.hidden_reason == "csam_match" %>
        <p class="text-sm italic text-gray-500">Content blocked by automated safety systems</p>
      <% elsif message.content.present? %>
        <p class="text-sm text-gray-400 break-words"><%= truncate(message.content, length: 200) %></p>
      <% else %>
        <p class="text-sm italic text-gray-500">No text content</p>
      <% end %>
      <% if message.hidden_attachment_records.any? %>
        <div class="flex items-center gap-1.5 mt-2">
          <svg class="w-3.5 h-3.5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"/></svg>
          <span class="text-xs text-gray-500"><%= message.hidden_attachment_records.count %> attachment<%= message.hidden_attachment_records.count == 1 ? '' : 's' %> (purged)</span>
        </div>
      <% end %>
    </div>
  </div>
</div>
