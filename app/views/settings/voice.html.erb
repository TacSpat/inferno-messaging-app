<h2 class="text-xl font-bold text-white mb-6">Voice & Video</h2>

<div class="max-w-lg" data-controller="voice-settings">
  <%= form_tag settings_update_voice_path, method: :patch, class: "space-y-8" do %>

    <%# ── Input Mode ── %>
    <div class="rounded-lg border border-gray-700 p-6">
      <h3 class="text-sm font-semibold text-white/80 uppercase mb-4">Input Mode</h3>
      <div class="flex gap-3">
        <label class="flex-1 cursor-pointer">
          <input type="radio" name="input_mode" value="voice_activity"
                 <%= 'checked' if @user.voice_setting('input_mode') == 'voice_activity' %>
                 class="sr-only peer"
                 data-action="change->voice-settings#inputModeChanged">
          <div class="border-2 border-gray-600 peer-checked:border-accent rounded-lg p-3 text-center transition">
            <svg class="w-6 h-6 mx-auto mb-1 text-gray-400 peer-checked:text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/></svg>
            <span class="text-sm text-gray-300">Voice Activity</span>
          </div>
        </label>
        <label class="flex-1 cursor-pointer">
          <input type="radio" name="input_mode" value="push_to_talk"
                 <%= 'checked' if @user.voice_setting('input_mode') == 'push_to_talk' %>
                 class="sr-only peer"
                 data-action="change->voice-settings#inputModeChanged">
          <div class="border-2 border-gray-600 peer-checked:border-accent rounded-lg p-3 text-center transition">
            <svg class="w-6 h-6 mx-auto mb-1 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
            <span class="text-sm text-gray-300">Push to Talk</span>
          </div>
        </label>
      </div>

      <%# PTT keybind section (shown only when push_to_talk selected) %>
      <div data-voice-settings-target="pttSection"
           class="<%= 'hidden' unless @user.voice_setting('input_mode') == 'push_to_talk' %> mt-4 p-3 bg-gray-800 rounded-lg">
        <label class="block text-xs font-semibold text-white/50 uppercase mb-2">Push-to-Talk Key</label>
        <div class="flex items-center gap-3">
          <div data-voice-settings-target="keyDisplay"
               class="flex-1 bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white text-sm text-center font-mono">
            <%= @user.voice_setting('ptt_key') %>
          </div>
          <button type="button"
                  class="px-3 py-2 bg-gray-700 hover:bg-gray-600 text-white text-sm rounded transition cursor-pointer"
                  data-action="click->voice-settings#captureKey">
            Record
          </button>
        </div>
        <input type="hidden" name="ptt_key" value="<%= @user.voice_setting('ptt_key') %>"
               data-voice-settings-target="pttKeyField">
        <input type="hidden" name="ptt_key_code" value="<%= @user.voice_setting('ptt_key_code') %>"
               data-voice-settings-target="pttKeyCodeField">
      </div>
    </div>

    <%# ── Input Sensitivity ── %>
    <div class="rounded-lg border border-gray-700 p-6">
      <h3 class="text-sm font-semibold text-white/80 uppercase mb-4">Input Sensitivity</h3>
      <p class="text-xs text-gray-500 mb-3">Adjust the threshold for when your mic activates. Speak to test against the marker.</p>

      <%# Live mic level bar %>
      <div class="relative h-6 bg-gray-900 rounded overflow-hidden mb-3" data-voice-settings-target="micLevelBar">
        <div class="absolute inset-y-0 left-0 bg-green-500/60 transition-all duration-75 rounded"
             style="width: 0%"
             data-voice-settings-target="micLevelFill"></div>
        <div class="absolute inset-y-0 w-0.5 bg-accent z-10"
             style="left: <%= (@user.voice_setting('input_sensitivity').to_f / 0.1 * 100).clamp(0, 100) %>%"
             data-voice-settings-target="thresholdMarker"></div>
      </div>

      <input type="range" name="input_sensitivity"
             min="0.001" max="0.1" step="0.001"
             value="<%= @user.voice_setting('input_sensitivity') %>"
             class="w-full accent-accent"
             data-voice-settings-target="sensitivitySlider"
             data-action="input->voice-settings#sensitivityChanged">
      <div class="flex justify-between text-xs text-gray-500 mt-1">
        <span>Sensitive</span>
        <span>Aggressive</span>
      </div>
    </div>

    <%# ── Noise Suppression ── %>
    <div class="rounded-lg border border-gray-700 p-6">
      <h3 class="text-sm font-semibold text-white/80 uppercase mb-4">Noise Suppression</h3>
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-gray-300">AI-powered noise suppression</p>
          <p class="text-xs text-gray-500 mt-0.5">Uses RNNoise to remove keyboard, fan, and background noise</p>
        </div>
        <label class="relative inline-flex items-center cursor-pointer">
          <input type="hidden" name="noise_suppression" value="false">
          <input type="checkbox" name="noise_suppression" value="true"
                 <%= 'checked' if @user.voice_setting('noise_suppression') %>
                 class="sr-only peer">
          <div class="w-11 h-6 bg-gray-600 peer-checked:bg-toggle-on rounded-full transition-colors
                      after:content-[''] after:absolute after:top-0.5 after:left-[2px]
                      after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all
                      peer-checked:after:translate-x-full"></div>
        </label>
      </div>
    </div>

    <%# ── Auto-Join ── %>
    <div class="rounded-lg border border-gray-700 p-6">
      <h3 class="text-sm font-semibold text-white/80 uppercase mb-4">Voice Channels</h3>
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-gray-300">Auto-join on click</p>
          <p class="text-xs text-gray-500 mt-0.5">Automatically connect when you click a voice channel</p>
        </div>
        <label class="relative inline-flex items-center cursor-pointer">
          <input type="hidden" name="auto_join_voice" value="false">
          <input type="checkbox" name="auto_join_voice" value="true"
                 <%= 'checked' if @user.voice_setting('auto_join_voice') %>
                 class="sr-only peer">
          <div class="w-11 h-6 bg-gray-600 peer-checked:bg-toggle-on rounded-full transition-colors
                      after:content-[''] after:absolute after:top-0.5 after:left-[2px]
                      after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all
                      peer-checked:after:translate-x-full"></div>
        </label>
      </div>
    </div>

    <%# ── Save ── %>
    <button type="submit"
            class="w-full bg-gradient-to-r from-confirm-dark to-confirm hover:from-confirm hover:to-confirm-light text-white font-semibold py-2.5 rounded transition cursor-pointer text-sm">
      Save Changes
    </button>
  <% end %>
</div>
