<h2 class="text-xl font-bold text-white mb-6">Profile</h2>

<% emoji_server = current_user.servers.joins(:server_emojis).first %>

<div class="flex flex-col lg:flex-row gap-8" data-controller="banner-editor">
  <!-- Form (left) -->
  <div class="flex-1 max-w-2xl">
    <%= form_with model: @user, url: settings_profile_path, method: :patch,
        html: { multipart: true },
        class: "space-y-6" do |f| %>

      <% if @user.errors.any? %>
        <div class="bg-danger-dark/20 border border-danger-dark rounded-lg p-4">
          <% @user.errors.full_messages.each do |msg| %>
            <p class="text-sm text-danger-light"><%= msg %></p>
          <% end %>
        </div>
      <% end %>

      <!-- Banner area -->
      <div data-hint="settings_banner" class="bg-gray-800 rounded-xl border border-gray-700/50">
        <div class="h-32 relative cursor-grab active:cursor-grabbing group rounded-t-xl overflow-hidden"
             style="background: linear-gradient(135deg, <%= @user.profile_color || '#1e1c1b' %>, <%= @user.profile_color_2 || @user.profile_color || '#1e1c1b' %>);"
             data-banner-editor-target="container">
          <% if @user.effective_banner_url.present? %>
            <%= image_tag @user.effective_banner_url,
                class: "w-full absolute left-0 object-cover pointer-events-none",
                style: "top: #{@user.banner_offset_y || 0}px; min-height: 100%;",
                data: { banner_editor_target: "image" } %>
          <% else %>
            <%= image_tag "", class: "w-full absolute left-0 object-cover pointer-events-none hidden",
                style: "top: 0px; min-height: 100%;",
                data: { banner_editor_target: "image" } %>
          <% end %>
          <label class="absolute inset-0 flex items-center justify-center bg-black/0 group-hover:bg-black/40 transition-colors cursor-pointer">
            <div class="opacity-0 group-hover:opacity-100 transition-opacity flex flex-col items-center gap-1">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              <span class="text-white text-xs font-medium">Change Banner</span>
            </div>
            <%= f.file_field :banner, accept: "image/*", class: "hidden",
                data: { action: "change->banner-editor#previewBannerFile", banner_editor_target: "input" } %>
          </label>
          <span class="absolute bottom-2 right-2 text-white/50 text-[10px] font-medium opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"
                data-banner-editor-target="hint">
            <% if @user.effective_banner_url.present? %>Drag to reposition<% end %>
          </span>
        </div>
        <%= f.hidden_field :banner_offset_y, value: @user.banner_offset_y || 0, data: { banner_editor_target: "offsetField" } %>

        <!-- Avatar overlapping banner -->
        <div class="px-5 pb-4">
          <div class="relative -mt-10">
            <label class="group relative w-20 h-20 rounded-full overflow-hidden border-4 border-gray-800 cursor-pointer block"
                   style="background-color: <%= @user.profile_color || '#1e1c1b' %>">
              <% if @user.effective_avatar_url.present? %>
                <%= image_tag @user.effective_avatar_url, class: "w-full h-full object-cover", data: { banner_editor_target: "avatarPreview" } %>
              <% else %>
                <%= image_tag "", class: "w-full h-full object-cover hidden", data: { banner_editor_target: "avatarPreview" } %>
                <span class="w-full h-full flex items-center justify-center text-2xl font-bold text-white" data-banner-editor-target="avatarInitial"><%= @user.username[0].upcase %></span>
              <% end %>
              <div class="absolute inset-0 bg-black/0 group-hover:bg-black/40 transition-colors flex items-center justify-center">
                <svg class="w-5 h-5 text-white opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>
              <%= f.file_field :avatar, accept: "image/*", class: "hidden",
                  data: { action: "change->banner-editor#previewAvatarFile", banner_editor_target: "avatarInput" } %>
            </label>
            <p class="text-[11px] text-gray-500 mt-1.5">Click to change avatar</p>
          </div>
        </div>
      </div>

      <!-- Profile Theme -->
      <div data-hint="settings_theme" class="bg-gray-800 rounded-xl border border-gray-700/50 p-5">
        <label class="block text-[11px] font-semibold text-gray-500 uppercase tracking-wider mb-3">Profile Theme</label>
        <div class="flex items-center gap-3">
          <div>
            <p class="text-[10px] text-gray-500 uppercase font-semibold mb-1">Color 1</p>
            <%= f.color_field :profile_color, value: @user.profile_color || '#1e1c1b',
                class: "w-8 h-8 rounded cursor-pointer border border-gray-600 bg-transparent p-0", data: { action: "input->banner-editor#updateColors" } %>
          </div>
          <div>
            <p class="text-[10px] text-gray-500 uppercase font-semibold mb-1">Color 2</p>
            <%= f.color_field :profile_color_2, value: @user.profile_color_2 || @user.profile_color || '#1e1c1b',
                class: "w-8 h-8 rounded cursor-pointer border border-gray-600 bg-transparent p-0", data: { action: "input->banner-editor#updateColors" } %>
          </div>
          <div class="flex-1">
            <p class="text-[10px] text-gray-500 uppercase font-semibold mb-1">Preview</p>
            <div class="h-8 rounded border border-gray-600"
                 data-banner-editor-target="gradientPreviewStrip" style="background: linear-gradient(135deg, <%= @user.profile_color || '#1e1c1b' %>, <%= @user.profile_color_2 || @user.profile_color || '#1e1c1b' %>);"></div>
          </div>
        </div>
      </div>

      <!-- Profile fields -->
      <div class="bg-gray-800 rounded-xl border border-gray-700/50 p-5 space-y-4">
        <!-- Display Name with emoji picker -->
        <div data-hint="settings_display" data-controller="emoji-input" <%= "data-emoji-input-server-id-value=#{emoji_server.public_id}" if emoji_server %>>
          <label class="block text-[11px] font-semibold text-gray-500 uppercase tracking-wider mb-2">Display Name</label>
          <div class="flex items-center bg-gray-900 border border-gray-700/50 rounded-lg px-3 py-2.5 focus-within:border-accent/50 transition">
            <div class="flex-1 relative">
              <div data-emoji-input-target="highlight" class="absolute inset-0 text-sm text-white whitespace-pre break-words pointer-events-none overflow-hidden" aria-hidden="true"></div>
              <%= f.text_field :display_name, class: "w-full bg-transparent text-transparent caret-white placeholder-gray-600 focus:outline-none text-sm relative z-10", data: { emoji_input_target: "input", action: "input->emoji-input#handleInput keydown->emoji-input#handleKeydown" } %>
            </div>
            <button type="button" class="text-gray-500 hover:text-gray-300 ml-1.5 shrink-0 cursor-pointer transition" data-action="click->emoji-input#toggle" data-emoji-input-target="button" title="Add emoji">
              <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </button>
          </div>
        </div>

        <!-- Username -->
        <div>
          <label class="block text-[11px] font-semibold text-gray-500 uppercase tracking-wider mb-2">Username</label>
          <%= f.text_field :username, class: "w-full bg-gray-900 border border-gray-700/50 rounded-lg px-3 py-2.5 text-white focus:outline-none focus:border-accent/50 text-sm transition" %>
        </div>

        <!-- About Me -->
        <div>
          <label class="block text-[11px] font-semibold text-gray-500 uppercase tracking-wider mb-2">About Me</label>
          <%= f.text_area :bio, rows: 3, maxlength: 500, class: "w-full bg-gray-900 border border-gray-700/50 rounded-lg px-3 py-2.5 text-white focus:outline-none focus:border-accent/50 text-sm resize-none transition", placeholder: "Tell others about yourself" %>
          <p class="text-[11px] text-gray-600 mt-1"><%= @user.bio&.length || 0 %>/500</p>
        </div>

        <!-- Custom Status -->
        <div data-hint="settings_status" data-controller="status-emoji" <%= "data-status-emoji-server-id-value=#{emoji_server.public_id}" if emoji_server %>>
          <label class="block text-[11px] font-semibold text-gray-500 uppercase tracking-wider mb-2">Custom Status</label>
          <div class="flex gap-2">
            <button type="button" data-action="click->status-emoji#toggle" data-status-emoji-target="button"
                    class="w-11 h-11 bg-gray-900 border border-gray-700/50 rounded-lg flex items-center justify-center text-lg hover:border-accent/50 transition cursor-pointer shrink-0">
              <span data-status-emoji-target="display"><%= @user.status_emoji.present? ? @user.status_emoji : "😊" %></span>
            </button>
            <%= f.hidden_field :status_emoji, data: { status_emoji_target: "field" } %>
            <div class="flex-1">
              <%= f.text_field :status, class: "w-full bg-gray-900 border border-gray-700/50 rounded-lg px-3 py-2.5 text-white focus:outline-none focus:border-accent/50 text-sm transition", placeholder: "What are you up to?" %>
            </div>
          </div>
        </div>
      </div>

      <%= f.submit "Save Changes", class: "w-full bg-gradient-to-r from-confirm-dark to-confirm hover:from-confirm hover:to-confirm-light text-white font-semibold py-2.5 rounded transition cursor-pointer text-sm" %>
    <% end %>
  </div>

  <!-- Preview card (right) -->
  <div data-hint="settings_preview" class="hidden lg:block w-72 flex-shrink-0">
    <h3 class="text-[11px] font-semibold text-gray-500 uppercase tracking-wider mb-3">Preview</h3>
    <%= render 'settings/preview_card' %>
  </div>
</div>
