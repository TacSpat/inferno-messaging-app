<h2 class="text-xl font-bold text-white mb-6">Profile</h2>

<div class="flex flex-col lg:flex-row gap-8" data-controller="banner-editor">
  <!-- Form (left) -->
  <div class="flex-1">
    <%= form_with model: @user, url: settings_profile_path, method: :patch,
        html: { multipart: true },
        class: "space-y-5" do |f| %>

      <% if @user.errors.any? %>
        <div class="bg-danger-dark/20 border border-danger-dark rounded-lg p-4">
          <% @user.errors.full_messages.each do |msg| %>
            <p class="text-sm text-danger-light"><%= msg %></p>
          <% end %>
        </div>
      <% end %>

      <!-- Avatar -->
      <div class="bg-gray-800 rounded-lg p-4">
        <label class="block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-3">Avatar</label>
        <div class="flex items-center gap-4">
          <div class="w-20 h-20 rounded-full flex items-center justify-center text-2xl font-bold text-white overflow-hidden" style="background-color: <%= @user.profile_color || '#1e1c1b' %>">
            <% if @user.avatar.attached? %>
              <%= image_tag @user.avatar, class: "w-full h-full object-cover", data: { banner_editor_target: "avatarPreview" } %>
            <% elsif @user.effective_avatar_url.present? %>
              <%= image_tag @user.effective_avatar_url, class: "w-full h-full object-cover", data: { banner_editor_target: "avatarPreview" } %>
            <% else %>
              <%= image_tag "", class: "w-full h-full object-cover hidden", data: { banner_editor_target: "avatarPreview" } %>
              <span data-banner-editor-target="avatarInitial"><%= @user.username[0].upcase %></span>
            <% end %>
          </div>
          <div>
            <%= f.file_field :avatar, accept: "image/*",
                class: "text-sm text-gray-400 file:mr-4 file:py-2 file:px-4 file:rounded file:border-0 file:text-sm file:font-semibold file:bg-accent hover:file:bg-accent-dark file:cursor-pointer",
                data: { action: "change->banner-editor#previewAvatarFile", banner_editor_target: "avatarInput" } %>
            <p class="text-xs text-gray-500 mt-1">Recommended: 128Ã128 or larger</p>
          </div>
        </div>
      </div>

      <!-- Banner -->
      <div class="bg-gray-800 rounded-lg p-4">
        <label class="block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-3">Banner</label>
        <div class="h-24 rounded-lg overflow-hidden relative cursor-grab active:cursor-grabbing"
             style="background-color: <%= @user.profile_color || '#1e1c1b' %>"
             data-banner-editor-target="container"
             >
          <% if @user.banner.attached? %>
            <%= image_tag @user.banner,
                class: "w-full absolute left-0 object-cover pointer-events-none",
                style: "top: #{@user.banner_offset_y || 0}px; min-height: 100%;",
                data: { banner_editor_target: "image" } %>
          <% elsif @user.effective_banner_url.present? %>
            <%= image_tag @user.effective_banner_url,
                class: "w-full absolute left-0 object-cover pointer-events-none",
                style: "top: #{@user.banner_offset_y || 0}px; min-height: 100%;",
                data: { banner_editor_target: "image" } %>
          <% else %>
            <%= image_tag "", class: "w-full absolute left-0 object-cover pointer-events-none hidden",
                style: "top: 0px; min-height: 100%;",
                data: { banner_editor_target: "image" } %>
          <% end %>
          <div class="absolute inset-0 flex items-center justify-center bg-black/0 hover:bg-black/30 transition-colors pointer-events-none">
            <span class="text-white text-xs font-medium opacity-0 hover:opacity-100 transition-opacity" data-banner-editor-target="hint">
              <% if @user.banner.attached? %>Drag to reposition<% end %>
            </span>
          </div>
        </div>
        <%= f.file_field :banner, accept: "image/*",
            class: "text-sm text-gray-400 file:mr-4 file:py-2 file:px-4 file:rounded file:border-0 file:text-sm file:font-semibold file:bg-gray-600 file:text-white hover:file:bg-gray-500 file:cursor-pointer mt-2",
            data: { action: "change->banner-editor#previewBannerFile", banner_editor_target: "input" } %>
        <%= f.hidden_field :banner_offset_y, value: @user.banner_offset_y || 0, data: { banner_editor_target: "offsetField" } %>
      </div>

      <!-- Profile Color Gradient -->
      <div class="bg-gray-800 rounded-lg p-4">
        <label class="block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-3">Profile Theme</label>
        <div class="flex items-center gap-4">
          <div class="text-center">
            <p class="text-xs text-gray-500 mb-1">Color 1</p>
            <%= f.color_field :profile_color, value: @user.profile_color || '#1e1c1b',
                class: "w-12 h-12 rounded cursor-pointer border-2 border-gray-600 bg-transparent p-0", data: { action: "input->banner-editor#updateColors" } %>
          </div>
          <div class="text-center">
            <p class="text-xs text-gray-500 mb-1">Color 2</p>
            <%= f.color_field :profile_color_2, value: @user.profile_color_2 || @user.profile_color || '#1e1c1b',
                class: "w-12 h-12 rounded cursor-pointer border-2 border-gray-600 bg-transparent p-0", data: { action: "input->banner-editor#updateColors" } %>
          </div>
          <div class="flex-1">
            <p class="text-xs text-gray-500 mb-1">Preview</p>
            <div class="h-12 rounded-lg border border-gray-600"
                 data-banner-editor-target="gradientPreviewStrip" style="background: linear-gradient(135deg, <%= @user.profile_color || '#1e1c1b' %>, <%= @user.profile_color_2 || @user.profile_color || '#1e1c1b' %>);"></div>
          </div>
        </div>
        <p class="text-xs text-gray-500 mt-2">Colors your profile card background and banner fallback</p>
      </div>

      <!-- Profile fields -->
      <div class="bg-gray-800 rounded-lg p-4 space-y-4">
        <div>
          <%= f.label :display_name, "Display Name", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
          <%= f.text_field :display_name, class: "w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-accent text-sm" %>
        </div>

        <div>
          <%= f.label :username, class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
          <div class="flex items-center">
            <%= f.text_field :username, class: "flex-1 bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-accent text-sm" %>
            <span class="ml-2 text-gray-400 text-sm font-mono">#<%= @user.discriminator %></span>
          </div>
        </div>

        <div>
          <%= f.label :bio, "About Me", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
          <%= f.text_area :bio, rows: 3, maxlength: 500, class: "w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-accent text-sm resize-none", placeholder: "Tell others about yourself" %>
          <p class="text-xs text-gray-500 mt-1"><%= @user.bio&.length || 0 %>/500</p>
        </div>

        <div class="flex gap-3">
          <div class="w-16">
            <%= f.label :status_emoji, "Emoji", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
            <%= f.text_field :status_emoji, class: "w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-accent text-sm text-center", maxlength: 2 %>
          </div>
          <div class="flex-1">
            <%= f.label :status, "Custom Status", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
            <%= f.text_field :status, class: "w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-accent text-sm", placeholder: "What are you up to?" %>
          </div>
        </div>
      </div>

      <div class="flex justify-end">
        <%= f.submit "Save Changes", class: "bg-gradient-to-r from-confirm-dark to-confirm hover:from-confirm hover:to-confirm-light text-white font-semibold px-6 py-2 rounded transition cursor-pointer text-sm" %>
      </div>
    <% end %>
  </div>

  <!-- Preview card (right) -->
  <div class="hidden lg:block w-72 flex-shrink-0">
    <h3 class="text-xs font-semibold text-gray-300 uppercase tracking-wide mb-3">Preview</h3>
    <%= render 'settings/preview_card' %>
  </div>
</div>
