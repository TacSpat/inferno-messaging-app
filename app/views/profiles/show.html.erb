<div class="flex items-center justify-center min-h-screen bg-gray-900">
  <div class="w-full max-w-2xl bg-gray-800 rounded-lg shadow-xl overflow-hidden">
    <!-- Banner -->
    <div class="h-32 " style="<%= profile_gradient_style(@user) %> relative">
      <% if @user.effective_banner_url.present? %>
        <%= image_tag @user.effective_banner_url, class: "w-full h-full object-cover" %>
      <% end %>
    </div>

    <!-- Avatar + info -->
    <div class="px-6 pb-6">
      <div class="flex items-end -mt-12 mb-4">
        <div class="w-24 h-24 rounded-full border-4 border-gray-800 flex items-center justify-center text-3xl font-bold text-white" style="<%= profile_gradient_style(@user) %> shrink-0">
          <% if @user.effective_avatar_url.present? %>
            <%= image_tag @user.effective_avatar_url, class: "w-full h-full rounded-full object-cover" %>
          <% else %>
            <%= @user.username[0].upcase %>
          <% end %>
        </div>
        <div class="ml-4 mb-1">
          <h1 class="text-xl font-bold text-white"><%= @user.display_name %></h1>
          <p class="text-sm text-gray-400"><%= @user.tag %></p>
        </div>
        <%= link_to "Edit Profile", edit_profile_path, class: "ml-auto bg-gray-700 hover:bg-gray-600 text-white text-sm font-medium px-4 py-2 rounded transition" %>
      </div>

      <!-- Details -->
      <div class="space-y-4">
        <% if @user.bio.present? %>
          <div>
            <h3 class="text-xs font-semibold text-gray-400 uppercase mb-1">About Me</h3>
            <p class="text-sm text-gray-200"><%= @user.bio %></p>
          </div>
        <% end %>

        <div>
          <h3 class="text-xs font-semibold text-gray-400 uppercase mb-1">Member Since</h3>
          <p class="text-sm text-gray-200"><%= @user.created_at.strftime("%B %d, %Y") %></p>
        </div>

        <% if @user.status.present? %>
          <div>
            <h3 class="text-xs font-semibold text-gray-400 uppercase mb-1">Status</h3>
            <p class="text-sm text-gray-200"><%= @user.status_emoji %> <%= @user.status %></p>
          </div>
        <% end %>
      </div>

      <div class="mt-6 pt-4 border-t border-gray-700">
        <%= link_to "← Back", :back, class: "text-sm text-gray-400 hover:text-gray-200" %>
      </div>
    </div>
  </div>
</div>
