<div class="flex items-center justify-center min-h-screen bg-gray-900">
  <div class="w-full max-w-2xl bg-gray-800 rounded-lg shadow-xl p-8">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-2xl font-bold text-white">User Settings</h1>
      <%= link_to "✕", profile_path, class: "text-gray-400 hover:text-white text-xl" %>
    </div>

    <%= form_with model: @user, url: profile_path, method: :patch, html: { multipart: true }, class: "space-y-6" do |f| %>
      <% if @user.errors.any? %>
        <div class="bg-red-900/50 border border-red-700 rounded-lg p-4">
          <% @user.errors.full_messages.each do |msg| %>
            <p class="text-sm text-red-300"><%= msg %></p>
          <% end %>
        </div>
      <% end %>

      <!-- Avatar -->
      <div>
        <label class="block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-2">Avatar</label>
        <div class="flex items-center gap-4">
          <div class="w-20 h-20 rounded-full bg-orange-600 flex items-center justify-center text-2xl font-bold text-white overflow-hidden">
            <% if @user.avatar.attached? %>
              <%= image_tag @user.avatar, class: "w-full h-full object-cover" %>
            <% else %>
              <%= @user.username[0].upcase %>
            <% end %>
          </div>
          <div>
            <%= f.file_field :avatar, accept: "image/*", class: "text-sm text-gray-400 file:mr-4 file:py-2 file:px-4 file:rounded file:border-0 file:text-sm file:font-semibold file:bg-orange-600 file:text-white hover:file:bg-orange-700 file:cursor-pointer" %>
          </div>
        </div>
      </div>

      <!-- Banner -->
      <div>
        <label class="block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-2">Banner</label>
        <div class="h-24 rounded-lg bg-gradient-to-r from-orange-600 to-red-600 mb-2 overflow-hidden">
          <% if @user.banner.attached? %>
            <%= image_tag @user.banner, class: "w-full h-full object-cover" %>
          <% end %>
        </div>
        <%= f.file_field :banner, accept: "image/*", class: "text-sm text-gray-400 file:mr-4 file:py-2 file:px-4 file:rounded file:border-0 file:text-sm file:font-semibold file:bg-gray-700 file:text-white hover:file:bg-gray-600 file:cursor-pointer" %>
      </div>

      <!-- Username -->
      <div>
        <%= f.label :username, class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
        <div class="flex items-center">
          <%= f.text_field :username, class: "flex-1 bg-gray-900 border border-gray-700 rounded px-3 py-2 text-white focus:outline-none focus:border-orange-500 text-sm" %>
          <span class="ml-2 text-gray-500 text-sm">#<%= @user.discriminator %></span>
        </div>
      </div>

      <!-- Display Name -->
      <div>
        <%= f.label :display_name, "Display Name", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
        <%= f.text_field :display_name, class: "w-full bg-gray-900 border border-gray-700 rounded px-3 py-2 text-white focus:outline-none focus:border-orange-500 text-sm" %>
      </div>

      <!-- Bio -->
      <div>
        <%= f.label :bio, "About Me", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
        <%= f.text_area :bio, rows: 3, maxlength: 500, class: "w-full bg-gray-900 border border-gray-700 rounded px-3 py-2 text-white focus:outline-none focus:border-orange-500 text-sm resize-none", placeholder: "Tell others about yourself" %>
        <p class="text-xs text-gray-500 mt-1"><%= @user.bio&.length || 0 %>/500</p>
      </div>

      <!-- Status -->
      <div class="flex gap-3">
        <div class="w-16">
          <%= f.label :status_emoji, "Emoji", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
          <%= f.text_field :status_emoji, class: "w-full bg-gray-900 border border-gray-700 rounded px-3 py-2 text-white focus:outline-none focus:border-orange-500 text-sm text-center", maxlength: 2 %>
        </div>
        <div class="flex-1">
          <%= f.label :status, "Custom Status", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
          <%= f.text_field :status, class: "w-full bg-gray-900 border border-gray-700 rounded px-3 py-2 text-white focus:outline-none focus:border-orange-500 text-sm", placeholder: "What are you up to?" %>
        </div>
      </div>

      <!-- Actions -->
      <div class="flex items-center justify-between pt-4 border-t border-gray-700">
        <%= link_to "Cancel", profile_path, class: "text-sm text-gray-400 hover:text-gray-200" %>
        <%= f.submit "Save Changes", class: "bg-orange-600 hover:bg-orange-700 text-white font-semibold px-6 py-2 rounded transition cursor-pointer text-sm" %>
      </div>
    <% end %>

    <!-- Danger zone -->
    <div class="mt-8 pt-6 border-t border-gray-700">
      <h3 class="text-sm font-semibold text-red-400 mb-3">Danger Zone</h3>
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-gray-300">Log Out</p>
          <p class="text-xs text-gray-500">Sign out of your account</p>
        </div>
        <%= button_to "Log Out", destroy_user_session_path, method: :delete, class: "bg-red-600 hover:bg-red-700 text-white text-sm font-medium px-4 py-2 rounded transition cursor-pointer" %>
      </div>
    </div>
  </div>
</div>
