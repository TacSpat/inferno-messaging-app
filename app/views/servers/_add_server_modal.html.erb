<div data-controller="add-server-modal" data-action="keydown@document->add-server-modal#keydown">
  <!-- Trigger: the "+" button in the server rail calls open -->
  <button type="button" data-action="click->add-server-modal#open" data-hint="add_server"
          class="flex items-center justify-center w-12 h-12 rounded-2xl bg-gray-700 hover:bg-green-600 hover:rounded-xl transition-all duration-200 text-green-500 hover:text-white text-2xl cursor-pointer">
    +
  </button>

  <!-- Modal overlay — teleported to <body> on connect so it escapes the server rail's
       CSS transform (which creates a containing block that breaks fixed positioning on mobile) -->
  <div data-add-server-modal-target="modal"
       class="hidden fixed inset-0 z-[200] bg-black/60 flex items-center justify-center">
    <div class="w-full max-w-md mx-4 max-h-[85vh] overflow-y-auto rounded-xl bg-gray-800 border border-gray-700/50 shadow-2xl">
      <!-- Header -->
      <div class="flex items-center justify-between px-5 pt-5 pb-2">
        <h2 class="text-lg font-bold text-white">Add a Server</h2>
        <button type="button" data-dismiss="modal" data-action="click->add-server-modal#close"
                class="w-8 h-8 rounded-full flex items-center justify-center text-gray-400 hover:text-white hover:bg-gray-700 transition cursor-pointer">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <div class="px-5 pb-5 space-y-5">
        <!-- ═══ Join a Server ═══ -->
        <div>
          <p class="text-sm text-gray-400 mb-3">Enter an invite link or server ID to join</p>
          <div data-controller="server-invite-preview" class="space-y-3">
            <input type="text"
                   data-server-invite-preview-target="input"
                   data-action="input->server-invite-preview#onInput keydown->server-invite-preview#onKeydown"
                   placeholder="Paste invite link or server ID..."
                   class="w-full bg-gray-900 text-white text-sm rounded-lg px-3 py-2.5 outline-none border border-gray-700/50 focus:border-accent/50 placeholder-gray-500 transition"
                   autocomplete="off">

            <!-- Server preview card (hidden until resolved) -->
            <div data-server-invite-preview-target="preview" class="hidden">
              <div class="bg-gray-900 rounded-xl overflow-hidden border border-gray-700/50">
                <div class="h-20 bg-gradient-to-br from-accent-dark/30 to-gray-900">
                  <img data-server-invite-preview-target="banner" class="w-full h-full object-cover hidden">
                </div>
                <div class="relative px-4 pb-4">
                  <div class="-mt-8 mb-2">
                    <div data-server-invite-preview-target="iconFallback" class="w-14 h-14 rounded-xl bg-gray-700 border-3 border-gray-800 flex items-center justify-center text-xl font-bold text-white">
                      <span data-server-invite-preview-target="iconLetter">?</span>
                    </div>
                    <img data-server-invite-preview-target="icon" class="hidden w-14 h-14 rounded-xl object-cover border-3 border-gray-800">
                  </div>
                  <h3 data-server-invite-preview-target="name" class="text-sm font-bold text-white"></h3>
                  <p data-server-invite-preview-target="description" class="text-xs text-gray-400 mt-0.5 line-clamp-2 hidden"></p>
                  <div class="flex items-center gap-3 mt-2 text-xs text-gray-500">
                    <div class="flex items-center gap-1">
                      <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
                      <span data-server-invite-preview-target="online">0</span> Online
                    </div>
                    <div class="flex items-center gap-1">
                      <span class="w-1.5 h-1.5 rounded-full bg-gray-500"></span>
                      <span data-server-invite-preview-target="members">0</span> Members
                    </div>
                  </div>
                  <button type="button"
                          data-server-invite-preview-target="joinBtn"
                          data-action="click->server-invite-preview#join"
                          class="w-full mt-3 bg-accent hover:bg-accent-light text-white font-semibold py-2 rounded-lg transition cursor-pointer text-sm">
                    Join Server
                  </button>
                </div>
              </div>
            </div>

            <!-- Loading state -->
            <div data-server-invite-preview-target="loading" class="hidden text-center py-4">
              <svg class="w-5 h-5 text-gray-400 animate-spin mx-auto" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
              </svg>
            </div>

            <!-- Error state -->
            <p data-server-invite-preview-target="error" class="hidden text-xs text-danger-light px-1"></p>
          </div>
        </div>

        <!-- ═══ Discover Servers ═══ -->
        <div>
          <div class="flex items-center gap-3 mb-3">
            <div class="flex-1 border-t border-gray-700/50"></div>
            <span class="text-[11px] text-gray-500 uppercase tracking-wide font-semibold">Discover</span>
            <div class="flex-1 border-t border-gray-700/50"></div>
          </div>

          <div data-controller="server-discover">
            <p class="text-[11px] text-gray-500 uppercase tracking-wide font-semibold mb-2">Servers on your relays</p>
            <div data-server-discover-target="list" class="space-y-1">
            </div>
          </div>
        </div>

        <!-- ═══ Create a Server ═══ -->
        <div>
          <div class="flex items-center gap-3 mb-3">
            <div class="flex-1 border-t border-gray-700/50"></div>
            <span class="text-[11px] text-gray-500 uppercase tracking-wide font-semibold">Or create your own</span>
            <div class="flex-1 border-t border-gray-700/50"></div>
          </div>

          <%= form_with model: Server.new, url: servers_path, html: { multipart: true }, class: "space-y-3", data: { controller: "server-icon-preview" } do |f| %>
            <input type="hidden" name="server[server_type]" value="community" id="server-type-input">

            <!-- Icon + Name -->
            <div class="flex items-start gap-3">
              <label class="w-14 h-14 shrink-0 rounded-xl bg-gray-900 border border-dashed border-gray-600 flex items-center justify-center cursor-pointer hover:border-accent/60 transition overflow-hidden group" data-server-icon-preview-target="iconLabel">
                <div class="flex flex-col items-center" data-server-icon-preview-target="iconPlaceholder">
                  <svg class="w-5 h-5 text-gray-500 group-hover:text-gray-400 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                </div>
                <img class="w-full h-full object-cover hidden" data-server-icon-preview-target="iconPreview">
                <%= f.file_field :icon, accept: "image/*", class: "hidden", data: { action: "change->server-icon-preview#previewIcon", server_icon_preview_target: "iconInput" } %>
              </label>
              <% emoji_server = current_user.servers.joins(:server_emojis).first %>
              <div class="flex-1 min-w-0 space-y-2" data-controller="emoji-input" <%= "data-emoji-input-server-id-value=#{emoji_server.public_id}" if emoji_server %>>
                <div class="flex items-center bg-gray-900 rounded-lg px-3 py-2.5 border border-gray-700/50 focus-within:border-accent/50 transition">
                  <div class="flex-1 relative">
                    <div data-emoji-input-target="highlight" class="absolute inset-0 text-sm text-white whitespace-pre break-words pointer-events-none overflow-hidden" aria-hidden="true"></div>
                    <%= f.text_field :name, class: "w-full bg-transparent text-transparent caret-white placeholder-gray-500 focus:outline-none text-sm relative z-10", placeholder: "Server name", data: { emoji_input_target: "input", action: "input->emoji-input#handleInput keydown->emoji-input#handleKeydown" } %>
                  </div>
                  <button type="button" class="text-gray-500 hover:text-gray-300 ml-1.5 shrink-0 cursor-pointer transition" data-action="click->emoji-input#toggle" data-emoji-input-target="button" title="Add emoji">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  </button>
                </div>
                <%= f.text_area :description, rows: 2, class: "w-full bg-gray-900 text-white text-sm rounded-lg px-3 py-2.5 outline-none border border-gray-700/50 focus:border-accent/50 placeholder-gray-500 resize-none transition", placeholder: "Description (optional)" %>
              </div>
            </div>

            <!-- Server type -->
            <div>
              <p class="text-[11px] text-gray-500 uppercase tracking-wide font-semibold mb-2">Server type</p>
              <div class="grid grid-cols-2 gap-1.5" id="server-type-cards">
                <button type="button" data-type="community" class="server-type-card selected flex items-center gap-2 p-2 rounded-lg border border-accent/60 bg-accent/10 cursor-pointer transition text-left">
                  <svg class="w-4 h-4 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                  <span class="text-xs font-medium text-white">Community</span>
                </button>
                <button type="button" data-type="friends_family" class="server-type-card flex items-center gap-2 p-2 rounded-lg border border-gray-700/50 hover:border-gray-600 cursor-pointer transition text-left">
                  <svg class="w-4 h-4 text-green-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
                  <span class="text-xs font-medium text-gray-300">Friends</span>
                </button>
                <button type="button" data-type="gaming" class="server-type-card flex items-center gap-2 p-2 rounded-lg border border-gray-700/50 hover:border-gray-600 cursor-pointer transition text-left">
                  <svg class="w-4 h-4 text-purple-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  <span class="text-xs font-medium text-gray-300">Gaming</span>
                </button>
                <button type="button" data-type="work_team" class="server-type-card flex items-center gap-2 p-2 rounded-lg border border-gray-700/50 hover:border-gray-600 cursor-pointer transition text-left">
                  <svg class="w-4 h-4 text-blue-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                  <span class="text-xs font-medium text-gray-300">Work</span>
                </button>
                <button type="button" data-type="adult" class="server-type-card col-span-2 flex items-center gap-2 p-2 rounded-lg border border-gray-700/50 hover:border-gray-600 cursor-pointer transition text-left">
                  <svg class="w-4 h-4 text-red-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                  <span class="text-xs font-medium text-gray-300">18+ Community</span>
                </button>
              </div>
            </div>

            <%= f.submit "Create Server", class: "w-full bg-accent hover:bg-accent-light text-white font-semibold py-2.5 rounded-lg transition cursor-pointer text-sm" %>
          <% end %>

          <script>
            document.getElementById("server-type-cards")?.addEventListener("click", (e) => {
              const card = e.target.closest(".server-type-card")
              if (!card) return
              document.querySelectorAll(".server-type-card").forEach(c => {
                c.classList.remove("selected", "border-accent/60", "bg-accent/10")
                c.classList.add("border-gray-700/50")
                c.querySelector("span").classList.remove("text-white")
                c.querySelector("span").classList.add("text-gray-300")
              })
              card.classList.add("selected", "border-accent/60", "bg-accent/10")
              card.classList.remove("border-gray-700/50")
              card.querySelector("span").classList.remove("text-gray-300")
              card.querySelector("span").classList.add("text-white")
              document.getElementById("server-type-input").value = card.dataset.type
            })
          </script>
        </div>
      </div>
    </div>
  </div>
</div>
