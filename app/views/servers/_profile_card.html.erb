<div class="w-72 rounded-lg shadow-2xl border border-gray-700 overflow-hidden">
  <div class="h-[80px] relative">
    <% if member.banner.attached? %>
      <%= image_tag member.banner, class: "w-full h-full object-cover",
          style: "object-position: center #{(member.banner_offset_y || 0)}px;" %>
    <% else %>
      <div class="w-full h-full bg-gray-700"></div>
    <% end %>
  </div>
  <div class="relative px-3 pb-3 pt-1" style="<%= profile_card_bg_style(member) %>">
    <div class="relative -mt-[35px] mb-2">
      <div class="w-[66px] h-[66px] rounded-full p-[5px] inline-block"
           style="background: <%= member.profile_color_2.presence || member.profile_color || '#2b2d31' %>">
        <% if member.avatar.attached? %>
          <%= image_tag member.avatar, class: "w-full h-full rounded-full object-cover" %>
        <% else %>
          <div class="w-full h-full rounded-full flex items-center justify-center text-xl font-bold text-white"
               style="background-color: <%= member.profile_color || '#2b2d31' %>">
            <%= member.username[0].upcase %>
          </div>
        <% end %>
      </div>
      <% status_color = case member.online_state
                        when "online" then "bg-green-500"
                        when "idle" then "bg-yellow-500"
                        when "dnd" then "bg-red-500"
                        else "bg-gray-500"
                        end %>
      <div class="absolute bottom-[2px] left-[46px] w-[18px] h-[18px] rounded-full border-[4px] <%= status_color %>"
           style="border-color: <%= member.profile_color_2.presence || member.profile_color || '#2b2d31' %>"></div>
    </div>
    <div class="bg-black/30 rounded-lg p-3 space-y-2">
      <div>
        <h3 class="text-base font-bold text-white leading-tight"><%= member.display_name_for(server) %></h3>
        <p class="text-xs text-white/60"><%= member.tag %></p>
        <% if member.remote? %>
          <p class="text-[10px] text-indigo-400 flex items-center gap-1">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <%= member.home_instance_domain %>
          </p>
        <% end %>
      </div>
      <% if member.status.present? %>
        <p class="text-xs text-white/70"><%= member.status_emoji %> <%= member.status %></p>
      <% end %>
      <% if member.bio.present? %>
        <div class="border-t border-white/10 pt-2">
          <h4 class="text-[10px] font-semibold text-white/50 uppercase mb-0.5">About Me</h4>
          <p class="text-xs text-white/80"><%= member.bio %></p>
        </div>
      <% end %>
      <% membership = server.server_memberships.find_by(user: member) %>
      <% visible_roles = membership&.roles&.where&.not(name: "@everyone")&.ordered || [] %>
      <% if visible_roles.any? %>
        <div class="border-t border-white/10 pt-2">
          <h4 class="text-[10px] font-semibold text-white/50 uppercase mb-1">Roles</h4>
          <div class="flex flex-wrap gap-1">
            <% visible_roles.each do |role| %>
              <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[11px] font-medium bg-black/30 text-white/80 border border-white/10">
                <span class="w-2 h-2 rounded-full mr-1" style="background-color: <%= role.color || '#ffffff' %>"></span>
                <%= role.name %>
              </span>
            <% end %>
          </div>
        </div>
      <% end %>
      <div class="border-t border-white/10 pt-2">
        <h4 class="text-[10px] font-semibold text-white/50 uppercase mb-0.5">Member Since</h4>
        <p class="text-[11px] text-white/50"><%= membership&.joined_at&.strftime("%b %d, %Y") || "Unknown" %></p>
      </div>
    </div>
  </div>
</div>
