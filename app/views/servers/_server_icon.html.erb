<% mention_count = current_user.notifications.unread.for_server(server.id).count %>
<% has_unread = server.channels.any? { |ch| ch.unread_for?(current_user) } %>
<% is_gif = server.icon.attached? && server.icon.content_type == "image/gif" %>
<% icon_classes = "relative w-12 h-12 rounded-2xl overflow-hidden transition-all duration-200 flex items-center justify-center #{active ? 'bg-orange-600 rounded-xl' : 'bg-gray-700 hover:bg-orange-600 hover:rounded-xl'}#{ ' server-icon-gif' if is_gif}" %>
<div class="server-icon-wrap relative flex items-center justify-center">
  <% if active %>
  <div class="<%= icon_classes %>" title="<%= server.name %> — <%= Rails.application.config.x.instance_domain %>">
  <% else %>
  <a href="<%= server_channel_path(server, server.channels.ordered.first) %>" class="<%= icon_classes %>" title="<%= server.name %> — <%= Rails.application.config.x.instance_domain %>">
  <% end %>
    <% if server.icon.attached? %>
      <% if is_gif %>
        <canvas class="gif-static w-full h-full object-cover absolute inset-0" data-gif-freeze></canvas>
        <%= image_tag server.icon, class: 'gif-animated w-full h-full object-cover absolute inset-0', data: { gif_src: true } %>
      <% else %>
        <%= image_tag server.icon, class: 'w-full h-full object-cover' %>
      <% end %>
    <% else %>
      <span class="text-white font-semibold text-sm"><%= server.name.split.map(&:first).join[0..1].upcase %></span>
    <% end %>
  <% if active %></div><% else %></a><% end %>
  <% if active %>
    <div class="active-server-pill absolute -left-[10px] top-1/2 -translate-y-1/2 w-[3px] h-10 bg-amber-300 rounded-r-full"></div>
  <% elsif has_unread && mention_count == 0 %>
    <div class="server-unread-pill absolute -left-[10px] top-1/2 -translate-y-1/2 w-[3px] h-2 bg-amber-300 rounded-r-full"></div>
  <% end %>
  <% if mention_count > 0 %>
    <div class="mention-badge absolute -bottom-0.5 -right-0.5 min-w-[18px] h-[18px] bg-red-500 rounded-full flex items-center justify-center text-white text-xs font-bold px-1 border-2 border-gray-950 z-10">
      <%= mention_count > 99 ? '99+' : mention_count %>
    </div>
  <% end %>
</div>
