<div class="flex items-center justify-center min-h-screen" style="background: #0e0d0c;">
  <div class="w-full max-w-lg mx-4">
    <!-- Header -->
    <div class="text-center mb-8">
      <h1 class="text-2xl font-bold text-white">Create a Server</h1>
      <p class="text-gray-500 text-sm mt-1">Give your server a name and personality</p>
    </div>

    <!-- Form card -->
    <div class="bg-gray-800 rounded-xl border border-gray-700/50 shadow-2xl overflow-hidden">
      <%= form_with model: @server, url: servers_path, html: { multipart: true }, class: "divide-y divide-gray-700/50", data: { controller: "server-icon-preview" } do |f| %>
        <% if current_user.nostr_public_key.present? %>
          <div class="p-6">
            <label class="block text-[11px] font-semibold text-gray-500 uppercase tracking-wider mb-2">Instance</label>
            <select name="instance_url" class="w-full bg-gray-900 border border-gray-700/50 rounded-lg px-3.5 py-2.5 text-white text-sm focus:outline-none focus:border-accent/50 focus:ring-1 focus:ring-accent/20 transition">
              <option value="local">This instance (<%= Rails.application.config.x.instance_domain %>)</option>
              <% RelayConnection.active.each do |relay| %>
                <% begin %>
                  <% relay_host = URI.parse(relay.url.gsub(/^wss?:\/\//, "https://")).host %>
                  <option value="https://<%= relay_host %>"><%= relay_host %></option>
                <% rescue URI::InvalidURIError %>
                <% end %>
              <% end %>
            </select>
            <p class="text-[11px] text-gray-600 mt-1.5">Choose which instance will host this server</p>
          </div>
        <% end %>

        <!-- Identity: Icon + Name -->
        <div class="p-6 space-y-5">
          <div class="flex gap-5">
            <div class="shrink-0">
              <label class="block text-[11px] font-semibold text-gray-500 uppercase tracking-wider mb-2">Icon</label>
              <label class="block w-20 h-20 rounded-2xl bg-gray-900 border-2 border-dashed border-gray-700 hover:border-gray-500 flex items-center justify-center cursor-pointer overflow-hidden transition group" data-server-icon-preview-target="iconLabel">
                <div class="flex flex-col items-center" data-server-icon-preview-target="iconPlaceholder">
                  <svg class="w-6 h-6 text-gray-500 group-hover:text-gray-400 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                </div>
                <img class="w-full h-full object-cover hidden" data-server-icon-preview-target="iconPreview">
                <%= f.file_field :icon, accept: "image/*", class: "hidden", data: { action: "change->server-icon-preview#previewIcon", server_icon_preview_target: "iconInput" } %>
              </label>
            </div>
            <div class="flex-1 min-w-0">
              <div data-controller="emoji-input">
                <label class="block text-[11px] font-semibold text-gray-500 uppercase tracking-wider mb-2">Server Name</label>
                <div class="flex items-center bg-gray-900 border border-gray-700/50 rounded-lg px-3.5 py-2.5 focus-within:border-accent/50 focus-within:ring-1 focus-within:ring-accent/20 transition">
                  <div class="flex-1 relative">
                    <div data-emoji-input-target="highlight" class="absolute inset-0 text-sm text-white whitespace-pre break-words pointer-events-none overflow-hidden" aria-hidden="true"></div>
                    <%= f.text_field :name, class: "w-full bg-transparent text-transparent caret-white placeholder-gray-600 focus:outline-none text-sm relative z-10", placeholder: "My Awesome Server", data: { emoji_input_target: "input", action: "input->emoji-input#handleInput keydown->emoji-input#handleKeydown" } %>
                  </div>
                  <button type="button" class="text-gray-500 hover:text-gray-300 ml-1.5 shrink-0 cursor-pointer transition" data-action="click->emoji-input#toggle" data-emoji-input-target="button" title="Add emoji">
                    <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  </button>
                </div>
              </div>
            </div>
          </div>

          <div>
            <label class="block text-[11px] font-semibold text-gray-500 uppercase tracking-wider mb-2">Description <span class="text-gray-600 normal-case tracking-normal font-normal">— optional</span></label>
            <%= f.text_area :description, rows: 3, class: "w-full bg-gray-900 border border-gray-700/50 rounded-lg px-3.5 py-2.5 text-white placeholder-gray-600 focus:outline-none focus:border-accent/50 focus:ring-1 focus:ring-accent/20 text-sm resize-none transition", placeholder: "What's this server about?" %>
          </div>
        </div>

        <!-- Banner -->
        <div class="p-6">
          <label class="block text-[11px] font-semibold text-gray-500 uppercase tracking-wider mb-2">Banner <span class="text-gray-600 normal-case tracking-normal font-normal">— optional</span></label>
          <label class="block w-full h-28 rounded-lg bg-gray-900 border-2 border-dashed border-gray-700 hover:border-gray-500 flex items-center justify-center cursor-pointer overflow-hidden transition group" data-server-icon-preview-target="bannerLabel">
            <div class="flex flex-col items-center gap-1.5" data-server-icon-preview-target="bannerPlaceholder">
              <svg class="w-6 h-6 text-gray-500 group-hover:text-gray-400 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/></svg>
              <span class="text-xs text-gray-500 group-hover:text-gray-400 transition">Click to upload a banner</span>
            </div>
            <img class="w-full h-full object-cover hidden" data-server-icon-preview-target="bannerPreview">
            <%= f.file_field :banner, accept: "image/*", class: "hidden", data: { action: "change->server-icon-preview#previewBanner", server_icon_preview_target: "bannerInput" } %>
          </label>
        </div>

        <div class="p-6 bg-gray-800/50">
          <%= f.submit "Create Server", class: "w-full bg-confirm hover:bg-confirm-light text-white font-semibold py-2.5 rounded-lg transition cursor-pointer text-sm" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
