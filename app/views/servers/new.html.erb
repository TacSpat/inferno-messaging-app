<div class="flex items-center justify-center min-h-screen bg-gray-700">
  <div class="w-full max-w-md bg-gray-800 rounded-lg shadow-xl p-8">
    <div class="text-center mb-6">
      <h1 class="text-2xl font-bold text-white">Create Your Server</h1>
      <p class="text-gray-400 mt-1">Give your server a name and personality</p>
    </div>

    <%= form_with model: @server, url: servers_path, class: "space-y-4" do |f| %>
      <div>
        <%= f.label :name, "Server Name", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
        <%= f.text_field :name, class: "w-full bg-gray-900 border border-gray-700 rounded px-3 py-2 text-white placeholder-gray-500 focus:outline-none focus:border-orange-500 text-sm", placeholder: "My Awesome Server" %>
      </div>

      <div>
        <%= f.label :description, class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
        <%= f.text_area :description, rows: 3, class: "w-full bg-gray-900 border border-gray-700 rounded px-3 py-2 text-white placeholder-gray-500 focus:outline-none focus:border-orange-500 text-sm resize-none", placeholder: "What's this server about?" %>
      </div>

      <div>
        <%= f.submit "Create Server", class: "w-full bg-orange-600 hover:bg-orange-700 text-white font-semibold py-2.5 rounded transition cursor-pointer text-sm" %>
      </div>
    <% end %>
  </div>
</div>
