<% if defined?(@members) && @members %>
  <aside id="member-sidebar" data-mobile-nav-target="memberSidebar" data-panel-hidden="true" style="display:none" class="w-60 bg-gray-800 shrink-0 flex flex-col mobile-member-sidebar"
         data-controller="server-members profile-card member-context"
         data-server-members-server-id-value="<%= @server.public_id %>" data-profile-card-server-id-value="<%= @server.public_id %>" data-member-context-server-id-value="<%= @server.public_id %>">
    <%
      online_members = @members.reject { |m| m.offline? || m.invisible? }
      offline_members = @members.select { |m| m.offline? || m.invisible? }
      hoisted_roles = @server.roles.where(hoist: true).where.not(name: ["@everyone", "New Role"]).where("json_extract(permissions, '$.owner') IS NOT TRUE").ordered.to_a
      everyone_role = @server.roles.find_by(name: "@everyone")
      everyone_position = everyone_role&.position || 0
      role_groups = {}
      ungrouped_online = []
      online_members.each do |member|
        membership = member.server_memberships.find { |sm| sm.server_id == @server.id }
        hoisted = membership&.top_hoisted_role
        if hoisted
          (role_groups[hoisted.id] ||= []) << member
        else
          ungrouped_online << member
        end
      end
      sort_fn = ->(m) {
        ms = m.server_memberships.find { |sm| sm.server_id == @server.id }
        [-(ms&.top_role&.position || 0), m.display_name_for(@server).downcase]
      }
      role_groups.each_value { |list| list.sort_by!(&sort_fn) }
      ungrouped_online.sort_by!(&sort_fn)
      offline_members.sort_by!(&sort_fn)
      sections = []
      hoisted_roles.each do |role|
        group_members = role_groups[role.id]
        next unless group_members&.any?
        sections << { type: :role, role: role, members: group_members, position: role.position }
      end
      if ungrouped_online.any?
        sections << { type: :online, members: ungrouped_online, position: everyone_position }
      end
      sections.sort_by! { |s| -s[:position] }
    %>
    <div class="py-4 px-2 flex-1 overflow-y-auto border-l border-gray-900" data-server-members-target="list">
      <% sections.each do |section| %>
        <% if section[:type] == :role %>
          <h3 class="text-xs font-semibold uppercase tracking-wide mb-1 mt-4 first:mt-0 px-2"
              style="color: <%= section[:role].color.presence || '#878583' %>"
              data-status-group="role:<%= section[:role].public_id %>"
              data-role-position="<%= section[:role].position %>">
            <%= section[:role].name %> — <%= section[:members].count %>
          </h3>
          <% section[:members].each do |member| %>
            <%= render partial: "servers/member_item", locals: { member: member, server: @server } %>
          <% end %>
        <% else %>
          <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1 mt-4 first:mt-0 px-2"
              data-status-group="online"
              data-role-position="<%= everyone_position %>">
            Online — <%= section[:members].count %>
          </h3>
          <% section[:members].each do |member| %>
            <%= render partial: "servers/member_item", locals: { member: member, server: @server } %>
          <% end %>
        <% end %>
      <% end %>
      <% if offline_members.any? %>
        <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1 mt-4 px-2"
            data-status-group="offline">
          Offline — <%= offline_members.count %>
        </h3>
        <% offline_members.each do |member| %>
          <%= render partial: "servers/member_item", locals: { member: member, server: @server } %>
        <% end %>
      <% end %>
    </div>
  </aside>
<% end %>
