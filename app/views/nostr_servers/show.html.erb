<% content_for :head do %>
  <meta property="og:title" content="Join <%= @server_name %> on Inferno">
  <meta property="og:description" content="<%= @server_description.presence || "#{@member_count} members" %>">
  <% if @local_server&.icon&.attached? %>
    <meta property="og:image" content="<%= rails_blob_url(@local_server.icon) %>">
  <% elsif @nostr_info && @nostr_info[:picture_url].present? %>
    <meta property="og:image" content="<%= @nostr_info[:picture_url] %>">
  <% end %>
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= request.original_url %>">
  <meta property="og:site_name" content="Inferno · <%= @instance_domain %>">
  <meta name="twitter:card" content="summary">
<% end %>

<div class="flex items-center justify-center min-h-screen bg-gray-900 px-4">
  <div class="w-full max-w-sm">
    <!-- Server card -->
    <div class="bg-gray-800 rounded-lg shadow-xl overflow-hidden">
      <!-- Banner -->
      <div class="relative h-32 bg-gradient-to-br from-accent-dark/60 to-gray-800">
        <% if @local_server&.respond_to?(:banner) && @local_server&.banner&.attached? && @local_server.banner.blob&.persisted? %>
          <%= image_tag @local_server.banner, class: "w-full h-full object-cover" %>
        <% elsif @nostr_info && @nostr_info[:banner_url].present? %>
          <img src="<%= @nostr_info[:banner_url] %>" class="w-full h-full object-cover" />
        <% end %>
      </div>

      <!-- Content -->
      <div class="relative px-6 pb-6">
        <!-- Server icon overlapping banner -->
        <div class="-mt-10 mb-3">
          <% if @local_server&.icon&.attached? && @local_server.icon.blob&.persisted? %>
            <%= image_tag @local_server.icon, class: "w-20 h-20 rounded-2xl object-cover border-4 border-gray-800 bg-gray-700" %>
          <% elsif @nostr_info && @nostr_info[:picture_url].present? %>
            <img src="<%= @nostr_info[:picture_url] %>" class="w-20 h-20 rounded-2xl object-cover border-4 border-gray-800 bg-gray-700" />
          <% else %>
            <div class="w-20 h-20 rounded-2xl bg-gray-700 border-4 border-gray-800 flex items-center justify-center text-3xl font-bold text-white">
              <%= @server_name[0].upcase %>
            </div>
          <% end %>
        </div>

        <p class="text-xs text-gray-400 mb-0.5">Join server via Nostr</p>
        <h1 class="text-xl font-bold text-white mb-1"><%= @server_name %></h1>

        <% if @server_description.present? %>
          <p class="text-sm text-gray-400 mb-3 line-clamp-2"><%= @server_description %></p>
        <% end %>

        <!-- Member counts -->
        <div class="flex items-center gap-4 mb-2 text-xs">
          <% if @local_server %>
            <div class="flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-green-500"></span>
              <span class="text-gray-300"><%= @online_count %> Online</span>
            </div>
          <% end %>
          <div class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-gray-500"></span>
            <span class="text-gray-300"><%= @member_count %> Members</span>
          </div>
        </div>

        <p class="text-xs text-gray-500 mb-5">Inferno · <%= @instance_domain %></p>

        <% if @already_member %>
          <%= link_to "Open #{@server_name}",
                server_channel_path(@local_server, @local_server.channels.ordered.first),
                class: "block w-full text-center bg-gradient-to-r from-confirm-dark to-confirm hover:from-confirm hover:to-confirm-light text-white font-semibold py-2.5 rounded transition text-sm" %>
        <% elsif user_signed_in? %>
          <%= button_to "Join Server",
                join_nostr_server_path(@nostr_group_id),
                method: :post,
                class: "w-full bg-gradient-to-r from-confirm-dark to-confirm hover:from-confirm hover:to-confirm-light text-white font-semibold py-2.5 rounded transition cursor-pointer text-sm" %>
        <% else %>
          <div class="space-y-3">
            <%= button_to "Join Server",
                  join_nostr_server_path(@nostr_group_id),
                  method: :post,
                  class: "w-full bg-gradient-to-r from-confirm-dark to-confirm hover:from-confirm hover:to-confirm-light text-white font-semibold py-2.5 rounded transition cursor-pointer text-sm" %>
            <p class="text-xs text-gray-500 text-center">
              Already have an account?
              <%= link_to "Log in", new_user_session_path, class: "text-accent-light hover:text-accent" %>
            </p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
