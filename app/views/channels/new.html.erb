<div class="flex items-center justify-center min-h-screen bg-gray-900">
  <div class="w-full max-w-md bg-gray-800 rounded-lg shadow-xl p-8">
    <h1 class="text-xl font-bold text-white mb-1">Create Channel</h1>
    <p class="text-sm text-gray-400 mb-6">in <%= @server.name %></p>

    <%= form_with model: [@server, @channel], class: "space-y-4" do |f| %>
      <div>
        <label class="block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1">Channel Type</label>
        <%= f.select :channel_type, Channel.channel_types.keys.map { |t| [t.capitalize, t] }, {}, class: "w-full bg-gray-900 border border-gray-700 rounded px-3 py-2 text-white focus:outline-none focus:border-orange-500 text-sm" %>
      <div>
        <label class="block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1">Category</label>
        <%= f.collection_select :category_id, @server.categories.ordered, :id, :name, { include_blank: "No Category" }, class: "w-full bg-gray-900 border border-gray-700 rounded px-3 py-2 text-white focus:outline-none focus:border-orange-500 text-sm" %>
      </div>

      <div>
        <%= f.label :name, "Channel Name", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
        <div class="flex items-center bg-gray-900 border border-gray-700 rounded px-3 py-2">
          <span class="text-gray-500 mr-1">#</span>
          <%= f.text_field :name, class: "flex-1 bg-transparent text-white focus:outline-none text-sm", placeholder: "new-channel" %>
        </div>
      </div>

      <div>
        <%= f.label :topic, class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
        <%= f.text_field :topic, class: "w-full bg-gray-900 border border-gray-700 rounded px-3 py-2 text-white focus:outline-none focus:border-orange-500 text-sm", placeholder: "What's this channel about?" %>
      </div>

      <div class="flex items-center gap-3 pt-2">
        <%= link_to "Cancel", server_channel_path(@server, @server.channels.ordered.first), class: "text-sm text-gray-400 hover:text-gray-200" %>
        <%= f.submit "Create Channel", class: "bg-orange-600 hover:bg-orange-700 text-white font-semibold px-6 py-2 rounded transition cursor-pointer text-sm" %>
      </div>
    <% end %>
  </div>
</div>
