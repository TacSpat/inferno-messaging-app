<%= turbo_frame_tag "main-content", class: "flex flex-col flex-1 min-h-0", data: { turbo_action: "advance" } do %>
<div class="flex flex-col flex-1 min-h-0" data-current-channel-id="<%= @channel.public_id %>" data-current-server-id="<%= @server.public_id %>">

  <!-- Channel header -->
  <div class="flex items-center px-4 h-12 border-b border-gray-900 shadow-sm shrink-0">
    <!-- Hamburger menu (mobile only) -->
    <button type="button" class="md:hidden text-gray-400 hover:text-white mr-2 p-1" data-action="click->mobile-nav#toggleSidebar">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>

    <svg class="w-5 h-5 text-gray-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072M12 6v12m-3.536-2.464a5 5 0 010-7.072M18.364 5.636a9 9 0 010 12.728M5.636 18.364a9 9 0 010-12.728"/></svg>
    <h1 class="font-semibold text-white"><%= render_name_with_emojis(@channel.name, @server) %></h1>
    <% if @channel.topic.present? %>
      <div class="mx-4 w-px h-6 bg-gray-600 hidden sm:block"></div>
      <p class="text-sm text-gray-400 truncate hidden sm:block"><%= @channel.topic %></p>
    <% end %>

    <div class="flex-1"></div>

    <% if @channel.voice_user_limit > 0 %>
      <span class="text-xs text-gray-500 mr-2"><%= @voice_states.count + @remote_voice_states.size %>/<%= @channel.voice_user_limit %></span>
    <% end %>
  </div>

  <!-- Voice channel content -->
  <div class="flex-1 flex flex-col min-h-0" style="background: #0a0a09;" data-voice-content
       data-controller="voice-context" data-voice-context-server-id-value="<%= @server.public_id %>">
    <% if !@voice_configured %>
      <!-- No voice providers available -->
      <div class="flex-1 flex items-center justify-center p-4">
        <div class="text-center max-w-sm">
          <div class="w-24 h-24 rounded-full flex items-center justify-center mx-auto mb-6" style="background: rgba(255,255,255,0.05);">
            <svg class="w-12 h-12 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/></svg>
          </div>
          <h2 class="text-xl font-bold text-white mb-2">Voice Not Available</h2>
          <p class="text-gray-400 text-sm mb-4">Voice channels need at least one voice provider. Members can volunteer their LiveKit credentials in server settings.</p>
          <% membership = current_user.server_memberships.find_by(server: @server) %>
          <% if membership&.has_permission?("manage_server") || membership&.admin? %>
            <a href="<%= server_settings_voice_path(@server) %>"
               class="px-4 py-2 bg-accent hover:bg-accent-light text-white rounded text-sm font-medium cursor-pointer transition inline-block">
              Voice Settings
            </a>
          <% else %>
            <p class="text-gray-500 text-xs">Ask a server admin to set up voice in Server Settings > Voice.</p>
          <% end %>
        </div>
      </div>
    <% elsif @voice_states.any? || @remote_voice_states.any? %>
      <!-- Participant grid -->
      <div class="flex-1 p-3 overflow-y-auto" data-voice-participant-grid>
        <div class="voice-grid h-full">
          <% @voice_states.each do |vs| %>
            <div class="voice-card group"
                 data-voice-participant-id="<%= vs.user.public_id %>"
                 data-voice-state-id="<%= vs.public_id %>"
                 data-action="contextmenu->voice-context#show"
                 style="--card-color: <%= vs.user.profile_color || '#1e1c1b' %>">
              <div class="voice-card-inner">
                <!-- Avatar -->
                <div class="voice-avatar-wrapper">
                  <% if vs.user.effective_avatar_url.present? %>
                    <img src="<%= vs.user.effective_avatar_url %>" class="voice-avatar">
                  <% else %>
                    <div class="voice-avatar-fallback" style="background-color: color-mix(in srgb, <%= vs.user.profile_color || '#1e1c1b' %>, white 20%)">
                      <%= vs.user.username[0].upcase %>
                    </div>
                  <% end %>
                </div>
                <!-- Status icons on avatar -->
                <% if vs.self_mute || vs.self_deaf || vs.server_mute || vs.server_deaf %>
                  <div class="voice-status-icons">
                    <% if vs.server_mute %>
                      <div class="voice-status-badge server-muted">
                        <svg class="w-3.5 h-3.5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/><line x1="3" y1="3" x2="21" y2="21" stroke-width="2.5" stroke-linecap="round"/></svg>
                      </div>
                    <% elsif vs.self_mute %>
                      <div class="voice-status-badge">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/><line x1="3" y1="3" x2="21" y2="21" stroke-width="2.5" stroke-linecap="round"/></svg>
                      </div>
                    <% end %>
                    <% if vs.server_deaf %>
                      <div class="voice-status-badge server-deafened">
                        <svg class="w-3.5 h-3.5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"/></svg>
                      </div>
                    <% elsif vs.self_deaf %>
                      <div class="voice-status-badge">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"/></svg>
                      </div>
                    <% end %>
                  </div>
                <% end %>
                <!-- Username pill -->
                <div class="voice-username-pill">
                  <span class="truncate"><%= vs.user.display_name.presence || vs.user.username %></span>
                </div>
              </div>
            </div>
          <% end %>
          <% @remote_voice_states.each do |rvs| %>
            <div class="voice-card group"
                 data-voice-participant-id="<%= rvs[:user_id] %>"
                 data-voice-remote="true"
                 data-action="contextmenu->voice-context#show"
                 style="--card-color: <%= rvs[:profile_color] || '#1e1c1b' %>">
              <div class="voice-card-inner">
                <div class="voice-avatar-wrapper">
                  <% if rvs[:avatar_url].present? %>
                    <img src="<%= rvs[:avatar_url] %>" class="voice-avatar">
                  <% else %>
                    <div class="voice-avatar-fallback" style="background-color: color-mix(in srgb, <%= rvs[:profile_color] || '#1e1c1b' %>, white 20%)">
                      <%= (rvs[:username] || "?")[0].upcase %>
                    </div>
                  <% end %>
                </div>
                <div class="voice-username-pill">
                  <span class="truncate"><%= rvs[:username] || "Remote User" %></span>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% else %>
      <!-- Empty state -->
      <div class="flex-1 flex flex-col items-center justify-center p-8" data-voice-empty-state>
        <div class="w-24 h-24 rounded-full flex items-center justify-center mx-auto mb-6" style="background: rgba(255,255,255,0.05);">
          <svg class="w-12 h-12 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.536 8.464a5 5 0 010 7.072M12 6v12m-3.536-2.464a5 5 0 010-7.072M18.364 5.636a9 9 0 010 12.728M5.636 18.364a9 9 0 010-12.728"/></svg>
        </div>
        <h2 class="text-xl font-bold text-white mb-1" data-slot="channel-name"><%= render_name_with_emojis(@channel.name, @server) %></h2>
        <p class="text-gray-500 text-sm">No one is in this channel yet.</p>
      </div>
    <% end %>

    <% if @channel.child_channels.any? %>
      <!-- Monitor panel for hearth channels with embers -->
      <div class="shrink-0 border-t border-gray-800" style="background: #0e0d0c;" data-voice-monitor-panel data-voice-monitor-server="<%= @server.public_id %>">
        <button type="button" class="w-full px-4 py-2 flex items-center justify-between text-sm text-gray-400 hover:text-gray-200"
                onclick="this.nextElementSibling.classList.toggle('hidden'); this.querySelector('svg').classList.toggle('rotate-180')">
          <span class="font-medium">Monitor</span>
          <svg class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </button>
        <div class="hidden px-4 pb-3 space-y-2">
          <% @channel.child_channels.ordered.each do |child| %>
            <div class="flex items-center gap-3 py-1.5 px-2 rounded bg-gray-800/50" data-monitor-child="<%= child.public_id %>">
              <label class="flex items-center gap-2 cursor-pointer flex-1 min-w-0">
                <input type="checkbox" class="w-3.5 h-3.5 rounded bg-gray-900 border-gray-600 text-accent focus:ring-accent focus:ring-offset-0 cursor-pointer"
                       data-action="change->voice-channel#toggleMonitor"
                       data-monitor-channel-id="<%= child.public_id %>">
                <span class="text-sm text-gray-300 truncate"><%= render_name_with_emojis(child.name, @server) %></span>
              </label>
              <span class="text-xs text-gray-500 shrink-0"><%= child.voice_states.count %> users</span>
              <button type="button" class="shrink-0 p-1 rounded hover:bg-gray-700 text-gray-500 hover:text-green-400 transition cursor-pointer" title="Showcase ember"
                      data-action="click->voice-channel#showcaseChannel"
                      data-showcase-channel-id="<%= child.public_id %>">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"/></svg>
              </button>
              <input type="range" min="0" max="100" value="80" class="w-20 h-1 accent-accent cursor-pointer"
                     data-action="input->voice-channel#setMonitorVolume"
                     data-monitor-volume-channel="<%= child.public_id %>">
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Join / Connected bar -->
    <div class="shrink-0 px-4 py-3 flex items-center justify-center" style="background: #0e0d0c;"
         data-voice-panel-status data-voice-panel-channel="<%= @channel.public_id %>" data-voice-panel-server="<%= @server.public_id %>">
      <% current_voice_state = VoiceState.find_by(user: current_user, channel: @channel) %>
      <% if current_voice_state %>
        <div class="flex items-center gap-2" data-voice-status="connected">
          <div class="w-2 h-2 rounded-full bg-green-400"></div>
          <p class="text-green-400 text-sm font-medium">Voice Connected</p>
        </div>
      <% else %>
        <button type="button"
                class="px-6 py-2.5 bg-green-600 hover:bg-green-500 text-white font-semibold rounded-full transition flex items-center gap-2 cursor-pointer text-sm"
                data-voice-status="join"
                onclick="window.dispatchEvent(new CustomEvent('voice:join', { detail: { channelId: '<%= @channel.public_id %>', serverId: '<%= @server.public_id %>' } }))">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072M12 6v12m-3.536-2.464a5 5 0 010-7.072"/></svg>
          Join Voice
        </button>
      <% end %>
    </div>
  </div>
</div>
<% end %>
