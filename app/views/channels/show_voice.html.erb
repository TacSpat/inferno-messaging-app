<%= turbo_frame_tag "main-content", class: "flex flex-col flex-1 min-h-0", data: { turbo_action: "advance" } do %>
<div class="flex flex-col flex-1 min-h-0" data-controller="voice-context" data-voice-context-server-id-value="<%= @server.public_id %>" data-current-channel-id="<%= @channel.public_id %>" data-current-server-id="<%= @server.public_id %>">

  <!-- Channel header -->
  <div class="flex items-center px-4 h-12 border-b border-gray-900 shadow-sm shrink-0">
    <button type="button" class="md:hidden text-gray-400 hover:text-white mr-2 p-1" data-action="click->mobile-nav#toggleSidebar">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>

    <svg class="w-5 h-5 text-gray-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072M12 6v12m-3.536-2.464a5 5 0 010-7.072M18.364 5.636a9 9 0 010 12.728M5.636 18.364a9 9 0 010-12.728"/></svg>
    <h1 class="font-semibold text-white"><%= @channel.name %></h1>
    <% if @channel.topic.present? %>
      <div class="mx-4 w-px h-6 bg-gray-600 hidden sm:block"></div>
      <p class="text-sm text-gray-400 truncate hidden sm:block"><%= @channel.topic %></p>
    <% end %>

    <div class="flex-1"></div>

    <% if @channel.voice_user_limit > 0 %>
      <span class="text-xs text-gray-500 mr-2"><%= @voice_states.size %>/<%= @channel.voice_user_limit %></span>
    <% end %>

    <%= render "shared/header_toolbar" %>

    <button type="button" class="lg:hidden text-gray-400 hover:text-white p-1" data-action="click->mobile-nav#toggleMembers">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"/></svg>
    </button>
  </div>

  <!-- Voice channel content -->
  <div class="flex-1 flex flex-col min-h-0" style="background: #0a0a09;">
    <% if @voice_states.any? %>
      <!-- Participant grid — fills available space -->
      <div class="flex-1 p-3 overflow-y-auto" data-voice-participant-grid>
        <div class="voice-grid h-full">
          <% @voice_states.each do |vs| %>
            <div class="voice-card group"
                 data-voice-participant-id="<%= vs.user.public_id %>"
                 data-voice-state-id="<%= vs.public_id %>"
                 data-action="contextmenu->voice-context#show"
                 style="--card-color: <%= vs.user.profile_color || '#1e1c1b' %>">
              <div class="voice-card-inner">
                <!-- Avatar -->
                <div class="voice-avatar-wrapper">
                  <% if vs.user.avatar.attached? %>
                    <%= image_tag vs.user.avatar, class: "voice-avatar" %>
                  <% else %>
                    <div class="voice-avatar-fallback" style="background-color: color-mix(in srgb, <%= vs.user.profile_color || '#1e1c1b' %>, white 20%)">
                      <%= vs.user.username[0].upcase %>
                    </div>
                  <% end %>
                </div>
                <!-- Status icons on avatar -->
                <% if vs.self_mute || vs.self_deaf %>
                  <div class="voice-status-icons">
                    <% if vs.self_mute %>
                      <div class="voice-status-badge">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/><line x1="3" y1="3" x2="21" y2="21" stroke-width="2.5" stroke-linecap="round"/></svg>
                      </div>
                    <% end %>
                    <% if vs.self_deaf %>
                      <div class="voice-status-badge">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"/></svg>
                      </div>
                    <% end %>
                  </div>
                <% end %>
                <!-- Username pill -->
                <div class="voice-username-pill">
                  <span class="truncate"><%= vs.user.display_name.presence || vs.user.username %></span>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% else %>
      <!-- Empty state -->
      <div class="flex-1 flex flex-col items-center justify-center p-8" data-voice-empty-state>
        <div class="w-24 h-24 rounded-full flex items-center justify-center mx-auto mb-6" style="background: rgba(255,255,255,0.05);">
          <svg class="w-12 h-12 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.536 8.464a5 5 0 010 7.072M12 6v12m-3.536-2.464a5 5 0 010-7.072M18.364 5.636a9 9 0 010 12.728M5.636 18.364a9 9 0 010-12.728"/></svg>
        </div>
        <h2 class="text-xl font-bold text-white mb-1"><%= @channel.name %></h2>
        <p class="text-gray-500 text-sm">No one is in this channel yet.</p>
      </div>
    <% end %>

    <!-- Join / Connected bar -->
    <div class="shrink-0 px-4 py-3 flex items-center justify-center" style="background: #0e0d0c;">
      <% already_here = @current_voice_state&.channel_id == @channel.id %>
      <% in_other_channel = @current_voice_state && @current_voice_state.channel_id != @channel.id %>

      <% if already_here %>
        <p class="text-green-400 text-sm font-medium" data-voice-connected-text>You're connected to this voice channel</p>
      <% else %>
        <button type="button"
                class="px-6 py-2.5 bg-green-600 hover:bg-green-500 text-white font-semibold rounded-full transition flex items-center gap-2 cursor-pointer text-sm"
                data-voice-join-btn
                onclick="window.dispatchEvent(new CustomEvent('voice:join', { detail: { channelId: '<%= @channel.public_id %>', serverId: '<%= @server.public_id %>' } }))">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072M12 6v12m-3.536-2.464a5 5 0 010-7.072"/></svg>
          Join Voice
        </button>
        <% if in_other_channel %>
          <p class="text-yellow-400/70 text-xs ml-3">You'll leave <strong><%= @current_voice_state.channel.name %></strong></p>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<style>
  .voice-grid {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    grid-auto-rows: 1fr;
    align-content: start;
  }
  /* When few participants, make cards larger */
  .voice-grid:has(> :last-child:nth-child(1)) { grid-template-columns: 1fr; max-width: 400px; margin: 0 auto; }
  .voice-grid:has(> :last-child:nth-child(2)) { grid-template-columns: repeat(2, 1fr); max-width: 600px; margin: 0 auto; }
  .voice-grid:has(> :last-child:nth-child(3)) { grid-template-columns: repeat(3, 1fr); max-width: 800px; margin: 0 auto; }
  .voice-grid:has(> :last-child:nth-child(4)) { grid-template-columns: repeat(2, 1fr); max-width: 600px; margin: 0 auto; }

  .voice-card {
    position: relative;
    border-radius: 0.75rem;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    min-height: 0;
    border: 1px solid rgba(220, 38, 38, 0.15);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .voice-card:hover {
    border-color: rgba(220, 38, 38, 0.4);
    box-shadow: 0 0 20px rgba(220, 38, 38, 0.1);
  }
  .voice-card-inner {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center 40%, color-mix(in srgb, var(--card-color) 90%, white 10%), var(--card-color) 60%, color-mix(in srgb, var(--card-color), black 30%) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: box-shadow 0.2s ease;
  }

  /* Speaking indicator — audio-level responsive ring */
  .voice-card.speaking {
    border-color: #dc2626;
    box-shadow: 0 0 calc(8px + 20px * var(--audio-level, 0)) rgba(220, 38, 38, calc(0.25 + 0.5 * var(--audio-level, 0))),
                0 0 calc(3px + 8px * var(--audio-level, 0)) rgba(220, 38, 38, 0.5);
    transition: box-shadow 0.1s ease-out;
  }
  .voice-card.speaking .voice-card-inner {
    box-shadow: inset 0 0 0 2px rgba(220, 38, 38, calc(0.4 + 0.4 * var(--audio-level, 0))),
                inset 0 0 calc(15px + 20px * var(--audio-level, 0)) rgba(220, 38, 38, calc(0.04 + 0.08 * var(--audio-level, 0)));
    transition: box-shadow 0.1s ease-out;
  }

  .voice-avatar-wrapper {
    position: relative;
  }
  .voice-avatar {
    width: 5rem;
    height: 5rem;
    border-radius: 9999px;
    object-fit: cover;
    border: 3px solid rgba(220, 38, 38, 0.2);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .voice-card:hover .voice-avatar {
    border-color: rgba(220, 38, 38, 0.5);
    box-shadow: 0 0 16px rgba(220, 38, 38, 0.25);
  }
  .voice-card.speaking .voice-avatar {
    border-color: #dc2626;
    box-shadow: 0 0 calc(10px + 16px * var(--audio-level, 0)) rgba(220, 38, 38, calc(0.3 + 0.4 * var(--audio-level, 0)));
    transition: box-shadow 0.1s ease-out;
  }
  .voice-avatar-fallback {
    width: 5rem;
    height: 5rem;
    border-radius: 9999px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.75rem;
    font-weight: 700;
    color: white;
    border: 3px solid rgba(220, 38, 38, 0.2);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .voice-card:hover .voice-avatar-fallback {
    border-color: rgba(220, 38, 38, 0.5);
    box-shadow: 0 0 16px rgba(220, 38, 38, 0.25);
  }
  .voice-card.speaking .voice-avatar-fallback {
    border-color: #dc2626;
    box-shadow: 0 0 calc(10px + 16px * var(--audio-level, 0)) rgba(220, 38, 38, calc(0.3 + 0.4 * var(--audio-level, 0)));
    transition: box-shadow 0.1s ease-out;
  }
  @media (min-width: 640px) {
    .voice-avatar, .voice-avatar-fallback { width: 6rem; height: 6rem; font-size: 2rem; }
  }
  .voice-status-icons {
    position: absolute;
    bottom: 0.5rem;
    right: 0.5rem;
    display: flex;
    gap: 0.25rem;
    z-index: 10;
  }
  .voice-status-badge {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 9999px;
    background: rgba(0, 0, 0, 0.8);
    border: 1px solid rgba(248, 113, 113, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #f87171;
    box-shadow: 0 0 6px rgba(248, 113, 113, 0.2);
  }
  .voice-username-pill {
    position: absolute;
    bottom: 0.5rem;
    left: 0.5rem;
    max-width: calc(100% - 1rem);
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(4px);
    border-radius: 0.375rem;
    border: 1px solid rgba(220, 38, 38, 0.15);
    padding: 0.2rem 0.5rem;
    display: flex;
    align-items: center;
    z-index: 10;
  }
  .voice-username-pill span {
    font-size: 0.8rem;
    font-weight: 600;
    color: white;
    line-height: 1.3;
  }
  .voice-card.speaking .voice-username-pill {
    border-color: rgba(220, 38, 38, calc(0.3 + 0.3 * var(--audio-level, 0)));
    box-shadow: 0 0 calc(4px + 8px * var(--audio-level, 0)) rgba(220, 38, 38, calc(0.1 + 0.15 * var(--audio-level, 0)));
    transition: border-color 0.1s ease-out, box-shadow 0.1s ease-out;
  }
</style>
<% end %>
