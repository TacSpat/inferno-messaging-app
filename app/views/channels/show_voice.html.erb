<%= turbo_frame_tag "main-content", class: "flex flex-col flex-1 min-h-0", data: { turbo_action: "advance" } do %>
<div class="flex flex-col flex-1 min-h-0 relative" data-controller="sidechat" data-current-channel-id="<%= @channel.public_id %>" data-current-server-id="<%= @server.public_id %>">

  <!-- Data for persistent header -->
  <div id="channel-header-data" class="hidden"
       data-channel-icon="voice"
       data-channel-name="<%= @channel.name %>"
       data-channel-name-html="<%= h(render_name_with_emojis(@channel.name, @server)) %>"
       data-channel-topic="<%= @channel.topic %>"
       data-pin-count="0"
       data-pin-url=""></div>

  <%= render "shared/search_panel" %>

  <!-- Desktop: Voice + Sidechat + Members horizontal split -->
  <div class="flex-1 hidden lg:flex min-h-0 relative">
    <div class="flex-1 flex flex-col min-h-0" style="background: var(--color-gray-950);" data-voice-content
         data-controller="voice-context" data-voice-context-server-id-value="<%= @server.public_id %>">
      <%= render "channels/voice_content", voice_configured: @voice_configured, voice_states: @voice_states, remote_voice_states: @remote_voice_states, channel: @channel, server: @server, is_afk_channel: @is_afk_channel %>
    </div>

    <% unless @is_afk_channel %>
    <%= render "channels/sidechat_panel" %>
    <% end %>
  </div>

  <!-- Mobile: Full-height voice + inline controls -->
  <div class="flex-1 flex flex-col min-h-0 lg:hidden" style="background: var(--color-gray-950);"
       data-controller="voice-context" data-voice-context-server-id-value="<%= @server.public_id %>">
    <div class="flex-1 flex flex-col min-h-0">
      <%= render "channels/voice_content", voice_configured: @voice_configured, voice_states: @voice_states, remote_voice_states: @remote_voice_states, channel: @channel, server: @server, is_afk_channel: @is_afk_channel %>
    </div>

    <!-- Mobile voice controls bar (synced with sidebar #voice-controls-bar) -->
    <div id="mobile-voice-controls" class="hidden shrink-0 border-t border-gray-800 px-4 py-2" style="background: var(--color-gray-900);">
      <script>
        // Show mobile bar if sidebar voice bar is already visible (user navigated while connected)
        requestAnimationFrame(() => {
          const sidebarBar = document.getElementById("voice-controls-bar")
          const mobileBar = document.getElementById("mobile-voice-controls")
          if (sidebarBar && !sidebarBar.classList.contains("hidden") && mobileBar) {
            mobileBar.classList.remove("hidden")
          }
        })
      </script>
      <div class="flex items-center justify-center gap-3">
        <button type="button" data-mobile-voice-btn="mute" class="p-2.5 rounded-full hover:bg-gray-700 text-gray-300 hover:text-white transition cursor-pointer" title="Mute"
                onclick="document.querySelector('[data-voice-channel-target=&quot;muteBtn&quot;]')?.click()">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/></svg>
        </button>
        <button type="button" data-mobile-voice-btn="deafen" class="p-2.5 rounded-full hover:bg-gray-700 text-gray-300 hover:text-white transition cursor-pointer" title="Deafen"
                onclick="document.querySelector('[data-voice-channel-target=&quot;deafenBtn&quot;]')?.click()">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z M15.54 8.46a5 5 0 010 7.07"/></svg>
        </button>
        <button type="button" data-mobile-voice-btn="camera" class="p-2.5 rounded-full hover:bg-gray-700 text-gray-300 hover:text-white transition cursor-pointer" title="Camera"
                onclick="document.querySelector('[data-voice-channel-target=&quot;cameraBtn&quot;]')?.click()">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
        </button>
        <button type="button" data-mobile-voice-btn="screenshare" class="p-2.5 rounded-full hover:bg-gray-700 text-gray-300 hover:text-white transition cursor-pointer" title="Share Screen"
                onclick="document.querySelector('[data-voice-channel-target=&quot;screenShareBtn&quot;]')?.click()">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        </button>
        <div class="w-px h-8 bg-gray-700 mx-1"></div>
        <button type="button" class="p-2.5 rounded-full bg-danger/20 hover:bg-danger/40 text-danger-light hover:text-danger transition cursor-pointer" title="Disconnect"
                onclick="document.querySelector('[data-voice-channel-target=&quot;disconnectBtn&quot;]')?.click()">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 8l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2M5 3a2 2 0 00-2 2v1c0 8.284 6.716 15 15 15h1a2 2 0 002-2v-3.28a1 1 0 00-.684-.948l-4.493-1.498a1 1 0 00-1.21.502l-1.13 2.257a11.042 11.042 0 01-5.516-5.517l2.257-1.128a1 1 0 00.502-1.21L9.228 3.683A1 1 0 008.279 3H5z"/></svg>
        </button>
        <% unless @is_afk_channel %>
        <div class="w-px h-8 bg-gray-700 mx-1"></div>
        <% linked_text = @channel.sidechat_channel_id.present? ? Channel.find_by(id: @channel.sidechat_channel_id) : nil %>
        <% if linked_text %>
        <a href="<%= server_channel_path(@server, linked_text) %>" class="p-2.5 rounded-full hover:bg-gray-700 text-gray-300 hover:text-white transition cursor-pointer" title="Open Chat">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
        </a>
        <% end %>
        <% end %>
      </div>
    </div>
  </div>

</div>
<% end %>
