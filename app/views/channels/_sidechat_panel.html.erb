<% can_send_gifs = @current_membership&.has_permission?("send_gifs") != false %>
<% can_send_custom_emojis = @current_membership&.has_permission?("send_custom_emojis") != false %>
<% can_send_custom_stickers = @current_membership&.has_permission?("send_custom_stickers") != false %>
<% user_servers = current_user.servers.includes(:server_emojis, :server_stickers).map { |s| { id: s.public_id, name: s.name } } %>

<div data-sidechat-target="panel"
     data-controller="message-form unified-picker mention-autocomplete"
     data-message-form-channel-id-value="<%= @sidechat_channel.public_id %>"
     data-mention-autocomplete-server-id-value="<%= @server.public_id %>"
     data-unified-picker-server-id-value="<%= @server.public_id %>"
     data-unified-picker-can-send-gifs-value="<%= can_send_gifs %>"
     data-unified-picker-can-send-custom-emojis-value="<%= can_send_custom_emojis %>"
     data-unified-picker-can-send-custom-stickers-value="<%= can_send_custom_stickers %>"
     data-unified-picker-server-name-value="<%= @server.name %>"
     data-unified-picker-user-servers-value="<%= user_servers.to_json %>"
     class="hidden lg:flex flex-col h-full border-l border-gray-800 bg-gray-900/50"
     style="width: 350px; min-width: 280px;">

  <!-- Sidechat header -->
  <div class="flex items-center px-3 h-10 border-b border-gray-800 shrink-0">
    <svg class="w-4 h-4 text-gray-400 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
    <span class="text-xs font-semibold text-gray-300 truncate">Chat</span>
    <div class="flex-1"></div>
    <% sidechat_pin_count = @sidechat_channel.messages.where(pinned: true).count %>
    <div class="relative">
      <button type="button" class="text-gray-500 hover:text-gray-300 p-0.5 relative cursor-pointer"
              data-action="click->message-form#togglePinnedPanel"
              data-pinned-url="<%= pinned_channel_messages_path(@sidechat_channel) %>"
              data-message-form-target="pinButton" title="Pinned Messages">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12V4h1V2H7v2h1v8l-2 2v2h5.2v6h1.6v-6H18v-2l-2-2z"/></svg>
        <span data-message-form-target="pinBadge" class="hidden absolute -top-1.5 -right-2 min-w-[14px] h-3.5 bg-accent text-[9px] font-bold text-white rounded-full flex items-center justify-center px-0.5"><%= sidechat_pin_count %></span>
      </button>
    </div>
    <button type="button" class="text-gray-500 hover:text-gray-300 p-0.5" data-action="click->sidechat#toggle" title="Close chat">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
  </div>

  <% if @channel.sidechat_channel_id.present? %>
    <div class="text-xs text-gray-500 px-3 py-1.5 border-b border-gray-700/50 flex items-center gap-1.5">
      <svg class="w-3 h-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
      Linked to #<%= @sidechat_channel.name %>
    </div>
  <% end %>

  <!-- Messages area -->
  <div id="sidechat-messages"
       data-message-form-target="messagesContainer"
       class="flex-1 overflow-y-auto px-2 py-2 space-y-0.5"
       data-controller="scroll-position image-preview gif-save message-actions"
       data-scroll-position-channel-id-value="<%= @sidechat_channel.public_id %>"
       data-scroll-position-server-id-value="<%= @server.public_id %>"
       data-scroll-position-oldest-message-id-value="<%= @sidechat_messages.any? ? @sidechat_messages.first.public_id : '' %>"
       data-scroll-position-has-older-value="<%= @sidechat_has_older %>"
       data-scroll-position-newest-message-id-value="<%= @sidechat_messages.any? ? @sidechat_messages.last.public_id : '' %>"
       data-scroll-position-has-newer-value="false">
    <% if @sidechat_messages.empty? %>
      <div class="flex flex-col items-center justify-center h-full text-center py-8">
        <svg class="w-10 h-10 text-gray-600 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
        <p class="text-gray-500 text-xs">No messages yet</p>
      </div>
    <% else %>
      <% previous_message = nil %>
      <% @sidechat_messages.each do |message| %>
        <% grouped = previous_message &&
                     previous_message.user_id == message.user_id &&
                     !message.system_message? &&
                     !previous_message.system_message? &&
                     message.parent_id.nil? &&
                     previous_message.parent_id.nil? &&
                     (message.created_at - previous_message.created_at) < 300 %>
        <%= render partial: "messages/message", locals: { message: message, server: @server, grouped: grouped } %>
        <% previous_message = message %>
      <% end %>
    <% end %>
  </div>

  <!-- New messages bar -->
  <div data-scroll-position-target="newMessageBar" class="hidden">
    <button class="w-full bg-gradient-to-r from-confirm-dark to-confirm hover:from-confirm hover:to-confirm-light text-white text-xs py-1 px-3 flex items-center justify-center gap-1.5 cursor-pointer transition">
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
      <span data-count>New message</span>
    </button>
  </div>

  <!-- Typing indicator -->
  <div id="sidechat-typing-indicator" class="px-3 h-5 text-[10px] text-gray-400"></div>

  <!-- Message input -->
  <div class="px-2 pb-2 mt-auto shrink-0 relative">
    <!-- Mention autocomplete popup -->
    <div data-mention-autocomplete-target="popup" class="hidden absolute bottom-full left-0 right-0 mb-1 bg-gray-800 border border-gray-700 rounded-lg shadow-xl py-1 z-50 max-h-36 overflow-y-auto"></div>

    <!-- Edit bar -->
    <div data-message-form-target="editBar" class="hidden bg-gray-700 rounded-t-lg px-3 py-1.5 flex items-center text-xs border-b border-gray-600">
      <svg class="w-3.5 h-3.5 text-accent-light mr-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
      <span class="text-accent-light font-medium mr-2">Editing</span>
      <span data-message-form-target="editPreview" class="text-gray-400 truncate flex-1"></span>
      <button type="button" class="text-gray-400 hover:text-gray-200 ml-2 shrink-0" data-action="click->message-form#clearEdit">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <!-- Reply bar -->
    <div data-message-form-target="replyBar" class="hidden bg-gray-700 rounded-t-lg px-3 py-1.5 flex items-center text-xs border-b border-gray-600">
      <span class="text-gray-400 mr-1">Replying to</span>
      <span data-message-form-target="replyAuthor" class="text-accent-light font-medium mr-2"></span>
      <span data-message-form-target="replyPreview" class="text-gray-400 truncate flex-1"></span>
      <button type="button" class="text-gray-400 hover:text-gray-200 ml-2 shrink-0" data-action="click->message-form#clearReply">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <!-- File preview area -->
    <div data-message-form-target="filePreview" class="hidden bg-gray-700 px-3 py-1.5 flex flex-wrap border-b border-gray-600"></div>

    <%= form_with model: @message, url: channel_messages_path(@sidechat_channel), html: { multipart: true, class: "relative" }, data: { turbo_frame: "_top", action: "turbo:submit-end->message-form#handleSubmit" } do |f| %>
      <%= f.hidden_field :parent_id, data: { message_form_target: "parentId" } %>
      <div class="flex items-center bg-gray-600 rounded-lg px-1">
        <!-- File upload -->
        <label class="text-gray-400 hover:text-gray-200 shrink-0 cursor-pointer p-1.5">
          <%= f.file_field :files, multiple: true, class: "hidden", accept: "image/*,video/*,audio/*,.pdf,.txt,.zip,.md,.gif", data: { action: "change->message-form#handleFileSelect" } %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        </label>

        <div class="flex-1 relative min-w-0">
          <div data-message-form-target="highlight" class="absolute inset-0 py-1.5 px-0.5 text-sm leading-5 whitespace-pre-wrap break-words pointer-events-none overflow-hidden" aria-hidden="true"></div>
          <%= f.text_area :content,
              placeholder: "Message",
              class: "w-full bg-transparent text-transparent caret-white placeholder-gray-400 py-1.5 px-0.5 resize-none outline-none text-sm leading-5 max-h-32 relative z-10",
              rows: 1,
              data: { action: "keydown->mention-autocomplete#onKeydown keydown->message-form#handleKeydown input->mention-autocomplete#onInput input->message-form#autoResize input->message-form#updateHighlight input->message-form#sendTyping", message_form_target: "input", unified_picker_target: "input", mention_autocomplete_target: "input" } %>
        </div>

        <!-- Unified Picker button -->
        <div class="relative">
          <button type="button" class="text-gray-400 hover:text-gray-200 shrink-0 p-1.5" data-action="click->unified-picker#toggle">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </button>
          <div data-unified-picker-target="panel" class="hidden fixed bottom-0 left-0 right-0 sm:absolute sm:bottom-10 sm:left-auto sm:right-0 w-full sm:w-80 bg-gray-800 border border-gray-700 rounded-t-lg sm:rounded-lg shadow-xl z-50 flex flex-col" style="max-height: min(350px, 50vh);">
            <div class="flex border-b border-gray-700 shrink-0">
              <button type="button" data-unified-picker-target="tabGifs" data-tab="gifs" data-action="click->unified-picker#switchTab" class="flex-1 py-1.5 text-[10px] font-semibold text-center border-b-2 border-transparent text-gray-400 hover:text-white transition cursor-pointer">GIFs</button>
              <button type="button" data-unified-picker-target="tabStickers" data-tab="stickers" data-action="click->unified-picker#switchTab" class="flex-1 py-1.5 text-[10px] font-semibold text-center border-b-2 border-transparent text-gray-400 hover:text-white transition cursor-pointer">Stickers</button>
              <button type="button" data-unified-picker-target="tabEmoji" data-tab="emoji" data-action="click->unified-picker#switchTab" class="flex-1 py-1.5 text-[10px] font-semibold text-center border-b-2 border-accent text-white transition cursor-pointer">Emoji</button>
            </div>
            <div class="px-2 py-1.5 shrink-0">
              <input type="text" data-unified-picker-target="searchInput" data-action="input->unified-picker#onSearch" placeholder="Search..." class="w-full bg-gray-700 text-gray-200 text-xs rounded px-2.5 py-1 outline-none placeholder-gray-500 focus:ring-1 focus:ring-accent">
            </div>
            <div data-unified-picker-target="content" class="flex-1 overflow-y-auto px-2 pb-2 min-h-0"></div>
          </div>
        </div>

        <button type="submit" class="text-gray-400 hover:text-accent ml-0.5 shrink-0 p-0.5">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
        </button>
      </div>
    <% end %>
  </div>
</div>
