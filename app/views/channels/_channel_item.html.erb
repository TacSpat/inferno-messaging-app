<% indent = local_assigns[:indent] || 0 %>
<% is_read_only = local_assigns[:read_only] %>
<% is_voice = channel.voice? %>
<% is_afk = is_voice && channel.afk? %>
<% has_sidechat_link = is_voice && channel.sidechat_channel_id.present? %>
<% sidechat_target = is_voice ? channel.sidechat_target : nil %>
<% linked_voice = channel.text? ? channel.voice_channels_using_as_sidechat.first : nil %>
<% if channel.text?
     unread = channel.unread_for?(current_user)
     mention_count = current_user.notifications.unread.for_channel(channel.id).count
   elsif is_voice && sidechat_target
     unread = sidechat_target.unread_for?(current_user)
     mention_count = current_user.notifications.unread.for_channel(sidechat_target.id).count
   else
     unread = false
     mention_count = 0
   end %>
<a href="<%= server_channel_path(server, channel) %>"
   data-turbo-frame="main-content"
   data-channel-id="<%= channel.public_id %>"
   <%= 'data-voice-channel=true' if is_voice %>
   <%= "data-sidechat-channel-id=#{sidechat_target.public_id}" if has_sidechat_link %>
   <%= "data-linked-voice-channel-id=#{linked_voice.public_id}" if linked_voice %>
   class="flex items-center px-2 py-1.5 rounded group relative <%= 'ml-3' if indent > 0 %>
          <%= if is_read_only
                active ? 'bg-gray-600 text-gray-500' : 'text-gray-500 hover:bg-gray-700 hover:text-gray-400'
              elsif active
                'bg-gray-600 text-white'
              elsif unread
                'text-white hover:bg-gray-700'
              else
                'text-gray-400 hover:bg-gray-700 hover:text-gray-200'
              end %>">
  <% if unread && !active && !is_read_only %>
    <div class="unread-pill absolute -left-2 top-1/2 -translate-y-1/2 w-1 h-2 bg-gray-300 rounded-r-full"></div>
  <% end %>
  <% if is_read_only %>
    <svg class="w-4 h-4 mr-1.5 opacity-50 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
  <% elsif is_afk %>
    <svg class="w-4 h-4 mr-1.5 opacity-60 shrink-0 text-warning-light" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
  <% elsif is_voice %>
    <svg class="w-4 h-4 mr-1.5 opacity-60 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072M18.364 5.636a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/></svg>
  <% elsif channel.encrypted? %>
    <svg class="w-4 h-4 mr-1.5 opacity-60 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
  <% else %>
    <span class="text-lg mr-1.5 opacity-60">#</span>
  <% end %>
  <span class="truncate text-sm flex-1 <%= unread && !is_read_only ? 'font-bold' : 'font-medium' %>"><%= render_name_with_emojis(channel.name, server) %></span>
  <% if mention_count > 0 && !is_read_only %>
    <div class="mention-badge ml-auto min-w-[18px] h-[18px] bg-accent rounded-full flex items-center justify-center text-white text-xs font-bold px-1 shrink-0">
      <%= mention_count > 99 ? '99+' : mention_count %>
    </div>
  <% end %>
  <% if is_voice && !is_afk %>
    <button type="button" title="Open chat" class="sidechat-btn ml-auto opacity-0 group-hover:opacity-100 text-gray-400 hover:text-white p-0.5 shrink-0 cursor-pointer transition"
            data-channel-chat-btn="<%= channel.public_id %>"
            data-href="<%= server_channel_path(server, channel) %>">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
    </button>
  <% end %>
</a>
<% if is_voice %>
  <% remote_states = RelaySubscriptionManager.remote_voice_states(channel.public_id).values %>
  <% has_local = channel.voice_states.loaded? ? channel.voice_states.any? : channel.voice_states.exists? %>
  <% if has_local || remote_states.any? %>
    <div class="voice-participants" data-voice-channel-participants="<%= channel.public_id %>">
      <% channel.voice_states.includes(:user).each do |vs| %>
        <%= render partial: "voice_states/sidebar_participant", locals: { voice_state: vs } %>
      <% end %>
      <% remote_states.each do |rvs| %>
        <div class="flex items-center py-0.5 pl-6 pr-2 rounded hover:bg-gray-700/50 group"
             data-voice-user-id="<%= rvs[:user_id] %>"
             data-voice-remote="true"
             data-action="contextmenu->voice-context#show">
          <div class="relative">
            <% if rvs[:avatar_url].present? %>
              <img src="<%= rvs[:avatar_url] %>" class="w-5 h-5 rounded-full object-cover voice-sidebar-avatar" loading="lazy">
            <% else %>
              <div class="w-5 h-5 rounded-full flex items-center justify-center text-[10px] font-bold text-white voice-sidebar-avatar" style="background-color: <%= rvs[:profile_color] || '#1e1c1b' %>">
                <%= (rvs[:username] || "?")[0].upcase %>
              </div>
            <% end %>
          </div>
          <span class="ml-1.5 text-xs text-gray-300 truncate flex-1"><%= rvs[:username] || "Remote User" %></span>
        </div>
      <% end %>
    </div>
  <% end %>
  <% if channel.child_channels.any? %>
    <div class="voice-child-channels" data-parent-channel="<%= channel.public_id %>">
      <% channel.child_channels.ordered.each do |child| %>
        <% child_access = child.visible_to?(current_user) %>
        <% next unless child_access %>
        <%= render partial: "channels/channel_item", locals: { channel: child, server: server, active: (defined?(@channel) && child == @channel), indent: indent + 1, read_only: child_access == :read_only } %>
      <% end %>
    </div>
  <% end %>
<% end %>
