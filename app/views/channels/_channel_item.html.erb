<% is_voice = channel.voice? %>
<% unread = is_voice ? false : channel.unread_for?(current_user) %>
<% mention_count = is_voice ? 0 : current_user.notifications.unread.for_channel(channel.id).count %>
<a href="<%= server_channel_path(server, channel) %>"
   data-turbo-frame="main-content"
   data-channel-id="<%= channel.public_id %>"
   class="flex items-center px-2 py-1.5 rounded group relative
          <%= active ? 'bg-gray-600 text-white' : (unread ? 'text-white hover:bg-gray-700' : 'text-gray-400 hover:bg-gray-700 hover:text-gray-200') %>">
  <% if unread && !active %>
    <div class="unread-pill absolute -left-2 top-1/2 -translate-y-1/2 w-1 h-2 bg-gray-300 rounded-r-full"></div>
  <% end %>
  <% if is_voice %>
    <svg class="w-4 h-4 mr-1.5 opacity-60 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072M12 6v12m-3.536-2.464a5 5 0 010-7.072M18.364 5.636a9 9 0 010 12.728M5.636 18.364a9 9 0 010-12.728"/></svg>
  <% else %>
    <span class="text-lg mr-1.5 opacity-60">#</span>
  <% end %>
  <span class="truncate text-sm flex-1 <%= unread ? 'font-bold' : 'font-medium' %>"><%= channel.name %></span>
  <% if mention_count > 0 %>
    <div class="mention-badge ml-auto min-w-[18px] h-[18px] bg-red-500 rounded-full flex items-center justify-center text-white text-xs font-bold px-1 shrink-0">
      <%= mention_count > 99 ? '99+' : mention_count %>
    </div>
  <% end %>
</a>
<% if is_voice && channel.voice_states.loaded? ? channel.voice_states.any? : channel.voice_states.exists? %>
  <div class="voice-participants" data-voice-channel-participants="<%= channel.public_id %>">
    <% channel.voice_states.includes(:user).each do |vs| %>
      <%= render partial: "voice_states/participant", locals: { voice_state: vs } %>
    <% end %>
  </div>
<% end %>
