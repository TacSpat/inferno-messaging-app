<% unread = channel.text? ? channel.unread_for?(current_user) : false %>
<% mention_count = channel.text? ? current_user.notifications.unread.for_channel(channel.id).count : 0 %>
<% is_read_only = local_assigns[:read_only] %>
<% is_voice = channel.voice? %>
<a href="<%= server_channel_path(server, channel) %>"
   data-turbo-frame="main-content"
   data-channel-id="<%= channel.public_id %>"
   <%= 'data-voice-channel=true' if is_voice %>
   class="flex items-center px-2 py-1.5 rounded group relative
          <%= if is_read_only
                active ? 'bg-gray-600 text-gray-500' : 'text-gray-500 hover:bg-gray-700 hover:text-gray-400'
              elsif active
                'bg-gray-600 text-white'
              elsif unread
                'text-white hover:bg-gray-700'
              else
                'text-gray-400 hover:bg-gray-700 hover:text-gray-200'
              end %>">
  <% if unread && !active && !is_read_only %>
    <div class="unread-pill absolute -left-2 top-1/2 -translate-y-1/2 w-1 h-2 bg-gray-300 rounded-r-full"></div>
  <% end %>
  <% if is_read_only %>
    <svg class="w-4 h-4 mr-1.5 opacity-50 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
  <% elsif is_voice %>
    <svg class="w-4 h-4 mr-1.5 opacity-60 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072M18.364 5.636a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/></svg>
  <% elsif channel.encrypted? %>
    <svg class="w-4 h-4 mr-1.5 opacity-60 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
  <% else %>
    <span class="text-lg mr-1.5 opacity-60">#</span>
  <% end %>
  <span class="truncate text-sm flex-1 <%= unread && !is_read_only ? 'font-bold' : 'font-medium' %>"><%= render_name_with_emojis(channel.name, server) %></span>
  <% if mention_count > 0 && !is_read_only %>
    <div class="mention-badge ml-auto min-w-[18px] h-[18px] bg-accent rounded-full flex items-center justify-center text-white text-xs font-bold px-1 shrink-0">
      <%= mention_count > 99 ? '99+' : mention_count %>
    </div>
  <% end %>
</a>
<% if is_voice && (channel.voice_states.loaded? ? channel.voice_states.any? : channel.voice_states.exists?) %>
  <div class="voice-participants" data-voice-channel-participants="<%= channel.public_id %>">
    <% channel.voice_states.includes(:user).each do |vs| %>
      <%= render partial: "voice_states/sidebar_participant", locals: { voice_state: vs } %>
    <% end %>
  </div>
<% end %>
