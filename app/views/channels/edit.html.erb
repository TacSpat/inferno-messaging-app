<div class="flex items-center justify-center min-h-screen bg-gray-900">
  <div class="w-full max-w-md bg-gray-800 rounded-lg shadow-xl p-8">
    <h1 class="text-xl font-bold text-white mb-1">Edit Channel</h1>
    <p class="text-sm text-gray-400 mb-6">#<%= @channel.name %> in <%= @server.name %></p>

    <%= form_with model: [@server, @channel], class: "space-y-4" do |f| %>
      <div data-controller="emoji-input" data-emoji-input-server-id-value="<%= @server.public_id %>">
        <%= f.label :name, "Channel Name", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
        <div class="flex items-center bg-gray-900 border border-gray-700 rounded px-3 py-2">
          <span class="text-gray-500 mr-1">#</span>
          <div class="flex-1 relative">
            <div data-emoji-input-target="highlight" class="absolute inset-0 text-sm text-white whitespace-pre break-words pointer-events-none overflow-hidden" aria-hidden="true"></div>
            <%= f.text_field :name, class: "w-full bg-transparent text-transparent caret-white placeholder-gray-500 focus:outline-none text-sm relative z-10", data: { emoji_input_target: "input", action: "input->emoji-input#handleInput keydown->emoji-input#handleKeydown" } %>
          </div>
          <button type="button" class="text-gray-400 hover:text-gray-200 ml-1 shrink-0 cursor-pointer" data-action="click->emoji-input#toggle" data-emoji-input-target="button" title="Add emoji">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </button>
        </div>
      </div>

      <div>
        <%= f.label :topic, class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
        <%= f.text_field :topic, class: "w-full bg-gray-900 border border-gray-700 rounded px-3 py-2 text-white focus:outline-none focus:border-red-500 text-sm" %>
      </div>

      <div class="flex items-center gap-3 pt-2">
        <%= link_to "Cancel", server_channel_path(@server, @channel), class: "text-sm text-gray-400 hover:text-gray-200" %>
        <%= f.submit "Save Changes", class: "bg-gradient-to-r from-red-700 to-red-500 hover:from-red-600 hover:to-red-400 text-white font-semibold px-6 py-2 rounded transition cursor-pointer text-sm" %>
      </div>
    <% end %>

    <!-- Channel Sharing (NIP-29) -->
    <div class="mt-6 pt-4 border-t border-gray-700">
      <h2 class="text-sm font-semibold text-white mb-3">Cross-Instance Sharing</h2>

      <% if @channel.shared? %>
        <div class="bg-gray-900 rounded-lg p-4 mb-3">
          <div class="flex items-center gap-2 mb-2">
            <div class="w-2.5 h-2.5 rounded-full bg-green-400"></div>
            <span class="text-sm text-green-400 font-medium">Shared</span>
          </div>
          <div class="space-y-1">
            <p class="text-xs text-gray-400">Group ID: <span class="text-gray-300 font-mono select-all"><%= @channel.nostr_group_id %></span></p>
            <p class="text-xs text-gray-400">Relay: <span class="text-gray-300 font-mono select-all"><%= @channel.nostr_relay_url %></span></p>
          </div>
        </div>
        <%= button_to "Disable Sharing", unbridge_server_channel_path(@server, @channel), method: :delete,
            data: { turbo_confirm: "Stop sharing this channel? Remote participants will no longer see new messages." },
            class: "text-sm text-red-400 hover:text-red-300 cursor-pointer" %>
      <% else %>
        <p class="text-xs text-gray-400 mb-3">Share this channel via a NIP-29 relay group so users on other instances can participate.</p>

        <%= form_with url: bridge_server_channel_path(@server, @channel), method: :post, class: "space-y-3" do |f| %>
          <div>
            <%= f.label :relay_url, "Relay URL", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
            <%= f.text_field :relay_url,
                value: InstanceConfig.current.instance_relay_url,
                placeholder: "wss://relay.example.com",
                class: "w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-red-500 text-sm" %>
          </div>
          <div>
            <%= f.label :group_id, "Group ID (optional)", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
            <%= f.text_field :group_id,
                placeholder: "Leave empty to create a new group",
                class: "w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-red-500 text-sm" %>
            <p class="text-xs text-gray-500 mt-1">Provide a group ID to bridge to an existing NIP-29 group on another instance.</p>
          </div>
          <%= f.submit "Enable Sharing", class: "bg-gradient-to-r from-red-700 to-red-500 hover:from-red-600 hover:to-red-400 text-white font-semibold px-4 py-2 rounded transition cursor-pointer text-sm" %>
        <% end %>
      <% end %>
    </div>

    <div class="mt-6 pt-4 border-t border-gray-700">
      <%= button_to "Delete Channel", server_channel_path(@server, @channel), method: :delete, data: { turbo_confirm: "Delete ##{@channel.name}?" }, class: "text-sm text-red-400 hover:text-red-300 cursor-pointer" %>
    </div>
  </div>
</div>
