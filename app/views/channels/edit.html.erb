<div class="flex items-center justify-center min-h-screen bg-gray-900">
  <div class="w-full max-w-md bg-gray-800 rounded-lg shadow-xl p-8">
    <h1 class="text-xl font-bold text-white mb-1">Edit Channel</h1>
    <p class="text-sm text-gray-400 mb-6">#<%= @channel.name %> in <%= @server.name %></p>

    <%= form_with model: [@server, @channel], class: "space-y-4", data: { controller: "encrypted-channel channel-type", action: "submit->encrypted-channel#confirmSubmit" } do |f| %>
      <% if @channel.errors.any? %>
        <div class="bg-danger/20 border border-danger/40 rounded-lg p-3">
          <% @channel.errors.full_messages.each do |msg| %>
            <p class="text-sm text-red-300"><%= msg %></p>
          <% end %>
        </div>
      <% end %>
      <div data-controller="emoji-input" data-emoji-input-server-id-value="<%= @server.public_id %>">
        <%= f.label :name, "Channel Name", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
        <div class="flex items-center bg-gray-900 border border-gray-700 rounded px-3 py-2">
          <span class="text-gray-500 mr-1">#</span>
          <div class="flex-1 relative">
            <div data-emoji-input-target="highlight" class="absolute inset-0 text-sm text-white whitespace-pre break-words pointer-events-none overflow-hidden" aria-hidden="true"></div>
            <%= f.text_field :name, class: "w-full bg-transparent text-transparent caret-white placeholder-gray-500 focus:outline-none text-sm relative z-10", data: { emoji_input_target: "input", action: "input->emoji-input#handleInput keydown->emoji-input#handleKeydown" } %>
          </div>
          <button type="button" class="text-gray-400 hover:text-gray-200 ml-1 shrink-0 cursor-pointer" data-action="click->emoji-input#toggle" data-emoji-input-target="button" title="Add emoji">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </button>
        </div>
      </div>

      <div>
        <%= f.label :topic, class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
        <%= f.text_field :topic, class: "w-full bg-gray-900 border border-gray-700 rounded px-3 py-2 text-white focus:outline-none focus:border-accent text-sm" %>
      </div>

      <!-- Voice channel options (shown when channel_type is voice) -->
      <div data-channel-type-target="voiceOptions" class="<%= @channel.voice? ? '' : 'hidden' %> border border-gray-700 rounded-lg p-4 space-y-4">
        <h3 class="text-sm font-semibold text-white">Voice Channel Options</h3>

        <div>
          <label class="block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1">Bitrate</label>
          <%= f.select :voice_bitrate,
              [["32 kbps (Low)", 32000], ["64 kbps (Normal)", 64000], ["96 kbps (High)", 96000], ["128 kbps (Very High)", 128000], ["256 kbps (Best)", 256000]],
              {},
              class: "w-full bg-gray-900 border border-gray-700 rounded px-3 py-2 text-white focus:outline-none focus:border-accent text-sm" %>
          <p class="text-xs text-gray-500 mt-1">Higher bitrate = better quality but uses more bandwidth</p>
        </div>

        <div>
          <label class="block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1">User Limit</label>
          <%= f.number_field :voice_user_limit, min: 0, max: 99, class: "w-full bg-gray-900 border border-gray-700 rounded px-3 py-2 text-white focus:outline-none focus:border-accent text-sm" %>
          <p class="text-xs text-gray-500 mt-1">0 = unlimited</p>
        </div>

        <label class="flex items-center gap-3 cursor-pointer">
          <%= f.check_box :video_enabled, class: "w-4 h-4 rounded bg-gray-900 border-gray-600 text-accent focus:ring-accent focus:ring-offset-0 cursor-pointer" %>
          <div>
            <span class="text-sm font-medium text-white">Enable Video</span>
            <p class="text-xs text-gray-400">Allow members to share their camera in this channel</p>
          </div>
        </label>
      </div>

      <!-- Encrypted channel toggle -->
      <% current_role_ids = @channel.permissions_overrides&.dig("allowed_role_ids") || [] %>
      <div class="border border-gray-700 rounded-lg p-4 space-y-3">
        <label class="flex items-center gap-3 cursor-pointer">
          <%= f.check_box :encrypted, class: "w-4 h-4 rounded bg-gray-900 border-gray-600 text-accent focus:ring-accent focus:ring-offset-0 cursor-pointer", data: { action: "change->encrypted-channel#toggle", encrypted_channel_target: "checkbox" } %>
          <div>
            <span class="text-sm font-medium text-white">Encrypted Channel</span>
            <p class="text-xs text-gray-400">Messages are encrypted on relays. Only members with allowed roles can access this channel.</p>
          </div>
        </label>

        <div data-encrypted-channel-target="purgeWarning" class="hidden bg-danger/10 border border-danger/30 rounded-lg px-3 py-2 mt-2">
          <p class="text-xs text-danger-light font-medium">All message history in this channel will be permanently deleted. The encryption key will be destroyed so encrypted messages on relays become unrecoverable.</p>
        </div>

        <div data-encrypted-channel-target="roleSelector" class="<%= @channel.encrypted? ? '' : 'hidden' %> space-y-2 pt-2 border-t border-gray-700">
          <label class="block text-xs font-semibold text-gray-300 uppercase tracking-wide">Allowed Roles</label>
          <p class="text-xs text-gray-500 mb-2">Select which roles can access this channel. Admins and owners always have access.</p>
          <% @server.roles.where.not(name: "@everyone").ordered.reject(&:owner?).each do |role| %>
            <label class="flex items-center gap-2 px-2 py-1.5 rounded hover:bg-gray-700 cursor-pointer">
              <input type="checkbox" name="channel[allowed_role_ids][]" value="<%= role.public_id %>"
                     <%= 'checked' if current_role_ids.include?(role.public_id) %>
                     class="w-3.5 h-3.5 rounded bg-gray-900 border-gray-600 text-accent focus:ring-accent focus:ring-offset-0 cursor-pointer">
              <span class="w-3 h-3 rounded-full shrink-0" style="background-color: <%= role.color || '#99aab5' %>"></span>
              <span class="text-sm text-gray-200"><%= role.name %></span>
            </label>
          <% end %>
        </div>
      </div>

      <div class="flex items-center gap-3 pt-2">
        <%= link_to "Cancel", server_channel_path(@server, @channel), class: "text-sm text-gray-400 hover:text-gray-200" %>
        <%= f.submit "Save Changes", class: "bg-gradient-to-r from-confirm-dark to-confirm hover:from-confirm hover:to-confirm-light text-white font-semibold px-6 py-2 rounded transition cursor-pointer text-sm" %>
      </div>
    <% end %>

    <!-- Nostr Group Info (NIP-29) -->
    <div class="mt-6 pt-4 border-t border-gray-700">
      <h2 class="text-sm font-semibold text-white mb-3">Nostr Group</h2>

      <div class="bg-gray-900 rounded-lg p-4">
        <div class="space-y-1">
          <p class="text-xs text-gray-400">Group ID: <span class="text-gray-300 font-mono select-all"><%= @channel.nostr_group_id %></span></p>
          <p class="text-xs text-gray-400">Relays:
            <% @channel.effective_relay_urls.each do |url| %>
              <span class="text-gray-300 font-mono select-all block ml-2"><%= url %></span>
            <% end %>
          </p>
          <% if @channel.encrypted? && @channel.channel_public_key.present? %>
            <p class="text-xs text-gray-400">Channel Public Key: <span class="text-gray-300 font-mono select-all break-all"><%= @channel.channel_public_key %></span></p>
          <% end %>
        </div>
      </div>
    </div>

    <div class="mt-6 pt-4 border-t border-gray-700">
      <%= button_to "Delete Channel", server_channel_path(@server, @channel), method: :delete, data: { turbo_confirm: "Delete ##{@channel.name}?" }, class: "text-sm text-danger-light hover:text-danger cursor-pointer" %>
    </div>
  </div>
</div>
