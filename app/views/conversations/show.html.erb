<%= turbo_frame_tag "main-content", class: "flex flex-col flex-1 min-h-0 min-w-0", data: { turbo_action: "advance" } do %>
<% user_servers_dm = current_user.servers.includes(:server_emojis).map { |s| { id: s.public_id, name: s.name } } %>
<% livekit_configured = @conversation.participants.any?(&:livekit_configured?) %>
<% active_call = @conversation.calls.active.last %>
<div data-controller="dm-message-form unified-picker call message-search" data-dm-message-form-conversation-id-value="<%= @conversation.public_id %>" data-call-conversation-id-value="<%= @conversation.public_id %>" data-call-livekit-configured-value="<%= livekit_configured %>" data-call-active-call-id-value="<%= active_call&.public_id %>" data-unified-picker-can-send-gifs-value="true" data-unified-picker-can-send-custom-emojis-value="true" data-unified-picker-can-send-custom-stickers-value="true" data-unified-picker-user-servers-value="<%= user_servers_dm.to_json %>" data-message-search-url-value="<%= search_conversation_dm_messages_path(@conversation) %>" class="flex flex-col flex-1 min-h-0 min-w-0 relative">

<!-- DM header -->
<div class="flex items-center px-4 h-12 border-b border-gray-900 shadow-sm shrink-0">
  <!-- Hamburger menu (mobile only) -->
  <button type="button" class="md:hidden text-gray-400 hover:text-white mr-2 p-1" data-action="click->mobile-nav#toggleSidebar">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
  </button>

  <% if @conversation.group_chat? %>
    <% header_icon = @conversation.effective_icon_url %>
    <% if header_icon %>
      <%= image_tag header_icon, class: "w-6 h-6 rounded-full object-cover mr-2" %>
    <% else %>
      <svg class="w-5 h-5 text-gray-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
    <% end %>
    <h1 class="font-semibold text-white"><%= @conversation.display_name(current_user) %></h1>
    <span class="ml-2 text-xs text-gray-500"><%= @conversation.conversation_participants.count %> members</span>
  <% else %>
    <span class="text-gray-400 text-xl mr-2">@</span>
    <% if @other_user %>
      <h1 class="font-semibold text-white"><%= @other_user.display_name.presence || @other_user.username %></h1>
      <% header_status = case @other_user.online_state
                         when "online" then "bg-green-500"
                         when "idle" then "bg-warning"
                         when "dnd" then "bg-red-500"
                         else "bg-gray-500"
                         end %>
      <div data-dm-presence-dot class="ml-2 w-2.5 h-2.5 rounded-full shrink-0 <%= header_status %>"></div>
    <% elsif @dm_contact %>
      <h1 class="font-semibold text-white"><%= @dm_contact.effective_display_name %></h1>
      <div data-dm-presence-dot class="ml-2 w-2.5 h-2.5 rounded-full shrink-0 <%= @dm_contact.online? ? 'bg-green-500' : 'bg-gray-500' %>"></div>
    <% else %>
      <h1 class="font-semibold text-white"><%= @conversation.display_name(current_user) %></h1>
    <% end %>
  <% end %>

  <div class="flex-1"></div>

  <% dm_pin_count = @conversation.messages.where(pinned: true).count %>
  <div class="relative">
    <button type="button" class="text-gray-400 hover:text-white p-1 transition cursor-pointer relative"
            data-action="click->dm-message-form#togglePinnedPanel"
            data-pinned-url="<%= pinned_conversation_dm_messages_path(@conversation) %>"
            data-dm-message-form-target="pinButton" title="Pinned Messages">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12V4h1V2H7v2h1v8l-2 2v2h5.2v6h1.6v-6H18v-2l-2-2z"/></svg>
      <span data-dm-message-form-target="pinBadge" class="hidden absolute -top-1 -right-1.5 min-w-[16px] h-4 bg-accent text-[10px] font-bold text-white rounded-full flex items-center justify-center px-0.5"><%= dm_pin_count %></span>
    </button>
  </div>

  <!-- Call button -->
  <% if livekit_configured %>
    <button type="button"
            data-call-target="callBtn"
            data-action="click->call#startCall"
            class="text-gray-400 hover:text-white p-1 transition cursor-pointer mr-1"
            title="Start Call">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
    </button>
  <% end %>

  <% if @conversation.group_chat? %>
    <!-- Group settings toggle -->
    <button type="button" class="text-gray-400 hover:text-white p-1 transition cursor-pointer" id="dm-profile-toggle-btn" onclick="window._toggleSidePanel('dm-profile-panel', this)" title="Group Settings">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
    </button>
  <% end %>
  <%= render "shared/header_toolbar", dm_user: @other_user, dm_layout: true %>

  <%= render "shared/search_input" %>
</div>

<%= render "shared/search_panel" %>

<!-- Call panel (voice-channel style, replaces messages during calls) -->
<div data-call-target="callPanel" class="hidden flex flex-col flex-1 min-h-0" style="background: var(--color-gray-950);">
  <!-- Ringing state (outgoing call) -->
  <div data-call-target="ringingState" class="flex-1 flex flex-col items-center justify-center p-8">
    <div class="w-24 h-24 rounded-full flex items-center justify-center mx-auto mb-6" style="background: rgba(255,255,255,0.05);">
      <svg class="w-12 h-12 text-green-400 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
    </div>
    <h2 class="text-xl font-bold text-white mb-1">Calling</h2>
    <p data-call-target="ringingName" class="text-gray-400 mb-6"></p>
    <button type="button" data-action="click->call#cancelCall"
            class="w-14 h-14 bg-red-500 hover:bg-red-600 rounded-full flex items-center justify-center text-white transition cursor-pointer mx-auto" title="Cancel">
      <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 8l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2M5 3a2 2 0 00-2 2v1c0 8.284 6.716 15 15 15h1a2 2 0 002-2v-3.28a1 1 0 00-.684-.948l-4.493-1.498a1 1 0 00-1.21.502l-1.13 2.257a11.042 11.042 0 01-5.516-5.516l2.257-1.13a1 1 0 00.502-1.21L8.228 3.684A1 1 0 007.28 3H5z"/></svg>
    </button>
  </div>

  <!-- Incoming call state -->
  <div data-call-target="incomingState" class="hidden flex-1 flex flex-col items-center justify-center p-8">
    <div class="relative mb-6 mx-auto" style="width: 96px; height: 96px;">
      <div class="w-24 h-24 rounded-full flex items-center justify-center" style="background: rgba(255,255,255,0.05);">
        <img data-call-target="callerAvatar" class="hidden w-20 h-20 rounded-full object-cover" src="" alt="">
        <svg data-call-target="callerAvatarFallback" class="w-12 h-12 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
      </div>
      <div class="absolute inset-0 rounded-full border-2 border-green-400/40 animate-ping"></div>
    </div>
    <h2 class="text-xl font-bold text-white mb-1">Incoming Call</h2>
    <p data-call-target="callerName" class="text-gray-400 mb-6"></p>
    <div class="flex justify-center gap-6">
      <button type="button" data-action="click->call#declineCall"
              class="w-14 h-14 bg-red-500 hover:bg-red-600 rounded-full flex items-center justify-center text-white transition cursor-pointer" title="Decline">
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 8l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2M5 3a2 2 0 00-2 2v1c0 8.284 6.716 15 15 15h1a2 2 0 002-2v-3.28a1 1 0 00-.684-.948l-4.493-1.498a1 1 0 00-1.21.502l-1.13 2.257a11.042 11.042 0 01-5.516-5.516l2.257-1.13a1 1 0 00.502-1.21L8.228 3.684A1 1 0 007.28 3H5z"/></svg>
      </button>
      <button type="button" data-action="click->call#acceptCall"
              class="w-14 h-14 bg-green-500 hover:bg-green-600 rounded-full flex items-center justify-center text-white transition cursor-pointer" title="Accept">
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
      </button>
    </div>
  </div>

  <!-- Active call: participant grid + controls -->
  <div data-call-target="activeState" class="hidden flex flex-col flex-1 min-h-0">
    <div class="flex-1 p-3 overflow-y-auto">
      <div class="voice-grid h-full" data-call-target="grid"></div>
    </div>
    <div class="shrink-0 px-4 py-3 flex items-center justify-center gap-4" style="background: var(--color-gray-950);">
      <span data-call-target="timer" class="text-white/60 text-sm font-mono mr-2">0:00</span>
      <button type="button" data-call-target="muteBtn" data-action="click->call#toggleMute"
              class="w-10 h-10 rounded-full flex items-center justify-center transition cursor-pointer bg-gray-700 hover:bg-gray-600 text-gray-300" title="Toggle Mute">
        <svg data-call-target="muteIcon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/></svg>
      </button>
      <button type="button" data-action="click->call#hangup"
              class="w-12 h-12 bg-red-500 hover:bg-red-600 rounded-full flex items-center justify-center text-white transition cursor-pointer" title="Hang Up">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 8l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2M5 3a2 2 0 00-2 2v1c0 8.284 6.716 15 15 15h1a2 2 0 002-2v-3.28a1 1 0 00-.684-.948l-4.493-1.498a1 1 0 00-1.21.502l-1.13 2.257a11.042 11.042 0 01-5.516-5.516l2.257-1.13a1 1 0 00.502-1.21L8.228 3.684A1 1 0 007.28 3H5z"/></svg>
      </button>
    </div>
  </div>
</div>

<% if active_call %>
  <!-- Join active call banner -->
  <div data-call-target="joinBanner" class="bg-accent/20 border-b border-accent/30 px-4 py-2 flex items-center gap-3 shrink-0" data-call-id="<%= active_call.public_id %>">
    <div class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></div>
    <span class="text-sm text-white flex-1">A call is in progress</span>
    <button type="button" data-action="click->call#joinCall" class="bg-green-500 hover:bg-green-600 text-white text-sm font-medium px-3 py-1 rounded transition cursor-pointer">Join Call</button>
  </div>
<% end %>

<!-- Content area: messages + optional profile panel -->
<div data-call-target="messagesWrapper" class="flex flex-1 min-h-0 min-w-0">
  <!-- Messages column -->
  <div class="flex flex-col flex-1 min-h-0 min-w-0">
    <!-- Messages area -->
    <div id="messages"
         class="flex-1 overflow-y-auto overflow-x-hidden px-2 sm:px-4 py-4 space-y-0.5 relative"
         data-controller="scroll-position image-preview gif-save message-actions"
         data-scroll-position-channel-id-value="dm_<%= @conversation.public_id %>"
         data-scroll-position-base-url-value="<%= conversation_dm_messages_path(@conversation) %>"
         data-scroll-position-has-older-value="<%= @has_older %>"
         <% if @messages.any? %>data-scroll-position-oldest-message-id-value="<%= @messages.first.public_id %>"<% end %>>
      <% if @messages.empty? %>
        <div class="flex flex-col items-center justify-center h-full text-center">
          <% if @other_user %>
            <div class="w-20 h-20 rounded-full flex items-center justify-center text-3xl mb-4 overflow-hidden">
              <% if @other_user.effective_avatar_url.present? %>
                <%= image_tag @other_user.effective_avatar_url, class: "w-full h-full object-cover" %>
              <% else %>
                <div class="w-full h-full flex items-center justify-center text-2xl font-bold text-white" style="background-color: <%= @other_user.profile_color || '#1e1c1b' %>">
                  <%= @other_user.username[0].upcase %>
                </div>
              <% end %>
            </div>
            <h2 class="text-2xl font-bold text-white"><%= @other_user.display_name.presence || @other_user.username %></h2>
            <p class="text-gray-400 mt-1"><%= @other_user.tag %></p>
            <p class="text-gray-400 mt-2 text-sm">This is the beginning of your direct message history with <strong class="text-white"><%= @other_user.display_name.presence || @other_user.username %></strong>.</p>
          <% elsif @dm_contact %>
            <div class="w-20 h-20 rounded-full flex items-center justify-center text-3xl mb-4 overflow-hidden">
              <% if @dm_contact.avatar_url.present? %>
                <%= image_tag @dm_contact.avatar_url, class: "w-full h-full object-cover" %>
              <% else %>
                <div class="w-full h-full flex items-center justify-center text-2xl font-bold text-white bg-gray-600">
                  <%= @dm_contact.effective_display_name[0].upcase %>
                </div>
              <% end %>
            </div>
            <h2 class="text-2xl font-bold text-white"><%= @dm_contact.effective_display_name %></h2>
            <p class="text-gray-400 mt-2 text-sm">This is the beginning of your direct message history with <strong class="text-white"><%= @dm_contact.effective_display_name %></strong>.</p>
          <% else %>
            <h2 class="text-2xl font-bold text-white"><%= @conversation.display_name(current_user) %></h2>
            <p class="text-gray-400 mt-1">This is the beginning of this conversation.</p>
          <% end %>
        </div>
      <% else %>
        <% @messages.each do |message| %>
          <%= render partial: "messages/dm_message", locals: { message: message } %>
        <% end %>
      <% end %>
    </div>

    <!-- New messages bar -->
    <div data-scroll-position-target="newMessageBar" class="hidden">
      <button class="w-full bg-gradient-to-r from-confirm-dark to-confirm hover:from-confirm hover:to-confirm-light text-white text-sm py-1.5 px-4 flex items-center justify-center gap-2 cursor-pointer transition"
              data-action="click->scroll-position#jumpToBottom">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
        <span data-count>New message</span>
      </button>
    </div>

    <!-- Typing indicator -->
    <div id="typing-indicator" class="px-4 h-6 text-xs text-gray-400"></div>

    <!-- Message input -->
    <div class="px-2 sm:px-4 pb-4 mt-auto shrink-0 relative">
      <!-- Edit bar -->
      <div data-dm-message-form-target="editBar" class="hidden bg-gray-700 rounded-t-lg px-4 py-2 flex items-center text-sm border-b border-gray-600">
        <svg class="w-4 h-4 text-accent-light mr-1.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
        <span class="text-accent-light font-medium mr-2">Editing message</span>
        <span data-dm-message-form-target="editPreview" class="text-gray-400 truncate flex-1"></span>
        <button type="button" class="text-gray-400 hover:text-gray-200 ml-2 shrink-0" data-action="click->dm-message-form#clearEdit">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <!-- Reply bar -->
      <div data-dm-message-form-target="replyBar" class="hidden bg-gray-700 rounded-t-lg px-4 py-2 flex items-center text-sm border-b border-gray-600">
        <span class="text-gray-400 mr-1">Replying to</span>
        <span data-dm-message-form-target="replyAuthor" class="text-accent-light font-medium mr-2"></span>
        <span data-dm-message-form-target="replyPreview" class="text-gray-400 truncate flex-1"></span>
        <button type="button" class="text-gray-400 hover:text-gray-200 ml-2 shrink-0" data-action="click->dm-message-form#clearReply">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <!-- File preview area -->
      <div data-dm-message-form-target="filePreview" class="hidden bg-gray-700 px-4 py-2 flex flex-wrap border-b border-gray-600"></div>

      <%= form_with model: @message, url: conversation_dm_messages_path(@conversation), html: { multipart: true, class: "relative" }, data: { action: "turbo:submit-end->dm-message-form#handleSubmit" } do |f| %>
        <%= f.hidden_field :parent_id, data: { dm_message_form_target: "parentId" } %>
        <div class="flex items-center bg-gray-600 rounded-lg px-1 sm:px-2">
          <!-- File upload -->
          <label class="text-gray-400 hover:text-gray-200 shrink-0 cursor-pointer p-2">
            <%= f.file_field :files, multiple: true, class: "hidden", accept: "image/*,video/*,audio/*,.pdf,.txt,.zip,.md,.gif", data: { action: "change->dm-message-form#handleFileSelect" } %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          </label>

          <div class="flex-1 relative min-w-0">
            <div data-dm-message-form-target="highlight" class="absolute inset-0 py-2 px-1 text-sm leading-6 whitespace-pre-wrap break-words pointer-events-none overflow-hidden" aria-hidden="true"></div>
            <%= f.text_area :content,
                placeholder: "Message @#{@other_user&.display_name.presence || @other_user&.username || @conversation.display_name(current_user)}",
                spellcheck: false,
                class: "w-full bg-transparent text-transparent caret-white placeholder-gray-400 py-2 px-1 resize-none outline-none text-sm leading-6 max-h-48 relative z-10",
                rows: 1,
                data: { action: "keydown->dm-message-form#handleKeydown input->dm-message-form#autoResize input->dm-message-form#updateHighlight", dm_message_form_target: "input", unified_picker_target: "input" } %>
          </div>

          <!-- Unified Picker button -->
          <div class="relative">
            <button type="button" class="text-gray-400 hover:text-gray-200 shrink-0 p-2" data-action="click->unified-picker#toggle">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </button>
            <!-- Unified Picker panel -->
            <div data-unified-picker-target="panel" class="hidden fixed bottom-0 left-0 right-0 sm:absolute sm:bottom-12 sm:left-auto sm:right-0 w-full sm:w-96 bg-gray-800 border border-gray-700 rounded-t-lg sm:rounded-lg shadow-xl z-50 flex flex-col" style="max-height: min(420px, 60vh);">
              <!-- Tabs -->
              <div class="flex border-b border-gray-700 shrink-0">
                <button type="button" data-unified-picker-target="tabGifs" data-tab="gifs" data-action="click->unified-picker#switchTab" class="flex-1 py-2 text-xs font-semibold text-center border-b-2 border-transparent text-gray-400 hover:text-white transition cursor-pointer">GIFs</button>
                <button type="button" data-unified-picker-target="tabStickers" data-tab="stickers" data-action="click->unified-picker#switchTab" class="flex-1 py-2 text-xs font-semibold text-center border-b-2 border-transparent text-gray-400 hover:text-white transition cursor-pointer">Stickers</button>
                <button type="button" data-unified-picker-target="tabEmoji" data-tab="emoji" data-action="click->unified-picker#switchTab" class="flex-1 py-2 text-xs font-semibold text-center border-b-2 border-accent text-white transition cursor-pointer">Emoji</button>
              </div>
              <!-- Search -->
              <div class="px-3 py-2 shrink-0">
                <input type="text" data-unified-picker-target="searchInput" data-action="input->unified-picker#onSearch" placeholder="Search..." class="w-full bg-gray-700 text-gray-200 text-sm rounded px-3 py-1.5 outline-none placeholder-gray-500 focus:ring-1 focus:ring-accent">
              </div>
              <!-- Content -->
              <div data-unified-picker-target="content" class="flex-1 overflow-y-auto px-2 pb-2 min-h-0"></div>
            </div>
          </div>

          <button type="submit" class="text-gray-400 hover:text-accent shrink-0 p-2">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
          </button>
        </div>
      <% end %>
    </div>

    <!-- Drag-and-drop overlay -->
    <div data-dm-message-form-target="dropzone" class="hidden fixed inset-0 bg-gray-900/80 z-50 flex items-center justify-center pointer-events-auto">
      <div class="border-2 border-dashed border-accent rounded-2xl p-12 text-center">
        <svg class="w-16 h-16 text-accent-light mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/></svg>
        <p class="text-xl text-white font-semibold">Drop files to upload</p>
      </div>
    </div>
  </div>

  <% if @conversation.group_chat? %>
    <%= render "conversations/group_settings" %>
  <% end %>
  <%= render "conversations/dm_member_sidebar" if @conversation %>

  <% dm_profile = @other_user || @dm_contact %>
  <% if dm_profile && @conversation.direct? %>
    <!-- DM Profile Panel (right sidebar) -->
    <aside id="dm-profile-panel" class="hidden w-80 bg-gray-800 border-l border-gray-900 overflow-y-auto shrink-0">
      <!-- Banner -->
      <div class="h-[120px] relative">
        <% dm_banner = dm_profile.try(:effective_banner_url) || dm_profile.try(:banner_url) %>
        <% if dm_banner.present? %>
          <%= image_tag dm_banner, class: "w-full h-full object-cover",
              style: "object-position: center #{(dm_profile.try(:banner_offset_y) || 0)}px;" %>
        <% else %>
          <div class="w-full h-full" style="background-color: <%= dm_profile.try(:profile_color) || '#1e1c1b' %>"></div>
        <% end %>
      </div>

      <!-- Profile info -->
      <div class="relative px-4 pb-4">
        <!-- Avatar -->
        <div class="relative -mt-[40px] mb-3">
          <div class="w-[80px] h-[80px] rounded-full p-[4px] inline-block" style="background-color: <%= dm_profile.try(:profile_color_2).presence || dm_profile.try(:profile_color) || '#1e1c1b' %>">
            <% dm_avatar_panel = dm_profile.try(:effective_avatar_url) || dm_profile.try(:avatar_url) %>
            <% if dm_avatar_panel.present? %>
              <%= image_tag dm_avatar_panel, class: "w-full h-full rounded-full object-cover" %>
            <% else %>
              <div class="w-full h-full rounded-full flex items-center justify-center text-2xl font-bold text-white" style="background-color: <%= dm_profile.try(:profile_color) || '#1e1c1b' %>">
                <%= (dm_profile.try(:username) || dm_profile.try(:effective_display_name) || "?")[0].upcase %>
              </div>
            <% end %>
          </div>
          <% if @other_user %>
            <% status_color = case @other_user.online_state
                              when "online" then "bg-green-500"
                              when "idle" then "bg-warning"
                              when "dnd" then "bg-red-500"
                              else "bg-gray-500"
                              end %>
          <% else %>
            <% status_color = @dm_contact&.online? ? "bg-green-500" : "bg-gray-500" %>
          <% end %>
          <div data-dm-presence-dot class="absolute bottom-[2px] left-[56px] w-[20px] h-[20px] rounded-full border-[4px] <%= status_color %>" style="border-color: <%= dm_profile.try(:profile_color_2).presence || dm_profile.try(:profile_color) || '#1e1c1b' %>"></div>
        </div>

        <!-- Card content -->
        <div class="bg-black/30 rounded-lg p-3 space-y-3">
          <div>
            <h3 class="text-lg font-bold text-white leading-tight"><%= @other_user ? (@other_user.display_name.presence || @other_user.username) : @dm_contact.effective_display_name %></h3>
            <% if @other_user %>
              <p class="text-xs text-white/60"><%= @other_user.tag %></p>
            <% elsif @dm_contact&.npub %>
              <p class="text-xs text-white/60 truncate"><%= @dm_contact.npub %></p>
            <% end %>
          </div>

          <% profile_status = dm_profile.try(:status) %>
          <% if profile_status.present? %>
            <p class="text-sm text-white/70"><%= dm_profile.try(:status_emoji) %> <%= profile_status %></p>
          <% end %>

          <% profile_bio = dm_profile.try(:bio) %>
          <% if profile_bio.present? %>
            <div class="border-t border-white/10 pt-2">
              <h4 class="text-[10px] font-semibold text-white/50 uppercase mb-1">About Me</h4>
              <p class="text-sm text-white/80"><%= profile_bio %></p>
            </div>
          <% end %>

          <% if @other_user %>
            <div class="border-t border-white/10 pt-2">
              <h4 class="text-[10px] font-semibold text-white/50 uppercase mb-0.5">Member Since</h4>
              <p class="text-[11px] text-white/50"><%= @other_user.created_at.strftime("%b %d, %Y") %></p>
            </div>
          <% end %>
        </div>

        <% dm_pubkey = @other_user&.nostr_public_key || @dm_contact&.pubkey %>
        <% dm_friend = Contact.find_by(pubkey: dm_pubkey) if dm_pubkey.present? %>
        <% if dm_friend || dm_pubkey.present? %>
          <div class="mt-2">
            <% if dm_friend&.accepted? %>
              <%= button_to friendship_path(dm_friend), method: :delete,
                    class: "w-full py-1.5 text-sm text-danger-light hover:bg-danger/20 rounded cursor-pointer text-center",
                    data: { turbo_confirm: "Remove friend?" } do %>
                Remove Friend
              <% end %>
            <% elsif dm_friend&.pending_outgoing? %>
              <div class="w-full py-1.5 text-sm text-gray-500 text-center">Friend Request Sent</div>
            <% elsif dm_friend&.pending_incoming? %>
              <div class="flex gap-2">
                <%= button_to accept_friendship_path(dm_friend), method: :post,
                      class: "flex-1 py-1.5 text-sm text-green-400 hover:bg-green-600/20 rounded cursor-pointer text-center" do %>
                  Accept
                <% end %>
                <%= button_to decline_friendship_path(dm_friend), method: :post,
                      class: "flex-1 py-1.5 text-sm text-gray-400 hover:bg-gray-700 rounded cursor-pointer text-center" do %>
                  Decline
                <% end %>
              </div>
            <% elsif dm_pubkey.present? %>
              <% npub_val = @other_user&.npub || @dm_contact&.npub %>
              <% if npub_val.present? %>
                <%= button_to friendships_path(tag: npub_val), method: :post,
                      class: "w-full py-1.5 text-sm text-white bg-accent hover:bg-accent-light rounded cursor-pointer text-center font-medium" do %>
                  Add Friend
                <% end %>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    </aside>
  <% end %>
</div>

</div>
<% end %>
