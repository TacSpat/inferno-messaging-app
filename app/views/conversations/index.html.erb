<%= turbo_frame_tag "main-content", class: "flex flex-col flex-1 min-h-0", data: { turbo_action: "advance" } do %>
<!-- Header bar -->
<div class="shrink-0 border-b border-gray-900 shadow-sm">
  <div class="flex items-center h-12 px-4">
    <!-- Hamburger menu (mobile only) -->
    <button type="button" class="md:hidden text-gray-400 hover:text-white mr-2 p-1" data-action="click->mobile-nav#toggleSidebar">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>

    <svg class="w-5 h-5 text-gray-400 mr-2" fill="currentColor" viewBox="0 0 24 24">
      <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
    </svg>
    <h2 class="font-semibold text-white">Contacts</h2>
  </div>

  <!-- Tab buttons -->
  <div class="flex items-center gap-1 px-4 pb-2 overflow-x-auto">
    <% tabs = [
      { key: 'online', label: 'Online' },
      { key: 'all', label: 'All' },
      { key: 'pending', label: 'Pending' },
      { key: 'blocked', label: 'Blocked' },
    ] %>
    <% tabs.each do |tab| %>
      <%= link_to conversations_path(tab: tab[:key]),
            class: "px-3 py-1.5 rounded text-sm font-medium transition-colors whitespace-nowrap #{@tab == tab[:key] ? 'bg-gray-600 text-white' : 'text-gray-300 hover:bg-gray-600/50 hover:text-white'}" do %>
        <%= tab[:label] %>
        <% if tab[:key] == 'pending' && @pending_count && @pending_count > 0 %>
          <span class="ml-1 bg-accent text-white text-xs rounded-full px-1.5 min-w-[18px] inline-flex items-center justify-center"><%= @pending_count %></span>
        <% end %>
      <% end %>
    <% end %>

    <%= link_to conversations_path(tab: 'search'),
          class: "px-3 py-1.5 rounded text-sm font-medium transition-colors whitespace-nowrap #{@tab == 'search' ? 'text-white bg-green-600' : 'text-white bg-green-600/80 hover:bg-green-600'}" do %>
      Search
    <% end %>
  </div>
</div>

<!-- Tab content -->
<div class="flex-1 overflow-y-auto">
  <% if @tab == 'search' %>
    <!-- Search tab -->
    <div class="p-4 border-b border-gray-600" data-controller="nostr-search">
      <h3 class="text-white font-semibold mb-1">Find People</h3>
      <p class="text-sm text-gray-400 mb-3">Search by name, npub, or NIP-05 identifier (user@domain).</p>
      <div class="relative">
        <div class="flex items-center gap-2 bg-gray-900 rounded-lg px-3 sm:px-4 py-2.5 border border-gray-700 focus-within:border-accent">
          <svg class="w-5 h-5 text-gray-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <input type="text"
                 data-nostr-search-target="input"
                 data-action="input->nostr-search#onInput keydown->nostr-search#onKeydown focus->nostr-search#onFocus"
                 placeholder="Search by name, npub, or user@domain..."
                 class="flex-1 bg-transparent text-white text-base sm:text-sm placeholder-gray-500 focus:outline-none py-1"
                 autocomplete="off"
                 autofocus>
          <div data-nostr-search-target="spinner" class="hidden">
            <svg class="w-5 h-5 text-gray-400 animate-spin" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"/>
            </svg>
          </div>
        </div>

        <!-- Dropdown overlay -->
        <div data-nostr-search-target="dropdown"
             class="hidden absolute z-50 left-0 right-0 mt-1 bg-gray-800 border border-gray-700 rounded-lg shadow-xl max-h-80 overflow-y-auto">
        </div>
      </div>
      <p class="text-xs text-gray-500 px-1 mt-2">Searches Nostr relays for matching profiles. Try a name, npub1..., or alice@example.com</p>
    </div>

  <% elsif @tab == 'pending' %>
    <!-- Pending tab -->
    <div class="px-2 sm:px-4 pt-3">
      <% if @incoming&.any? %>
        <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-2 px-2">
          Incoming — <%= @incoming.count %>
        </h3>
        <% @incoming.each do |contact| %>
          <div class="flex items-center px-2 py-2.5 rounded hover:bg-gray-600/30 group border-b border-gray-700/50 last:border-b-0">
            <div class="relative shrink-0">
              <% if contact.avatar_url.present? %>
                <%= image_tag contact.avatar_url, class: "w-9 h-9 rounded-full object-cover" %>
              <% else %>
                <div class="w-9 h-9 rounded-full flex items-center justify-center text-sm font-bold bg-gray-600">
                  <%= contact.effective_display_name[0].upcase %>
                </div>
              <% end %>
            </div>
            <div class="ml-3 flex-1 min-w-0">
              <p class="text-sm font-medium text-white truncate"><%= contact.effective_display_name %></p>
              <p class="text-xs text-gray-400">Incoming Friend Request</p>
            </div>
            <div class="flex items-center gap-2">
              <%= button_to accept_friendship_path(contact), method: :post, class: "w-9 h-9 flex items-center justify-center rounded-full bg-gray-700 hover:bg-gray-600 text-gray-300 hover:text-green-400 cursor-pointer" do %>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <% end %>
              <%= button_to decline_friendship_path(contact), method: :post, class: "w-9 h-9 flex items-center justify-center rounded-full bg-gray-700 hover:bg-gray-600 text-gray-300 hover:text-danger-light cursor-pointer" do %>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>

      <% if @outgoing&.any? %>
        <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-2 mt-4 px-2">
          Outgoing — <%= @outgoing.count %>
        </h3>
        <% @outgoing.each do |contact| %>
          <div class="flex items-center px-2 py-2.5 rounded hover:bg-gray-600/30 group border-b border-gray-700/50 last:border-b-0">
            <div class="relative shrink-0">
              <% if contact.avatar_url.present? %>
                <%= image_tag contact.avatar_url, class: "w-9 h-9 rounded-full object-cover" %>
              <% else %>
                <div class="w-9 h-9 rounded-full flex items-center justify-center text-sm font-bold bg-gray-600">
                  <%= contact.effective_display_name[0].upcase %>
                </div>
              <% end %>
            </div>
            <div class="ml-3 flex-1 min-w-0">
              <p class="text-sm font-medium text-white truncate"><%= contact.effective_display_name %></p>
              <p class="text-xs text-gray-400">Outgoing Friend Request</p>
            </div>
            <div class="flex items-center gap-2">
              <%= button_to friendship_path(contact), method: :delete, class: "w-9 h-9 flex items-center justify-center rounded-full bg-gray-700 hover:bg-gray-600 text-gray-300 hover:text-danger-light cursor-pointer" do %>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>

      <% if !@incoming&.any? && !@outgoing&.any? %>
        <div class="flex flex-col items-center justify-center py-16 text-gray-400">
          <svg class="w-16 h-16 mb-4 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          <p class="text-sm">There are no pending friend requests.</p>
        </div>
      <% end %>
    </div>

  <% elsif @tab == 'blocked' %>
    <!-- Blocked tab -->
    <div class="px-2 sm:px-4 pt-3">
      <% if @blocked&.any? %>
        <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-2 px-2">
          Blocked — <%= @blocked.count %>
        </h3>
        <% @blocked.each do |user| %>
          <div class="flex items-center px-2 py-2.5 rounded hover:bg-gray-600/30 group border-b border-gray-700/50 last:border-b-0">
            <div class="relative shrink-0">
              <% if user.avatar.attached? %>
                <%= image_tag user.avatar, class: "w-9 h-9 rounded-full object-cover" %>
              <% else %>
                <div class="w-9 h-9 rounded-full flex items-center justify-center text-sm font-bold" style="background-color: <%= user.profile_color || '#1e1c1b' %>">
                  <%= user.username[0].upcase %>
                </div>
              <% end %>
            </div>
            <div class="ml-3 flex-1 min-w-0">
              <p class="text-sm font-medium text-white truncate"><%= user.display_name.presence || user.username %></p>
              <p class="text-xs text-gray-400">Blocked</p>
            </div>
            <div class="flex items-center gap-2">
              <% block = current_user.blocks.find_by(blocked_id: user.id) %>
              <% if block %>
                <%= button_to block_path(block), method: :delete, class: "px-3 py-1.5 bg-gray-700 hover:bg-gray-600 text-sm text-gray-300 hover:text-white rounded cursor-pointer" do %>
                  Unblock
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="flex flex-col items-center justify-center py-16 text-gray-400">
          <p class="text-sm">You haven't blocked anyone.</p>
        </div>
      <% end %>
    </div>

  <% else %>
    <!-- Online / All contacts tab -->
    <div class="px-2 sm:px-4 pt-3">
      <% if @contacts&.any? %>
        <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-2 px-2">
          <%= @tab == 'online' ? 'Online' : 'All Contacts' %> — <%= @contacts.count %>
        </h3>
        <% @contacts.each do |contact| %>
          <div class="flex items-center px-2 py-2.5 rounded hover:bg-gray-600/30 group border-b border-gray-700/50 last:border-b-0 cursor-pointer"
               onclick="document.getElementById('dm-contact-<%= contact.id %>').requestSubmit()">
            <div class="relative shrink-0">
              <% if contact.avatar_url.present? %>
                <%= image_tag contact.avatar_url, class: "w-9 h-9 rounded-full object-cover" %>
              <% else %>
                <div class="w-9 h-9 rounded-full flex items-center justify-center text-sm font-bold bg-gray-600">
                  <%= contact.effective_display_name[0].upcase %>
                </div>
              <% end %>
              <div class="absolute -bottom-0.5 -right-0.5 w-3.5 h-3.5 rounded-full border-2 border-gray-700 <%= contact.online? ? 'bg-green-500' : 'bg-gray-500' %>"></div>
            </div>
            <div class="ml-3 flex-1 min-w-0">
              <p class="text-sm font-medium text-white truncate"><%= contact.effective_display_name %></p>
              <p class="text-xs text-gray-400 truncate"><%= contact.online? ? 'Online' : 'Offline' %></p>
            </div>
            <div class="flex items-center gap-2 sm:opacity-0 sm:group-hover:opacity-100 transition-opacity" onclick="event.stopPropagation()">
              <%= button_to friendship_path(contact), method: :delete, data: { turbo_confirm: "Remove #{contact.effective_display_name} from your contacts?" }, class: "w-9 h-9 flex items-center justify-center rounded-full bg-gray-700 hover:bg-gray-600 text-gray-300 hover:text-danger-light cursor-pointer" do %>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
              <% end %>
            </div>
            <%= form_tag conversations_path, method: :post, id: "dm-contact-#{contact.id}", class: "hidden", data: { turbo_frame: "_top" } do %>
              <%= hidden_field_tag :pubkey, contact.pubkey %>
            <% end %>
          </div>
        <% end %>
      <% end %>

      <% unless @contacts&.any? %>
        <div class="flex flex-col items-center justify-center py-16 text-gray-400">
          <svg class="w-16 h-16 mb-4 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          <p class="text-sm"><%= @tab == 'online' ? "No contacts are online right now." : "You don't have any contacts yet. Add some!" %></p>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
<% end %>
