<div id="new-group-chat-modal" class="hidden fixed inset-0 z-[200] bg-black/60 flex items-center justify-center" data-controller="group-chat-modal">
  <div class="bg-gray-800 rounded-xl shadow-2xl w-full max-w-md mx-4 overflow-hidden">
    <div class="px-5 pt-5 pb-3 flex items-center justify-between">
      <h3 class="text-lg font-semibold text-white">New Group Chat</h3>
      <button type="button" class="w-8 h-8 rounded-full flex items-center justify-center text-gray-400 hover:text-white hover:bg-gray-700 transition cursor-pointer" onclick="document.getElementById('new-group-chat-modal').classList.add('hidden')">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <%= form_tag conversations_path, method: :post, data: { turbo_frame: "_top" } do %>
      <div class="px-5 pb-5 space-y-4">
        <!-- Group name -->
        <div>
          <label class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1 block">Group Name</label>
          <input type="text" name="group_chat[name]" placeholder="My Group Chat" maxlength="100"
                 class="w-full bg-gray-900 border border-gray-600 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:border-accent"
                 data-group-chat-modal-target="nameInput">
        </div>

        <!-- Member search -->
        <div>
          <label class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1 block">Add Members</label>
          <input type="text" placeholder="Search contacts..."
                 class="w-full bg-gray-900 border border-gray-600 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:border-accent mb-2"
                 data-group-chat-modal-target="searchInput"
                 data-action="input->group-chat-modal#filterContacts">

          <!-- Selected members pills -->
          <div data-group-chat-modal-target="selectedPills" class="flex flex-wrap gap-1 mb-2"></div>

          <!-- Contact list -->
          <div data-group-chat-modal-target="contactList" class="max-h-40 overflow-y-auto space-y-1">
            <% Contact.friends.each do |contact| %>
              <% user = User.find_by(nostr_public_key: contact.pubkey) %>
              <% member_id = user ? "user:#{user.public_id}" : "contact:#{contact.id}" %>
              <button type="button"
                      class="flex items-center w-full px-3 py-2 text-sm text-gray-300 hover:bg-gray-700 rounded-lg transition"
                      data-group-chat-modal-target="contactItem"
                      data-contact-name="<%= contact.effective_display_name %>"
                      data-user-id="<%= member_id %>"
                      data-action="click->group-chat-modal#toggleContact">
                <% if contact.avatar_url.present? %>
                  <%= image_tag contact.avatar_url, class: "w-6 h-6 rounded-full object-cover mr-2" %>
                <% else %>
                  <div class="w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold bg-gray-600 mr-2">
                    <%= contact.effective_display_name[0].upcase %>
                  </div>
                <% end %>
                <span class="truncate"><%= contact.effective_display_name %></span>
                <svg class="w-4 h-4 ml-auto text-green-400 hidden" data-check-icon fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              </button>
            <% end %>
          </div>
        </div>
      </div>

      <div class="px-5 py-3 flex justify-end gap-3" style="background: var(--color-gray-900);">
        <button type="button" class="px-4 py-2 text-sm font-medium text-gray-300 hover:text-white transition cursor-pointer" onclick="document.getElementById('new-group-chat-modal').classList.add('hidden')">Cancel</button>
        <button type="submit" class="px-5 py-2 text-sm bg-accent hover:bg-accent-light text-white rounded font-semibold transition cursor-pointer">Create Group</button>
      </div>
    <% end %>
  </div>
</div>
