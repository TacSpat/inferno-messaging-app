<aside data-mobile-nav-target="channelSidebar" class="hidden md:flex flex-col w-60 bg-gray-800 shrink-0 mobile-channel-sidebar">
  <!-- Search header -->
  <div class="flex items-center px-4 h-12 border-b border-gray-900 shadow-sm">
    <button class="w-full px-2 py-1 text-sm text-gray-400 bg-gray-900 rounded text-left">
      Find or start a conversation
    </button>
  </div>

  <!-- Navigation -->
  <div class="flex-1 overflow-y-auto pt-2 px-2 space-y-0.5">
    <!-- Friends link -->
    <% friends_active = controller_name == 'conversations' && action_name == 'index' %>
    <%= link_to conversations_path, class: "flex items-center px-2.5 py-2 rounded #{friends_active ? 'bg-gray-700 text-white' : 'text-gray-400 hover:bg-gray-700 hover:text-gray-200'}" do %>
      <svg class="w-5 h-5 mr-3" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
      </svg>
      <span class="font-medium text-sm">Friends</span>
    <% end %>

    <!-- Direct Messages header -->
    <div class="flex items-center justify-between px-2.5 pt-4 pb-1">
      <span class="text-xs font-semibold text-gray-400 uppercase tracking-wide">Direct Messages</span>
    </div>

    <!-- Conversation list -->
    <% @conversations&.each do |conversation| %>
      <% other = conversation.direct? ? conversation.other_user(current_user) : nil %>
      <% cp = conversation.conversation_participants.find_by(user: current_user) %>
      <% unread = cp&.unread_count || 0 %>
      <%= link_to conversation_path(conversation), data: { conversation_id: conversation.public_id }, class: "flex items-center px-2.5 py-1.5 rounded group #{defined?(@conversation) && @conversation == conversation ? 'bg-gray-700 text-white' : 'text-gray-400 hover:bg-gray-700 hover:text-gray-200'}" do %>
        <div class="relative shrink-0">
          <% if other&.avatar&.attached? %>
            <%= image_tag other.avatar, class: "w-8 h-8 rounded-full object-cover" %>
          <% else %>
            <div class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold" style="background-color: <%= other&.profile_color || '#2b2d31' %>">
              <%= other&.username&.first&.upcase || '?' %>
            </div>
          <% end %>
          <% if other %>
            <div class="absolute -bottom-0.5 -right-0.5 w-3.5 h-3.5 rounded-full border-2 border-gray-800 <%= other.online_state.present? && other.online_state != 'offline' ? 'bg-green-500' : 'bg-gray-500' %>"></div>
          <% end %>
        </div>
        <div class="ml-2.5 min-w-0 flex-1">
          <p class="text-sm font-medium truncate">
            <%= conversation.display_name(current_user) %>
          </p>
        </div>
        <% if unread > 0 %>
          <div class="mention-badge ml-auto min-w-[18px] h-[18px] bg-red-500 rounded-full flex items-center justify-center text-white text-xs font-bold px-1 shrink-0">
            <%= unread > 99 ? '99+' : unread %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <!-- User panel (bottom) -->
  <div class="flex items-center px-2 py-2 border-t border-gray-900" style="background-color: #1a1b1e;">
    <div class="relative">
      <% if current_user.avatar.attached? %>
        <%= image_tag current_user.avatar, class: "w-8 h-8 rounded-full object-cover" %>
      <% else %>
        <div class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold" style="background-color: <%= current_user.profile_color || '#2b2d31' %>">
          <%= current_user.username[0].upcase %>
        </div>
      <% end %>
      <div class="absolute -bottom-0.5 -right-0.5 w-3.5 h-3.5 rounded-full border-2 border-gray-900 bg-gray-500" data-user-status-dot></div>
    </div>
    <div class="ml-2 flex-1 min-w-0">
      <p class="text-sm font-medium text-white truncate"><%= current_user.display_name.presence || current_user.username %></p>
      <p class="text-xs text-gray-400 truncate"><%= current_user.tag %></p>
    </div>
    <button onclick="document.dispatchEvent(new CustomEvent('open-settings'))" class="text-gray-400 hover:text-gray-200 p-1 cursor-pointer">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
    </button>
  </div>
</aside>
