<aside data-mobile-nav-target="channelSidebar" class="hidden md:flex flex-col w-60 bg-gray-800 shrink-0 mobile-channel-sidebar">
  <!-- Search header -->
  <div class="flex items-center justify-between px-3 h-12 border-b border-gray-900 shadow-sm">
    <h2 class="font-semibold text-white text-sm">Direct Messages</h2>
    <div class="flex items-center gap-1">
      <button class="w-8 h-8 flex items-center justify-center rounded text-gray-400 hover:text-white hover:bg-gray-700 transition-colors" title="Find or start a conversation">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      </button>
      <%= link_to conversations_path(tab: 'add_friend'), data: { turbo_frame: "main-content" }, class: "w-8 h-8 flex items-center justify-center rounded text-gray-400 hover:text-white hover:bg-gray-700 transition-colors", title: "Add Friend" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
      <% end %>
    </div>
  </div>

  <!-- Navigation -->
  <div class="flex-1 overflow-y-auto pt-2 px-2 space-y-0.5">
    <!-- Friends link -->
    <% friends_active = controller_name == 'conversations' && action_name == 'index' %>
    <%= link_to conversations_path, data: { turbo_frame: "main-content" }, class: "flex items-center px-2.5 py-2 rounded #{friends_active ? 'bg-gray-700 text-white' : 'text-gray-400 hover:bg-gray-700 hover:text-gray-200'}" do %>
      <svg class="w-5 h-5 mr-3" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
      </svg>
      <span class="font-medium text-sm">Friends</span>
    <% end %>

    <!-- Conversation list -->
    <% @conversations&.each do |conversation| %>
      <% other = conversation.direct? ? conversation.other_user(current_user) : nil %>
      <% contact = other ? nil : conversation.counterparty_contact %>
      <% cp = conversation.conversation_participants.find_by(user: current_user) %>
      <% unread = cp&.unread_count || 0 %>
      <%= link_to conversation_path(conversation), data: { conversation_id: conversation.public_id, turbo_frame: "main-content" }, class: "flex items-center px-2.5 py-1.5 rounded group #{defined?(@conversation) && @conversation == conversation ? 'bg-gray-700 text-white' : 'text-gray-400 hover:bg-gray-700 hover:text-gray-200'}" do %>
        <div class="relative shrink-0">
          <% if other&.avatar&.attached? %>
            <%= image_tag other.avatar, class: "w-8 h-8 rounded-full object-cover" %>
          <% elsif other&.effective_avatar_url.present? %>
            <%= image_tag other.effective_avatar_url, class: "w-8 h-8 rounded-full object-cover" %>
          <% elsif contact&.avatar_url.present? %>
            <%= image_tag contact.avatar_url, class: "w-8 h-8 rounded-full object-cover" %>
          <% else %>
            <div class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold" style="background-color: <%= other&.profile_color || '#1e1c1b' %>">
              <%= other&.username&.first&.upcase || conversation.counterparty_display_name&.first&.upcase || '?' %>
            </div>
          <% end %>
          <% if other %>
            <% dm_status = case other.online_state
                           when "online" then "bg-green-500"
                           when "idle" then "bg-yellow-500"
                           when "dnd" then "bg-red-500"
                           else "bg-gray-500"
                           end %>
            <div data-user-presence="<%= other.public_id %>" class="absolute -bottom-0.5 -right-0.5 w-3.5 h-3.5 rounded-full border-2 border-gray-800 <%= dm_status %>"></div>
          <% elsif contact %>
            <div class="absolute -bottom-0.5 -right-0.5 w-3.5 h-3.5 rounded-full border-2 border-gray-800 <%= contact.online? ? 'bg-green-500' : 'bg-gray-500' %>"></div>
          <% end %>
        </div>
        <div class="ml-2.5 min-w-0 flex-1">
          <p class="text-sm font-medium truncate">
            <%= conversation.display_name(current_user) %>
          </p>
        </div>
        <% if unread > 0 %>
          <div class="mention-badge ml-auto min-w-[18px] h-[18px] bg-accent rounded-full flex items-center justify-center text-white text-xs font-bold px-1 shrink-0">
            <%= unread > 99 ? '99+' : unread %>
          </div>
        <% end %>
      <% end %>
    <% end %>

  </div>

  <script>
    (function() {
      const ACTIVE = ["bg-gray-700", "text-white"]
      const INACTIVE = ["text-gray-400", "hover:bg-gray-700", "hover:text-gray-200"]

      function setActive(link) {
        link.classList.remove(...INACTIVE)
        link.classList.add(...ACTIVE)
      }
      function setInactive(link) {
        link.classList.remove(...ACTIVE)
        link.classList.add(...INACTIVE)
      }

      function updateAll(activeHref) {
        const friendsLink = document.querySelector("a[href='/conversations']")
        document.querySelectorAll("[data-conversation-id]").forEach(link => {
          if (link.getAttribute("href") === activeHref) setActive(link)
          else setInactive(link)
        })
        if (friendsLink) {
          if (activeHref === "/conversations" || activeHref?.startsWith("/conversations?")) setActive(friendsLink)
          else setInactive(friendsLink)
        }
      }

      // Immediate feedback on click
      document.addEventListener("click", (e) => {
        const link = e.target.closest("a[data-conversation-id], a[href='/conversations']")
        if (!link || link.dataset.turboFrame !== "main-content") return
        updateAll(link.getAttribute("href"))
      })

      // Sync after frame load (handles back/forward, initial load)
      document.addEventListener("turbo:frame-load", (e) => {
        if (e.target.id !== "main-content") return
        updateAll(window.location.pathname)
      })
    })()
  </script>

  <!-- User panel (bottom) -->
  <div class="flex items-center px-2 py-2 border-t border-gray-900" style="background-color: #0a0a09;">
    <div class="relative">
      <% if current_user.avatar.attached? %>
        <%= image_tag current_user.avatar, class: "w-8 h-8 rounded-full object-cover" %>
      <% elsif current_user.effective_avatar_url.present? %>
        <%= image_tag current_user.effective_avatar_url, class: "w-8 h-8 rounded-full object-cover" %>
      <% else %>
        <div class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold" style="background-color: <%= current_user.profile_color || '#1e1c1b' %>">
          <%= current_user.username[0].upcase %>
        </div>
      <% end %>
      <div class="absolute -bottom-0.5 -right-0.5 w-3.5 h-3.5 rounded-full border-2 border-gray-900 bg-gray-500" data-user-status-dot></div>
    </div>
    <div class="ml-2 flex-1 min-w-0">
      <p class="text-sm font-medium text-white truncate"><%= current_user.display_name.presence || current_user.username %></p>
      <p class="text-xs text-gray-400 truncate"><%= current_user.tag %></p>
    </div>
    <%= link_to user_settings_account_path, data: { turbo_frame: "settings-frame" }, onclick: "document.getElementById('settings-overlay')?.classList.remove('hidden'); document.body.style.overflow='hidden'", class: "text-gray-400 hover:text-gray-200 p-1" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
    <% end %>
  </div>
</aside>
