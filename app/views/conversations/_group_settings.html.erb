<%# Group chat settings panel — rendered inside the profile panel slot for group chats %>
<aside id="dm-profile-panel" class="hidden w-80 bg-gray-800 border-l border-gray-900 overflow-y-auto shrink-0">
  <!-- Group icon header -->
  <div class="flex flex-col items-center pt-6 pb-4 border-b border-gray-700">
    <% group_icon_url = @conversation.effective_icon_url %>
    <label class="relative cursor-pointer group mb-3" id="group-icon-label">
      <% if group_icon_url %>
        <%= image_tag group_icon_url, class: "w-20 h-20 rounded-full object-cover", id: "group-icon-preview" %>
      <% else %>
        <div class="w-20 h-20 rounded-full bg-accent/20 flex items-center justify-center" id="group-icon-preview">
          <svg class="w-10 h-10 text-accent-light" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        </div>
      <% end %>
      <div class="absolute inset-0 rounded-full bg-black/50 flex items-center justify-center opacity-0 group-hover:opacity-100 transition">
        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
      </div>
      <input type="file" accept="image/*" class="hidden" id="group-icon-input">
    </label>
    <h3 class="text-lg font-bold text-white"><%= @conversation.name.presence || "Group Chat" %></h3>
    <span class="text-xs text-gray-400 mt-0.5"><%= @conversation.conversation_participants.count %> members</span>

    <!-- Stacked member avatars -->
    <div class="flex items-center mt-3 -space-x-2">
      <% @conversation.conversation_participants.includes(user: { avatar_attachment: :blob }, contact: []).limit(8).each do |cp| %>
        <% member = cp.user %>
        <% contact = cp.contact %>
        <% avatar = member&.effective_avatar_url || contact&.avatar_url %>
        <% if avatar.present? %>
          <%= image_tag avatar, class: "w-7 h-7 rounded-full object-cover border-2 border-gray-800", title: cp.display_name %>
        <% else %>
          <div class="w-7 h-7 rounded-full flex items-center justify-center text-[10px] font-bold text-white border-2 border-gray-800" style="background-color: <%= member&.profile_color || 'var(--color-gray-600)' %>" title="<%= cp.display_name %>">
            <%= cp.display_name&.first&.upcase || '?' %>
          </div>
        <% end %>
      <% end %>
      <% overflow = @conversation.conversation_participants.count - 8 %>
      <% if overflow > 0 %>
        <div class="w-7 h-7 rounded-full flex items-center justify-center text-[10px] font-bold text-gray-300 bg-gray-600 border-2 border-gray-800">
          +<%= overflow %>
        </div>
      <% end %>
    </div>
  </div>

  <script>
    (function() {
      const input = document.getElementById("group-icon-input")
      if (!input) return
      input.addEventListener("change", async () => {
        const file = input.files[0]
        if (!file) return
        // Preview immediately
        const preview = document.getElementById("group-icon-preview")
        const url = URL.createObjectURL(file)
        if (preview.tagName === "IMG") {
          preview.src = url
        } else {
          const img = document.createElement("img")
          img.src = url
          img.className = "w-20 h-20 rounded-full object-cover"
          img.id = "group-icon-preview"
          preview.replaceWith(img)
        }
        // Upload via fetch
        const form = new FormData()
        form.append("conversation[icon]", file)
        const csrf = document.querySelector("meta[name=csrf-token]")?.content
        await fetch("<%= conversation_path(@conversation) %>", {
          method: "PATCH",
          headers: { "X-CSRF-Token": csrf },
          body: form
        })
      })
    })()
  </script>

  <!-- Rename -->
  <div class="p-4 border-b border-gray-700">
    <%= form_with url: conversation_path(@conversation), method: :patch, class: "" do |f| %>
      <label class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1 block">Group Name</label>
      <div class="flex gap-2">
        <%= f.text_field :name, value: @conversation.name, placeholder: "Group name...", maxlength: 100,
              class: "flex-1 bg-gray-900 border border-gray-600 rounded px-2 py-1.5 text-white text-sm focus:outline-none focus:border-accent" %>
        <%= f.submit "Save", class: "px-3 py-1.5 text-sm bg-accent hover:bg-accent-light text-white rounded font-medium cursor-pointer transition" %>
      </div>
    <% end %>
  </div>

  <!-- Members -->
  <div class="p-4">
    <h4 class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-2">
      Members — <%= @conversation.conversation_participants.count %>
    </h4>
    <div class="space-y-0.5">
      <% @conversation.conversation_participants.includes(user: { avatar_attachment: :blob }, contact: []).each do |cp| %>
        <% member = cp.user %>
        <% contact = cp.contact %>
        <div class="flex items-center px-2 py-1.5 rounded hover:bg-gray-700/50 group">
          <% avatar = member&.effective_avatar_url || contact&.avatar_url %>
          <% if avatar.present? %>
            <%= image_tag avatar, class: "w-8 h-8 rounded-full object-cover shrink-0" %>
          <% else %>
            <div class="w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold text-white shrink-0" style="background-color: <%= member&.profile_color || 'var(--color-gray-600)' %>">
              <%= cp.display_name&.first&.upcase || '?' %>
            </div>
          <% end %>
          <div class="ml-2 min-w-0 flex-1">
            <span class="text-sm text-white truncate block"><%= cp.display_name %></span>
            <% if member == current_user %>
              <span class="text-[10px] text-gray-500">You</span>
            <% end %>
          </div>
          <% if member && member != current_user %>
            <%= button_to remove_member_conversation_path(@conversation, member_id: member.public_id),
                  method: :delete,
                  class: "hidden group-hover:flex text-gray-400 hover:text-danger-light p-1 cursor-pointer items-center",
                  data: { turbo_confirm: "Remove #{cp.display_name} from the group?" } do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            <% end %>
          <% elsif contact %>
            <%= button_to remove_member_conversation_path(@conversation, contact_id: contact.id),
                  method: :delete,
                  class: "hidden group-hover:flex text-gray-400 hover:text-danger-light p-1 cursor-pointer items-center",
                  data: { turbo_confirm: "Remove #{cp.display_name} from the group?" } do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- Add member -->
    <div class="mt-3">
      <% existing_pubkeys = @conversation.conversation_participants.map(&:pubkey).compact %>
      <%= form_tag add_member_conversation_path(@conversation), method: :post, class: "flex gap-2" do %>
        <select name="member_id" class="flex-1 bg-gray-900 border border-gray-600 rounded px-2 py-1.5 text-white text-sm focus:outline-none focus:border-accent">
          <option value="">Add member...</option>
          <% Contact.friends.each do |contact| %>
            <% next if existing_pubkeys.include?(contact.pubkey) %>
            <% user = User.find_by(nostr_public_key: contact.pubkey) %>
            <% value = user ? "user:#{user.public_id}" : "contact:#{contact.id}" %>
            <option value="<%= value %>"><%= contact.effective_display_name %></option>
          <% end %>
        </select>
        <button type="submit" class="px-3 py-1.5 text-sm bg-accent hover:bg-accent-light text-white rounded font-medium cursor-pointer transition">Add</button>
      <% end %>
    </div>
  </div>

  <!-- Leave group -->
  <div class="p-4 border-t border-gray-700">
    <%= button_to remove_member_conversation_path(@conversation, member_id: current_user.public_id),
          method: :delete,
          class: "w-full py-2 text-sm text-danger-light hover:bg-danger/10 rounded cursor-pointer text-center transition",
          data: { turbo_confirm: "Leave this group chat?" } do %>
      Leave Group
    <% end %>
  </div>
</aside>
