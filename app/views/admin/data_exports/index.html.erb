<div class="h-full overflow-y-auto bg-gray-900 text-gray-100">
  <div class="max-w-4xl mx-auto px-6 py-8">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="text-2xl font-bold text-white">Data Exports</h1>
        <p class="text-sm text-gray-400 mt-1">GDPR-compliant user data exports</p>
      </div>
      <%= link_to "Back to Admin", admin_instance_config_path, class: "text-sm text-gray-400 hover:text-white transition" %>
    </div>

    <%# Create export form %>
    <div class="bg-gray-800 rounded-lg p-4 mb-6">
      <h3 class="text-sm font-semibold text-white mb-3">Request New Export</h3>
      <%= form_tag admin_data_exports_path, method: :post, class: "flex flex-wrap items-end gap-4" do %>
        <div>
          <label class="block text-xs text-gray-400 mb-1">User ID</label>
          <input type="number" name="user_id" required
                 class="bg-gray-700 text-white text-sm rounded px-3 py-1.5 border border-gray-600 w-24"
                 placeholder="User ID">
        </div>
        <div>
          <label class="block text-xs text-gray-400 mb-1">Export Type</label>
          <select name="export_type" class="bg-gray-700 text-white text-sm rounded px-3 py-1.5 border border-gray-600">
            <% DataExport::EXPORT_TYPES.each do |et| %>
              <option value="<%= et %>"><%= et.capitalize %></option>
            <% end %>
          </select>
        </div>
        <button type="submit" class="bg-amber-600 hover:bg-amber-500 text-white text-sm px-4 py-1.5 rounded transition">
          Request Export
        </button>
      <% end %>
    </div>

    <%# Exports list %>
    <% if @exports.any? %>
      <div class="space-y-2">
        <% @exports.each do |export| %>
          <div class="bg-gray-800 rounded-lg px-4 py-3 flex items-center justify-between">
            <div>
              <div class="flex items-center gap-2">
                <span class="text-xs font-semibold px-2 py-0.5 rounded
                  <%= case export.status
                      when 'pending' then 'bg-yellow-900 text-yellow-300'
                      when 'processing' then 'bg-amber-900 text-amber-300'
                      when 'completed' then 'bg-green-900 text-green-300'
                      when 'failed' then 'bg-red-900 text-red-300'
                      when 'expired' then 'bg-gray-700 text-gray-400'
                      end %>">
                  <%= export.status.capitalize %>
                </span>
                <span class="text-sm text-white"><%= export.export_type.capitalize %> export</span>
                <span class="text-xs text-gray-500">#<%= export.id %></span>
              </div>
              <div class="mt-1 text-xs text-gray-400">
                User #<%= export.user_id %> (<%= export.user.username %>)
                &mdash; requested by <%= export.requested_by.username %>
                &mdash; <%= time_ago_in_words(export.created_at) %> ago
                <% if export.expires_at.present? %>
                  &mdash; expires <%= time_ago_in_words(export.expires_at) %> from now
                <% end %>
              </div>
            </div>
            <% if export.status == "completed" && !export.expired? %>
              <%= link_to "Download", download_admin_data_export_path(export),
                  class: "bg-amber-600 hover:bg-amber-500 text-white text-xs px-3 py-1 rounded transition" %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="bg-gray-800 rounded-lg p-6 text-center">
        <p class="text-gray-400">No data exports found.</p>
      </div>
    <% end %>
  </div>
</div>
