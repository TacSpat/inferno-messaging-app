<div class="h-full overflow-y-auto bg-gray-900 text-gray-100">
  <div class="max-w-4xl mx-auto px-6 py-8">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="text-2xl font-bold text-white">Audit Log</h1>
        <p class="text-sm text-gray-400 mt-1">Federation events and admin model changes</p>
      </div>
      <%= link_to "Back to Admin", admin_instance_config_path, class: "text-sm text-gray-400 hover:text-white transition" %>
    </div>

    <%# Filter bar %>
    <div class="bg-gray-800 rounded-lg p-4 mb-6">
      <%= form_tag admin_audit_logs_path, method: :get, class: "flex flex-wrap items-end gap-4" do %>
        <div>
          <label class="block text-xs text-gray-400 mb-1">Event Type</label>
          <select name="event_type" class="bg-gray-700 text-white text-sm rounded px-3 py-1.5 border border-gray-600">
            <option value="">All Events</option>
            <% @event_types.each do |et| %>
              <option value="<%= et %>" <%= "selected" if params[:event_type] == et %>><%= et.humanize %></option>
            <% end %>
          </select>
        </div>
        <div>
          <label class="block text-xs text-gray-400 mb-1">Domain</label>
          <select name="domain" class="bg-gray-700 text-white text-sm rounded px-3 py-1.5 border border-gray-600">
            <option value="">All Domains</option>
            <% @domains.each do |d| %>
              <option value="<%= d %>" <%= "selected" if params[:domain] == d %>><%= d %></option>
            <% end %>
          </select>
        </div>
        <div>
          <label class="block text-xs text-gray-400 mb-1">From</label>
          <input type="date" name="date_from" value="<%= params[:date_from] %>"
                 class="bg-gray-700 text-white text-sm rounded px-3 py-1.5 border border-gray-600">
        </div>
        <div>
          <label class="block text-xs text-gray-400 mb-1">To</label>
          <input type="date" name="date_to" value="<%= params[:date_to] %>"
                 class="bg-gray-700 text-white text-sm rounded px-3 py-1.5 border border-gray-600">
        </div>
        <button type="submit" class="bg-amber-600 hover:bg-amber-500 text-white text-sm px-4 py-1.5 rounded transition">
          Filter
        </button>
        <% if params[:event_type].present? || params[:domain].present? || params[:date_from].present? %>
          <%= link_to "Clear", admin_audit_logs_path, class: "text-sm text-gray-400 hover:text-white transition" %>
        <% end %>
      <% end %>
    </div>

    <%# Federation audit logs %>
    <h2 class="text-lg font-semibold text-white mb-3">Federation Events</h2>
    <% if @federation_logs.any? %>
      <div class="space-y-2 mb-8">
        <% @federation_logs.each do |log| %>
          <div class="bg-gray-800 rounded-lg px-4 py-3">
            <div class="flex items-start justify-between">
              <div class="flex items-center gap-2">
                <span class="text-xs font-semibold px-2 py-0.5 rounded
                  <%= case log.event_type
                      when 'auth_success' then 'bg-green-900 text-green-300'
                      when 'auth_failure' then 'bg-red-900 text-red-300'
                      when 'auth_attempt' then 'bg-amber-900 text-amber-300'
                      when 'token_issued' then 'bg-purple-900 text-purple-300'
                      when 'domain_block' then 'bg-red-900 text-red-300'
                      when 'domain_unblock' then 'bg-green-900 text-green-300'
                      when 'lockdown_activated' then 'bg-orange-900 text-orange-300'
                      when 'lockdown_lifted' then 'bg-teal-900 text-teal-300'
                      when 'moderation_report_reviewed' then 'bg-yellow-900 text-yellow-300'
                      else 'bg-gray-700 text-gray-300'
                      end %>">
                  <%= log.event_type.humanize %>
                </span>
                <% if log.remote_domain.present? %>
                  <span class="text-xs text-gray-400"><%= log.remote_domain %></span>
                <% end %>
              </div>
              <span class="text-xs text-gray-500"><%= log.created_at.strftime("%Y-%m-%d %H:%M:%S") %></span>
            </div>
            <div class="mt-1 text-xs text-gray-400">
              <% if log.actor %>
                Actor: <%= log.actor_type %> #<%= log.actor_id %>
              <% end %>
              <% if log.ip_address.present? %>
                <span class="ml-2">IP: <%= log.ip_address %></span>
              <% end %>
              <% if log.metadata.present? && log.metadata.any? %>
                <span class="ml-2 font-mono"><%= log.metadata.to_json %></span>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="bg-gray-800 rounded-lg p-6 text-center mb-8">
        <p class="text-gray-400">No federation events found.</p>
      </div>
    <% end %>

    <%# PaperTrail model versions %>
    <h2 class="text-lg font-semibold text-white mb-3">Admin Model Changes</h2>
    <% if @model_versions.any? %>
      <div class="space-y-2">
        <% @model_versions.each do |version| %>
          <% label, color, icon = audit_action_display(version) %>
          <div class="bg-gray-800 rounded-lg px-4 py-3">
            <div class="flex items-start justify-between">
              <div class="flex items-center gap-2">
                <span class="<%= color %> rounded-full p-1"><%= icon %></span>
                <span class="text-sm text-white"><%= label %></span>
                <span class="text-xs text-gray-500"><%= version.item_type %> #<%= version.item_id %></span>
              </div>
              <span class="text-xs text-gray-500"><%= version.created_at.strftime("%Y-%m-%d %H:%M:%S") %></span>
            </div>
            <div class="mt-1 text-xs text-gray-400">
              <% if version.whodunnit.present? %>
                By user #<%= version.whodunnit %>
              <% end %>
              <% if version.ip_address.present? %>
                <span class="ml-2">IP: <%= version.ip_address %></span>
              <% end %>
              <% if version.remote_domain.present? %>
                <span class="ml-2">Domain: <%= version.remote_domain %></span>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="bg-gray-800 rounded-lg p-6 text-center">
        <p class="text-gray-400">No admin model changes found.</p>
      </div>
    <% end %>
  </div>
</div>
