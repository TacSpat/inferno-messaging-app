<div class="h-full overflow-y-auto bg-gray-900 text-gray-100">
  <div class="max-w-4xl mx-auto px-6 py-8">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="text-2xl font-bold text-white">Moderation Reports</h1>
        <p class="text-sm text-gray-400 mt-1">
          <%= @open_count %> open <%= "report".pluralize(@open_count) %>
        </p>
      </div>
      <div class="flex items-center gap-2">
        <%= link_to "Open", admin_moderation_reports_path,
            class: "text-sm px-3 py-1 rounded transition #{params[:filter].blank? ? 'bg-amber-600 text-white' : 'bg-gray-700 text-gray-300 hover:text-white'}" %>
        <%= link_to "Resolved", admin_moderation_reports_path(filter: "resolved"),
            class: "text-sm px-3 py-1 rounded transition #{params[:filter] == 'resolved' ? 'bg-amber-600 text-white' : 'bg-gray-700 text-gray-300 hover:text-white'}" %>
        <%= link_to "All", admin_moderation_reports_path(filter: "all"),
            class: "text-sm px-3 py-1 rounded transition #{params[:filter] == 'all' ? 'bg-amber-600 text-white' : 'bg-gray-700 text-gray-300 hover:text-white'}" %>
        <%= link_to "Back to Admin", admin_instance_config_path, class: "text-sm text-gray-400 hover:text-white transition ml-4" %>
      </div>
    </div>

    <% if @reports.any? %>
      <div class="space-y-3">
        <% @reports.each do |report| %>
          <%= link_to admin_moderation_report_path(report), class: "block bg-gray-800 rounded-lg p-4 hover:bg-gray-750 transition" do %>
            <div class="flex items-start justify-between">
              <div>
                <div class="flex items-center gap-2 mb-1">
                  <span class="text-xs font-semibold px-2 py-0.5 rounded
                    <%= case report.report_type
                        when 'spam' then 'bg-yellow-900 text-yellow-300'
                        when 'illegal' then 'bg-red-900 text-red-300'
                        when 'impersonation' then 'bg-purple-900 text-purple-300'
                        when 'harassment' then 'bg-orange-900 text-orange-300'
                        else 'bg-gray-700 text-gray-300'
                        end %>">
                    <%= report.report_type.capitalize %>
                  </span>
                  <span class="text-xs text-gray-500">#<%= report.id %></span>
                </div>
                <p class="text-sm text-white font-mono mb-1"><%= truncate(report.reported_pubkey, length: 24) %></p>
                <% if report.reason.present? %>
                  <p class="text-sm text-gray-400"><%= truncate(report.reason, length: 120) %></p>
                <% end %>
                <p class="text-xs text-gray-500 mt-2">
                  Reported by <%= report.reporter.username %> &middot; <%= time_ago_in_words(report.created_at) %> ago
                </p>
              </div>
              <div class="text-right">
                <span class="text-xs font-medium px-2 py-1 rounded
                  <%= case report.status
                      when 'open' then 'bg-amber-900 text-amber-300'
                      when 'reviewed' then 'bg-gray-700 text-gray-300'
                      when 'dismissed' then 'bg-gray-700 text-gray-400'
                      when 'actioned' then 'bg-green-900 text-green-300'
                      end %>">
                  <%= report.status.capitalize %>
                </span>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="bg-gray-800 rounded-lg p-8 text-center">
        <p class="text-gray-400">No reports found.</p>
      </div>
    <% end %>
  </div>
</div>
