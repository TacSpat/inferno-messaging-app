<div class="h-full overflow-y-auto bg-gray-900 text-gray-100">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-6 sm:py-8">
    <div class="flex items-center justify-between mb-5">
      <div>
        <h1 class="text-xl sm:text-2xl font-bold text-white">Instance Administration</h1>
        <p class="text-sm text-gray-400 mt-0.5">Configure limits, pruning, and instance identity</p>
      </div>
      <%= link_to "Back to App", root_path, class: "text-sm text-gray-400 hover:text-white transition shrink-0 ml-4" %>
    </div>

    <!-- Admin quick links -->
    <div class="flex flex-wrap gap-2 mb-5">
      <%= link_to "Moderation Reports", admin_moderation_reports_path, class: "text-xs bg-gray-800 hover:bg-gray-700 text-gray-300 hover:text-white px-3 py-1.5 rounded transition" %>
      <%= link_to "Audit Logs", admin_audit_logs_path, class: "text-xs bg-gray-800 hover:bg-gray-700 text-gray-300 hover:text-white px-3 py-1.5 rounded transition" %>
      <%= link_to "Legal Holds", admin_legal_holds_path, class: "text-xs bg-gray-800 hover:bg-gray-700 text-gray-300 hover:text-white px-3 py-1.5 rounded transition" %>
      <%= link_to "Data Exports", admin_data_exports_path, class: "text-xs bg-gray-800 hover:bg-gray-700 text-gray-300 hover:text-white px-3 py-1.5 rounded transition" %>
      <%= link_to "User Suspensions", admin_user_suspensions_path, class: "text-xs bg-gray-800 hover:bg-gray-700 text-gray-300 hover:text-white px-3 py-1.5 rounded transition" %>
    </div>

    <!-- Stats overview -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-2 sm:gap-3 mb-5">
      <div class="bg-gray-800 rounded-lg p-3">
        <p class="text-xs text-gray-400 uppercase tracking-wide">Users</p>
        <p class="text-xl font-bold text-white"><%= @stats[:total_users] %></p>
        <% unless @config.unlimited?(:max_users) %>
          <p class="text-xs text-gray-500">of <%= @config.max_users %></p>
        <% end %>
      </div>
      <div class="bg-gray-800 rounded-lg p-3">
        <p class="text-xs text-gray-400 uppercase tracking-wide">Servers</p>
        <p class="text-xl font-bold text-white"><%= @stats[:total_servers] %></p>
        <% unless @config.unlimited?(:max_servers) %>
          <p class="text-xs text-gray-500">of <%= @config.max_servers %></p>
        <% end %>
      </div>
      <div class="bg-gray-800 rounded-lg p-3">
        <p class="text-xs text-gray-400 uppercase tracking-wide">Channels</p>
        <p class="text-xl font-bold text-white"><%= @stats[:total_channels] %></p>
      </div>
      <div class="bg-gray-800 rounded-lg p-3">
        <p class="text-xs text-gray-400 uppercase tracking-wide">Messages</p>
        <p class="text-xl font-bold text-white"><%= number_with_delimiter(@stats[:total_messages]) %></p>
      </div>
      <div class="bg-gray-800 rounded-lg p-3 col-span-2 sm:col-span-1">
        <p class="text-xs text-gray-400 uppercase tracking-wide">Storage</p>
        <p class="text-xl font-bold text-white"><%= @stats[:storage_used_mb] %> MB</p>
      </div>
    </div>

    <% if @config.errors.any? %>
      <div class="bg-red-900/50 border border-red-700 rounded-lg p-3 mb-4">
        <% @config.errors.full_messages.each do |msg| %>
          <p class="text-sm text-red-300"><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <%= form_with model: @config, url: admin_instance_config_path, method: :patch, class: "space-y-4", id: "admin-settings-form" do |f| %>

      <!-- Instance Identity -->
      <div class="bg-gray-800 rounded-lg p-4 sm:p-5">
        <h2 class="text-base font-semibold text-white mb-3">Instance Identity</h2>
        <div class="space-y-3">
          <div>
            <%= f.label :instance_name, "Instance Name", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
            <%= f.text_field :instance_name, class: "w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-red-500 text-sm" %>
          </div>
          <div>
            <%= f.label :instance_description, "Description", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
            <%= f.text_area :instance_description, rows: 2, class: "w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-red-500 text-sm resize-none", placeholder: "A short description of this instance" %>
          </div>
        </div>
      </div>

      <!-- Federation & Lockdown -->
      <div class="bg-gray-800 rounded-lg p-4 sm:p-5">
        <h2 class="text-base font-semibold text-white mb-3">Federation</h2>
        <div class="space-y-3">
          <div>
            <%= f.label :federation_mode, "Mode", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
            <%= f.select :federation_mode,
                options_for_select([
                  ["Open — any instance can authenticate remote users", "open"],
                  ["Allowlist — only explicitly trusted instances", "allowlist"],
                  ["Closed — no remote authentication", "closed"]
                ], @config.federation_mode),
                {},
                class: "w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-red-500 text-sm" %>
          </div>

          <div>
            <div class="flex items-center gap-1.5 mb-1">
              <%= f.label :instance_relay_url, "Canonical Relay URL", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide" %>
              <span class="relative group">
                <span class="inline-flex items-center justify-center w-4 h-4 rounded-full bg-gray-600 text-gray-300 text-[10px] font-bold cursor-help leading-none">i</span>
                <span class="hidden group-hover:block absolute z-10 bottom-full left-1/2 -translate-x-1/2 mb-1.5 w-56 p-2 bg-gray-950 border border-gray-700 rounded text-xs text-gray-300 shadow-lg">
                  Your instance's public identity relay, advertised in metadata and Nostr event hints. This is not where events are published — add working relays under Relay Connections below.
                </span>
              </span>
            </div>
            <%= f.text_field :instance_relay_url, class: "w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-red-500 text-sm", placeholder: "wss://relay.example.com" %>
          </div>

          <!-- Lockdown controls -->
          <div class="border-t border-gray-700 pt-3 mt-1">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-3">
              <p class="text-xs font-semibold text-gray-300 uppercase tracking-wide">Lockdown Controls</p>
              <% if @config.lockdown? %>
                <%= link_to "Lift All Lockdowns", lift_lockdown_admin_instance_config_path,
                    data: { turbo_method: :post },
                    class: "bg-green-600 hover:bg-green-700 text-white font-semibold px-3 py-1 rounded transition cursor-pointer text-xs w-fit inline-block" %>
              <% else %>
                <%= link_to "Lock Everything", emergency_lockdown_admin_instance_config_path,
                    data: { turbo_method: :post, turbo_confirm: "This will immediately block all remote auth, registrations, remote joins, and invite creation. Continue?" },
                    class: "bg-gradient-to-r from-red-700 to-red-500 hover:from-red-600 hover:to-red-400 text-white font-semibold px-3 py-1 rounded transition cursor-pointer text-xs w-fit inline-block" %>
              <% end %>
            </div>

            <div class="flex items-center gap-2 mb-3">
              <%= f.check_box :lockdown_enabled, class: "w-4 h-4 rounded border-gray-600 bg-gray-900 text-red-500 focus:ring-red-500" %>
              <%= f.label :lockdown_enabled, class: "text-sm text-gray-300" do %>
                Full lockdown <span class="text-red-400 text-xs">(overrides all below)</span>
              <% end %>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
              <div class="flex items-center gap-2">
                <%= f.check_box :lockdown_remote_auth, class: "w-4 h-4 rounded border-gray-600 bg-gray-900 text-red-400 focus:ring-red-500" %>
                <%= f.label :lockdown_remote_auth, "Block remote auth", class: "text-sm text-gray-300" %>
              </div>
              <div class="flex items-center gap-2">
                <%= f.check_box :lockdown_remote_joins, class: "w-4 h-4 rounded border-gray-600 bg-gray-900 text-red-400 focus:ring-red-500" %>
                <%= f.label :lockdown_remote_joins, "Block remote joins", class: "text-sm text-gray-300" %>
              </div>
              <div class="flex items-center gap-2">
                <%= f.check_box :lockdown_local_signups, class: "w-4 h-4 rounded border-gray-600 bg-gray-900 text-red-400 focus:ring-red-500" %>
                <%= f.label :lockdown_local_signups, "Block registrations", class: "text-sm text-gray-300" %>
              </div>
              <div class="flex items-center gap-2">
                <%= f.check_box :lockdown_invite_creation, class: "w-4 h-4 rounded border-gray-600 bg-gray-900 text-red-400 focus:ring-red-500" %>
                <%= f.label :lockdown_invite_creation, "Block invites", class: "text-sm text-gray-300" %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Limits & Quotas -->
      <div class="bg-gray-800 rounded-lg p-4 sm:p-5">
        <div class="flex items-center gap-1.5 mb-3">
          <h2 class="text-base font-semibold text-white">Limits & Quotas</h2>
          <span class="relative group">
            <span class="inline-flex items-center justify-center w-4 h-4 rounded-full bg-gray-600 text-gray-300 text-[10px] font-bold cursor-help leading-none">i</span>
            <span class="hidden group-hover:block absolute z-10 bottom-full left-1/2 -translate-x-1/2 mb-1.5 w-44 p-2 bg-gray-950 border border-gray-700 rounded text-xs text-gray-300 shadow-lg">
              Set any field to 0 for unlimited.
            </span>
          </span>
        </div>

        <div class="space-y-4">
          <div>
            <p class="text-xs font-semibold text-gray-300 uppercase tracking-wide mb-2">Users</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <%= f.label :max_users, "Max Total Users", class: "block text-xs text-gray-400 mb-1" %>
                <%= f.number_field :max_users, min: 0, class: "w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-red-500 text-sm" %>
              </div>
              <div>
                <%= f.label :max_servers_per_user, "Servers Per User", class: "block text-xs text-gray-400 mb-1" %>
                <%= f.number_field :max_servers_per_user, min: 1, class: "w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-red-500 text-sm" %>
              </div>
            </div>
          </div>

          <div>
            <p class="text-xs font-semibold text-gray-300 uppercase tracking-wide mb-2">Servers</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
              <div>
                <%= f.label :max_servers, "Max Total Servers", class: "block text-xs text-gray-400 mb-1" %>
                <%= f.number_field :max_servers, min: 0, class: "w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-red-500 text-sm" %>
              </div>
              <div>
                <%= f.label :max_channels_per_server, "Channels Per Server", class: "block text-xs text-gray-400 mb-1" %>
                <%= f.number_field :max_channels_per_server, min: 1, class: "w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-red-500 text-sm" %>
              </div>
              <div>
                <%= f.label :max_categories_per_server, "Categories Per Server", class: "block text-xs text-gray-400 mb-1" %>
                <%= f.number_field :max_categories_per_server, min: 1, class: "w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-red-500 text-sm" %>
              </div>
              <div>
                <%= f.label :max_members_per_server, "Members Per Server", class: "block text-xs text-gray-400 mb-1" %>
                <%= f.number_field :max_members_per_server, min: 0, class: "w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-red-500 text-sm" %>
              </div>
              <div>
                <%= f.label :max_roles_per_server, "Roles Per Server", class: "block text-xs text-gray-400 mb-1" %>
                <%= f.number_field :max_roles_per_server, min: 1, class: "w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-red-500 text-sm" %>
              </div>
            </div>
          </div>

          <div>
            <p class="text-xs font-semibold text-gray-300 uppercase tracking-wide mb-2">Storage</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <%= f.label :max_upload_size_mb, "Max Upload (MB)", class: "block text-xs text-gray-400 mb-1" %>
                <%= f.number_field :max_upload_size_mb, min: 1, class: "w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-red-500 text-sm" %>
              </div>
              <div>
                <%= f.label :max_storage_per_user_mb, "Per User (MB)", class: "block text-xs text-gray-400 mb-1" %>
                <%= f.number_field :max_storage_per_user_mb, min: 0, class: "w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-red-500 text-sm" %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Message Pruning -->
      <div class="bg-gray-800 rounded-lg p-4 sm:p-5">
        <h2 class="text-base font-semibold text-white mb-3">Message Pruning</h2>
        <div class="space-y-3">
          <div>
            <%= f.label :pruning_strategy, "Strategy", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
            <%= f.select :pruning_strategy,
                options_for_select([
                  ["Disabled — keep everything", "none"],
                  ["Time-Based — delete after retention period", "time_based"],
                  ["Storage-Based — prune attachments first", "storage_based"]
                ], @config.pruning_strategy),
                {},
                class: "w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-red-500 text-sm" %>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <%= f.label :message_retention_days, "Message Retention (days)", class: "block text-xs text-gray-400 mb-1" %>
              <%= f.number_field :message_retention_days, min: 0, class: "w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-red-500 text-sm", placeholder: "0 = forever" %>
            </div>
            <div>
              <%= f.label :attachment_retention_days, "Attachment Retention (days)", class: "block text-xs text-gray-400 mb-1" %>
              <%= f.number_field :attachment_retention_days, min: 0, class: "w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-red-500 text-sm", placeholder: "0 = forever" %>
            </div>
          </div>

          <div class="flex items-center gap-2">
            <%= f.check_box :keep_pinned_messages, class: "w-4 h-4 rounded border-gray-600 bg-gray-900 text-red-500 focus:ring-red-500" %>
            <%= f.label :keep_pinned_messages, "Keep pinned messages (never prune)", class: "text-sm text-gray-300" %>
          </div>
        </div>
      </div>

      <!-- Sticky save bar (hidden until changes detected) -->
      <div id="admin-save-bar" class="fixed bottom-0 left-0 right-0 z-50" style="display: none; opacity: 0; transform: translateY(100%); transition: opacity 0.2s ease, transform 0.2s ease; padding-bottom: env(safe-area-inset-bottom, 0px);">
        <div class="max-w-4xl mx-auto px-3 sm:px-6 pb-3 sm:pb-4">
          <div class="flex items-center justify-between gap-3 bg-gray-950 border border-gray-700 rounded-lg px-3 sm:px-4 py-2.5 sm:py-3 shadow-2xl">
            <p class="text-xs sm:text-sm text-gray-300">Unsaved changes</p>
            <div class="flex items-center gap-2 sm:gap-3 shrink-0">
              <button type="button" id="admin-reset-btn" class="text-xs sm:text-sm text-gray-400 hover:text-white cursor-pointer">Reset</button>
              <%= f.submit "Save", class: "bg-gradient-to-r from-red-700 to-red-500 hover:from-red-600 hover:to-red-400 text-white font-semibold px-4 sm:px-5 py-1.5 rounded transition cursor-pointer text-xs sm:text-sm" %>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <script>
      (function() {
        const form = document.getElementById("admin-settings-form")
        const bar = document.getElementById("admin-save-bar")
        const resetBtn = document.getElementById("admin-reset-btn")
        if (!form || !bar) return

        function capture() {
          const state = {}
          for (const el of form.elements) {
            if (!el.name) continue
            state[el.name] = el.type === "checkbox" ? el.checked : el.value
          }
          return state
        }

        const snapshot = capture()

        function isDirty() {
          const current = capture()
          for (const key in snapshot) {
            if (snapshot[key] !== current[key]) return true
          }
          return false
        }

        function check() {
          const dirty = isDirty()
          if (dirty) {
            bar.style.display = ""
            requestAnimationFrame(() => {
              bar.style.opacity = "1"
              bar.style.transform = "translateY(0)"
            })
          } else {
            bar.style.opacity = "0"
            bar.style.transform = "translateY(100%)"
            setTimeout(() => { if (!isDirty()) bar.style.display = "none" }, 200)
          }
        }

        form.addEventListener("input", check)
        form.addEventListener("change", check)

        if (resetBtn) {
          resetBtn.addEventListener("click", () => {
            for (const el of form.elements) {
              if (!el.name || !(el.name in snapshot)) continue
              if (el.type === "checkbox") el.checked = snapshot[el.name]
              else el.value = snapshot[el.name]
            }
            check()
          })
        }
      })()
    </script>

    <!-- Relay Connections -->
    <div class="bg-gray-800 rounded-lg p-4 sm:p-5 mt-4">
      <div class="flex items-center gap-1.5 mb-3">
        <h2 class="text-base font-semibold text-white">Relay Connections</h2>
        <span class="relative group">
          <span class="inline-flex items-center justify-center w-4 h-4 rounded-full bg-gray-600 text-gray-300 text-[10px] font-bold cursor-help leading-none">i</span>
          <span class="hidden group-hover:block absolute z-10 bottom-full left-1/2 -translate-x-1/2 mb-1.5 w-56 p-2 bg-gray-950 border border-gray-700 rounded text-xs text-gray-300 shadow-lg">
            Working relays this instance publishes to and fetches from. Unlike the canonical relay URL (an identity hint), these are the actual connections for syncing profiles and events.
          </span>
        </span>
      </div>

      <%= form_with url: admin_relay_connections_path, method: :post, class: "flex flex-col sm:flex-row gap-2 mb-3" do |f| %>
        <%= f.text_field :url, placeholder: "wss://relay.example.com", class: "flex-1 bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-red-500 text-sm" %>
        <%= f.submit "Add", class: "bg-gradient-to-r from-red-700 to-red-500 hover:from-red-600 hover:to-red-400 text-white font-semibold px-4 py-2 rounded transition cursor-pointer text-sm sm:w-auto" %>
      <% end %>

      <% relays = RelayConnection.order(created_at: :desc) %>
      <% if relays.any? %>
        <div class="space-y-1.5">
          <% relays.each do |relay| %>
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between bg-gray-900 rounded px-3 py-2.5 gap-1.5">
              <div class="flex items-center gap-2.5 min-w-0">
                <div class="w-2 h-2 rounded-full shrink-0 <%= relay.active? ? 'bg-green-400' : relay.error? ? 'bg-red-400' : 'bg-gray-500' %>"></div>
                <div class="min-w-0">
                  <p class="text-sm font-medium text-white font-mono truncate"><%= relay.url %></p>
                  <p class="text-xs text-gray-400">
                    <%= relay.status.capitalize %>
                    <% if relay.last_connected_at %> &middot; <%= time_ago_in_words(relay.last_connected_at) %> ago<% end %>
                    <% if relay.error? && relay.last_error_message.present? %>
                      &middot; <span class="text-red-400"><%= truncate(relay.last_error_message, length: 60) %></span>
                    <% end %>
                  </p>
                </div>
              </div>
              <div class="flex items-center gap-1.5 shrink-0 ml-4 sm:ml-0">
                <%= button_to relay.active? ? "Disable" : "Enable",
                    toggle_admin_relay_connection_path(relay),
                    method: :post,
                    class: "text-xs text-gray-400 hover:text-white bg-gray-700 hover:bg-gray-600 px-2.5 py-1 rounded transition cursor-pointer" %>
                <%= button_to "Remove", admin_relay_connection_path(relay),
                    method: :delete,
                    class: "text-xs text-gray-400 hover:text-white bg-gray-700 hover:bg-red-600 px-2.5 py-1 rounded transition cursor-pointer" %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-gray-500">No relays configured.</p>
      <% end %>
    </div>

    <!-- Instance Blocklist -->
    <div class="bg-gray-800 rounded-lg p-4 sm:p-5 mt-4">
      <h2 class="text-base font-semibold text-white mb-3">Blocked Instances</h2>

      <%= form_with url: admin_instance_blocklists_path, method: :post, class: "flex flex-col sm:flex-row gap-2 mb-3" do |f| %>
        <%= f.text_field :domain, placeholder: "spam.example.com", class: "flex-1 bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-red-500 text-sm" %>
        <%= f.text_field :reason, placeholder: "Reason (optional)", class: "flex-1 bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-red-500 text-sm" %>
        <%= f.submit "Block", class: "bg-gradient-to-r from-red-700 to-red-500 hover:from-red-600 hover:to-red-400 text-white font-semibold px-4 py-2 rounded transition cursor-pointer text-sm sm:w-auto" %>
      <% end %>

      <% blocked = InstanceBlocklist.ordered %>
      <% if blocked.any? %>
        <div class="space-y-1.5">
          <% blocked.each do |entry| %>
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between bg-gray-900 rounded px-3 py-2.5 gap-1.5">
              <div class="min-w-0">
                <p class="text-sm font-medium text-white"><%= entry.domain %></p>
                <p class="text-xs text-gray-400">
                  <% if entry.reason.present? %><%= entry.reason %> &middot; <% end %>
                  Blocked <%= time_ago_in_words(entry.blocked_at) %> ago by <%= entry.blocked_by.username %>
                </p>
              </div>
              <div class="shrink-0">
                <%= button_to "Unblock", admin_instance_blocklist_path(entry), method: :delete,
                    class: "text-xs text-gray-400 hover:text-white bg-gray-700 hover:bg-gray-600 px-2.5 py-1 rounded transition cursor-pointer" %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-gray-500">No instances are blocked.</p>
      <% end %>
    </div>
  </div>
</div>
