<div class="h-full overflow-y-auto bg-gray-900 text-gray-100">
  <div class="max-w-4xl mx-auto px-6 py-8">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-2xl font-bold text-white">Instance Administration</h1>
        <p class="text-sm text-gray-400 mt-1">Configure limits, pruning, and instance identity</p>
      </div>
      <%= link_to "Back to App", root_path, class: "text-sm text-gray-400 hover:text-white transition" %>
    </div>

    <!-- Stats overview -->
    <div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-8">
      <div class="bg-gray-800 rounded-lg p-4">
        <p class="text-xs text-gray-400 uppercase tracking-wide">Users</p>
        <p class="text-2xl font-bold text-white"><%= @stats[:total_users] %></p>
        <% unless @config.unlimited?(:max_users) %>
          <p class="text-xs text-gray-500">of <%= @config.max_users %></p>
        <% end %>
      </div>
      <div class="bg-gray-800 rounded-lg p-4">
        <p class="text-xs text-gray-400 uppercase tracking-wide">Servers</p>
        <p class="text-2xl font-bold text-white"><%= @stats[:total_servers] %></p>
        <% unless @config.unlimited?(:max_servers) %>
          <p class="text-xs text-gray-500">of <%= @config.max_servers %></p>
        <% end %>
      </div>
      <div class="bg-gray-800 rounded-lg p-4">
        <p class="text-xs text-gray-400 uppercase tracking-wide">Channels</p>
        <p class="text-2xl font-bold text-white"><%= @stats[:total_channels] %></p>
      </div>
      <div class="bg-gray-800 rounded-lg p-4">
        <p class="text-xs text-gray-400 uppercase tracking-wide">Messages</p>
        <p class="text-2xl font-bold text-white"><%= number_with_delimiter(@stats[:total_messages]) %></p>
      </div>
      <div class="bg-gray-800 rounded-lg p-4">
        <p class="text-xs text-gray-400 uppercase tracking-wide">Storage</p>
        <p class="text-2xl font-bold text-white"><%= @stats[:storage_used_mb] %> MB</p>
      </div>
    </div>

    <% if @config.errors.any? %>
      <div class="bg-red-900/50 border border-red-700 rounded-lg p-4 mb-6">
        <% @config.errors.full_messages.each do |msg| %>
          <p class="text-sm text-red-300"><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <%= form_with model: @config, url: admin_instance_config_path, method: :patch, class: "space-y-6" do |f| %>

      <!-- Instance Identity -->
      <div class="bg-gray-800 rounded-lg p-6">
        <h2 class="text-lg font-semibold text-white mb-4">Instance Identity</h2>
        <div class="space-y-4">
          <div>
            <%= f.label :instance_name, "Instance Name", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
            <%= f.text_field :instance_name, class: "w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-indigo-500 text-sm" %>
          </div>
          <div>
            <%= f.label :instance_description, "Description", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
            <%= f.text_area :instance_description, rows: 2, class: "w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-indigo-500 text-sm resize-none", placeholder: "A short description of this instance" %>
          </div>
        </div>
      </div>

      <!-- Federation -->
      <div class="bg-gray-800 rounded-lg p-6">
        <h2 class="text-lg font-semibold text-white mb-1">Federation</h2>
        <p class="text-xs text-gray-400 mb-4">Control how this instance communicates with other instances</p>
        <div class="space-y-4">
          <div>
            <%= f.label :federation_mode, "Federation Mode", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
            <%= f.select :federation_mode,
                options_for_select([
                  ["Open — any instance can authenticate remote users", "open"],
                  ["Allowlist — only explicitly trusted instances (not yet implemented)", "allowlist"],
                  ["Closed — no remote authentication", "closed"]
                ], @config.federation_mode),
                {},
                class: "w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-indigo-500 text-sm" %>
          </div>

          <div>
            <%= f.label :instance_relay_url, "Relay URL", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
            <%= f.text_field :instance_relay_url, class: "w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-indigo-500 text-sm", placeholder: "wss://relay.example.com" %>
            <p class="text-xs text-gray-500 mt-1">Optional. The Nostr relay this instance publishes events to.</p>
          </div>

          <div class="flex items-center gap-2">
            <%= f.check_box :lockdown_enabled, class: "w-4 h-4 rounded border-gray-600 bg-gray-900 text-red-500 focus:ring-red-500" %>
            <%= f.label :lockdown_enabled, class: "text-sm text-gray-300" do %>
              Full lockdown mode <span class="text-red-400 text-xs">(overrides all granular locks below)</span>
            <% end %>
          </div>

          <div class="border-t border-gray-700 pt-4 mt-2">
            <p class="text-xs font-semibold text-gray-300 uppercase tracking-wide mb-3">Granular Lockdown Controls</p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
              <div class="flex items-center gap-2">
                <%= f.check_box :lockdown_remote_auth, class: "w-4 h-4 rounded border-gray-600 bg-gray-900 text-orange-500 focus:ring-orange-500" %>
                <%= f.label :lockdown_remote_auth, "Block remote authentication", class: "text-sm text-gray-300" %>
              </div>
              <div class="flex items-center gap-2">
                <%= f.check_box :lockdown_remote_joins, class: "w-4 h-4 rounded border-gray-600 bg-gray-900 text-orange-500 focus:ring-orange-500" %>
                <%= f.label :lockdown_remote_joins, "Block remote server joins", class: "text-sm text-gray-300" %>
              </div>
              <div class="flex items-center gap-2">
                <%= f.check_box :lockdown_local_signups, class: "w-4 h-4 rounded border-gray-600 bg-gray-900 text-orange-500 focus:ring-orange-500" %>
                <%= f.label :lockdown_local_signups, "Block new registrations", class: "text-sm text-gray-300" %>
              </div>
              <div class="flex items-center gap-2">
                <%= f.check_box :lockdown_invite_creation, class: "w-4 h-4 rounded border-gray-600 bg-gray-900 text-orange-500 focus:ring-orange-500" %>
                <%= f.label :lockdown_invite_creation, "Block invite creation", class: "text-sm text-gray-300" %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- User Limits -->
      <div class="bg-gray-800 rounded-lg p-6">
        <h2 class="text-lg font-semibold text-white mb-1">User Limits</h2>
        <p class="text-xs text-gray-400 mb-4">Set to 0 for unlimited</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <%= f.label :max_users, "Max Total Users", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
            <%= f.number_field :max_users, min: 0, class: "w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-indigo-500 text-sm" %>
          </div>
          <div>
            <%= f.label :max_servers_per_user, "Max Servers Per User", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
            <%= f.number_field :max_servers_per_user, min: 1, class: "w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-indigo-500 text-sm" %>
          </div>
        </div>
      </div>

      <!-- Server Limits -->
      <div class="bg-gray-800 rounded-lg p-6">
        <h2 class="text-lg font-semibold text-white mb-1">Server Limits</h2>
        <p class="text-xs text-gray-400 mb-4">Set to 0 for unlimited where noted</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <%= f.label :max_servers, "Max Total Servers", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
            <%= f.number_field :max_servers, min: 0, class: "w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-indigo-500 text-sm" %>
            <p class="text-xs text-gray-500 mt-1">0 = unlimited</p>
          </div>
          <div>
            <%= f.label :max_channels_per_server, "Max Channels Per Server", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
            <%= f.number_field :max_channels_per_server, min: 1, class: "w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-indigo-500 text-sm" %>
          </div>
          <div>
            <%= f.label :max_categories_per_server, "Max Categories Per Server", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
            <%= f.number_field :max_categories_per_server, min: 1, class: "w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-indigo-500 text-sm" %>
          </div>
          <div>
            <%= f.label :max_members_per_server, "Max Members Per Server", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
            <%= f.number_field :max_members_per_server, min: 0, class: "w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-indigo-500 text-sm" %>
            <p class="text-xs text-gray-500 mt-1">0 = unlimited</p>
          </div>
          <div>
            <%= f.label :max_roles_per_server, "Max Roles Per Server", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
            <%= f.number_field :max_roles_per_server, min: 1, class: "w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-indigo-500 text-sm" %>
          </div>
        </div>
      </div>

      <!-- Storage Limits -->
      <div class="bg-gray-800 rounded-lg p-6">
        <h2 class="text-lg font-semibold text-white mb-1">Storage Limits</h2>
        <p class="text-xs text-gray-400 mb-4">Set to 0 for unlimited</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <%= f.label :max_upload_size_mb, "Max Upload Size (MB)", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
            <%= f.number_field :max_upload_size_mb, min: 1, class: "w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-indigo-500 text-sm" %>
          </div>
          <div>
            <%= f.label :max_storage_per_user_mb, "Max Storage Per User (MB)", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
            <%= f.number_field :max_storage_per_user_mb, min: 0, class: "w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-indigo-500 text-sm" %>
            <p class="text-xs text-gray-500 mt-1">0 = unlimited</p>
          </div>
        </div>
      </div>

      <!-- Message Pruning -->
      <div class="bg-gray-800 rounded-lg p-6">
        <h2 class="text-lg font-semibold text-white mb-1">Message Pruning</h2>
        <p class="text-xs text-gray-400 mb-4">Automatically clean up old messages and attachments to manage storage</p>
        <div class="space-y-4">
          <div>
            <%= f.label :pruning_strategy, "Pruning Strategy", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
            <%= f.select :pruning_strategy,
                options_for_select([
                  ["Disabled — keep everything forever", "none"],
                  ["Time-Based — delete messages older than retention period", "time_based"],
                  ["Storage-Based — prune attachments first, keep message text longer", "storage_based"]
                ], @config.pruning_strategy),
                {},
                class: "w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-indigo-500 text-sm" %>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <%= f.label :message_retention_days, "Message Retention (days)", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
              <%= f.number_field :message_retention_days, min: 0, class: "w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-indigo-500 text-sm" %>
              <p class="text-xs text-gray-500 mt-1">0 = forever (only applies when pruning is enabled)</p>
            </div>
            <div>
              <%= f.label :attachment_retention_days, "Attachment Retention (days)", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
              <%= f.number_field :attachment_retention_days, min: 0, class: "w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-indigo-500 text-sm" %>
              <p class="text-xs text-gray-500 mt-1">0 = forever. Prune file attachments separately from text.</p>
            </div>
          </div>

          <div class="flex items-center gap-2">
            <%= f.check_box :keep_pinned_messages, class: "w-4 h-4 rounded border-gray-600 bg-gray-900 text-indigo-500 focus:ring-indigo-500" %>
            <%= f.label :keep_pinned_messages, "Keep pinned messages (never prune)", class: "text-sm text-gray-300" %>
          </div>
        </div>
      </div>

      <div class="flex justify-end">
        <%= f.submit "Save Settings", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-6 py-2 rounded transition cursor-pointer text-sm" %>
      </div>
    <% end %>

    <!-- Emergency Lockdown -->
    <div class="bg-gray-800 border <%= @config.lockdown? ? 'border-red-600' : 'border-gray-700' %> rounded-lg p-6 mt-6">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-lg font-semibold text-white">Emergency Lockdown</h2>
          <p class="text-xs text-gray-400 mt-1">
            <% if @config.lockdown? %>
              All locks are active. Remote auth, registrations, remote joins, and invite creation are blocked.
            <% else %>
              Instantly enable all lockdown controls. Use during raids or abuse incidents.
            <% end %>
          </p>
        </div>
        <% if @config.lockdown? %>
          <%= button_to "Lift All Lockdowns", lift_lockdown_admin_instance_config_path,
              method: :post,
              class: "bg-green-600 hover:bg-green-700 text-white font-semibold px-5 py-2 rounded transition cursor-pointer text-sm" %>
        <% else %>
          <%= button_to "Activate Emergency Lockdown", emergency_lockdown_admin_instance_config_path,
              method: :post,
              data: { turbo_confirm: "This will immediately block all remote auth, registrations, remote joins, and invite creation. Continue?" },
              class: "bg-red-600 hover:bg-red-700 text-white font-semibold px-5 py-2 rounded transition cursor-pointer text-sm" %>
        <% end %>
      </div>
    </div>

    <!-- Relay Connections -->
    <div class="bg-gray-800 rounded-lg p-6 mt-6">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h2 class="text-lg font-semibold text-white">Relay Connections</h2>
          <p class="text-xs text-gray-400 mt-1">Nostr relays for publishing and fetching profile events</p>
        </div>
      </div>

      <!-- Add new relay -->
      <%= form_with url: admin_relay_connections_path, method: :post, class: "flex gap-2 mb-4" do |f| %>
        <%= f.text_field :url, placeholder: "wss://relay.example.com", class: "flex-1 bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-indigo-500 text-sm" %>
        <%= f.submit "Add Relay", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-4 py-2 rounded transition cursor-pointer text-sm" %>
      <% end %>

      <% relays = RelayConnection.order(created_at: :desc) %>
      <% if relays.any? %>
        <div class="space-y-2">
          <% relays.each do |relay| %>
            <div class="flex items-center justify-between bg-gray-900 rounded px-4 py-3">
              <div class="flex items-center gap-3">
                <div class="w-2.5 h-2.5 rounded-full shrink-0 <%= relay.active? ? 'bg-green-400' : relay.error? ? 'bg-red-400' : 'bg-gray-500' %>"></div>
                <div>
                  <p class="text-sm font-medium text-white font-mono"><%= relay.url %></p>
                  <p class="text-xs text-gray-400">
                    <%= relay.status.capitalize %>
                    <% if relay.last_connected_at %> &middot; Last connected <%= time_ago_in_words(relay.last_connected_at) %> ago<% end %>
                    <% if relay.error? && relay.last_error_message.present? %>
                      &middot; <span class="text-red-400"><%= truncate(relay.last_error_message, length: 60) %></span>
                    <% end %>
                  </p>
                </div>
              </div>
              <div class="flex items-center gap-2">
                <%= button_to relay.active? ? "Disable" : "Enable",
                    toggle_admin_relay_connection_path(relay),
                    method: :post,
                    class: "text-sm text-gray-400 hover:text-white bg-gray-700 hover:bg-gray-600 px-3 py-1 rounded transition cursor-pointer" %>
                <%= button_to "Remove", admin_relay_connection_path(relay),
                    method: :delete,
                    class: "text-sm text-gray-400 hover:text-white bg-gray-700 hover:bg-red-600 px-3 py-1 rounded transition cursor-pointer" %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-gray-500">No relays configured. Add a relay to enable profile sync across instances.</p>
      <% end %>
    </div>

    <!-- Instance Blocklist -->
    <div class="bg-gray-800 rounded-lg p-6 mt-6">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h2 class="text-lg font-semibold text-white">Blocked Instances</h2>
          <p class="text-xs text-gray-400 mt-1">Remote instances blocked from authenticating users on this instance</p>
        </div>
      </div>

      <!-- Add new block -->
      <%= form_with url: admin_instance_blocklists_path, method: :post, class: "flex gap-2 mb-4" do |f| %>
        <%= f.text_field :domain, placeholder: "spam.example.com", class: "flex-1 bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-indigo-500 text-sm" %>
        <%= f.text_field :reason, placeholder: "Reason (optional)", class: "flex-1 bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-indigo-500 text-sm" %>
        <%= f.submit "Block", class: "bg-red-600 hover:bg-red-700 text-white font-semibold px-4 py-2 rounded transition cursor-pointer text-sm" %>
      <% end %>

      <% blocked = InstanceBlocklist.ordered %>
      <% if blocked.any? %>
        <div class="space-y-2">
          <% blocked.each do |entry| %>
            <div class="flex items-center justify-between bg-gray-900 rounded px-4 py-3">
              <div>
                <p class="text-sm font-medium text-white"><%= entry.domain %></p>
                <p class="text-xs text-gray-400">
                  <% if entry.reason.present? %><%= entry.reason %> &middot; <% end %>
                  Blocked <%= time_ago_in_words(entry.blocked_at) %> ago by <%= entry.blocked_by.username %>
                </p>
              </div>
              <%= button_to "Unblock", admin_instance_blocklist_path(entry), method: :delete,
                  class: "text-sm text-gray-400 hover:text-white bg-gray-700 hover:bg-gray-600 px-3 py-1 rounded transition cursor-pointer" %>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-gray-500">No instances are blocked.</p>
      <% end %>
    </div>
  </div>
</div>
