<!-- Shown when user has no servers -->
<div class="flex flex-col items-center justify-center h-full bg-gray-700">
  <div class="text-center">
    <h1 class="text-4xl font-bold text-white mb-2">🔥 Welcome to Inferno</h1>
    <p class="text-gray-400 text-lg mb-8">You're not in any servers yet. Create one or join with an invite.</p>
    <div class="flex gap-4 justify-center">
      <button type="button" onclick="document.querySelector('[data-controller=add-server-modal] [data-add-server-modal-target=modal]')?.classList.remove('hidden')"
              class="bg-gradient-to-r from-confirm-dark to-confirm hover:from-confirm hover:to-confirm-light text-white font-semibold px-6 py-3 rounded-lg transition cursor-pointer">
        Create a Server
      </button>
    </div>
  </div>
</div>
