<!DOCTYPE html>
<html class="h-full bg-gray-900">
  <head>
    <title>Inferno - Syncing</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  </head>
  <body class="h-full flex items-center justify-center text-gray-100 bg-gray-900">
    <% if notice %><div class="fixed top-4 right-4 z-50 bg-green-600 text-white px-4 py-2 rounded-lg shadow-lg"><%= notice %></div><% end %>
    <% if alert %><div class="fixed top-4 right-4 z-50 bg-red-600 text-white px-4 py-2 rounded-lg shadow-lg"><%= alert %></div><% end %>
    <%= yield %>
  </body>
</html>
