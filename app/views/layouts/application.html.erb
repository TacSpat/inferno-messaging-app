<!DOCTYPE html>
<html class="h-full bg-gray-900" data-theme="<%= current_user&.theme || 'inferno' %>">
  <head>
    <title>Inferno</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <script>var t=localStorage.getItem("theme");if(t)document.documentElement.dataset.theme=t;</script>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
    <%= action_cable_meta_tag %>
    <% if user_signed_in? %>
      <meta name="user-server-gids" content="<%= current_user.servers.where.not(nostr_group_id: nil).pluck(:nostr_group_id).join(",") %>">
    <% end %>
    <%= yield :head %>
    <style>
      /* Mobile sidebar transitions */
      @media (max-width: 767px) {
        .mobile-server-rail {
          display: flex !important;
          flex-direction: column;
          position: fixed;
          left: 0;
          top: 0;
          bottom: 0;
          z-index: 70;
          transform: translateX(-100%);
          transition: transform 0.25s ease;
        }
        .mobile-server-rail.mobile-sidebar-open {
          transform: translateX(0);
        }
        .mobile-channel-sidebar {
          display: flex !important;
          flex-direction: column;
          position: fixed;
          left: 0;
          top: 0;
          bottom: 0;
          z-index: 60;
          transform: translateX(-100%);
          transition: transform 0.25s ease;
        }
        .mobile-channel-sidebar.mobile-sidebar-open {
          transform: translateX(72px);
        }
        .mobile-member-sidebar {
          position: fixed !important;
          right: 0;
          top: 0;
          bottom: 0;
          z-index: 60;
          transform: translateX(100%);
          transition: transform 0.25s ease;
          display: block !important;
        }
        .mobile-member-sidebar.mobile-members-open {
          transform: translateX(0);
        }
        .mobile-backdrop {
          position: fixed;
          inset: 0;
          background: rgba(0,0,0,0.6);
          z-index: 50;
          transition: opacity 0.25s ease;
        }
      }
    </style>
  </head>
  <body class="h-full overflow-hidden text-gray-100" <% if user_signed_in? %>data-controller="appearance notification-badge" data-current-user-id="<%= current_user.public_id %>"<% end %>>
    <% if notice %><div class="fixed top-4 right-4 z-50 bg-success text-white px-4 py-2 rounded-lg shadow-lg" data-controller="toast"><%= notice %></div><% end %>
    <% if alert %><div class="fixed top-4 right-4 z-50 bg-danger text-white px-4 py-2 rounded-lg shadow-lg" data-controller="toast"><%= alert %></div><% end %>
    <% if user_signed_in? && current_user.instance_admin? && !request.ssl? && !request.host.in?(%w[localhost 127.0.0.1]) %>
      <div class="bg-warning-dark text-warning-light text-xs text-center px-3 py-1.5 font-medium z-50 relative">
        <svg class="w-3.5 h-3.5 inline -mt-0.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/></svg>
        Insecure connection — HTTPS is required for voice chat, federation stability, and security.
        <%= link_to "Configure", admin_instance_config_path, class: "underline text-warning-light hover:text-white ml-1" %>
      </div>
    <% end %>

    <% if user_signed_in? && @server&.persisted? %>
      <div class="flex h-full" data-controller="mobile-nav">
        <!-- Mobile backdrop -->
        <div data-mobile-nav-target="backdrop" data-action="click->mobile-nav#closeAll" class="mobile-backdrop hidden md:hidden"></div>

        <!-- Server rail -->
        <%= render "shared/server_rail", active_server: @server %>

        <!-- Channel sidebar -->
        <aside data-mobile-nav-target="channelSidebar" class="hidden md:flex flex-col w-60 bg-gray-800 shrink-0 mobile-channel-sidebar">
          <!-- Server name header -->
          <div class="relative" data-controller="dropdown">
            <div class="flex items-center justify-between px-4 h-12 border-b border-gray-900 shadow-sm cursor-pointer hover:bg-gray-700" data-action="click->dropdown#toggle">
              <h2 class="font-semibold text-white truncate"><%= @server.name %></h2>
              <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </div>
            <!-- Dropdown menu -->
            <div data-dropdown-target="menu" class="hidden absolute left-2 right-2 top-12 bg-gray-900 border border-gray-700 rounded-lg shadow-xl z-50 py-1.5 px-1.5">
              <% membership = current_user.server_memberships.find_by(server: @server) %>
              <% if membership&.has_permission?("manage_channels") %>
                <%= link_to new_server_channel_path(@server), class: "flex items-center px-2.5 py-1.5 text-sm text-gray-300 hover:bg-gray-700 hover:text-white rounded" do %>
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                  Create Channel
                <% end %>
                <%= link_to new_server_category_path(@server), class: "flex items-center px-2.5 py-1.5 text-sm text-gray-300 hover:bg-gray-700 hover:text-white rounded" do %>
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>
                  Create Category
                <% end %>
              <% end %>
              <% if membership&.has_permission?("manage_server") %>
                <%= link_to server_settings_overview_path(@server), class: "flex items-center px-2.5 py-1.5 text-sm text-gray-300 hover:bg-gray-700 hover:text-white rounded" do %>
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                  Server Settings
                <% end %>
              <% end %>
              <div class="border-t border-gray-700 my-1"></div>
              <% if @server.owner != current_user %>
                <%= button_to "Leave Server", leave_server_path(@server), method: :delete, class: "flex items-center w-full px-2.5 py-1.5 text-sm text-danger-light hover:bg-danger/20 rounded cursor-pointer", data: { turbo_confirm: "Leave #{@server.name}?" } %>
              <% end %>
              <% if membership&.has_permission?("create_invite") %>
                <div data-controller="invite-menu" data-invite-menu-base-url-value="<%= request.base_url %>" data-invite-menu-server-id-value="<%= @server.public_id %>" data-invite-menu-nostr-group-id-value="<%= @server.nostr_group_id %>">
                  <button type="button" data-action="invite-menu#toggle" class="flex items-center w-full px-2.5 py-1.5 text-sm text-gray-300 hover:bg-gray-700 hover:text-white rounded cursor-pointer">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
                    Invite People
                  </button>
                  <div data-invite-menu-target="panel" class="hidden mt-1 bg-gray-800 border border-gray-700 rounded-lg p-3 space-y-2 w-[420px] z-50">
                    <% active_invite = @server.invites.active_invites.first %>
                    <% if active_invite %>
                      <div class="flex items-center gap-2 bg-gray-900 rounded px-2.5 py-1.5">
                        <span data-invite-menu-target="linkText" class="text-xs text-gray-300 font-mono flex-1 select-all truncate"><%= active_invite.to_naddr || "#{request.base_url}/inferno/invite/#{@server.nostr_group_id}/#{active_invite.code}" %></span>
                        <button type="button" data-invite-menu-target="copyBtn" data-action="invite-menu#copy" class="text-accent-light hover:text-accent text-xs font-semibold shrink-0 cursor-pointer">Copy</button>
                      </div>
                    <% else %>
                      <div class="flex items-center gap-2 bg-gray-900 rounded px-2.5 py-1.5">
                        <span data-invite-menu-target="linkText" class="text-xs text-gray-500 italic truncate flex-1">No active invite</span>
                        <button type="button" data-invite-menu-target="copyBtn" data-action="invite-menu#copy" class="text-accent-light hover:text-accent text-xs font-semibold shrink-0 cursor-pointer hidden">Copy</button>
                      </div>
                    <% end %>
                    <button type="button" data-invite-menu-target="generateBtn" data-action="invite-menu#generate" class="w-full text-center text-xs text-accent-light hover:text-accent font-semibold py-1 cursor-pointer">
                      Create New Invite
                    </button>
                  </div>
                </div>
              <% end %>
            </div>
          </div>


          <!-- Channels list -->
          <% _membership = current_user.server_memberships.find_by(server: @server) %>
          <div class="flex-1 overflow-y-auto py-2 px-2 space-y-0.5" data-controller="channel-sidebar channel-reorder" data-channel-sidebar-server-id-value="<%= @server.public_id %>" data-channel-sidebar-can-move-members-value="<%= _membership&.has_permission?('move_members') || _membership&.owner? || false %>" data-channel-reorder-server-id-value="<%= @server.public_id %>" data-channel-reorder-can-manage-value="<%= _membership&.has_permission?('manage_channels') || false %>" data-can-manage-messages="<%= _membership&.has_permission?('manage_messages') || false %>">
            <%# Render uncategorized channels and categories interleaved by position %>
            <% root_channels = @server.channels.uncategorized.where(channel_type: [:text, :voice]).where(parent_channel_id: nil).ordered.to_a %>
            <% root_categories = @server.categories.ordered.to_a %>
            <% root_items = (root_channels.map { |ch| [:channel, ch] } + root_categories.map { |cat| [:category, cat] }).sort_by { |_type, item| [item.position, item.created_at] } %>
            <% root_items.each do |type, item| %>
              <% if type == :channel %>
                <% channel_access = item.visible_to?(current_user) %>
                <% next unless channel_access %>
                <%= render partial: "channels/channel_item", locals: { channel: item, server: @server, active: (defined?(@channel) && item == @channel), read_only: channel_access == :read_only } %>
              <% else %>
                <%= render partial: "categories/category", locals: { category: item, server: @server } %>
              <% end %>
            <% end %>
          </div>

          <!-- Voice controls bar -->
          <div id="voice-controls-bar" data-turbo-permanent class="hidden voice-controls-inferno" style="background-color: var(--color-gray-900);"
               data-controller="voice-channel"
               data-voice-channel-target="controlsBar">
            <!-- Header: status + disconnect -->
            <div class="flex items-center justify-between px-3 pt-2 pb-1">
              <div class="min-w-0">
                <div class="flex items-center">
                  <svg class="w-4 h-4 text-green-500 mr-1.5 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M15.536 8.464a5 5 0 010 7.072M12 6v12m-3.536-2.464a5 5 0 010-7.072M18.364 5.636a9 9 0 010 12.728M5.636 18.364a9 9 0 010-12.728"/></svg>
                  <span class="text-sm font-medium text-green-500" data-voice-channel-target="statusText">Voice Connected</span>
                </div>
                <p class="text-xs text-gray-400 truncate" data-voice-channel-target="channelName"></p>
              </div>
              <button type="button" class="p-1.5 rounded bg-danger/20 hover:bg-danger/40 text-danger-light hover:text-danger transition cursor-pointer shrink-0 ml-2" title="Disconnect"
                      data-action="click->voice-channel#disconnectVoice"
                      data-voice-channel-target="disconnectBtn">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 8l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2M5 3a2 2 0 00-2 2v1c0 8.284 6.716 15 15 15h1a2 2 0 002-2v-3.28a1 1 0 00-.684-.948l-4.493-1.498a1 1 0 00-1.21.502l-1.13 2.257a11.042 11.042 0 01-5.516-5.517l2.257-1.128a1 1 0 00.502-1.21L9.228 3.683A1 1 0 008.279 3H5z"/></svg>
              </button>
            </div>
            <!-- Hierarchy controls row (above main controls) — hidden when not applicable -->
            <div class="hidden items-center justify-center gap-1.5 px-3 pb-1" data-voice-channel-target="hierarchyRow">
              <button type="button" class="hidden flex items-center gap-1 px-2 py-0.5 rounded text-xs font-medium text-gray-300 hover:text-white hover:bg-gray-600 transition cursor-pointer" title="Broadcast to child channels"
                      data-action="click->voice-channel#toggleBroadcast"
                      data-voice-channel-target="broadcastBtn">
                <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
                <span>Broadcast</span>
              </button>
              <button type="button" class="hidden flex items-center gap-1 px-2 py-0.5 rounded text-xs font-medium text-gray-300 hover:text-white hover:bg-gray-600 transition cursor-pointer" title="Request to speak in parent channel"
                      data-action="click->voice-channel#requestToSpeak"
                      data-voice-channel-target="requestSpeakBtn">
                <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/></svg>
                <span>Ask to Speak</span>
              </button>
            </div>
            <!-- Main controls: mute, deafen, camera, screen share -->
            <div class="flex items-center justify-center gap-2 px-3 pb-2">
              <button type="button" class="p-1.5 rounded hover:bg-gray-600 text-gray-300 hover:text-white transition cursor-pointer" title="Mute"
                      data-action="click->voice-channel#toggleMute"
                      data-voice-channel-target="muteBtn">
                <svg class="w-5 h-5" data-voice-channel-target="muteIcon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/></svg>
              </button>
              <button type="button" class="p-1.5 rounded hover:bg-gray-600 text-gray-300 hover:text-white transition cursor-pointer" title="Deafen"
                      data-action="click->voice-channel#toggleDeafen"
                      data-voice-channel-target="deafenBtn">
                <svg class="w-5 h-5" data-voice-channel-target="deafenIcon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z M15.54 8.46a5 5 0 010 7.07"/></svg>
              </button>
              <button type="button" class="p-1.5 rounded hover:bg-gray-600 text-gray-300 hover:text-white transition cursor-pointer" title="Camera"
                      data-action="click->voice-channel#toggleCamera"
                      data-voice-channel-target="cameraBtn">
                <svg class="w-5 h-5" data-voice-channel-target="cameraIcon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
              </button>
              <button type="button" class="p-1.5 rounded hover:bg-gray-600 text-gray-300 hover:text-white transition cursor-pointer" title="Share Screen"
                      data-action="click->voice-channel#toggleScreenShare"
                      data-voice-channel-target="screenShareBtn">
                <svg class="w-5 h-5" data-voice-channel-target="screenShareIcon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </button>
            </div>
          </div>

          <!-- User panel (bottom) -->
          <div class="flex items-center px-2 py-2 bg-gray-850 border-t border-gray-900" style="background-color: var(--color-gray-950);">
            <div class="relative">
              <% if current_user.effective_avatar_url.present? %>
                <%= image_tag current_user.effective_avatar_url, class: "w-8 h-8 rounded-full object-cover" %>
              <% else %>
                <div class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold" style="background-color: <%= current_user.profile_color || '#1e1c1b' %>">
                  <%= current_user.username[0].upcase %>
                </div>
              <% end %>
              <div class="absolute -bottom-0.5 -right-0.5 w-3.5 h-3.5 rounded-full border-2 border-gray-900 bg-gray-500 cursor-pointer hover:ring-2 hover:ring-white/20" data-user-status-dot data-action="click->appearance#toggleStatusPicker"></div>
              <%= render "shared/status_picker" %>
            </div>
            <div class="ml-2 flex-1 min-w-0">
              <p class="text-sm font-medium text-white truncate"><%= current_user.display_name.presence || current_user.username %></p>
              <p class="text-xs text-gray-400 truncate"><%= current_user.tag %></p>
            </div>
            <span class="text-[10px] text-gray-600 ml-auto mr-1">v<%= Inferno::VERSION %></span>
            <%= link_to user_settings_account_path, data: { turbo_frame: "settings-frame" }, onclick: "document.getElementById('settings-overlay')?.classList.remove('hidden'); document.body.style.overflow='hidden'", class: "text-gray-400 hover:text-gray-200 p-1" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <% end %>
          </div>
        </aside>

        <!-- Main content + member sidebar -->
        <div class="flex-1 flex flex-col min-w-0 bg-gray-700" data-controller="frame-loading message-search"
             data-message-search-url-value="<%= defined?(@server) && @server ? search_server_path(@server) : '' %>"
             data-message-search-autocomplete-url-value="<%= defined?(@server) && @server ? server_search_autocomplete_path(@server) : '' %>">
          <%= render "shared/friend_request_bar" %>
          <!-- Persistent header bar: channel name/pin updated via JS on frame-load -->
          <div id="persistent-header" class="flex items-center px-4 h-12 border-b border-gray-900 shadow-sm shrink-0">
            <!-- Hamburger menu (mobile only) -->
            <button type="button" class="md:hidden text-gray-400 hover:text-white mr-2 p-1" data-action="click->mobile-nav#toggleSidebar">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
            </button>
            <!-- Channel icon + name + topic (updated by JS) -->
            <span id="ph-channel-icon" class="text-gray-400 mr-2 shrink-0"></span>
            <h1 id="ph-channel-name" class="font-semibold text-white truncate"></h1>
            <div id="ph-topic-divider" class="mx-4 w-px h-6 bg-gray-600 hidden"></div>
            <p id="ph-channel-topic" class="text-sm text-gray-400 truncate hidden"></p>
            <div class="flex-1"></div>
            <!-- Pin button (updated by JS) -->
            <div class="relative" id="ph-pin-wrap">
              <button type="button" class="text-gray-400 hover:text-white p-1 transition cursor-pointer relative"
                      id="ph-pin-btn" title="Pinned Messages">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12V4h1V2H7v2h1v8l-2 2v2h5.2v6h1.6v-6H18v-2l-2-2z"/></svg>
                <span id="ph-pin-badge" class="hidden absolute -top-1 -right-1.5 min-w-[16px] h-4 bg-accent text-[10px] font-bold text-white rounded-full flex items-center justify-center px-0.5">0</span>
              </button>
            </div>
            <%= render "shared/header_toolbar" %>
            <!-- Member list toggle (mobile only) -->
            <button type="button" class="lg:hidden text-gray-400 hover:text-white p-1" data-action="click->mobile-nav#toggleMembers">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"/></svg>
            </button>
            <%= render "shared/search_input", server: @server if defined?(@server) && @server %>
          </div>
          <div class="flex flex-1 min-h-0">
            <main class="flex-1 flex flex-col min-w-0 min-h-0">
              <%= yield %>
            </main>
            <!-- Member sidebar: outside turbo frame, persists across channel navigations -->
            <%= render "servers/member_sidebar" if defined?(@members) && @members %>
          </div>
        </div>
      </div>
    <% elsif user_signed_in? && @dm_layout %>
      <div class="flex h-full" data-controller="mobile-nav">
        <!-- Mobile backdrop -->
        <div data-mobile-nav-target="backdrop" data-action="click->mobile-nav#closeAll" class="mobile-backdrop hidden md:hidden"></div>

        <!-- Server rail -->
        <%= render "shared/server_rail" %>

        <!-- DM sidebar -->
        <%= render "conversations/dm_sidebar" %>

        <!-- Main content + DM member sidebar -->
        <div class="flex-1 flex flex-col min-w-0 bg-gray-700" data-controller="frame-loading">
          <%= render "shared/friend_request_bar" %>
          <div class="flex flex-1 min-h-0">
            <main class="flex-1 flex flex-col min-w-0 min-h-0">
              <%= yield %>
            </main>
          </div>
        </div>
      </div>
    <% else %>
      <%= yield %>
    <% end %>

    <%= render "shared/js_templates" if user_signed_in? %>

    <script>
      // Shared panel slide animation helpers
      function _slideOpen(el, targetW) {
        el.style.overflow = "hidden";
        el.style.minWidth = "0px";
        el.style.maxWidth = "0px";
        el.style.opacity = "0";
        el.style.borderLeftWidth = "0px";
        el.offsetHeight;
        el.style.transition = "min-width 200ms ease, max-width 200ms ease, opacity 150ms ease, border-left-width 200ms ease";
        el.style.minWidth = targetW + "px";
        el.style.maxWidth = targetW + "px";
        el.style.opacity = "1";
        el.style.borderLeftWidth = "";
        el.addEventListener("transitionend", function handler(e) {
          if (e.propertyName !== "max-width") return;
          el.removeEventListener("transitionend", handler);
          el.style.transition = "";
          el.style.overflow = "";
          el.style.minWidth = "";
          el.style.maxWidth = "";
        });
      }
      function _slideClose(el, onDone) {
        el.style.overflow = "hidden";
        var w = el.offsetWidth;
        el.style.minWidth = w + "px";
        el.style.maxWidth = w + "px";
        el.offsetHeight;
        el.style.transition = "min-width 200ms ease, max-width 200ms ease, opacity 150ms ease, border-left-width 200ms ease";
        el.style.minWidth = "0px";
        el.style.maxWidth = "0px";
        el.style.opacity = "0";
        el.style.borderLeftWidth = "0px";
        el.addEventListener("transitionend", function handler(e) {
          if (e.propertyName !== "max-width") return;
          el.removeEventListener("transitionend", handler);
          el.style.transition = "";
          el.style.overflow = "";
          el.style.minWidth = "";
          el.style.maxWidth = "";
          el.style.opacity = "";
          el.style.borderLeftWidth = "";
          if (onDone) onDone();
        });
      }

      // Generic side panel toggle with width animation
      window._toggleSidePanel = function(panelId, btn) {
        var p = document.getElementById(panelId);
        if (!p) return;
        if (p._animating) return;
        var isHidden = p.classList.contains("hidden");
        if (isHidden) {
          p.classList.remove("hidden");
          p._animating = true;
          var targetW = p.offsetWidth || 320;
          _slideOpen(p, targetW);
          p.addEventListener("transitionend", function h(e) {
            if (e.propertyName !== "max-width") return;
            p.removeEventListener("transitionend", h);
            p._animating = false;
          });
          if (btn) btn.classList.add("text-white");
        } else {
          p._animating = true;
          _slideClose(p, function() { p.classList.add("hidden"); p._animating = false; });
          if (btn) btn.classList.remove("text-white");
        }
      };

      window._toggleMemberSidebar = function() {
        var sb = document.getElementById("member-sidebar");
        if (!sb) return;
        if (sb._animating) return;
        var isHidden = sb.dataset.panelHidden === "true";
        if (isHidden) {
          sb.dataset.panelHidden = "false";
          sb.style.display = "";
          sb._animating = true;
          _slideOpen(sb, 240);
          sb.addEventListener("transitionend", function h(e) {
            if (e.propertyName !== "max-width") return;
            sb.removeEventListener("transitionend", h);
            sb._animating = false;
          });
          localStorage.setItem("members_hidden", "");
        } else {
          sb.dataset.panelHidden = "true";
          sb._animating = true;
          _slideClose(sb, function() { sb.style.display = "none"; sb._animating = false; });
          localStorage.setItem("members_hidden", "1");
        }
        var btn = document.getElementById("member-toggle-btn");
        if (btn) btn.classList.toggle("text-white", isHidden);
      };
      // Apply saved preference on load and after turbo frame navigations
      function _applyMemberPref() {
        var sb = document.getElementById("member-sidebar");
        if (!sb) return;
        // Always hide for voice channels
        var activeLink = document.querySelector("a[data-channel-id].bg-gray-600");
        var isVoice = activeLink && activeLink.dataset.voiceChannel === "true";
        var shouldHide = isVoice || localStorage.getItem("members_hidden") === "1";
        if (shouldHide) {
          sb.style.display = "none";
          sb.dataset.panelHidden = "true";
        } else {
          sb.style.display = "";
          sb.dataset.panelHidden = "false";
        }
        var btn = document.getElementById("member-toggle-btn");
        if (btn) btn.classList.toggle("text-white", !shouldHide);
      }
      _applyMemberPref();

      // DM member sidebar toggle (profile card for 1-on-1 DMs, member list for group chats)
      window._toggleDmMemberSidebar = function() {
        var sb = document.getElementById("dm-member-sidebar");
        if (!sb) return;
        if (sb._animating) return;
        var isHidden = sb.dataset.panelHidden === "true";
        if (isHidden) {
          sb.dataset.panelHidden = "false";
          sb.style.display = "";
          sb._animating = true;
          _slideOpen(sb, 240);
          sb.addEventListener("transitionend", function h(e) {
            if (e.propertyName !== "max-width") return;
            sb.removeEventListener("transitionend", h);
            sb._animating = false;
          });
          localStorage.setItem("dm_members_hidden", "");
        } else {
          sb.dataset.panelHidden = "true";
          sb._animating = true;
          _slideClose(sb, function() { sb.style.display = "none"; sb._animating = false; });
          localStorage.setItem("dm_members_hidden", "1");
        }
        var btn = document.getElementById("dm-member-toggle-btn");
        if (btn) btn.classList.toggle("text-white", isHidden);
      };

      function _applyDmMemberPref() {
        var sb = document.getElementById("dm-member-sidebar");
        if (!sb) return;
        var shouldHide = localStorage.getItem("dm_members_hidden") === "1";
        if (shouldHide) {
          sb.style.display = "none";
          sb.dataset.panelHidden = "true";
        } else {
          sb.style.display = "";
          sb.dataset.panelHidden = "false";
        }
        var btn = document.getElementById("dm-member-toggle-btn");
        if (btn) btn.classList.toggle("text-white", !shouldHide);
      }
      _applyDmMemberPref();

      // Icons for the persistent header
      var _headerIcons = {
        text: '<span class="text-gray-400 text-xl mr-2">#</span>',
        encrypted: '<svg class="w-5 h-5 text-gray-400 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>',
        voice: '<svg class="w-5 h-5 text-gray-400 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072M12 6v12m-3.536-2.464a5 5 0 010-7.072M18.364 5.636a9 9 0 010 12.728M5.636 18.364a9 9 0 010-12.728"/></svg>'
      };

      // Update persistent header from channel-header-data in the turbo frame
      function _updatePersistentHeader() {
        var d = document.getElementById("channel-header-data");
        if (!d) return;
        // Close any open pinned panel from the previous channel
        var oldPanel = document.querySelector("#ph-pin-wrap .pinned-panel");
        if (oldPanel) oldPanel.remove();
        var icon = document.getElementById("ph-channel-icon");
        var name = document.getElementById("ph-channel-name");
        var divider = document.getElementById("ph-topic-divider");
        var topic = document.getElementById("ph-channel-topic");
        var pinBtn = document.getElementById("ph-pin-btn");
        var pinBadge = document.getElementById("ph-pin-badge");
        var pinWrap = document.getElementById("ph-pin-wrap");

        // Hide entire header for voice channels (they have their own layout)
        var header = document.getElementById("persistent-header");
        if (header) header.style.display = d.dataset.channelIcon === "voice" ? "none" : "";

        if (icon) icon.innerHTML = _headerIcons[d.dataset.channelIcon] || _headerIcons.text;
        if (name) name.innerHTML = d.dataset.channelNameHtml || d.dataset.channelName || "";
        if (d.dataset.channelTopic) {
          if (divider) { divider.classList.remove("hidden"); divider.classList.add("sm:block"); }
          if (topic) { topic.textContent = d.dataset.channelTopic; topic.classList.remove("hidden"); topic.classList.add("sm:block"); }
        } else {
          if (divider) { divider.classList.add("hidden"); divider.classList.remove("sm:block"); }
          if (topic) { topic.classList.add("hidden"); topic.classList.remove("sm:block"); topic.textContent = ""; }
        }

        var pinCount = parseInt(d.dataset.pinCount) || 0;
        var pinUrl = d.dataset.pinUrl || "";
        if (pinWrap) pinWrap.style.display = pinUrl ? "" : "none";
        if (pinBtn) pinBtn.onclick = function() {
          document.dispatchEvent(new CustomEvent("toggle-pinned-panel", { detail: { url: pinUrl } }));
        };
        if (pinBadge) {
          pinBadge.textContent = pinCount;
          // Check localStorage for seen pins — only show badge if there are unseen pins
          var channelData = document.querySelector("[data-current-channel-id]");
          var chId = channelData ? channelData.dataset.currentChannelId : "";
          var seen = chId ? (parseInt(localStorage.getItem("seenPins_" + chId)) || 0) : 0;
          pinBadge.classList.toggle("hidden", pinCount === 0 || pinCount <= seen);
        }
      }
      _updatePersistentHeader();

      document.addEventListener("turbo:frame-load", function(e) {
        if (e.target.id === "main-content") {
          _updatePersistentHeader();
          _applyMemberPref();
          _applyDmMemberPref();
        }
      });
    </script>

    <% if user_signed_in? %>
      <div id="settings-overlay" class="hidden fixed inset-0 z-[80] bg-gray-900" data-controller="settings-overlay" data-action="keydown@document->settings-overlay#escClose">
        <turbo-frame id="settings-frame" class="block h-full" data-settings-overlay-target="frame" data-action="turbo:frame-load->settings-overlay#frameLoaded"></turbo-frame>
      </div>
    <% end %>
  </body>
</html>
