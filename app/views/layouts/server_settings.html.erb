<!DOCTYPE html>
<html class="h-full bg-gray-900">
  <head>
    <title>Server Settings - Inferno</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>
  <body class="h-full overflow-hidden text-gray-100">
    <% if notice %><div class="fixed top-4 right-4 z-50 bg-success text-white px-4 py-2 rounded-lg shadow-lg" data-controller="toast"><%= notice %></div><% end %>
    <% if alert %><div class="fixed top-4 right-4 z-50 bg-danger text-white px-4 py-2 rounded-lg shadow-lg" data-controller="toast"><%= alert %></div><% end %>

    <div class="flex h-full" data-controller="settings-sidebar">
      <!-- Mobile sidebar backdrop -->
      <div data-settings-sidebar-target="backdrop" class="hidden fixed inset-0 bg-black/50 z-40 md:hidden" data-action="click->settings-sidebar#close"></div>
      <!-- Settings sidebar -->
      <div data-settings-sidebar-target="sidebar" class="hidden md:block w-56 shrink-0 bg-gray-800 overflow-y-auto fixed top-0 left-0 bottom-0 z-50 md:relative md:z-auto">
        <nav class="py-8 px-4">
          <!-- Mobile close button -->
          <button type="button" class="md:hidden flex items-center text-gray-400 hover:text-white mb-4 px-2" data-action="click->settings-sidebar#close">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            Back
          </button>
          <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wide px-2 mb-2"><%= @server.name %></h3>

          <% if @current_membership&.has_permission?("manage_server") || @current_membership&.admin? %>
          <div class="space-y-0.5 mb-4">
            <%= link_to "Overview", server_settings_overview_path(@server),
                class: "block px-2 py-1.5 rounded text-sm #{action_name == 'overview' || action_name == 'update_overview' ? 'bg-gray-600 text-white' : 'text-gray-400 hover:bg-gray-700 hover:text-gray-200'}" %>
          </div>
          <% end %>

          <% show_emoji_link = @current_membership&.has_permission?("create_emojis") || @current_membership&.has_permission?("manage_emojis") || @current_membership&.has_permission?("manage_server") || @current_membership&.admin? %>
          <% show_sticker_link = @current_membership&.has_permission?("create_stickers") || @current_membership&.has_permission?("manage_emojis") || @current_membership&.has_permission?("manage_server") || @current_membership&.admin? %>
          <% if show_emoji_link || show_sticker_link %>
          <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wide px-2 mb-2 mt-4">Expression</h3>
          <div class="space-y-0.5 mb-4">
            <% if show_emoji_link %>
              <%= link_to "Emoji", server_settings_emojis_path(@server),
                  class: "block px-2 py-1.5 rounded text-sm #{action_name == 'emojis' ? 'bg-gray-600 text-white' : 'text-gray-400 hover:bg-gray-700 hover:text-gray-200'}" %>
            <% end %>
            <% if show_sticker_link %>
              <%= link_to "Stickers", server_settings_stickers_path(@server),
                  class: "block px-2 py-1.5 rounded text-sm #{action_name == 'stickers' ? 'bg-gray-600 text-white' : 'text-gray-400 hover:bg-gray-700 hover:text-gray-200'}" %>
            <% end %>
          </div>
          <% end %>

          <% show_members = @current_membership&.has_permission?("manage_server") || @current_membership&.has_permission?("manage_roles") || @current_membership&.admin? %>
          <% show_roles = @current_membership&.has_permission?("manage_server") || @current_membership&.has_permission?("manage_roles") || @current_membership&.admin? %>
          <% show_invites = @current_membership&.has_permission?("create_invite") || @current_membership&.has_permission?("manage_invites") %>
          <% if show_members || show_roles || show_invites %>
          <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wide px-2 mb-2 mt-4">People</h3>
          <div class="space-y-0.5 mb-4">
            <% if show_members %>
              <%= link_to "Members", server_settings_members_path(@server),
                  class: "block px-2 py-1.5 rounded text-sm #{action_name == 'members' ? 'bg-gray-600 text-white' : 'text-gray-400 hover:bg-gray-700 hover:text-gray-200'}" %>
            <% end %>
            <% if show_roles %>
              <%= link_to "Roles", server_settings_roles_path(@server),
                  class: "block px-2 py-1.5 rounded text-sm #{action_name == 'roles' ? 'bg-gray-600 text-white' : 'text-gray-400 hover:bg-gray-700 hover:text-gray-200'}" %>
            <% end %>
            <% if show_invites %>
              <%= link_to "Invites", server_settings_invites_path(@server),
                  class: "block px-2 py-1.5 rounded text-sm #{action_name == 'invites' || action_name == 'create_invite' || action_name == 'destroy_invite' ? 'bg-gray-600 text-white' : 'text-gray-400 hover:bg-gray-700 hover:text-gray-200'}" %>
            <% end %>
          </div>
          <% end %>

          <% show_audit_log = @current_membership&.has_permission?("manage_server") || @current_membership&.admin? %>
          <% show_bans = @current_membership&.has_permission?("manage_server") || @current_membership&.has_permission?("ban_members") || @current_membership&.admin? %>
          <% if show_audit_log || show_bans %>
          <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wide px-2 mb-2 mt-4">Moderation</h3>
          <div class="space-y-0.5 mb-4">
            <% if show_audit_log %>
              <%= link_to "Audit Log", server_settings_audit_log_path(@server),
                  class: "block px-2 py-1.5 rounded text-sm #{action_name == 'audit_log' ? 'bg-gray-600 text-white' : 'text-gray-400 hover:bg-gray-700 hover:text-gray-200'}" %>
            <% end %>
            <% if show_bans %>
              <%= link_to "Bans", server_settings_bans_path(@server),
                  class: "block px-2 py-1.5 rounded text-sm #{action_name == 'bans' ? 'bg-gray-600 text-white' : 'text-gray-400 hover:bg-gray-700 hover:text-gray-200'}" %>
            <% end %>
          </div>
          <% end %>

          <div class="border-t border-gray-700 mt-4 pt-4">
            <% if @server.owner == current_user %>
              <%= button_to "Delete Server", server_path(@server), method: :delete,
                  data: { turbo_confirm: "Are you sure? This cannot be undone." },
                  class: "flex items-center w-full px-2 py-1.5 rounded text-sm text-danger-light hover:bg-danger/20 cursor-pointer" %>
            <% end %>
          </div>
        </nav>
      </div>

      <!-- Settings content -->
      <div class="flex-1 overflow-y-auto">
        <!-- Mobile header -->
        <div class="md:hidden flex items-center px-4 h-12 border-b border-gray-700 shrink-0">
          <button type="button" class="text-gray-400 hover:text-white mr-3 p-1" data-action="click->settings-sidebar#open">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
          </button>
          <span class="font-semibold text-white text-sm capitalize"><%= action_name.tr('_', ' ') %></span>
          <div class="flex-1"></div>
          <%= link_to server_channel_path(@server, @server.channels.ordered.first), class: "flex items-center justify-center w-8 h-8 rounded-full border-2 border-gray-600 text-gray-400 hover:border-gray-400 hover:text-gray-200 transition" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          <% end %>
        </div>

        <div class="py-4 sm:py-8 px-4 sm:px-10">
          <!-- Close button (desktop) -->
          <div class="hidden md:flex justify-end mb-4">
            <%= link_to server_channel_path(@server, @server.channels.ordered.first), class: "flex items-center justify-center w-9 h-9 rounded-full border-2 border-gray-600 text-gray-400 hover:border-gray-400 hover:text-gray-200 transition" do %>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            <% end %>
          </div>
          <%= yield %>
        </div>
      </div>
    </div>
  </body>
</html>
