<div class="flex items-center py-0.5 pl-6 pr-2 rounded hover:bg-gray-700/50 group"
     data-voice-user-id="<%= voice_state.user.public_id %>"
     data-channel-id="<%= voice_state.channel.public_id %>"
     data-voice-state-id="<%= voice_state.public_id %>"
     data-action="contextmenu->voice-context#show">
  <div class="relative">
    <% if voice_state.user.avatar.attached? %>
      <%= image_tag voice_state.user.avatar, class: "w-5 h-5 rounded-full object-cover voice-sidebar-avatar" %>
    <% else %>
      <div class="w-5 h-5 rounded-full flex items-center justify-center text-[10px] font-bold text-white voice-sidebar-avatar" style="background-color: <%= voice_state.user.profile_color || '#1e1c1b' %>">
        <%= voice_state.user.username[0].upcase %>
      </div>
    <% end %>
  </div>
  <span class="ml-1.5 text-xs text-gray-300 truncate flex-1"><%= voice_state.user.display_name.presence || voice_state.user.username %></span>
  <% if voice_state.server_mute %>
    <svg class="voice-server-mute-icon w-3 h-3 text-danger-light ml-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/><line x1="3" y1="3" x2="21" y2="21" stroke-width="2" stroke-linecap="round"/></svg>
  <% elsif voice_state.self_mute %>
    <svg class="voice-mute-icon w-3 h-3 text-gray-500 ml-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"/></svg>
  <% end %>
  <% if voice_state.server_deaf %>
    <svg class="voice-server-deaf-icon w-3 h-3 text-danger-light ml-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728L5.636 5.636"/></svg>
  <% elsif voice_state.self_deaf %>
    <svg class="voice-deaf-icon w-3 h-3 text-gray-500 ml-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728L5.636 5.636"/></svg>
  <% end %>
</div>
