<div class="max-w-2xl">
<h2 class="text-xl font-bold text-white mb-1">Stickers</h2>
<p class="text-sm text-gray-500 mb-6">Custom stickers that members can send in messages.</p>

<!-- Upload Sticker -->
<% if @current_membership&.has_permission?("create_stickers") || @current_membership&.has_permission?("manage_emojis") || @current_membership&.has_permission?("manage_server") || @current_membership&.admin? %>
<%= form_with url: server_stickers_path(@server), method: :post, html: { multipart: true } do |f| %>
  <div class="flex items-start gap-3 mb-6 bg-gray-800/60 rounded-xl p-3">
    <div id="sticker-preview-area" class="w-20 h-20 rounded-lg bg-gray-700/80 border border-dashed border-gray-600 flex items-center justify-center cursor-pointer hover:border-accent/60 transition shrink-0 overflow-hidden">
      <div id="sticker-preview-placeholder" class="text-center">
        <svg class="w-6 h-6 text-gray-500 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
      </div>
      <img id="sticker-preview-img" class="hidden w-full h-full object-contain" alt="Preview">
    </div>
    <input type="file" name="server_sticker[image]" id="sticker-file-input" accept="image/png,image/gif,image/webp" required class="hidden">
    <div class="flex-1 space-y-2 min-w-0">
      <input type="text" name="server_sticker[name]" id="sticker-name-input" placeholder="Sticker name" required
             class="w-full bg-gray-700/60 text-white text-sm rounded-lg px-3 py-2 outline-none border border-transparent focus:border-accent/40 placeholder-gray-500 transition">
      <input type="text" name="server_sticker[description]" placeholder="Description (optional)"
             class="w-full bg-gray-700/60 text-white text-sm rounded-lg px-3 py-2 outline-none border border-transparent focus:border-accent/40 placeholder-gray-500 transition">
      <div class="flex items-center gap-2 pt-0.5">
        <span class="text-[11px] text-gray-600">PNG, GIF, WebP. Max 512KB.</span>
        <div class="flex-1"></div>
        <button type="submit" class="bg-accent hover:bg-accent-light text-white text-sm font-medium px-4 py-2 rounded-lg transition cursor-pointer whitespace-nowrap">
          Upload
        </button>
      </div>
    </div>
  </div>
<% end %>
<script>
  document.addEventListener("turbo:load", function() {
    const area = document.getElementById("sticker-preview-area")
    const fileInput = document.getElementById("sticker-file-input")
    const preview = document.getElementById("sticker-preview-img")
    const placeholder = document.getElementById("sticker-preview-placeholder")
    const nameInput = document.getElementById("sticker-name-input")
    if (!area || !fileInput) return

    area.addEventListener("click", function() { fileInput.click() })

    fileInput.addEventListener("change", function() {
      const file = this.files[0]
      if (!file) return
      preview.src = URL.createObjectURL(file)
      preview.classList.remove("hidden")
      placeholder.classList.add("hidden")
      area.classList.remove("border-dashed")
      area.classList.add("border-solid", "border-accent/40")
      if (!nameInput.value) {
        nameInput.value = file.name.replace(/\.[^.]+$/, "").replace(/[-_]/g, " ").replace(/\b\w/g, function(c) { return c.toUpperCase() })
        nameInput.focus()
      }
    })
  })
</script>
<% end %>

<!-- Existing Stickers -->
<div>
  <div class="flex items-center justify-between mb-3">
    <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Stickers (<%= @stickers.count %>/<%= ServerSticker::MAX_STICKERS_PER_SERVER %>)</h3>
  </div>
  <% if @stickers.any? %>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
      <% @stickers.each do |sticker| %>
        <div class="relative group bg-gray-800/40 hover:bg-gray-800/70 rounded-xl p-3 transition">
          <% if sticker.image.attached? %>
            <div class="flex items-center justify-center h-24 mb-2">
              <%= image_tag sticker.image, class: "max-w-full max-h-full object-contain" %>
            </div>
          <% end %>
          <p class="text-white text-xs font-medium truncate"><%= sticker.name %></p>
          <% if sticker.description.present? %>
            <p class="text-gray-500 text-[11px] truncate"><%= sticker.description %></p>
          <% end %>
          <p class="text-gray-600 text-[11px] mt-0.5">by <%= sticker.creator.username %></p>
          <% if @current_membership&.has_permission?("manage_emojis") || @current_membership&.has_permission?("manage_server") || @current_membership&.admin? %>
            <%= button_to server_sticker_path(@server, sticker), method: :delete, data: { turbo_confirm: "Delete sticker '#{sticker.name}'?" }, class: "absolute top-2 right-2 opacity-0 group-hover:opacity-100 p-1 rounded-md bg-gray-900/80 text-gray-400 hover:text-danger-light transition cursor-pointer" do %>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-10">
      <p class="text-gray-600 text-sm">No stickers yet</p>
    </div>
  <% end %>
</div>
</div>
