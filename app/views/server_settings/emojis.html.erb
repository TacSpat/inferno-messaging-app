<h2 class="text-xl font-bold text-white mb-6">Emoji</h2>

<!-- Upload Emoji -->
<% if @current_membership&.has_permission?("create_emojis") || @current_membership&.has_permission?("manage_emojis") || @current_membership&.has_permission?("manage_server") || @current_membership&.admin? %>
<div class="bg-gray-800 rounded-lg p-4 mb-6">
  <h3 class="text-sm font-semibold text-white mb-3">Upload Custom Emoji</h3>
  <p class="text-xs text-gray-400 mb-3">PNG, GIF, or WebP. Max 256KB. Name must be lowercase letters, numbers, and underscores only.</p>
  <%= form_with url: server_emojis_path(@server), method: :post, html: { multipart: true, class: "space-y-4" } do |f| %>
    <!-- Upload area -->
    <div class="flex items-center gap-4">
      <div id="emoji-preview-area" class="w-16 h-16 rounded-lg bg-gray-700 border-2 border-dashed border-gray-600 flex items-center justify-center cursor-pointer hover:border-accent transition shrink-0 overflow-hidden">
        <div id="emoji-preview-placeholder" class="text-center">
          <svg class="w-6 h-6 text-gray-500 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        </div>
        <img id="emoji-preview-img" class="hidden w-full h-full object-contain" alt="Preview">
      </div>
      <div class="flex-1 space-y-2">
        <div>
          <label class="block text-xs text-gray-400 mb-1">Name</label>
          <input type="text" name="server_emoji[name]" id="emoji-name-input" placeholder="my_emoji" pattern="[a-z0-9_]+" required class="w-full max-w-48 bg-gray-700 text-white text-sm rounded px-3 py-2 outline-none focus:ring-1 focus:ring-accent">
        </div>
        <input type="file" name="server_emoji[image]" id="emoji-file-input" accept="image/png,image/gif,image/webp" required class="hidden">
      </div>
    </div>
    <button type="submit" class="bg-gradient-to-r from-confirm-dark to-confirm hover:from-confirm hover:to-confirm-light text-white text-sm font-medium px-4 py-2 rounded transition cursor-pointer">Upload Emoji</button>
  <% end %>
</div>
<script>
  document.addEventListener("turbo:load", function() {
    const area = document.getElementById("emoji-preview-area")
    const fileInput = document.getElementById("emoji-file-input")
    const preview = document.getElementById("emoji-preview-img")
    const placeholder = document.getElementById("emoji-preview-placeholder")
    const nameInput = document.getElementById("emoji-name-input")
    if (!area || !fileInput) return

    area.addEventListener("click", function() { fileInput.click() })

    fileInput.addEventListener("change", function() {
      const file = this.files[0]
      if (!file) return
      preview.src = URL.createObjectURL(file)
      preview.classList.remove("hidden")
      placeholder.classList.add("hidden")
      area.classList.remove("border-dashed")
      area.classList.add("border-solid", "border-accent")
      if (!nameInput.value) {
        nameInput.value = file.name.replace(/\.[^.]+$/, "").toLowerCase().replace(/[^a-z0-9_]/g, "_").replace(/_+/g, "_").replace(/^_|_$/g, "")
        nameInput.focus()
      }
    })
  })
</script>
<% end %>

<!-- Existing Emojis -->
<div>
  <h3 class="text-sm font-semibold text-gray-400 uppercase tracking-wide mb-3">Custom Emojis (<%= @emojis.count %>/<%= ServerEmoji::MAX_EMOJIS_PER_SERVER %>)</h3>
  <% if @emojis.any? %>
    <div class="bg-gray-800 rounded-lg divide-y divide-gray-700">
      <% @emojis.each do |emoji| %>
        <div class="flex items-center px-4 py-3">
          <% if emoji.image.attached? %>
            <%= image_tag emoji.image, class: "w-8 h-8 object-contain mr-3" %>
          <% end %>
          <div class="flex-1 min-w-0">
            <span class="text-white text-sm font-medium">:<%= emoji.name %>:</span>
            <span class="text-gray-500 text-xs ml-2">by <%= emoji.creator.username %></span>
          </div>
          <% if @current_membership&.has_permission?("manage_emojis") || @current_membership&.has_permission?("manage_server") || @current_membership&.admin? %>
            <%= button_to server_emoji_path(@server, emoji), method: :delete, data: { turbo_confirm: "Delete :#{emoji.name}:?" }, class: "text-gray-400 hover:text-danger-light transition cursor-pointer" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-gray-500 text-sm">No custom emojis yet. Upload one above!</p>
  <% end %>
</div>
