<div class="max-w-2xl">
<h2 class="text-xl font-bold text-white mb-1">Emoji</h2>
<p class="text-sm text-gray-500 mb-6">Manage custom emojis for your server. Members can use them in messages with <code class="text-xs bg-gray-800 px-1 py-0.5 rounded text-gray-300">:name:</code> syntax.</p>

<!-- Upload Emoji -->
<% if @current_membership&.has_permission?("create_emojis") || @current_membership&.has_permission?("manage_emojis") || @current_membership&.has_permission?("manage_server") || @current_membership&.admin? %>
<%= form_with url: server_emojis_path(@server), method: :post, html: { multipart: true } do |f| %>
  <div class="flex items-center gap-3 mb-6 bg-gray-800/60 rounded-xl p-3">
    <div id="emoji-preview-area" class="w-12 h-12 rounded-lg bg-gray-700/80 border border-dashed border-gray-600 flex items-center justify-center cursor-pointer hover:border-accent/60 transition shrink-0 overflow-hidden">
      <div id="emoji-preview-placeholder">
        <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      </div>
      <img id="emoji-preview-img" class="hidden w-full h-full object-contain" alt="Preview">
    </div>
    <input type="file" name="server_emoji[image]" id="emoji-file-input" accept="image/png,image/gif,image/webp" required class="hidden">
    <input type="text" name="server_emoji[name]" id="emoji-name-input" placeholder="emoji_name" pattern="[a-z0-9_]+" required
           class="flex-1 bg-gray-700/60 text-white text-sm rounded-lg px-3 py-2 outline-none border border-transparent focus:border-accent/40 placeholder-gray-500 transition">
    <button type="submit" class="bg-accent hover:bg-accent-light text-white text-sm font-medium px-4 py-2 rounded-lg transition cursor-pointer whitespace-nowrap shrink-0">
      Upload
    </button>
  </div>
<% end %>
<script>
  document.addEventListener("turbo:load", function() {
    const area = document.getElementById("emoji-preview-area")
    const fileInput = document.getElementById("emoji-file-input")
    const preview = document.getElementById("emoji-preview-img")
    const placeholder = document.getElementById("emoji-preview-placeholder")
    const nameInput = document.getElementById("emoji-name-input")
    if (!area || !fileInput) return

    area.addEventListener("click", function() { fileInput.click() })

    fileInput.addEventListener("change", function() {
      const file = this.files[0]
      if (!file) return
      preview.src = URL.createObjectURL(file)
      preview.classList.remove("hidden")
      placeholder.classList.add("hidden")
      area.classList.remove("border-dashed")
      area.classList.add("border-solid", "border-accent/40")
      if (!nameInput.value) {
        nameInput.value = file.name.replace(/\.[^.]+$/, "").toLowerCase().replace(/[^a-z0-9_]/g, "_").replace(/_+/g, "_").replace(/^_|_$/g, "")
        nameInput.focus()
      }
    })
  })
</script>
<% end %>

<!-- Existing Emojis -->
<div>
  <div class="flex items-center justify-between mb-3">
    <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Custom Emojis (<%= @emojis.count %>/<%= ServerEmoji::MAX_EMOJIS_PER_SERVER %>)</h3>
  </div>
  <% if @emojis.any? %>
    <div class="space-y-0.5">
      <% @emojis.each do |emoji| %>
        <div class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-gray-800/60 transition group">
          <% if emoji.image.attached? %>
            <%= image_tag emoji.image, class: "w-8 h-8 object-contain shrink-0" %>
          <% end %>
          <div class="flex-1 min-w-0 flex items-center gap-2">
            <span class="text-sm text-white font-medium">:<%= emoji.name %>:</span>
            <span class="text-[11px] text-gray-600">uploaded by <%= emoji.creator.username %></span>
          </div>
          <% if @current_membership&.has_permission?("manage_emojis") || @current_membership&.has_permission?("manage_server") || @current_membership&.admin? %>
            <%= button_to server_emoji_path(@server, emoji), method: :delete, data: { turbo_confirm: "Delete :#{emoji.name}:?" }, class: "opacity-0 group-hover:opacity-100 text-gray-500 hover:text-danger-light transition cursor-pointer" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-10">
      <p class="text-gray-600 text-sm">No custom emojis yet</p>
    </div>
  <% end %>
</div>
</div>
