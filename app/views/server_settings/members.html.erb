<div data-controller="member-management" data-member-management-server-id-value="<%= @server.public_id %>">

<!-- Top bar: search + prune -->
<div class="flex items-center justify-between mb-6">
  <h1 class="text-xl font-bold text-white">Members (<%= @all_members.size %>)</h1>
  <div class="flex items-center gap-3">
    <div class="relative">
      <input type="text" placeholder="Search members..."
             class="bg-gray-700 text-gray-200 text-sm rounded-lg pl-8 pr-3 py-1.5 outline-none placeholder-gray-500 focus:ring-1 focus:ring-accent w-48"
             data-member-management-target="searchInput"
             data-action="input->member-management#search">
      <svg class="w-4 h-4 text-gray-500 absolute left-2 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
    </div>
    <% if @current_membership&.has_permission?("kick_members") || @current_membership&.admin? %>
      <button type="button" class="text-sm text-gray-400 hover:text-white bg-gray-700 hover:bg-gray-600 px-3 py-1.5 rounded-lg cursor-pointer transition"
              data-action="click->member-management#togglePrune">
        Prune
      </button>
    <% end %>
  </div>
</div>

<!-- Prune panel -->
<div data-member-management-target="prunePanel" class="hidden mb-6 bg-gray-800 border border-gray-700 rounded-lg p-4">
  <h3 class="text-sm font-semibold text-white mb-3">Prune Inactive Members</h3>
  <div class="flex items-center gap-3 mb-3">
    <label class="text-sm text-gray-400">Inactive for</label>
    <select data-member-management-target="pruneDays" class="bg-gray-700 text-gray-200 text-sm rounded px-3 py-1.5 outline-none">
      <option value="7">7 days</option>
      <option value="14">14 days</option>
      <option value="30" selected>30 days</option>
      <option value="60">60 days</option>
      <option value="90">90 days</option>
    </select>
    <button type="button" class="text-sm text-accent-light hover:text-accent cursor-pointer"
            data-action="click->member-management#previewPrune">Preview</button>
  </div>
  <div data-member-management-target="pruneList" class="space-y-1 max-h-48 overflow-y-auto"></div>
  <div data-member-management-target="pruneFooter" class="hidden mt-3 flex items-center justify-between">
    <span data-member-management-target="pruneCount" class="text-sm text-gray-400"></span>
    <button type="button" class="text-sm bg-danger hover:bg-danger-light text-white px-3 py-1.5 rounded cursor-pointer transition"
            data-action="click->member-management#confirmPrune">Confirm Prune</button>
  </div>
</div>

<!-- Batch toolbar -->
<div data-member-management-target="toolbar" class="hidden mb-4 bg-accent/10 border border-accent/20 rounded-lg px-4 py-2.5 flex items-center gap-3">
  <span class="text-sm text-accent-light"><span data-member-management-target="selectedCount">0</span> selected</span>
  <div class="flex-1"></div>
  <!-- Batch timeout dropdown -->
  <div class="relative" data-member-management-target="batchTimeoutWrapper">
    <button type="button" class="text-xs text-warning-light hover:text-warning bg-warning-dark/20 hover:bg-warning-dark/30 px-2.5 py-1 rounded cursor-pointer transition"
            data-action="click->member-management#toggleBatchTimeout">
      Timeout
    </button>
    <div data-member-management-target="batchTimeoutDropdown" class="hidden absolute bottom-full left-0 mb-1 w-36 bg-gray-900 border border-gray-700 rounded-lg shadow-xl py-1 z-50">
      <button type="button" class="w-full text-left text-sm text-gray-300 hover:bg-gray-800 px-3 py-1.5 cursor-pointer" data-action="click->member-management#batchTimeout" data-duration="60">60 seconds</button>
      <button type="button" class="w-full text-left text-sm text-gray-300 hover:bg-gray-800 px-3 py-1.5 cursor-pointer" data-action="click->member-management#batchTimeout" data-duration="300">5 minutes</button>
      <button type="button" class="w-full text-left text-sm text-gray-300 hover:bg-gray-800 px-3 py-1.5 cursor-pointer" data-action="click->member-management#batchTimeout" data-duration="600">10 minutes</button>
      <button type="button" class="w-full text-left text-sm text-gray-300 hover:bg-gray-800 px-3 py-1.5 cursor-pointer" data-action="click->member-management#batchTimeout" data-duration="3600">1 hour</button>
      <button type="button" class="w-full text-left text-sm text-gray-300 hover:bg-gray-800 px-3 py-1.5 cursor-pointer" data-action="click->member-management#batchTimeout" data-duration="86400">1 day</button>
      <button type="button" class="w-full text-left text-sm text-gray-300 hover:bg-gray-800 px-3 py-1.5 cursor-pointer" data-action="click->member-management#batchTimeout" data-duration="604800">1 week</button>
    </div>
  </div>
  <button type="button" class="text-xs text-danger-light hover:text-danger bg-danger/20 hover:bg-danger/30 px-2.5 py-1 rounded cursor-pointer transition"
          data-action="click->member-management#batchKick">Kick</button>
  <button type="button" class="text-xs text-danger-light hover:text-danger bg-danger/20 hover:bg-danger/30 px-2.5 py-1 rounded cursor-pointer transition"
          data-action="click->member-management#batchBan">Ban</button>
</div>

<!-- Select all -->
<% if @current_membership&.admin? %>
<div class="flex items-center mb-2 px-4">
  <label class="flex items-center cursor-pointer text-xs text-gray-500 hover:text-gray-400">
    <input type="checkbox" class="mr-2" data-action="change->member-management#selectAll" data-member-management-target="selectAllCheckbox">
    Select all
  </label>
</div>
<% end %>

<!-- Member list -->
<div data-member-management-target="memberList" class="space-y-2">
  <%= render partial: "server_settings/members_list", locals: { all_members: @all_members } %>
</div>

</div>
