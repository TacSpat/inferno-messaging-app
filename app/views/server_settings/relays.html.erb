<h2 class="text-xl font-bold text-white mb-6">Relays</h2>

<p class="text-sm text-gray-400 mb-6">
  Configure which relays this server uses for federation and channel sync. Server-specific relays are used in addition to your global relays.
</p>

<!-- Add relay to server -->
<div class="mb-6">
  <%= form_with url: server_settings_add_relay_path(@server), method: :post, local: true, class: "flex gap-2" do %>
    <input type="text" name="relay_url" placeholder="wss://relay.example.com"
           class="flex-1 bg-gray-800 border border-gray-600 text-white text-sm rounded-lg px-3 py-2 placeholder-gray-500 focus:ring-1 focus:ring-accent focus:border-accent outline-none font-mono"
           required pattern="wss?://.*" list="known-relays">
    <datalist id="known-relays">
      <% @global_relays.active.each do |r| %>
        <% unless @server_relays.include?(r.url) %>
          <option value="<%= r.url %>">
        <% end %>
      <% end %>
    </datalist>
    <button type="submit" class="bg-accent hover:bg-accent-light text-white text-sm font-medium px-4 py-2 rounded-lg transition cursor-pointer shrink-0">
      Add Relay
    </button>
  <% end %>
</div>

<!-- Server-specific relays -->
<% if @server_relays.any? %>
  <h3 class="text-sm font-semibold text-gray-400 uppercase tracking-wide mb-3">Server Relays</h3>
  <div class="space-y-2 mb-6">
    <% @server_relays.each do |url| %>
      <% relay_record = @global_relays.find { |r| r.url == url } %>
      <div class="bg-gray-800 rounded-lg p-3 flex items-center gap-3 group">
        <div class="w-8 h-8 rounded-full flex items-center justify-center shrink-0
                    <%= relay_record&.active? ? 'bg-accent/15' : relay_record&.error? ? 'bg-red-500/15' : 'bg-gray-700' %>">
          <svg class="w-4 h-4 <%= relay_record&.active? ? 'text-accent-light' : relay_record&.error? ? 'text-red-400' : 'text-gray-500' %>" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.288 15.038a5.25 5.25 0 0 1 7.424 0M5.106 11.856c3.807-3.808 9.98-3.808 13.788 0M1.924 8.674c5.565-5.565 14.587-5.565 20.152 0M12.53 18.22l-.53.53-.53-.53a.75.75 0 0 1 1.06 0Z" />
          </svg>
        </div>
        <div class="flex-1 min-w-0">
          <p class="text-sm font-medium text-white font-mono truncate"><%= url %></p>
          <p class="text-xs text-gray-500">
            <% if relay_record&.active? %>
              Active
              <% if relay_record.last_connected_at %>
                &middot; Last connected <%= time_ago_in_words(relay_record.last_connected_at) %> ago
              <% end %>
            <% elsif relay_record&.error? %>
              <span class="text-red-400">Error<%= " - #{truncate(relay_record.last_error_message, length: 50)}" if relay_record.last_error_message.present? %></span>
            <% elsif relay_record %>
              Disabled in global settings
            <% else %>
              Not in global relay pool
            <% end %>
          </p>
        </div>
        <%= button_to server_settings_remove_relay_path(@server), method: :delete, params: { relay_url: url },
              class: "p-1.5 text-gray-400 hover:text-red-400 rounded hover:bg-gray-700 transition cursor-pointer opacity-0 group-hover:opacity-100 shrink-0",
              title: "Remove from server" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>

<!-- Global relays (inherited) -->
<h3 class="text-sm font-semibold text-gray-400 uppercase tracking-wide mb-3">Global Relays <span class="font-normal normal-case">(inherited)</span></h3>
<div class="space-y-2 mb-6">
  <% @global_relays.active.each do |relay| %>
    <% next if @server_relays.include?(relay.url) %>
    <div class="bg-gray-800/50 rounded-lg p-3 flex items-center gap-3">
      <div class="w-8 h-8 rounded-full bg-green-500/10 flex items-center justify-center shrink-0">
        <svg class="w-4 h-4 text-green-400/60" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.288 15.038a5.25 5.25 0 0 1 7.424 0M5.106 11.856c3.807-3.808 9.98-3.808 13.788 0M1.924 8.674c5.565-5.565 14.587-5.565 20.152 0M12.53 18.22l-.53.53-.53-.53a.75.75 0 0 1 1.06 0Z" />
        </svg>
      </div>
      <div class="flex-1 min-w-0">
        <p class="text-sm text-gray-300 font-mono truncate"><%= relay.url %></p>
        <p class="text-xs text-gray-600">Global relay &middot; Managed in user settings</p>
      </div>
    </div>
  <% end %>

  <% inactive_global = @global_relays.reject(&:active?).reject { |r| @server_relays.include?(r.url) } %>
  <% if inactive_global.any? %>
    <details class="mt-2">
      <summary class="text-xs text-gray-500 cursor-pointer hover:text-gray-400"><%= inactive_global.count %> inactive relay<%= inactive_global.count == 1 ? '' : 's' %></summary>
      <div class="space-y-2 mt-2">
        <% inactive_global.each do |relay| %>
          <div class="bg-gray-800/30 rounded-lg p-3 flex items-center gap-3 opacity-50">
            <div class="w-8 h-8 rounded-full bg-gray-700 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 0 0 5.636 5.636m12.728 12.728A9 9 0 0 1 5.636 5.636m12.728 12.728L5.636 5.636" />
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm text-gray-400 font-mono truncate"><%= relay.url %></p>
              <p class="text-xs text-gray-600"><%= relay.error? ? "Error" : "Disabled" %></p>
            </div>
          </div>
        <% end %>
      </div>
    </details>
  <% end %>

  <% if @global_relays.active.reject { |r| @server_relays.include?(r.url) }.empty? && @server_relays.empty? %>
    <div class="text-center py-6">
      <p class="text-sm text-gray-500">No relays configured.</p>
      <p class="text-xs text-gray-600 mt-1">Add relays in your user settings first, then optionally add server-specific relays here.</p>
    </div>
  <% end %>
</div>

<!-- Quick-add from known relays -->
<% available_global = @global_relays.active.reject { |r| @server_relays.include?(r.url) } %>
<% if available_global.any? %>
  <div class="border-t border-gray-700 pt-4">
    <h3 class="text-sm font-semibold text-gray-400 mb-3">Add from Known Relays</h3>
    <div class="flex flex-wrap gap-2">
      <% available_global.each do |relay| %>
        <%= button_to server_settings_add_relay_path(@server), method: :post, params: { relay_url: relay.url },
              class: "inline-flex items-center gap-1.5 bg-gray-800 hover:bg-gray-700 text-gray-300 text-xs font-mono px-3 py-1.5 rounded-full transition cursor-pointer border border-gray-700 hover:border-gray-600" do %>
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          <%= relay.url.sub("wss://", "") %>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
