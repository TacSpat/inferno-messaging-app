<h1 class="text-xl font-bold text-white mb-6">Server Overview</h1>

<%= form_with model: @server, url: server_settings_update_overview_path(@server), method: :patch, html: { multipart: true }, class: "space-y-6" do |f| %>
  <% if @server.errors.any? %>
    <div class="bg-red-900/50 border border-red-700 rounded-lg p-4">
      <% @server.errors.full_messages.each do |msg| %>
        <p class="text-sm text-red-300"><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div class="flex gap-6">
    <!-- Icon -->
    <div class="shrink-0">
      <div class="w-24 h-24 rounded-2xl bg-gray-700 flex items-center justify-center text-3xl font-bold text-white overflow-hidden">
        <% if @server.icon.attached? %>
          <%= image_tag @server.icon, class: "w-full h-full object-cover" %>
        <% else %>
          <%= @server.name.split.map(&:first).join[0..1].upcase %>
        <% end %>
      </div>
      <%= f.file_field :icon, accept: "image/*", class: "mt-2 text-xs text-gray-400 file:mr-2 file:py-1 file:px-3 file:rounded file:border-0 file:text-xs file:bg-orange-600 file:text-white hover:file:bg-orange-700 file:cursor-pointer w-24" %>
    </div>

    <div class="flex-1 space-y-4">
      <div>
        <%= f.label :name, "Server Name", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
        <%= f.text_field :name, class: "w-full bg-gray-900 border border-gray-700 rounded px-3 py-2 text-white focus:outline-none focus:border-orange-500 text-sm" %>
      </div>
      <div>
        <%= f.label :description, class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
        <%= f.text_area :description, rows: 3, class: "w-full bg-gray-900 border border-gray-700 rounded px-3 py-2 text-white focus:outline-none focus:border-orange-500 text-sm resize-none" %>
      </div>
    </div>
  </div>

  <!-- Welcome Message Settings -->
  <div class="border-t border-gray-700 pt-6">
    <h2 class="text-sm font-semibold text-gray-300 uppercase tracking-wide mb-4">Welcome Message</h2>

    <div class="space-y-4">
      <div class="flex items-center gap-3">
        <%= f.check_box :welcome_message_enabled, class: "w-4 h-4 rounded bg-gray-900 border-gray-700 text-orange-600 focus:ring-orange-500" %>
        <%= f.label :welcome_message_enabled, "Send a welcome message when someone joins", class: "text-sm text-gray-300" %>
      </div>

      <div>
        <%= f.label :welcome_channel_id, "Welcome Channel", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
        <%= f.collection_select :welcome_channel_id, @server.channels.text.ordered, :id, :name, { include_blank: "Default (#general)" }, class: "w-full bg-gray-900 border border-gray-700 rounded px-3 py-2 text-white focus:outline-none focus:border-orange-500 text-sm" %>
      </div>

      <div>
        <%= f.label :welcome_message_template, "Message Template", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
        <%= f.text_area :welcome_message_template, rows: 2, class: "w-full bg-gray-900 border border-gray-700 rounded px-3 py-2 text-white focus:outline-none focus:border-orange-500 text-sm resize-none", placeholder: "Welcome to the server, {user}!" %>
        <p class="text-xs text-gray-500 mt-1">Use {user} for display name, {tag} for username#discriminator, {server} for server name</p>
      </div>
    </div>
  </div>

  <%= f.submit "Save Changes", class: "bg-orange-600 hover:bg-orange-700 text-white font-semibold px-6 py-2 rounded transition cursor-pointer text-sm" %>
<% end %>
