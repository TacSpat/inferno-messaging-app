<% online_count = @server.members.where(online_state: :online).count %>
<% member_count = @server.members.count %>

<div class="flex flex-col lg:flex-row gap-8" data-controller="server-profile-preview">
  <!-- Left: Form -->
  <div class="flex-1 min-w-0">
    <h1 class="text-xl font-bold text-white mb-1">Server Profile</h1>
    <p class="text-sm text-gray-400 mb-6">Customize how your server appears in invite links</p>

    <%= form_with model: @server, url: server_settings_update_overview_path(@server), method: :patch, html: { multipart: true }, class: "space-y-6" do |f| %>
      <% if @server.errors.any? %>
        <div class="bg-danger-dark/20 border border-danger-dark rounded-lg p-4">
          <% @server.errors.full_messages.each do |msg| %>
            <p class="text-sm text-danger-light"><%= msg %></p>
          <% end %>
        </div>
      <% end %>

      <!-- Name -->
      <div data-hint="ss_name">
        <%= f.label :name, "Name", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
        <%= f.text_field :name, class: "w-full bg-gray-900 border border-gray-700 rounded px-3 py-2 text-white focus:outline-none focus:border-accent text-sm", data: { server_profile_preview_target: "nameInput", action: "input->server-profile-preview#updateName" } %>
      </div>

      <!-- Description -->
      <div>
        <%= f.label :description, "Description", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
        <%= f.text_area :description, rows: 3, class: "w-full bg-gray-900 border border-gray-700 rounded px-3 py-2 text-white focus:outline-none focus:border-accent text-sm resize-none", placeholder: "What's this server about?" %>
      </div>

      <div class="border-t border-gray-700 pt-6"></div>

      <!-- Icon -->
      <div data-hint="ss_icon">
        <h3 class="text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1">Icon</h3>
        <p class="text-xs text-gray-500 mb-3">We recommend an image of at least 512x512.</p>
        <div class="flex items-center gap-3">
          <label class="inline-flex items-center px-4 py-1.5 rounded bg-accent hover:bg-accent-dark text-white text-xs font-semibold cursor-pointer transition">
            Change Server Icon
            <%= f.file_field :icon, accept: "image/*", class: "hidden", data: { server_profile_preview_target: "iconInput", action: "change->server-profile-preview#previewIcon" } %>
          </label>
          <% if @server.icon.attached? %>
            <button type="button" class="text-xs text-danger-light hover:text-danger font-medium" data-action="click->server-profile-preview#removeIcon">Remove Icon</button>
          <% end %>
        </div>
      </div>

      <div class="border-t border-gray-700 pt-6"></div>

      <!-- Banner -->
      <div>
        <h3 class="text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1">Banner</h3>
        <p class="text-xs text-gray-500 mb-3">Recommended size: 960x540. Shown on your invite page.</p>
        <div class="flex items-center gap-3">
          <label class="inline-flex items-center px-4 py-1.5 rounded bg-accent hover:bg-accent-dark text-white text-xs font-semibold cursor-pointer transition">
            Upload Banner
            <%= f.file_field :banner, accept: "image/*", class: "hidden", data: { server_profile_preview_target: "bannerInput", action: "change->server-profile-preview#previewBanner" } %>
          </label>
          <% if @server.banner.attached? %>
            <button type="button" class="text-xs text-danger-light hover:text-danger font-medium" data-action="click->server-profile-preview#removeBanner">Remove Banner</button>
          <% end %>
        </div>
      </div>

      <div class="border-t border-gray-700 pt-6"></div>

      <!-- Server Configuration -->
      <div data-hint="ss_config">
        <h2 class="text-sm font-semibold text-gray-300 uppercase tracking-wide mb-4">Server Configuration</h2>
        <div class="space-y-4">
          <label class="flex items-center gap-2.5 cursor-pointer group">
            <%= f.check_box :discoverable, class: "w-4 h-4 rounded bg-gray-900 border-gray-700 text-accent focus:ring-accent cursor-pointer" %>
            <div>
              <span class="text-sm text-gray-300 group-hover:text-white transition">Public server</span>
              <p class="text-[11px] text-gray-500">Anyone can discover and join this server through connected relays. When disabled, users need an invite link.</p>
            </div>
          </label>

          <label class="flex items-center gap-2.5 cursor-pointer group">
            <%= f.check_box :age_restricted, class: "w-4 h-4 rounded bg-gray-900 border-gray-700 text-accent focus:ring-accent cursor-pointer" %>
            <div>
              <span class="text-sm text-gray-300 group-hover:text-white transition">Age restricted (18+)</span>
              <p class="text-[11px] text-gray-500">Members must confirm they are 18+ to join. Enables member verification workflow.</p>
            </div>
          </label>
        </div>
      </div>

      <% if @server.age_restricted? %>
        <!-- Verification Status -->
        <div class="mt-4 bg-gray-900 rounded-lg p-4">
          <% verified_role = @server.roles.find_by(name: "Verified") %>
          <% if verified_role %>
            <% verified_count = verified_role.server_memberships.count %>
            <% total_non_owner = @server.server_memberships.where.not(user: @server.owner).count %>
            <% unverified_count = total_non_owner - verified_count %>
            <div class="flex items-center justify-between mb-3">
              <div>
                <p class="text-sm text-white font-medium">Pending verifications</p>
                <p class="text-xs text-gray-500">Members without the Verified role</p>
              </div>
              <% if unverified_count > 0 %>
                <span class="text-lg font-bold text-accent"><%= unverified_count %></span>
              <% else %>
                <span class="text-sm text-green-400">All verified</span>
              <% end %>
            </div>
            <div class="flex items-center gap-4 text-xs text-gray-500">
              <span><%= verified_count %> verified</span>
              <span>&middot;</span>
              <span><%= total_non_owner %> total members</span>
            </div>
            <% verification_channel = @server.channels.find_by(post_only: true) %>
            <% if verification_channel %>
              <div class="mt-3 pt-3 border-t border-gray-800">
                <%= link_to server_channel_path(@server, verification_channel), class: "inline-flex items-center gap-1.5 text-xs text-accent-light hover:text-accent transition" do %>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                  Review submissions in #<%= verification_channel.name %>
                <% end %>
              </div>
            <% end %>
          <% else %>
            <p class="text-sm text-gray-500">No Verified role found. <span class="text-accent-light">Create a role named "Verified"</span> to enable the verification flow.</p>
          <% end %>
        </div>
      <% end %>

      <div class="border-t border-gray-700 pt-6"></div>

      <!-- Welcome Message Settings -->
      <div data-hint="ss_welcome">
        <h2 class="text-sm font-semibold text-gray-300 uppercase tracking-wide mb-4">Welcome Message</h2>
        <div class="space-y-4">
          <div class="flex items-center gap-3">
            <%= f.check_box :welcome_message_enabled, class: "w-4 h-4 rounded bg-gray-900 border-gray-700 text-accent focus:ring-accent" %>
            <%= f.label :welcome_message_enabled, "Send a welcome message when someone joins", class: "text-sm text-gray-300" %>
          </div>
          <div>
            <%= f.label :welcome_channel_id, "Welcome Channel", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
            <%= f.collection_select :welcome_channel_id, @server.channels.text.ordered, :id, :name, { include_blank: "Default (#general)" }, class: "w-full bg-gray-900 border border-gray-700 rounded px-3 py-2 text-white focus:outline-none focus:border-accent text-sm" %>
          </div>
          <div>
            <%= f.label :welcome_message_template, "Message Template", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wide mb-1" %>
            <%= f.text_area :welcome_message_template, rows: 2, class: "w-full bg-gray-900 border border-gray-700 rounded px-3 py-2 text-white focus:outline-none focus:border-accent text-sm resize-none", placeholder: "Welcome to the server, {user}!" %>
            <p class="text-xs text-gray-500 mt-1">Use {user} for display name, {tag} for username, {server} for server name</p>
          </div>
        </div>
      </div>

      <%= f.submit "Save Changes", class: "bg-gradient-to-r from-confirm-dark to-confirm hover:from-confirm hover:to-confirm-light text-white font-semibold px-6 py-2 rounded transition cursor-pointer text-sm" %>
    <% end %>
  </div>

  <!-- Right: Live Preview Card -->
  <div data-hint="ss_preview" class="lg:w-72 shrink-0">
    <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-3">Preview</h3>
    <div class="w-72 rounded-lg overflow-hidden bg-gray-900 shadow-xl">
      <!-- Banner area -->
      <div class="relative h-28 bg-gray-700" data-server-profile-preview-target="bannerPreview">
        <% if @server.banner.attached? %>
          <%= image_tag @server.banner, class: "w-full h-full object-cover", data: { server_profile_preview_target: "bannerImage" } %>
        <% end %>
      </div>
      <!-- Icon + Info -->
      <div class="relative px-4 pb-4">
        <!-- Icon overlapping banner -->
        <div class="-mt-8 mb-2">
          <div class="w-16 h-16 rounded-2xl bg-gray-700 border-4 border-gray-900 flex items-center justify-center text-xl font-bold text-white overflow-hidden" data-server-profile-preview-target="iconPreview">
            <% if @server.icon.attached? %>
              <%= image_tag @server.icon, class: "w-full h-full object-cover", data: { server_profile_preview_target: "iconImage" } %>
            <% else %>
              <span data-server-profile-preview-target="iconInitial"><%= @server.name[0].upcase %></span>
            <% end %>
          </div>
        </div>
        <!-- Server name -->
        <p class="text-white font-bold text-sm truncate" data-server-profile-preview-target="namePreview"><%= @server.name %></p>
        <!-- Member counts -->
        <div class="flex items-center gap-3 mt-1.5 text-xs text-gray-400">
          <div class="flex items-center gap-1">
            <span class="w-2 h-2 rounded-full bg-green-500"></span>
            <span><%= online_count %> Online</span>
          </div>
          <div class="flex items-center gap-1">
            <span class="w-2 h-2 rounded-full bg-gray-500"></span>
            <span><%= member_count %> Members</span>
          </div>
        </div>
        <!-- Established date -->
        <p class="text-xs text-gray-500 mt-1">Est. <%= @server.created_at.strftime("%b %Y") %></p>
      </div>
    </div>
  </div>
</div>
