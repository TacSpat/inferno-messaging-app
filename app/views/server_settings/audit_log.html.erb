<h1 class="text-xl font-bold text-white mb-6">Audit Log</h1>

<% if @events.empty? %>
  <p class="text-gray-400 text-sm">No audit log entries yet.</p>
<% else %>
  <div class="space-y-1">
    <% @events.each do |event| %>
      <% actor = audit_event_actor(event) %>
      <% label, color, icon = audit_event_display(event) %>
      <div class="bg-gray-800 rounded-lg px-4 py-3 hover:bg-gray-750">
        <div class="flex items-start gap-3">
          <div class="mt-0.5 w-8 h-8 rounded-full flex items-center justify-center shrink-0 <%= color %>">
            <%= icon %>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm text-gray-200">
              <span class="font-semibold text-white"><%= actor&.username || event.pubkey[0..11] %></span>
              <span class="text-gray-400"><%= label %></span>
            </p>
            <p class="text-xs text-gray-500 mt-1">
              <%= time_ago_in_words(event.event_created_at || event.created_at) %> ago
              · <%= (event.event_created_at || event.created_at).strftime("%b %d, %Y %l:%M %p") %>
            </p>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
