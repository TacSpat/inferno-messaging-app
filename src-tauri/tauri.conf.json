{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Inferno",
  "version": "0.2.0",
  "identifier": "com.inferno.app",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "bundle exec rails server -p 13100 -b 127.0.0.1",
    "frontendDist": "http://localhost:13100",
    "devUrl": "http://localhost:13100"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/inferno-server"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJDQjQ3RkM2Qzg3QkI3OEQKUldTTnQzdkl4biswdk1qVnpTcExpQzVKM2t5QVN4dlMxTjdjZzRLRVY2cXhjUWdLQk9UUFdhSEgK",
      "endpoints": [
        "https://github.com/TacSpat/inferno-messaging-app/releases/latest/download/latest.json"
      ]
    }
  }
}
