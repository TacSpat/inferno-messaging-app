# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Prebuilt native libraries (built from source or downloaded in CI)
native/deepfilter/*.so
native/deepfilter/*.dylib
native/deepfilter/*.dll
native/deepfilter/DeepFilterNet/

# RNNoise source (fetched by script)
native/rnnoise/src/
native/rnnoise/include/
native/rnnoise/.tmp/

# ML models (downloaded by setup script)
assets/models/*.tar.gz
assets/models/*.onnx
assets/models/*.onnx.data

# Screenshots / temp images
flutter_01.png

# graphify knowledge graph output (regenerable)
graphify-out/

# Rails secrets — never commit
/config/master.key
/.env
/.env~

# Rails runtime data (keep the tracked .keep files)
/storage/*
!/storage/.keep
/tmp/*
!/tmp/.keep
!/tmp/pids/
/tmp/pids/*
!/tmp/pids/.keep
!/tmp/storage/
/tmp/storage/*
!/tmp/storage/.keep
/log/*
!/log/.keep
/public/cached_assets/

# Rails/JS build output and dependencies
/app/assets/builds/*
!/app/assets/builds/.keep
/.bundle/
/node_modules/
/dist/
/binaries/

# Rails ML models (too large for git)
/lib/models/*.onnx
/lib/models/*.onnx.data

# Stale duplicate Flutter tree — live code is root lib/
/flutter/

# Editor settings
/doc/.obsidian/
